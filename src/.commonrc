# shellcheck shell=sh

# Interactive-only shell configuration sourced by both `bash` and `zsh`. Env
# vars, PATH, and helpers live in `.commonenv` (sourced before this file). MUST
# remain idempotent.

###########
# Aliases #
###########

# Docker Helpers
alias dockervm='screen ~/Library/Containers/com.docker.docker/Data/vms/0/tty'
alias dockerclean='docker rm `docker ps -aq`; docker volume rm `docker volume ls -q`; docker imagerm `docker image ls -aq`;'

# Helper to collapse rails routes after a grep.
alias collapse_routes="sed -E 's/^[[:space:]]+([A-Z])/  _  \1/g' | sed -E 's/^(.)/  \1/g' | align"

# Helper to show license for all gems.
# shellcheck disable=SC2154
alias gem_licenses='for i in `gem list | cut -d" " -f1`; do printf "%38s `gem spec $i license`\n" $i; done'

# Workaround for snap-store on Snapdragon.
alias snap-store-fix="LIBGL_ALWAYS_SOFTWARE=1 snap-store"

alias claude_yolo="claude --dangerously-skip-permissions"
alias fixdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"

#########################
# Interactive Tool Init #
#########################

# Google Cloud SDK completion (path setup lives in `.commonenv`).
if [ -n "$ZSH_VERSION" ]; then
  source_if_exists "$HOME/google-cloud-sdk/completion.zsh.inc"
elif [ -n "$BASH_VERSION" ]; then
  source_if_exists "$HOME/google-cloud-sdk/completion.bash.inc"
fi

# uv completions
if [ -n "$ZSH_VERSION" ]; then
  eval_if_exists uv generate-shell-completion zsh
  eval_if_exists uvx --generate-shell-completion zsh
elif [ -n "$BASH_VERSION" ]; then
  eval_if_exists uv generate-shell-completion bash
  eval_if_exists uvx --generate-shell-completion bash
fi

true
