    "CLAUDE_CODE_USE_GATEWAY",
)

# ------------------------------------------------------------------------------- patterns

MODE_NAME_RE = re.compile(r"[a-z](?:[a-z-]*[a-z])?")  # a mode's agents and stages
ANSI_RE = re.compile(r"\x1b\[[0-9;:?]*[A-Za-z]")
TYPED_NOISE_RE = re.compile(r"[\s│┃┆┊╎╏|]+")  # wrapping and box edges in an input box
BOX_RE = re.compile(r"[\u2500-\u257f]")  # box drawing, whose size follows the pane's
# ESC above all: an ESC[201~ in a paste ends it early. And lone surrogates, which UTF-8
# cannot hold.
CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f\ud800-\udfff]")
# An image path that ends a line, or comes before " /": claude attaches the image and
# changes the text around it.
CLAUDE_IMAGE_RE = re.compile(
    r"""(['"]?)([^\s`'"]+\.(?:png|jpe?g|gif|webp))\1(?=[ \t]*$|[ \t]+/)""",
    re.IGNORECASE | re.MULTILINE,
)
# Lines in the last message of an agent's turn: its status, with its word; and any
# PANTHEON line, which with [say] starts a post to the room. Models may set them in bold.
STATUS_RE = re.compile(
    r"PANTHEON\s*\[\s*status\s*\]\s*:[\s*_`]*([A-Za-z][A-Za-z0-9-]*)", re.I
)
MARKER_RE = re.compile(r"[\s>*_`-]*PANTHEON\s*\[\s*([A-Za-z]+)\s*\]\s*:[*_]*\s*", re.I)
FENCE_RE = re.compile(r"\s*(```|~~~)")  # a code block's first or last line

# --------------------------------------------------------------------------------- schema

SCHEMA_VERSION = 7

SCHEMA = """
CREATE TABLE session (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    slug TEXT NOT NULL DEFAULT '',
    mode TEXT NOT NULL DEFAULT '',
    task TEXT NOT NULL DEFAULT '',          -- the task text the agents get
    source TEXT NOT NULL DEFAULT '',        -- the issue URL, when the task came from one
    dir TEXT NOT NULL DEFAULT '',           -- where the agents start
    base_commit TEXT NOT NULL DEFAULT '',
    pre_existing TEXT NOT NULL DEFAULT '',  -- files with changes before the session, one per line
    yolo INTEGER NOT NULL DEFAULT 0,
    scramble INTEGER NOT NULL DEFAULT 0,    -- the scramble setting when the session started
    stop_when_done INTEGER NOT NULL DEFAULT 0,  -- stop the agents once the plan is done
    state TEXT NOT NULL DEFAULT 'running',  -- running, needs_you, done, active, stopped, ended
    origin TEXT NOT NULL DEFAULT '',        -- this install's signature; files from elsewhere open read-only
    created_at TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE lock (                         -- the pantheon that has this session open
    id INTEGER PRIMARY KEY CHECK (id = 1),
    pid INTEGER NOT NULL DEFAULT 0,
    host TEXT NOT NULL DEFAULT '',
    heartbeat REAL NOT NULL DEFAULT 0       -- unix time; a stale lock is free
) STRICT;

CREATE TABLE roster (                       -- the tools this session may run agents on, in order
    id INTEGER PRIMARY KEY,
    key TEXT NOT NULL UNIQUE,               -- claude, codex, codex-2: the end of agent names
    tool TEXT NOT NULL DEFAULT '',
    model TEXT NOT NULL DEFAULT '',
    effort TEXT NOT NULL DEFAULT '',
    listed INTEGER NOT NULL DEFAULT 1       -- from -a; 0: only --agent named it
) STRICT;

CREATE TABLE picks (                        -- --agent ROLE=SPEC
    role TEXT NOT NULL PRIMARY KEY,
    key TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE agents (                       -- one per instance, made for its first turn
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,              -- <role>-<key>, e.g. reviewer-codex
    role TEXT NOT NULL DEFAULT '',          -- the mode's agent it is an instance of
    tool TEXT NOT NULL DEFAULT '',          -- claude, codex, agy, or ollama
    model TEXT NOT NULL DEFAULT '',
    effort TEXT NOT NULL DEFAULT '',
    native_id TEXT NOT NULL DEFAULT '',     -- the tool's own session id
    state TEXT NOT NULL DEFAULT 'new',      -- new, starting, working, needs_you, idle, exited
    reason TEXT NOT NULL DEFAULT '',        -- why it needs you
    heard INTEGER NOT NULL DEFAULT 0,       -- the room id of the last post typed into it
    posted INTEGER NOT NULL DEFAULT 0,      -- it posted since pantheon typed it a turn
    answering INTEGER NOT NULL DEFAULT 0    -- its turn is for a room post
) STRICT;

CREATE TABLE steps (                        -- one per turn
    id INTEGER PRIMARY KEY AUTOINCREMENT,   -- never reused: names and room entries hold it
    agent_id INTEGER NOT NULL REFERENCES agents(id) ON DELETE RESTRICT,
    stage TEXT NOT NULL DEFAULT '',
    round INTEGER NOT NULL DEFAULT 0,       -- 1 to max_rounds in a loop; 0: none
    track INTEGER NOT NULL DEFAULT 0,       -- 1 to N: the track, or the instance in a together stage; 0: none
    name TEXT NOT NULL DEFAULT '',          -- its report's file name, e.g. 01-architect-claude.md
    prompt TEXT NOT NULL DEFAULT '',        -- what pantheon typed into the agent
    report TEXT NOT NULL DEFAULT '',        -- the last message of the turn that ended it
    statuses TEXT NOT NULL DEFAULT '',      -- allowed statuses, space separated
    status TEXT NOT NULL DEFAULT 'open',    -- open, or the status its report ends with
    sent INTEGER NOT NULL DEFAULT 0         -- the prompt reached the agent
) STRICT;

CREATE TABLE hooks (                        -- raw hook events from claude and codex, until read
    id INTEGER PRIMARY KEY,
    agent TEXT NOT NULL DEFAULT '',
    payload TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE events (                       -- the room, plus hook summaries (kind = hook)
    id INTEGER PRIMARY KEY,
    at TEXT NOT NULL DEFAULT '',
    agent_id INTEGER REFERENCES agents(id) ON DELETE SET NULL,  -- NULL: pantheon or you
    kind TEXT NOT NULL DEFAULT '',          -- note, start, prompt, say, ran, report, needs, done, error, hook
    text TEXT NOT NULL DEFAULT '',
    data TEXT NOT NULL DEFAULT '{}'
) STRICT;
"""

# ---------------------------------------------------------------------------------- tools


def hook_cmd(event: str = "") -> str:
    # Silent, because hook output can reach the model, and never a failure, so a broken
    # hook cannot get in an agent's way.
    cmd = f"{shlex.quote(sys.executable)} -I -c {shlex.quote(HOOK_PROGRAM)}"
    return cmd + (f" {event}" if event else "") + " 2>/dev/null || true"


def agy_hooks() -> str:
    """The hooks.json that agy reads in each folder --add-dir gives it, since it takes no
    hooks in --settings. Each prints {}, which agy reads as "go on"."""
    spec = {}
    for event in AGY_HOOK_EVENTS:
        hook = {"command": hook_cmd(event) + "; echo '{}'", "timeout": 10}
        tools = event.endswith("ToolUse")  # these take a matcher
        spec[event] = [{"matcher": "*", "hooks": [hook]}] if tools else [hook]
    return json.dumps({"pantheon": spec}, indent=2)


def claude_settings() -> dict:
    hook = [{"type": "command", "command": hook_cmd(), "timeout": 10}]
    hooks: dict = {event: [{"hooks": hook}] for event in CLAUDE_HOOK_EVENTS}
    hooks["PreToolUse"] = [{"matcher": "AskUserQuestion|ExitPlanMode", "hooks": hook}]
    # Agent view (the ← key on an empty prompt) would take over the agent's terminal.
    return {"disableAgentView": True, "hooks": hooks}


def codex_hook_args() -> list[str]:
    # Codex runs -c hooks only when they are trusted. Passing their trust hashes too (the
    # same hash as codex 0.158's hook_hash) avoids its review screen and writes nothing
    # to ~/.codex.
    cmd = hook_cmd()
    args, state = [], []
    for event, label in CODEX_HOOK_LABELS.items():
        hook = '[{hooks=[{type="command",command=%s,timeout=10}]}]' % json.dumps(cmd)
        args += ["-c", f"hooks.{event}={hook}"]
        ident = {
            "event_name": label,
            "hooks": [
                {"async": False, "command": cmd, "timeout": 10, "type": "command"}
            ],
        }
        blob = json.dumps(
            ident, sort_keys=True, separators=(",", ":"), ensure_ascii=False
        )
        digest = hashlib.sha256(blob.encode()).hexdigest()
        key = json.dumps(f"/<session-flags>/config.toml:{label}:0:0")
        state.append('%s={trusted_hash="sha256:%s"}' % (key, digest))
    return args + ["-c", "hooks.state={" + ",".join(state) + "}"]


def claude_fullscreen() -> bool:
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    try:
        return (
            json.loads((home / "settings.json").read_text(encoding="utf-8")).get("tui")
            == "fullscreen"
        )
    except (OSError, ValueError, AttributeError):
        return False


def tool_path(tool: str) -> str:
    """The program a tool runs, found on PATH at each launch; ollama runs claude."""
    path = shutil.which("claude" if tool == "ollama" else tool)
    if not path:
        raise OSError(f"{tool} is not on your PATH")
    return path


def model_args(tool: str, model: str, effort: str) -> list[str]:
    """The flags that give an agent its model and effort (ollama's go to claude)."""
    if tool == "codex":
        argv = ["-m", model] if model else []
        flag = f"model_reasoning_effort={json.dumps(effort)}"
        return argv + (["-c", flag] if effort else [])
    return (["--model", model] if model else []) + (
        ["--effort", effort] if effort else []
    )


def prompt_args(tool: str, text: str) -> list[str]:
    """The arguments that give a tool its first prompt. agy's would read a text that
    starts with "-" as a flag."""
    if tool == "agy":
        return [f"--prompt-interactive={text}"]
    return ["--", text]


def launch_claude(
    s: Session, a: AgentRun, route: dict | None = None
) -> tuple[list[str], dict]:
    # A settings file's env (user, project, local) beats the env claude starts with, and
    # claude applies --settings after those files (only managed settings come later). So
    # pantheon's own values go in --settings: the effort, which would also beat
    # --effort, and an ollama agent's route.
    values = dict(route or {})
    if a.effort or a.tool == "ollama":
        values["CLAUDE_CODE_EFFORT_LEVEL"] = a.effort or "auto"  # auto: not your effort
    settings = claude_settings()
    if values:
        settings["env"] = values
    if route:  # "": no apiKeyHelper, whose key claude would send this host as X-Api-Key
        settings["apiKeyHelper"] = ""
    text = json.dumps(settings)
    if route:  # it can hold a real token, which must not show in ps
        file = claude_settings_file(s.slug, a.name)
        write_private(file, text)
        text = str(file)
    argv = [tool_path("claude"), "--session-id", a.native_id]
    argv += ["--name", f"pantheon-{s.slug}-{a.name}", "--add-dir", s.scratch]
    argv += ["--settings", text]
    argv += model_args("claude", a.model, a.effort)
    if s.yolo:
        argv.append("--dangerously-skip-permissions")
    env = {"DISABLE_AUTOUPDATER": "1"}
    if claude_fullscreen():
        # Otherwise a claude stopped in its first 10 s counts as a failed fullscreen start.
        env["CLAUDE_CODE_NO_FLICKER"] = "1"
    return argv, env


def claude_settings_file(slug: str, agent: str) -> Path:
    # Outside run/<slug>, which agents can write to: it holds pantheon's hooks, and an
    # ollama agent's token.
    return RUN / f"{slug}.{agent}.claude-settings.json"


def claude_sends_no_effort(a: AgentRun, workdir: str) -> bool:
    """Whether CLAUDE_CODE_EFFORT_LEVEL comes to auto or unset for a claude agent, so
    claude sends no effort, though its hooks say high."""
    var = "CLAUDE_CODE_EFFORT_LEVEL"
    managed, *files = [
        text_of(dig(read_jsonc(path), "env", var))
        for path in claude_settings_files(workdir)
    ]
    ours = a.effort or ("auto" if a.tool == "ollama" else "")  # what launch_claude sets
    # Managed settings beat pantheon's --settings, which beats your files and your shell.
    order = (managed, ours, *files, clean_env().get(var, ""))
    return next((v for v in order if v), "").lower() in ("auto", "unset")


def codex_writable_roots() -> list[str]:
    """The writable roots in your codex config.toml, which a -c list would replace."""
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    try:
        cfg = tomllib.loads((home / "config.toml").read_text(encoding="utf-8"))
        roots = cfg["sandbox_workspace_write"]["writable_roots"]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    if not isinstance(roots, list):
        return []
    # Codex reads a relative root from the config file's dir, and expands ~.
    return [str(home / os.path.expanduser(r)) for r in roots if isinstance(r, str)]


def launch_codex(s: Session, a: AgentRun) -> tuple[list[str], dict]:
    argv = [tool_path("codex"), "--no-daemon", "-C", s.workdir]
    # --add-dir would quit in a folder you have not trusted yet (codex runs it
    # read-only); these roots wait until you trust it. -c replaces your own list, so
    # it carries yours too.
    roots = toml_value([*codex_writable_roots(), s.scratch])
    argv += ["-c", f"sandbox_workspace_write.writable_roots={roots}"]
    argv += ["-c", "check_for_update_on_startup=false"]
    # No folder-trust override: trusting a repo loads its .codex config (MCP servers,
    # sandbox), so codex asks you once per repo, through the startup watchdog.
    argv += codex_hook_args()
    argv += model_args("codex", a.model, a.effort)
    if s.yolo:
        argv.append("--dangerously-bypass-approvals-and-sandbox")
    return argv, {}


def launch_agy(s: Session, a: AgentRun) -> tuple[list[str], dict]:
    # Its hooks go in the run dir, which it gets with --add-dir, and not in the repo. No
    # trust override: agy asks you once per folder, through the startup watchdog.
    hooks = Path(s.scratch) / ".agents" / "hooks.json"
    private_dir(hooks.parent)
    write_private(hooks, agy_hooks())
    argv = [tool_path("agy"), "--add-dir", s.scratch]
    argv += model_args("agy", a.model, a.effort)
    if s.yolo:
        argv.append("--dangerously-skip-permissions")
    return argv, {}


def agy_reply(transcript: str) -> str:
    """The last message of agy's last turn, from the transcript its hooks name, or "":
    its last reply after the turn's prompt. agy adds each step as it ends, so the reply
    is there by the turn's Stop."""
    try:
        with open(transcript, "rb") as f:
            size = f.seek(0, os.SEEK_END)
            f.seek(max(0, size - 1_000_000))  # the turn's end is near the file's end
            lines = f.read().splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            rec = json.loads(line)
        except ValueError:  # the first line, cut by the seek
            continue
        kind = rec.get("type") if isinstance(rec, dict) else None
        if kind == "USER_INPUT":  # the turn had no reply
            return ""
        if kind == "PLANNER_RESPONSE":
            content = rec.get("content")
            return content if isinstance(content, str) else ""
    return ""


def agy_asks(screen: str) -> str:
    """Why agy waits on you, from its screen, or "": the live dialog's help line is at
    the screen's foot. A permission prompt names what agy would run; another dialog,
    its question, as "Do you trust the contents of this project?"."""
    lines = [line.strip() for line in screen.splitlines() if line.strip()]
    if not any(AGY_DIALOG in line for line in lines[-4:]):
        return ""
    for i, line in enumerate(lines[:-1]):
        if line.startswith(AGY_PERMISSION):
            return "permission: " + shorten(lines[i + 1], 100)
    questions = [line for line in lines if line.endswith("?")]
    return shorten(questions[-1], 100) if questions else "a dialog"


def launch_ollama(s: Session, a: AgentRun) -> tuple[list[str], dict]:
    # Checked again here: a reopen can bring another config or OLLAMA_HOST.
    if why := ollama_problem(s.cfg):
        raise OSError(why)
    model = a.model  # resolve_roster fills it in from ollama_models or ollama_model
    token_env = setting(s.cfg, "ollama_token_env")
    route = {
        "ANTHROPIC_BASE_URL": ollama_server(s.cfg),
        # Always set a token: without one, claude sends your claude.ai login to this host.
        "ANTHROPIC_AUTH_TOKEN": (os.environ.get(token_env) if token_env else "")
        or "ollama",
        "ANTHROPIC_API_KEY": "",
        **dict.fromkeys(CLAUDE_PROVIDERS, ""),
        "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
        "ANTHROPIC_DEFAULT_FABLE_MODEL": model,
        "CLAUDE_CODE_SUBAGENT_MODEL": model,
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": str(setting(s.cfg, "ollama_context")),
        "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    }
    return launch_claude(s, a, route)


LAUNCHERS = {
    "claude": launch_claude,
    "codex": launch_codex,
    "agy": launch_agy,
    "ollama": launch_ollama,
}

# --------------------------------------------------------------------------------- basics


class PrepError(Exception):
    """A new session cannot start; the message says why."""


class Locked(Exception):
    """Another pantheon has the session open."""


class TmuxError(Exception):
    pass


def die(message: str) -> NoReturn:
    raise SystemExit(f"pantheon: {message}")


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp(iso: str) -> str:
    try:
        return datetime.fromisoformat(iso).astimezone().strftime("%H:%M")
    except ValueError:
        return "--:--"


def age(iso: str) -> str:
    try:
        seconds = time.time() - datetime.fromisoformat(iso).timestamp()
    except ValueError:
        return "?"
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= size:
            return f"{int(seconds // size)}{unit}"
    return "now"


def shorten(text: str, width: int) -> str:
    text = " ".join(text.split())
    return text if len(text) <= width else text[: width - 1] + "…"


def name_list(names: list[str], limit: int = 20) -> str:
    more = len(names) - limit
    return ", ".join(names[:limit]) + (f", and {more} more" if more > 0 else "")


def first_line(text: str, width: int = 80) -> str:
    return shorten(
        next((line for line in text.splitlines() if line.strip()), ""), width
    )


def short_home(path: str) -> str:
    home = str(Path.home())
    return (
        "~" + path[len(home) :] if path == home or path.startswith(home + "/") else path
    )


def read_text(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def private_dir(path: Path) -> None:
    """Make path a directory only you can use; refuse a planted symlink or a foreign owner."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        path.mkdir(mode=0o700)
    except FileExistsError:
        pass
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise ValueError(f"{path} is not a directory of yours; remove it")
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)


def clean_instructions(text: str, tool: str) -> str:
    """text as pantheon gives it to a tool, typed or on its command line: as plain text
    to the tool, with nothing in it that the tool would act on."""
    text = CONTROL_RE.sub("", text.replace("\r\n", "\n").replace("\r", "\n"))
    if tool in ("claude", "ollama"):
        text = CLAUDE_IMAGE_RE.sub(lambda m: f"`{m[2]}`", text)
    # One newline at the end: tmux keeps a last ";", and Enter cannot take a completion
    # the text's last word opened.
    return text.strip("\n") + "\n"


def collapses(tool: str, text: str) -> bool:
    """Whether the tool shows a paste of text as a placeholder in its input box."""
    units = len(text.encode("utf-16-le")) // 2  # how JavaScript counts a string
    if tool in ("claude", "ollama"):  # claude counts a tab as 4 spaces
        return units + 3 * text.count("\t") > 800 or text.count("\n") > 2
    return len(text) > 1000  # codex and agy, whatever its lines


def paste_shown(tool: str, before: str, after: str, text: str) -> bool:
    """Whether a paste of text shows on screen: the tool's placeholder shows more often
    than before, or, for a text that shows as text, its end does. The end, since a box
    can scroll its start out of view."""
    b, a = TYPED_NOISE_RE.sub("", before), TYPED_NOISE_RE.sub("", after)
    pasted = PASTED_RE[tool]
    if len(pasted.findall(a)) > len(pasted.findall(b)):
        return True
    if collapses(tool, text):
        return False  # a long text shows only as a placeholder, never as its end
    tail = TYPED_NOISE_RE.sub("", text)[-60:]
    return bool(tail) and a.count(tail) > b.count(tail)


def last_lines(screen: str, n: int = 8) -> str:
    lines = [line.rstrip() for line in screen.splitlines() if line.strip()]
    lines = [line for line in lines if not line.startswith("Pane is dead")]
    return "\n".join(lines[-n:])


def write_private(path: Path, text: str) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")  # mode 0600
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, str):
        # JSON strings are TOML basic strings, except that TOML also forbids a raw DEL.
        # ensure_ascii=False: TOML rejects the surrogate pairs JSON writes for emoji.
        return json.dumps(v, ensure_ascii=False).replace("\x7f", "\\u007f")
    if isinstance(v, list) and all(isinstance(x, str) for x in v):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return (
            "{"
            + ", ".join(f"{toml_key(k)} = {toml_value(x)}" for k, x in v.items())
            + "}"
        )
    raise TypeError(f"cannot write {type(v).__name__} to TOML")


def toml_key(k: str) -> str:
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else json.dumps(k)


def toml_dumps(data: dict) -> str:
    """Write str, bool, int, list[str], and tables of them, one key a line (tomllib
    only reads)."""
    text = "".join(f"{toml_key(k)} = {toml_value(v)}\n" for k, v in data.items())
    if tomllib.loads(text) != data:  # never write a file that reads back differently
        raise ValueError("TOML round trip failed")
    return text


def read_jsonc(path: Path) -> dict:
    """Read a JSON file that may have // and /* */ comments."""
    try:
        # As the tools do, read a bad byte as U+FFFD, so we see the settings they use.
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {}
    out, i, in_string = [], 0, False
    while i < len(text):
        c = text[i]
        if in_string:
            out.append(c)
            if c == "\\":
                out.append(text[i + 1 : i + 2])
                i += 1
            elif c == '"':
                in_string = False
        elif c == '"':
            in_string = True
            out.append(c)
        elif text.startswith("//", i):
            i = text.find("\n", i)
            i = len(text) if i < 0 else i
            continue
        elif text.startswith("/*", i):
            i = text.find("*/", i + 2)
            i = len(text) if i < 0 else i + 2
            continue
        else:
            out.append(c)
        i += 1
    try:
        data = json.loads("".join(out))
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def clean_env() -> dict[str, str]:
    """The environment agents start with: yours, minus what uv and a parent Claude add."""
    env = dict(os.environ)
    if sys.prefix != sys.base_prefix:  # running in uv's venv: keep agents out of it
        venv_bin = os.path.realpath(os.path.join(sys.prefix, "bin"))
        paths = env.get("PATH", "").split(os.pathsep)
        env["PATH"] = os.pathsep.join(
            p for p in paths if p and os.path.realpath(p) != venv_bin
        )
    for k in (
        "VIRTUAL_ENV",
        "UV",
        "UV_RUN_RECURSION_DEPTH",
        "CI",
        "GITHUB_ACTIONS",
        "TMUX",
        "TMUX_PANE",
    ):
        env.pop(k, None)
    for k in [k for k in env if k.startswith("TERM_PROGRAM")]:
        del env[k]
    if "CLAUDECODE" in env:  # pantheon itself can run inside Claude Code
        for k in list(env):
            claude = k.startswith(("CLAUDE_CODE_", "CLAUDE_AGENT_SDK"))
            if claude or k in ("CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT"):
                del env[k]
    return env


def run_cmd(
    argv: list[str], cwd=None, timeout: float = 30, env=None
) -> tuple[int, str, str]:
    try:
        p = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=cwd,
            env=env,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr


def git(workdir: str, *args: str) -> tuple[int, str, str]:
    # Fail instead of waiting for a password behind the UI.
    env = {
        **os.environ,
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_SSH_COMMAND": "ssh -o BatchMode=yes",
    }
    return run_cmd(["git", "-C", workdir, *args], env=env)


def ask(prompt: str, default: str = "") -> str:
    try:
        answer = input(prompt).strip()
    except EOFError:
        answer = ""
    return answer or default


# ------------------------------------------------------------------------------ discovery


def setting(cfg: dict, key: str):
    return cfg.get(key, SETTINGS[key].default)


def as_written(value) -> str:
    """value about as config.toml shows it, for an error."""
    return json.dumps(value, ensure_ascii=False, default=str)


def check_setting(key: str, value):
    """value as the setting's type; ValueError says why it cannot be."""
    default = SETTINGS[key].default
    if isinstance(default, tuple):  # agents: tool names
        if not isinstance(value, (list, tuple)) or not value:
            got = as_written(value)
            raise ValueError(f'{key} is a list of tools, like ["codex"], not {got}')
        for tool in value:
            if tool in TOOLS:
                continue
            why = f"{key} takes tool names ({', '.join(TOOLS)}), not {as_written(tool)}"
            if isinstance(tool, str) and tool.startswith("ollama:"):
                why += ". An ollama model goes in ollama_model, or in -a"
            elif isinstance(tool, str) and re.search(r"[:@]", tool):
                why += ". A model or effort goes in the tool's own config, or in -a"
            raise ValueError(why)
        return tuple(value)
    if isinstance(default, dict):  # ollama_models: level = model
        items = value.items() if isinstance(value, dict) else None
        if items is None:
            got = as_written(value)
            raise ValueError(
                f'{key} is a table, like {{low = "qwen3.5:4b"}}, not {got}'
            )
        for level, model in items:
            if level in SETTINGS:  # written below a [table] line, so it is in the table
                raise ValueError(
                    f"{key}: {level} is inside this table; move it above [{key}]"
                )
            if level not in EFFORTS:
                raise ValueError(
                    f"{key}: no effort level {level!r}; use {', '.join(EFFORTS)}"
                )
            if not isinstance(model, str) or not model or re.search(r"[\s,]", model):
                raise ValueError(
                    f"{key}.{level} is a model name, not {as_written(model)}"
                )
        return dict(value)
    if type(value) is not type(default):
        got = as_written(value)
        if isinstance(value, str):  # yolo = "true": the quotes make it text
            got = f"the text {got}"
        raise ValueError(f"{key} is {TYPE_WORDS[type(default)]}, not {got}")
    if key == "ollama_url" and value:
        if re.search(r"\s", value):
            raise ValueError("ollama_url has a space in it")
        try:
            parts = urllib.parse.urlsplit(value)
            _ = parts.port  # a bad port raises only when read
        except ValueError:
            parts = None
        if not parts or parts.scheme not in ("http", "https") or not parts.hostname:
            raise ValueError("ollama_url is an http or https URL")
        if parts.username or parts.password:
            raise ValueError("ollama_url takes no password; use ollama_token_env")
    if key == "ollama_token_env" and value:
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", value):
            raise ValueError("ollama_token_env is the name of an env var")
    if key == "ollama_context" and value < 2048:
        raise ValueError("ollama_context is 2048 or more")
    return value


def parse_setting(key: str, text: str):
    """A value typed on the command line, as the setting's type."""
    default = SETTINGS[key].default
    t = text.strip()
    if isinstance(default, bool):
        if t.lower() in ("true", "yes", "on", "1"):
            return True
        if t.lower() in ("false", "no", "off", "0"):
            return False
        raise ValueError(f"{key} is true or false")
    if isinstance(default, int):
        if not t.isdecimal():
            raise ValueError(f"{key} is a whole number")
        return int(t)
    if isinstance(default, dict):
        table = {}
        for item in (x.strip() for x in t.split(",") if x.strip()):
            level, sep, model = (x.strip() for x in item.partition("="))
            if not sep:
                raise ValueError(f"{key} takes LEVEL=MODEL,..., like low=qwen3.5:4b")
            table[level] = model
        return table
    if isinstance(default, tuple):
        tools = tuple(x.strip() for x in t.split(",") if x.strip())
        if not tools:
            raise ValueError(f"{key} is a list of tools, like claude,codex")
        return tools
    return t


def read_config_file() -> dict:
    try:
        return tomllib.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        die(f"cannot read {CONFIG_PATH} ({e}); fix it, or delete it to start over")


def read_settings() -> tuple[dict, dict[str, str]]:
    """The good settings in config.toml, and why each other key is bad."""
    cfg, bad = {}, {}
    for key, value in read_config_file().items():
        try:
            if key not in SETTINGS:
                raise ValueError(f"{key} is not a setting")
            cfg[key] = check_setting(key, value)
        except ValueError as e:
            bad[key] = str(e)
    return cfg, bad


def drop_hint(bad: dict[str, str]) -> str:
    them = "it" if len(bad) == 1 else "them"
    return f"To drop {them}: pantheon config unset {' '.join(map(shlex.quote, bad))}"


def load_config() -> dict:
    """The settings you changed. A bad key stops pantheon, so a typo never quietly
    leaves a setting as it was."""
    cfg, bad = read_settings()
    if bad:
        die(f"{CONFIG_PATH}: {'; '.join(bad.values())}. {drop_hint(bad)}")
    return cfg


def save_config(cfg: dict) -> None:
    # An empty table is the default, and TOML would not keep it.
    data = {
        k: list(v) if isinstance(v, tuple) else v for k, v in cfg.items() if v != {}
    }
    head = "# pantheon settings. Change them with: pantheon config set KEY VALUE\n"
    write_private(CONFIG_PATH, head + toml_dumps(data))


def shown(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, tuple):
        return ",".join(value)
    if isinstance(value, dict):
        return ",".join(f"{k}={v}" for k, v in value.items()) or "{}"
    return str(value) if value != "" else '""'


def cmd_config(args) -> int:
    cfg, bad = read_settings()  # not load_config: these commands fix a bad file
    if args.action == "show":
        width = max(map(len, SETTINGS))
        print(f"pantheon: settings ({short_home(str(CONFIG_PATH))})")
        for key in SETTINGS:
            mark = "bad" if key in bad else "yours" if key in cfg else "default"
            print(f"  {key:<{width}}  {shown(setting(cfg, key)):<30} {mark}")
        for why in bad.values():
            print(f"  ! {why}")
        if bad:
            print(f"  {drop_hint(bad)}")
        return 0
    if args.action == "set":
        if args.key not in SETTINGS:
            die(f"no setting {args.key!r}; pantheon config show lists them")
        try:
            cfg[args.key] = check_setting(args.key, parse_setting(args.key, args.value))
        except ValueError as e:
            die(str(e))
        keys = [args.key]
    else:
        keys = args.keys
        for key in keys:
            if key not in SETTINGS and key not in bad:
                die(f"no setting {key!r}; pantheon config show lists them")
            cfg.pop(key, None)
    save_config(cfg)  # only good settings, so the bad keys go too
    for key, why in bad.items():
        if key not in keys:
            print(f"  dropped: {why}")
    for key in keys:
        if key in SETTINGS:
            print(f"  {key} = {shown(setting(cfg, key))}")
        else:
            print(f"  dropped {key}")
    return 0


def ollama_server(cfg: dict) -> str:
    url = setting(cfg, "ollama_url") or ollama_url(os.environ.get("OLLAMA_HOST", ""))
    return url.replace("://0.0.0.0", "://127.0.0.1")


def on_this_machine(url: str) -> bool:
    """Whether a URL's host is this machine, by its name or by a local address."""
    host = urllib.parse.urlsplit(url).hostname or ""
    if host == "localhost":
        return True
    try:
        addr = ipaddress.ip_address(host)
    except ValueError:
        return False
    return addr.is_loopback or addr.is_unspecified


def ollama_problem(cfg: dict) -> str:
    """Why ollama agents may not use the ollama server, or "". One on another machine
    gets their token, and any Console API key claude keeps, so it needs your yes."""
    server = ollama_server(cfg)
    if on_this_machine(server) or setting(cfg, "ollama_remote"):
        return ""
    return (
        f"{server} is not on this machine, and an ollama agent sends it your ollama "
        "token and any Console API key claude keeps; to allow that: pantheon config "
        "set ollama_remote true"
    )


def dig(d, *keys):
    """d[k1][k2]..., or None when a level is missing or is not an object. For JSON
    that you wrote by hand."""
    for k in keys:
        if not isinstance(d, dict):
            return None
        d = d.get(k)
    return d


def tool_problems(cfg: dict) -> dict[str, str]:
    """Why each tool cannot run here, or "" when it can. Cheap, so it runs every start."""
    out: dict[str, str] = {}
    for tool in TOOLS:
        if setting(cfg, f"disable_{tool}"):
            out[tool] = f"disabled by disable_{tool}"
        elif tool == "ollama" and not shutil.which("claude"):
            out[tool] = "ollama agents run claude, which is not installed"
        elif tool == "ollama":
            named = setting(cfg, "ollama_url") or os.environ.get("OLLAMA_HOST")
            if not (shutil.which("ollama") or named):
                out[tool] = "not installed, and no ollama_url or OLLAMA_HOST is set"
            else:
                out[tool] = ollama_problem(cfg)
        elif not shutil.which(tool):
            out[tool] = "not installed"
        else:
            out[tool] = ""
    return out


def find_tmux() -> tuple[str, str]:
    """tmux's path and its version line, each "" if not found."""
    path = shutil.which("tmux") or ""
    rc, out, _ = run_cmd([path, "-V"]) if path else (1, "", "")
    return path, out.strip() if rc == 0 else ""


def tmux_problem(version: str) -> str:
    """Why a tmux with this version line cannot host agents, or "" when it can."""
    m = re.search(r"(\d+)\.(\d+)", version)
    if m and (int(m[1]), int(m[2])) >= (3, 2):
        return ""
    return "tmux 3.2 or later is required" + (f" (found {version})" if version else "")


@functools.cache
def tmux_path() -> str:
    """The tmux that hosts the agents, found on each run rather than kept in config."""
    path, version = find_tmux()
    if why := tmux_problem(version):
        die(why)
    return path


def detect_claude() -> dict:
    path = shutil.which("claude")
    if not path:
        return {"note": "not installed"}
    # Never give claude a positional argument here: without a TTY it sends it as a prompt.
    rc, out, _ = run_cmd([path, "--version"], env=clean_env())
    version = out.split()[0] if rc == 0 and out.split() else ""
    rc, out, _ = run_cmd([path, "auth", "status"], env=clean_env())
    try:
        auth = json.loads(out).get("authMethod", "")
    except (ValueError, AttributeError):
        auth = ""
    note = "" if rc == 0 else "not logged in (claude auth login)"
    return {
        "path": path,
        "version": version,
        "auth": auth,
        "note": note,
    }


def detect_codex() -> dict:
    path = shutil.which("codex")
    if not path:
        return {"note": "not installed"}
    rc, out, _ = run_cmd([path, "--version"])
    version = out.split()[-1] if rc == 0 and out.split() else ""
    rc, out, err = run_cmd([path, "login", "status"])
    text = (err.strip() or out.strip()).splitlines()
    m = re.match(r"Logged in using (?:an? )?(.+?)(?: -|$)", text[0] if text else "")
    auth = m.group(1).lower() if m else ""  # never keep the masked key that may follow
    note = "" if rc == 0 else "not logged in (codex login)"
    return {
        "path": path,
        "version": version,
        "auth": auth,
        "note": note,
    }


def detect_agy() -> dict:
    path = shutil.which("agy")
    if not path:
        return {"note": "not installed"}
    rc, out, _ = run_cmd([path, "--version"], env=clean_env(), timeout=60)
    version = out.strip().splitlines()[-1] if rc == 0 and out.strip() else ""
    return {"path": path, "version": version}


def ollama_get(url: str, path: str, token_env: str = "", timeout: float = 3.0):
    request = urllib.request.Request(url.rstrip("/") + path)
    if token_env and os.environ.get(token_env):
        request.add_header("Authorization", f"Bearer {os.environ[token_env]}")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as r:
            return json.loads(r.read() or b"null")
    except (OSError, ValueError, http.client.HTTPException):
        return None


def ollama_url(text: str) -> str:
    text = text.strip().rstrip("/")
    if "://" in text:
        return text
    host = text or "127.0.0.1"
    return f"http://{host}" if re.search(r":\d+$", host) else f"http://{host}:11434"


def agent_file_warnings(problems: dict[str, str]) -> list[str]:
    shared = Path.home() / ".agents" / "AGENTS.md"
    files = {
        "claude": Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
        / "CLAUDE.md",
        "codex": Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
        / "AGENTS.md",
        "agy": Path.home() / ".gemini" / "AGENTS.md",  # or GEMINI.md, as agy reads both
    }
    out = []
    for tool, path in files.items():
        also = tool == "agy" and path.with_name("GEMINI.md").exists()
        if problems[tool] or path.exists() or also:
            continue
        hint = f" (for example: ln -s {shared} {path})" if shared.exists() else ""
        out.append(f"{tool} cannot see a global agent file at {path}{hint}")
    return out


def cmd_tools(cfg: dict) -> None:
    """What pantheon finds now: the program, version, and sign-in for each tool."""
    problems = tool_problems(cfg)
    found = {
        "claude": detect_claude(),
        "codex": detect_codex(),
        "agy": detect_agy(),
    }
    server, answer = ollama_server(cfg), None
    if not problems["ollama"]:
        answer = ollama_get(server, "/api/version", setting(cfg, "ollama_token_env"))
    found["ollama"] = {
        "path": shutil.which("ollama") or "",
        "version": (answer or {}).get("version", ""),
        "model": " ".join(
            x
            for x in (
                setting(cfg, "ollama_model"),
                shown(setting(cfg, "ollama_models")),
            )
            if x and x != "{}"
        ),
        "note": f"no server answers at {server}" if answer is None else server,
    }
    print("pantheon: found now (off: it cannot run, or you disabled it)")
    for name, t in found.items():
        mark = "off" if problems[name] else "on "
        detail = " ".join(
            x for x in (t.get("version"), t.get("auth"), t.get("model")) if x
        )
        where = short_home(t.get("path", ""))
        note = problems[name] or t.get("note", "")
        print(f"  {mark} {name:<7} {detail:<30} {where}  {note}".rstrip())
    path, version = find_tmux()
    note = tmux_problem(version)
    print(f"      tmux    {version:<30} {short_home(path)}  {note}".rstrip())
    for warning in agent_file_warnings(problems):
        print(f"  ! {warning}")


def claude_local_dir(workdir: str) -> Path:
    """Where claude reads settings.local.json first: the repo's top, a linked worktree's
    main checkout, or, in a bare repo's worktree, the start dir. It reads the start dir's
    copy too, which loses."""
    top = repo_dirs(workdir)[-1]
    try:  # a worktree's .git file names its git dir, whose commondir is the main .git
        text = (top / ".git").read_text(encoding="utf-8")
        gitdir = top / text.removeprefix("gitdir:").strip()
        common = gitdir / (gitdir / "commondir").read_text(encoding="utf-8").strip()
        if common.resolve().name == ".git":
            top = common.resolve().parent
        elif not (common / ".git").exists():
            # claude takes the bare repo as the top, finds no .git there to check its
            # owner, and falls back to the start dir.
            return Path(workdir)
    except (OSError, ValueError):
        pass
    # With your home dir as the top, claude keeps the start dir's file.
    home = os.path.realpath(Path.home())
    return Path(workdir) if os.path.realpath(top) == home else top


def claude_settings_files(workdir: str) -> list[Path]:
    """claude's settings files, the one that wins first, each real file once."""
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    project = Path(workdir) / ".claude"
    local = claude_local_dir(workdir) / ".claude" / "settings.local.json"
    files = [CLAUDE_MANAGED, local, project / "settings.local.json"]
    files.append(project / "settings.json")
    out, seen = [], set()
    for path in [*files, home / "settings.json"]:
        if os.path.realpath(path) not in seen:
            seen.add(os.path.realpath(path))
            out.append(path)
    return out


def repo_dirs(workdir: str) -> list[Path]:
    """workdir and its parents up to its git repo's top, nearest first; outside a repo,
    workdir alone."""
    dirs = []
    for d in [Path(workdir), *Path(workdir).parents]:
        dirs.append(d)
        if (d / ".git").exists():
            return dirs
    return dirs[:1]


def text_of(value) -> str:
    return value if isinstance(value, str) else ""


def tool_defaults(tool: str, workdir: str) -> dict[str, str]:
    """What a tool's own config says about its model and effort, the value that wins
    first. A guide only: pantheon cannot see an account's default, or the model behind
    an alias."""
    trusted = ", if you trust this folder"
    if tool == "claude":
        files = [(path, read_jsonc(path)) for path in claude_settings_files(workdir)]
        home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
        user = os.path.realpath(home / "settings.json")
        kept = clean_env()  # inside Claude Code, agents get no CLAUDE_CODE_ vars
        model, effort = [], []
        # A settings file's env beats your shell's, and both beat the settings.
        for var, found in (
            ("ANTHROPIC_MODEL", model),
            ("CLAUDE_CODE_EFFORT_LEVEL", effort),
        ):
            for path, d in files:
                if value := text_of(dig(d, "env", var)):
                    found.append(f"{value} (env in {short_home(str(path))})")
            if value := os.environ.get(var):
                lost = "" if var in kept else ", but agents started here do not get it"
                found.append(f"{value} (${var}{lost})")
        for path, d in files:
            where = short_home(str(path))
            if value := text_of(d.get("model")):
                model.append(f"{value} ({where})")
            per = d.get("modelSettings")
            for name, v in per.items() if isinstance(per, dict) else ():
                if value := text_of(dig(v, "effortLevel")):
                    effort.append(f"{value} for {name} ({where})")
            if value := text_of(d.get("effortLevel")):
                if os.path.realpath(path) == user:  # the older /effort key
                    value += " for models before Opus 5.5"
                effort.append(f"{value} ({where})")
        return {
            "model": " over ".join(model) or "your account's default",
            "effort": " over ".join(effort) or "the model's default",
        }
    if tool == "codex":
        home = (
            Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "config.toml"
        )
        # In a folder you trust, codex also reads .codex/config.toml from the repo's top
        # down to the start dir, and the nearest wins.
        files = [
            (d / ".codex" / "config.toml", trusted)
            for d in repo_dirs(workdir)
            if (d / ".codex").is_dir()  # codex skips a .codex that is not a folder
        ]
        model, effort = [], []
        for path, note in [*files, (home, "")]:
            if note and os.path.realpath(path) == os.path.realpath(home):
                continue
            where = short_home(str(path)) + note
            try:
                conf = tomllib.loads(path.read_text(encoding="utf-8"))
            except FileNotFoundError:
                continue
            except (OSError, ValueError):  # codex cannot start with it either
                model.append(f"unknown (cannot read {where})")
                effort.append(f"unknown (cannot read {where})")
                continue
            if value := text_of(conf.get("model")):
                model.append(f"{value} ({where})")
            if value := text_of(conf.get("model_reasoning_effort")):
                effort.append(f"{value} ({where})")
        return {
            "model": " over ".join(model) or "codex's default",
            "effort": " over ".join(effort) or "the model's default",
        }
    if tool == "agy":  # pantheon does not read agy's settings
        return {"model": "agy's own choice", "effort": "the model's own"}
    return {}  # ollama: pantheon always passes its model


def shown_flags(tool: str, model: str, effort: str) -> str:
    """What pantheon passes an agent for its model and effort, as you would type it."""
    text = shlex.join(model_args(tool, model, effort)) or "nothing"
    if tool == "ollama" and not effort:
        text += ", and CLAUDE_CODE_EFFORT_LEVEL=auto (no effort)"
    return text


def players(mode: Mode, roster: list, picks: dict[str, str]) -> dict[str, list]:
    """Each agent's tools: a multi agent's, track by track, before any scramble."""
    keys = [r[0] for r in roster if r[4]]
    return {
        name: keys if agent.multi else [picks.get(name, keys[0])]
        for name, agent in mode.agents.items()
    }


def cmd_agents(cfg: dict, args) -> None:
    """What pantheon start would pick here, and what each tool's config says."""
    workdir = os.path.realpath(os.path.expanduser(args.dir))
    if not os.path.isdir(workdir):
        die(f"{args.dir} is not a directory")
    if not args.mode:
        if args.agents or args.agent or args.effort:
            die("-a, --agent, and --effort need a MODE")
        cmd_pool(cfg, workdir)
        return
    mode, given = MODES[args.mode], effort_arg(args.effort)
    for level in [given] if given is not None else ["", *EFFORTS]:
        title = f"{args.mode} at {level}" if level else f"{args.mode} with no level"
        if given is None and level == mode.effort:
            title += " (what start uses)"
        try:
            roster, picks, notes = resolve_roster(
                cfg, args.mode, args.agents, args.agent, level
            )
        except PrepError as e:
            print(f"pantheon: {title}: {e}")
            continue
        print(f"pantheon: {title}")
        width = max(map(len, [*mode.agents, *(r[0] for r in roster)]))
        for name, keys in players(mode, roster, picks).items():
            each = " (one for each tool)" if mode.agents[name].multi else ""
            print(f"  {name:<{width}} {', '.join(keys)}{each}")
        if setting(cfg, "scramble"):
            print(
                "  (scramble is on: a session gives each agent these tools in a random "
                "order, which comes from the session's name)"
            )
        for key, tool, model, effort, _ in roster:
            print(f"  {key:<{width}} passes {shown_flags(tool, model, effort)}")
            given_parts = {"model": model, "effort": effort}
            left = [
                f"{part} {how}"
                for part, how in tool_defaults(tool, workdir).items()
                if not given_parts[part]
            ]
            if left:
                print(f"  {'':<{width}} {tool}'s config: {'; '.join(left)}")
        for note in notes:
            print(f"  ({note})")


def cmd_pool(cfg: dict, workdir: str) -> None:
    """The tools pantheon picks from, in order, and the effort levels."""
    problems = tool_problems(cfg)
    pool = setting(cfg, "agents")
    print(f"pantheon: the agents setting, in order: {', '.join(pool)}")
    for tool in dict.fromkeys(pool):
        why = problems[tool]
        ollama = setting(cfg, "ollama_model") or setting(cfg, "ollama_models")
        if not why and tool == "ollama" and not ollama:
            why = "no ollama_model or ollama_models is set"
        print(f"  {tool:<10} {'cannot run: ' + why if why else 'can run'}")
        if why:
            continue
        if tool == "ollama":
            model = setting(cfg, "ollama_model") or "none"
            per = ", ".join(
                f"{k} {v}" for k, v in setting(cfg, "ollama_models").items()
            )
            print(
                f"  {'':<10} model {model} (ollama_model); {per or 'none'} (ollama_models)"
            )
            print(f"  {'':<10} at {ollama_server(cfg)}")
            continue
        found = "; ".join(f"{k} {v}" for k, v in tool_defaults(tool, workdir).items())
        print(f"  {'':<10} its config: {found}")
    print("effort levels (a mode's, or start --effort LEVEL):")
    for level, cells in EFFORTS.items():
        for i, tool in enumerate(TOOLS):
            model, effort = cells[tool]
            if tool == "ollama":
                model = model or ollama_model_for(cfg, level)
            flags = shown_flags(tool, model, effort)
            if tool == "ollama" and not model:  # start skips a plain ollama here
                flags = (
                    f"cannot run: no ollama_model is set, and no ollama_models.{level}"
                )
            name = level if i == 0 else ""
            print(f"  {name:<10} {tool:<7} {flags}")


# ---------------------------------------------------------------------------------- store


def db_path(slug: str) -> Path:
    return SESSIONS / f"{slug}.sqlite3"


def scratch_dir(slug: str) -> Path:
    return RUN / slug


def db_uri(path: Path) -> str:
    # mode=rw: it never makes a file.
    return f"file:{urllib.parse.quote(os.path.realpath(path))}?mode=rw"


def connect(path: Path) -> sqlite3.Connection:
    # isolation_level=None: autocommit, so no read transaction stays open between polls.
    # The default rollback journal keeps a closed session in this one file.
    db = sqlite3.connect(db_uri(path), uri=True, timeout=10.0, isolation_level=None)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA foreign_keys = ON")
    return db


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def lock_holder(db: sqlite3.Connection) -> int:
    """The pid of another live pantheon that has this session open, or 0."""
    row = db.execute("SELECT pid, host, heartbeat FROM lock WHERE id = 1").fetchone()
    if row is None or not row["pid"] or row["pid"] == os.getpid():
        return 0
    if time.time() - row["heartbeat"] > LOCK_STALE:
        return 0
    # Host names change under a live pantheon (macOS renames hosts by network), so a fresh
    # heartbeat counts for any host; on this host the pid must be alive too.
    if row["host"] == socket.gethostname() and not pid_alive(row["pid"]):
        return 0
    return row["pid"]


def take_lock(db: sqlite3.Connection, slug: str) -> None:
    db.execute("BEGIN IMMEDIATE")
    try:
        holder = lock_holder(db)
        if holder:
            raise Locked(f"{slug} is open in another pantheon (pid {holder})")
        db.execute(
            "INSERT OR REPLACE INTO lock (id, pid, host, heartbeat) VALUES (1, ?, ?, ?)",
            (os.getpid(), socket.gethostname(), time.time()),
        )
    except BaseException:
        db.execute("ROLLBACK")
        raise
    db.execute("COMMIT")


def install_key() -> bytes:
    """This install's secret. It signs the session files the install creates. Made only
    when there is none: a new key turns each session the old one signed read-only."""
    path = HOME / "key"
    try:
        text = path.read_text(errors="replace")
    except FileNotFoundError:
        # Linked into place, so a pantheon that starts at the same time finds no key or
        # all of one, and both keep the first.
        fd, tmp = tempfile.mkstemp(dir=HOME, prefix=".key.")  # mode 0600
        try:
            with os.fdopen(fd, "w") as f:
                f.write(os.urandom(32).hex() + "\n")
            os.link(tmp, path)
        except FileExistsError:
            pass
        finally:
            os.unlink(tmp)
        text = path.read_text(errors="replace")
    try:
        key = bytes.fromhex(text)
    except ValueError:
        key = b""
    if len(key) != 32:
        raise ValueError(
            f"{path} holds no pantheon key; delete it to make a new one, and the "
            "sessions the old one signed open read-only"
        )
    return key


def session_origin(slug: str, created_at: str) -> str:
    message = f"{slug}\n{created_at}".encode()
    return hmac.new(install_key(), message, "sha256").hexdigest()


def view_id(slug: str) -> str:
    # Widget ids allow fewer characters than file names do.
    return "s-" + hashlib.sha1(slug.encode()).hexdigest()[:12]


def tab_id(slug: str) -> str:
    return "tab-" + view_id(slug)


def session_holder(path: Path) -> int:
    try:
        db = connect(path)
    except sqlite3.Error:
        return 0
    try:
        return lock_holder(db)
    except sqlite3.Error:  # not a session, or a crashed one a sandbox cannot repair
        return 0
    finally:
        db.close()


def make_slug(words: str) -> str:
    stem = re.sub(r"[^a-z0-9]+", "-", words.lower()).strip("-")
    base = datetime.now().strftime("%Y%m%d") + (f"-{stem}" if stem else "")
    if len(base) > 40:  # keeps tmux and file names short
        base = base[:40].rsplit("-", 1)[0]
    slug, n = base, 2
    while db_path(slug).exists() or scratch_dir(slug).exists():
        slug, n = f"{base}-{n}", n + 1
    return slug


def list_sessions() -> list[dict]:
    """Each session's record, newest first, with holder (the pid of a pantheon that has
    it open, or 0) and last (when its newest room entry came, hooks too)."""
    out = []
    for path in SESSIONS.glob("*.sqlite3"):
        try:
            db = connect(path)
        except sqlite3.Error:
            continue
        try:
            row = db.execute("SELECT * FROM session").fetchone()
            holder = lock_holder(db)
            last = db.execute("SELECT at FROM events ORDER BY id DESC LIMIT 1")
            last = last.fetchone()
        except sqlite3.Error:
            continue
        finally:
            db.close()
        if row is not None:
            at = last["at"] if last else row["created_at"]
            out.append({**dict(row), "slug": path.stem, "holder": holder, "last": at})
    return sorted(out, key=lambda s: s["created_at"], reverse=True)


def idle_days(iso: str) -> float:
    """Days since iso; a time pantheon cannot read counts as long ago."""
    try:
        return (time.time() - datetime.fromisoformat(iso).timestamp()) / 86400
    except ValueError:
        return float("inf")


def resolve_slug(text: str) -> str:
    slugs = [p.stem for p in SESSIONS.glob("*.sqlite3")]
    if text in slugs:
        return text
    hits = sorted(s for s in slugs if text in s)
    if not hits:
        die(f"no session matches {text!r}")
    if len(hits) > 1:
        die(f"{text!r} matches several sessions: {', '.join(hits)}")
    return hits[0]


def parse_spec(spec: str) -> tuple[str, str, str]:
    if re.search(r"[\s,]", spec):  # a lost comma would hide an agent in a model name
        raise PrepError(f"{spec!r} has a space or comma in it, so it is not one SPEC")
    rest, _, effort = spec.partition("@")
    tool, _, model = rest.partition(":")
    if tool not in TOOLS:
        raise PrepError(
            f"unknown tool {tool!r} in {spec!r}; use one of {', '.join(TOOLS)}"
        )
    return tool, model, effort


def spec_text(tool: str, model: str, effort: str) -> str:
    return tool + (f":{model}" if model else "") + (f"@{effort}" if effort else "")


def count_help(mode: Mode) -> str:
    """How many tools a mode takes with no -a, for its help."""
    if not mode.count:
        return "all that can run here"
    return str(mode.count) if mode.count == 1 else f"up to {mode.count}"


def effort_arg(text: str | None) -> str | None:
    """--effort as typed: None if not given, "" for default (no level), else a level."""
    return None if text is None else "" if text == "default" else text


def effort_level(mode: Mode, effort: str | None) -> str:
    """The level a run uses: --effort's ("": none), else the mode's."""
    return mode.effort if effort is None else effort


def agy_effort(model: str) -> bool:
    """Whether agy takes --effort with this model: its default, or a gemini model with
    no level in its name (gemini-3.8-flash, not gemini-3.8-flash-low); it refuses one
    for its other models."""
    return not model or (
        model.startswith("gemini") and not re.search(r"-(low|medium|high)$", model)
    )


def ollama_model_for(cfg: dict, level: str) -> str:
    """The model a plain ollama gets: ollama_models' for the level, else ollama_model."""
    return setting(cfg, "ollama_models").get(level, "") or setting(cfg, "ollama_model")


def resolve_roster(
    cfg: dict,
    mode_name: str,
    agents: str,
    picks: list[str],
    level: str | None = None,
) -> tuple[list[tuple[str, str, str, str, int]], dict[str, str], list[str]]:
    """Read -a, --agent, and --effort's level (None: the mode's). Returns the roster as
    (key, tool, model, effort, listed), the --agent picks as {agent: key}, and notes."""
    mode = MODES[mode_name]
    level = effort_level(mode, level)
    if level and level not in EFFORTS:
        raise PrepError(
            f"no effort level {level!r}; use {', '.join(EFFORTS)}, or default"
        )
    problems = tool_problems(cfg)
    notes: list[str] = []
    text = agents.strip()
    if not text or text.isdecimal():
        # -a N needs N. With no -a, up to the mode's count will do (with none, all),
        # down to one. Ollama counts only with a model for the level.
        pool = setting(cfg, "agents")
        n = int(text) if text else mode.count or len(pool)
        least = n if text else 1
        specs, skipped = [], []
        for tool in pool:  # the first n that can run here, in order
            if len(specs) == n:
                break
            why = problems[tool]
            if not why and tool == "ollama" and not ollama_model_for(cfg, level):
                why = "no ollama_model is set" + (
                    f", and no ollama_models.{level}" if level else ""
                )
            if why:
                skipped.append(f"{tool}: {why}")
            else:
                specs.append(tool)
        if n and len(specs) < least:
            why = f" Skipped: {'; '.join(skipped)}." if skipped else ""
            again = (
                ",".join(specs[i % len(specs)] for i in range(least)) if specs else ""
            )
            hint = (
                f" To run {least} anyway, give the agents (-a) as {again}"
                if again
                else ""
            )
            raise PrepError(
                f"this needs {least} tool{'s' if least != 1 else ''} that can run "
                f"here, and the agents setting ({', '.join(pool)}) has {len(specs)}."
                f"{why}{hint}"
            )
        if skipped:
            notes.append(f"skipped, since they cannot run here: {'; '.join(skipped)}")
    else:
        specs = [x.strip() for x in text.split(",")]
    if not specs or not all(specs):
        raise PrepError(f"-a takes a number above 0 or a list of SPECs, not {agents!r}")
    for spec in specs:
        parse_spec(spec)  # a bad SPEC says more than a count would
    roster: list[tuple[str, str, str, str, int]] = []

    def add(spec: str, listed: bool) -> str:
        tool, model, effort = parse_spec(spec)
        if problems[tool]:
            raise PrepError(f"{tool} cannot run here: {problems[tool]}")
        if effort and effort not in TOOL_EFFORTS[tool]:
            raise PrepError(
                f"{tool} takes effort {', '.join(TOOL_EFFORTS[tool])}, not {effort!r}"
            )
        # Your SPEC's parts win, the level fills the blanks, and the tool does the rest.
        cell = EFFORTS[level][tool] if level else ("", "")
        asked = effort
        model, effort = model or cell[0], effort or cell[1]
        if tool == "agy" and effort and not agy_effort(model):
            if asked:  # the level's own effort goes quietly
                note = (
                    f"agy takes effort only for a gemini model with no level in its "
                    f"name, so @{effort} is ignored for {model}"
                )
                notes.extend([note] if note not in notes else [])
            effort = ""
        if tool == "ollama" and not model:
            model = ollama_model_for(cfg, level)
            if not model:
                per_level = ","
                if level:  # config set replaces the whole table, so keep its levels
                    levels = shown({**setting(cfg, "ollama_models"), level: "MODEL"})
                    per_level = f", run pantheon config set ollama_models {levels},"
                raise PrepError(
                    f"ollama needs a model: write ollama:MODEL{per_level} or run "
                    "pantheon config set ollama_model MODEL"
                )
        if not listed:  # an agent -a has already keeps its key
            for row in roster:
                if row[1:4] == (tool, model, effort):
                    return row[0]
        taken = {row[0] for row in roster}
        key, n = tool, 2
        while key in taken:
            key, n = f"{tool}-{n}", n + 1
        roster.append((key, tool, model, effort, int(listed)))
        return key

    for spec in specs:
        add(spec, True)
    singles = [name for name, agent in mode.agents.items() if not agent.multi]
    keys: dict[str, str] = {}
    for item in picks:
        name, sep, spec = (x.strip() for x in item.partition("="))
        if name in mode.agents and name not in singles:
            raise PrepError(
                f"{name} has an instance for each tool, so -a gives its tools, not "
                "--agent"
            )
        if not sep or not spec or name not in singles:
            raise PrepError(
                f"bad --agent {item!r}; use ROLE=SPEC, where ROLE is one of: "
                + (", ".join(singles) or "none in this mode")
            )
        keys[name] = add(spec, False)
    return roster, keys, notes


# --------------------------------------------------------------------------------- issues


def parse_issue_ref(text: str) -> dict | None:
    t = text.strip()
    if m := re.fullmatch(r"#?(\d+)", t):
        return {"number": int(m[1])}
    if m := re.fullmatch(r"https?://github\.com/([^/\s]+/[^/\s]+)/issues/(\d+)/?", t):
        return {"number": int(m[2]), "host": "github.com", "path": m[1]}
    if m := re.fullmatch(
        r"https?://(?:[^@/\s]+@)?([^/\s]+)/(.+?)/-/(?:issues|work_items)/(\d+)/?", t
    ):
        return {"number": int(m[3]), "host": m[1], "path": m[2]}
    return None


def parse_remote(url: str) -> tuple[str, str]:
    url = url.strip()
    if "://" not in url:  # scp-like: git@host:group/project.git
        m = re.fullmatch(r"(?:[^@/\s]+@)?([^:/\s]+):(.+?)(?:\.git)?/?", url)
        if m:
            return m[1], m[2]
    u = urllib.parse.urlsplit(url)  # drops the user part, which can hold a token
    if u.hostname:
        return u.hostname, u.path.strip("/").removesuffix(".git")
    # Never echo it: it can hold a token.
    raise PrepError("cannot read the origin remote")


def forge_error(tool: str, rc: int, err: str) -> PrepError:
    line = first_line(err, 200) or f"exit status {rc}"
    if rc == 4 or re.search(r"401|403|auth|log ?in|token", err, re.I):
        return PrepError(
            f"{tool} could not sign in ({line}); fix its login and try again"
        )
    return PrepError(f"{tool}: {line}")


def fetch_issue(workdir: str, ref: dict) -> dict:
    host, path = ref.get("host", ""), ref.get("path", "")
    if not host:
        rc, out, _ = git(workdir, "remote", "get-url", "origin")
        if rc:
            raise PrepError("an issue number needs an origin remote")
        host, path = parse_remote(out)
    n = str(ref["number"])
    if host == "github.com":
        fields = "number,title,body,labels,comments,url,state"
        rc, out, err = run_cmd(
            ["gh", "issue", "view", n, "-R", path, "--json", fields], cwd=workdir
        )
        if rc:
            raise forge_error("gh", rc, err)
        data = json.loads(out)
        if "/pull/" in data.get("url", ""):  # issues and pull requests share numbers
            raise PrepError(f"#{n} is a pull request, not an issue")
        comments = [
            {
                "author": (c.get("author") or {}).get("login", ""),
                "at": c.get("createdAt", ""),
                "body": c.get("body", ""),
            }
            for c in data.get("comments", [])
        ]
        return {
            "title": data["title"],
            "url": data["url"],
            "body": data.get("body") or "",
            "comments": comments,
        }
    repo = f"{host}/{path}"  # always name the host, or glab falls back to gitlab.com
    rc, out, err = run_cmd(
        ["glab", "issue", "view", n, "--output", "json", "--repo", repo], cwd=workdir
    )
    if rc:
        raise forge_error("glab", rc, err)
    data = json.loads(out)
    notes_path = (
        f"projects/:id/issues/{n}/notes?sort=asc&order_by=created_at&per_page=100"
    )
    rc, out, err = run_cmd(
        ["glab", "api", "--repo", repo, "--paginate", "--output", "ndjson", notes_path],
        cwd=workdir,
    )
    if rc:
        raise forge_error("glab", rc, err)
    comments = []
    for line in out.splitlines():
        note = json.loads(line) if line.strip() else {}
        if note and not note.get("system"):
            author = (note.get("author") or {}).get("username", "")
            comments.append(
                {
                    "author": author,
                    "at": note.get("created_at", ""),
                    "body": note.get("body", ""),
                }
            )
    body = data.get("description") or ""
    return {
        "title": data["title"],
        "url": data.get("web_url", ""),
        "body": body,
        "comments": comments,
    }


def format_issue(issue: dict) -> str:
    parts = [issue["title"], issue["url"], issue["body"].strip() or "(no description)"]
    if issue["comments"]:
        parts.append("Comments:")
        for c in issue["comments"]:
            parts.append(f"{c['author']} ({c['at'][:10]}):\n{c['body'].strip()}")
    return "\n\n".join(parts)


# --------------------------------------------------------------------------- new sessions


@dataclass
class NewSession:
    mode: str
    task: str  # as typed: text, an issue number, or an issue URL
    dir: str
    yolo: bool
    agents: str = ""  # -a: how many, or SPEC,SPEC,...
    picks: list[str] = field(default_factory=list)  # --agent ROLE=SPEC
    effort: str | None = None  # --effort: a level, or "" for none; None: the mode's
    stop_when_done: bool = (
        False  # a one-shot run: stop the agents once the plan is done
    )


def scenario_repo() -> str:
    """A new git repo in a temp dir, with no files: where pantheon test runs a scenario.
    Its one commit is empty, since a session starts from a commit. It stays after
    pantheon exits, with the agents' work."""
    repo = tempfile.mkdtemp(prefix="pantheon-test-")
    # Pantheon's name on the commit, and no signing, which could ask for a passphrase.
    me = ["-c", "user.name=pantheon", "-c", "user.email=pantheon@localhost"]
    for args in (
        ["init", "-q"],
        [
            *me,
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "Start.",
        ],
    ):
        rc, _, err = git(repo, *args)
        if rc:
            raise PrepError(f"cannot make a git repo in {repo}: {err.strip()}")
    return repo


def dirty_files(workdir: str) -> list[str]:
    rc, out, _ = git(workdir, "status", "--porcelain")
    return [line[3:] for line in out.splitlines() if line.strip()] if rc == 0 else []


def prepare(
    cfg: dict, req: NewSession, confirm: Callable[[list[str], str], bool]
) -> tuple[str, list[str]]:
    """Check the start dir, read the task, pick the agents, and write the session file."""
    mode = MODES[req.mode]
    workdir = os.path.realpath(os.path.expanduser(req.dir or "."))
    if not os.path.isdir(workdir):
        raise PrepError(f"{req.dir} is not a directory")
    roster, picks, notes = resolve_roster(
        cfg, req.mode, req.agents, req.picks, req.effort
    )
    base, pre_existing = "", []
    if mode.needs_git:
        if git(workdir, "rev-parse", "--show-toplevel")[0]:
            raise PrepError(f"{workdir} is not in a git repo")
        rc, out, _ = git(workdir, "rev-parse", "HEAD")
        if rc:
            raise PrepError(f"{workdir} has no commits yet")
        base = out.strip()
        pre_existing = dirty_files(workdir)
        note = (
            "Branches from the last commit will not have these changes; agents that "
            "work in the start dir see them."
        )
        if pre_existing and not confirm(pre_existing, note):
            raise PrepError("stopped: the work tree has uncommitted changes")
        if pre_existing:
            notes.append(f"Uncommitted changes: {name_list(pre_existing)}. {note}")
        busy = [
            s["slug"]
            for s in list_sessions()
            if s["dir"] == workdir and s["state"] in ("running", "needs_you")
        ]
        if busy:
            notes.append(
                f"another running session starts in this dir too: {', '.join(busy)}"
            )
    task, source, title = req.task.strip(), "", req.task.strip()
    ref = parse_issue_ref(task) if task else None
    if ref:
        issue = fetch_issue(workdir, ref)
        task, source, title = format_issue(issue), issue["url"], issue["title"]
    if mode.needs_task and not task:
        raise PrepError(f"{req.mode} needs a task")
    slug = make_slug(first_line(title, 60) if title else req.mode)
    # A copy of the setting: changing it later must not reshuffle a running session.
    scramble = bool(setting(cfg, "scramble"))
    # Made here, and only if new, so the cleanup below never deletes another start's.
    try:
        os.close(os.open(db_path(slug), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    except FileExistsError:
        raise PrepError(
            f"another start took the name {slug} just now; try again"
        ) from None
    db = connect(db_path(slug))
    try:
        db.executescript(
            f"BEGIN; {SCHEMA} PRAGMA user_version = {SCHEMA_VERSION}; COMMIT;"
        )
        now = now_iso()
        db.execute(
            "INSERT INTO session (id, slug, mode, task, source, dir, base_commit, pre_existing,"
            " yolo, scramble, stop_when_done, state, origin, created_at)"
            " VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'running', ?, ?)",
            (
                slug,
                req.mode,
                task,
                source,
                workdir,
                base,
                "\n".join(pre_existing),
                int(req.yolo),
                int(scramble),
                int(req.stop_when_done),
                session_origin(slug, now),
                now,
            ),
        )
        db.executemany(
            "INSERT INTO roster (key, tool, model, effort, listed) VALUES (?, ?, ?, ?, ?)",
            roster,
        )
        db.executemany("INSERT INTO picks (role, key) VALUES (?, ?)", picks.items())
        specs = {
            key: spec_text(tool, model, effort)
            for key, tool, model, effort, _ in roster
        }
        opening = f"Started {req.mode} in {short_home(workdir)}" + (
            f" at {base[:9]}" if base else ""
        )
        if source:
            opening += f" for {source}"
        opening += " with " + ", ".join(specs[r[0]] for r in roster if r[4])
        opening += ", in a random order for each agent" if scramble else ""
        opening += "".join(f"; {name}: {specs[key]}" for name, key in picks.items())
        level = effort_level(mode, req.effort)
        opening += f" (effort {level})" if level else ""
        opening += (
            "; the agents stop once the plan is done" if req.stop_when_done else ""
        )
        for text in [opening + ".", *notes]:
            db.execute(
                "INSERT INTO events (at, kind, text) VALUES (?, 'note', ?)", (now, text)
            )
    except BaseException:
        db.close()
        # A file with no session row is never listed, so prune would never delete it.
        db_path(slug).unlink(missing_ok=True)
        raise
    db.close()
    return slug, notes


# ------------------------------------------------------------ the plan and agent commands


def on_tracks(mode: Mode, stage: Stage) -> bool:
    """Whether a stage runs on each track: one of its agents is multi, and they do not
    work together."""
    return not stage.together and any(mode.agents[name].multi for name in stage.agents)


def walk_lane(
    mode: Mode, st: Stage, tracks: int, lane: int, steps: list
) -> tuple[list[tuple[int, int, str]], bool, list]:
    """Where a stage is on a lane (a track, or 0 in a stage with no tracks), from its
    steps there so far, oldest first, as rows that start with track and status: the
    turns to start, as (track, round, agent); whether a turn is open; and, once the
    lane is done, the steps of the turn that halted its loop, if one did. In each
    round, each agent takes a turn, in order; together, a multi agent's turn is one
    for each of its instances, at once, and halts the loop only if all of them halt
    it. round is 0 outside a loop."""
    rounds = st.loop.max_rounds if st.loop else 1
    i = 0
    for rnd in range(1, rounds + 1):
        for role in st.agents:
            group = [lane]
            if st.together and mode.agents[role].multi:
                group = list(range(1, tracks + 1))
            # A turn's steps are made together, so they come in a row.
            mine, i = steps[i : i + len(group)], i + len(group)
            seen = {s[0] for s in mine}
            start = [(t, rnd if st.loop else 0, role) for t in group if t not in seen]
            busy = any(s[1] == "open" for s in mine)
            if start or busy:
                return start, busy, []
            if all(s[1] == "halt" for s in mine):
                return [], False, mine
    return [], False, []


def plan_turns(
    mode: Mode, tracks: int, steps: list[tuple[str, int, str]]
) -> list[tuple[str, int, int, str]] | None:
    """The turns the plan asks for now, from the steps so far as (stage, track,
    status), oldest first: (stage, track, round, agent) for each, or None once the plan
    is done. The first stage not done on every lane is the one under way (see
    walk_lane). A stage done with a stop in it ends the plan, and one that picks a
    track runs the later stages on that track alone."""
    picked = 0
    for name, st in mode.stages.items():
        mine = [(t, status) for stage, t, status in steps if stage == name]
        lanes = [0]
        if on_tracks(mode, st):
            lanes = [picked] if picked else list(range(1, tracks + 1))
        turns, busy = [], False
        for lane in lanes:
            here = [s for s in mine if s[0] == lane] if lane else mine
            start, open_, _ = walk_lane(mode, st, tracks, lane, here)
            turns += [(name, t, rnd, role) for t, rnd, role in start]
            busy = busy or open_
        if turns or busy:
            return turns
        statuses = [status for _, status in mine]
        if "stop" in statuses:
            return None
        if st.pick:  # its one turn ended with track-N
            picked = int(statuses[-1].removeprefix("track-"))
    return None


def turn_label(stage: str, rnd: int, track: int) -> str:
    """A turn as the prompts and the room name it, e.g. build round 2, track 1."""
    label = stage + (PROMPTS["round"].format(round=rnd) if rnd else "")
    return label + (PROMPTS["track"].format(track=track) if track else "")


def after_pick(mode: Mode, stage: str) -> bool:
    """Whether a stage comes after one that picks a track."""
    names = list(mode.stages)
    return any(mode.stages[n].pick for n in names[: names.index(stage)])


def plan_text(mode: Mode) -> str:
    """The plan, as every agent reads it, and as pantheon start help MODE prints it."""
    lines = []
    for n, (name, st) in enumerate(mode.stages.items(), 1):
        loop = ""
        if st.loop:
            n_max = st.loop.max_rounds
            loop = PROMPTS["plan_loop"].format(
                until=st.loop.until, max=n_max, s="" if n_max == 1 else "s"
            )
            loop += PROMPTS["plan_together"] if st.together else ""
        where = ""
        if on_tracks(mode, st):
            where = PROMPTS["on_pick" if after_pick(mode, name) else "on_tracks"]
        agents = [
            PROMPTS["at_once"].format(agent=role)
            if st.together and mode.agents[role].multi
            else role
            for role in st.agents
        ]
        lines.append(
            PROMPTS["plan_stage"].format(
                n=n,
                stage=name,
                agents=PROMPTS["then"].join(agents),
                where=where,
                goal=st.goal,
                loop=loop,
                go=PROMPTS["plan_go"].format(go_if=st.go_if) if st.go_if else "",
                pick=PROMPTS["plan_pick"].format(pick=st.pick) if st.pick else "",
            )
        )
    return PROMPTS["plan"].format(help=mode.help, stages="\n".join(lines))


def statuses_of(stage: Stage, tracks: int) -> tuple[str, ...]:
    """The statuses a turn in the stage may end with."""
    if stage.loop:
        return ("continue", "halt")
    if stage.pick:
        return (*(f"track-{t}" for t in range(1, tracks + 1)), "stop")
    return ("go", "stop") if stage.go_if else ("done",)


def report_lines(write: str, statuses) -> str:
    """The end of a prompt: what the report is, and the line it ends with."""
    lines = "\n".join(f"PANTHEON[status]: {s}" for s in statuses)
    key = "report" if len(statuses) == 1 else "reports"
    return PROMPTS[key].format(write=write, lines=lines)


def read_reply(text: str) -> tuple[list[str], str, str]:
    """The posts in the last message of an agent's turn, its status, and the rest of
    the message, which is the turn's report. A post runs from a PANTHEON[say] line
    (MARKER_RE) to the next PANTHEON line, or to the end. The status is the word after
    the last PANTHEON[status], in lower case, or "". A PANTHEON line in a code block is
    text, so an agent can quote one."""
    posts, status, rest = [], "", []
    post = None  # the lines of the post that is open
    fenced = False
    for line in text.splitlines():
        m = None if fenced else MARKER_RE.match(line)
        if FENCE_RE.match(line):
            fenced = not fenced
        if m is None:
            (rest if post is None else post).append(line)
            continue
        if post is not None:
            posts.append(post)
        kind = m.group(1).lower()
        post = [line[m.end() :]] if kind == "say" else None
        if kind == "status":
            word = STATUS_RE.search(line)
            status = word.group(1).lower() if word else ""
    if post is not None:
        posts.append(post)
    texts = [t for t in ("\n".join(p).strip() for p in posts) if t]
    return texts, status, "\n".join(rest).strip()


# -------------------------------------------------------------------------------- runtime


class Tmux:
    """The private tmux server of one session."""

    def __init__(self, path: str, name: str, conf: str, env: dict[str, str]):
        self.base = [path, "-L", name, "-f", conf]
        tmpdir = os.environ.get("TMUX_TMPDIR") or "/tmp"
        self.socket = Path(tmpdir) / f"tmux-{os.getuid()}" / name
        # The server takes its environment from the command that starts it.
        self.env = env

    async def run(
        self, *args: str, data: bytes | None = None, check: bool = True
    ) -> str:
        proc = await asyncio.create_subprocess_exec(
            *self.base,
            *args,
            stdin=asyncio.subprocess.PIPE
            if data is not None
            else asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
            env=self.env,
        )
        out, err = await proc.communicate(data)
        if check and proc.returncode:
            raise TmuxError(
                err.decode(errors="replace").strip() or f"tmux {args[0]} failed"
            )
        return out.decode(errors="replace")

    def run_sync(self, *args: str) -> str:
        return run_cmd([*self.base, *args], env=self.env)[1]


def pane(agent: str) -> str:
    # "=name" matches a session name exactly; the ":" then picks its current pane.
    return f"={agent}:"


def tmux_arg(arg: str) -> str:
    """arg as tmux must get it: tmux reads a ";" at the end of any argument as the end
    of its command, but reads "\\;" there as a ";"."""
    return arg[:-1] + "\\;" if arg.endswith(";") else arg


def tmux_conf(slug: str) -> Path:
    # Outside run/<slug>, which agents can write to.
    return RUN / f"{slug}.tmux.conf"


def private_files(slug: str) -> list[Path]:
    """The files a session keeps beside run/<slug>: its tmux conf, and each ollama
    agent's claude settings."""
    settings = RUN.glob(glob.escape(slug) + ".*.claude-settings.json")
    return [tmux_conf(slug), *settings]


def tmux_name(slug: str) -> str:
    digest = hashlib.sha1(os.path.realpath(db_path(slug)).encode()).hexdigest()[:6]
    return f"pantheon-{slug}-{digest}"


def signal_group(pid: int, sig: int) -> bool:
    """Signal a pane's process group (a tool may ignore hangups). False if it is gone."""
    try:
        os.killpg(pid, sig)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def stop_server_sync(slug: str) -> None:
    tmux = Tmux(tmux_path(), tmux_name(slug), os.devnull, clean_env())
    for path in private_files(slug):
        path.unlink(missing_ok=True)
    pids = [
        int(p)
        for p, _, dead in (
            line.partition("\t")
            for line in tmux.run_sync(
                "list-panes", "-a", "-F", "#{pane_pid}\t#{pane_dead}"
            ).splitlines()
        )
        if p.isdigit()
        and dead != "1"  # a dead pane's pid may belong to someone else now
    ]
    for pid in pids:
        signal_group(pid, signal.SIGTERM)
    deadline = time.time() + 3
    while time.time() < deadline and any(signal_group(p, 0) for p in pids):
        time.sleep(0.1)
    for pid in pids:
        signal_group(pid, signal.SIGKILL)
    tmux.run_sync("kill-server")
    tmux.socket.unlink(missing_ok=True)


def delete_session(slug: str) -> bool:
    """Delete a session for good: stop its agents, if they still run, and remove its
    files. False when another pantheon has it open, or it is busy."""
    # Hold its lock until the file is gone, so a pantheon that opens it meanwhile is
    # turned away rather than left with no file.
    try:
        held = connect(db_path(slug))
    except sqlite3.Error:
        return False
    try:
        take_lock(held, slug)
    except (Locked, sqlite3.Error):
        held.close()
        return False
    stop_server_sync(slug)  # and its private files
    shutil.rmtree(scratch_dir(slug), ignore_errors=True)
    for suffix in ("", "-journal"):
        Path(f"{db_path(slug)}{suffix}").unlink(missing_ok=True)
    held.close()
    return True


@dataclass
class Outgoing:
    """A text pantheon will type into an agent."""

    text: str
    kind: str  # step (a step's prompt), remind, or post (a room post)
    step_id: int = 0  # for step and remind
    event_id: int = 0  # for post: its room event


@dataclass
class Paste:
    """A text pantheon pasted into an agent, until a turn it started is seen. Kept
    so that pantheon never pastes a text twice into one input box."""

    item: Outgoing  # the head of the outbox until Enter
    text: str  # what went in: item.text, cleaned for the tool
    before: str  # the screen before the paste
    at: float  # when pantheon pasted it
    missed: bool = False  # it did not show in time: a dialog may have taken it
    looked: bool = False  # you went into the agent since the paste
    shown: bool = False  # it showed in the input box while you were in
    entered: float = 0.0  # when pantheon pressed Enter
    again: bool = False  # pantheon pressed Enter a second time


@dataclass
class AgentRun:
    id: int
    name: str
    role: str
    tool: str
    model: str
    effort: str
    native_id: str
    state: str
    reason: str
    launched: float = 0.0  # time.time() at launch, for the startup watchdog
    activity: float = 0.0  # tmux #{window_activity}
    typeable: bool = False  # it needs you, but pantheon may still type to it
    idle_since: float = 0.0  # agy: when its screen showed its input box mid-turn
    dialog: str = ""  # agy: the dialog its screen shows (agy_asks), which needs you
    in_turn: bool = False  # from a prompt to its Stop: tool hooks count only then
    ran: tuple[str, str] = ("", "")  # the model and effort it reports, as last known
    no_effort: bool | None = None  # claude_sends_no_effort, once read
    # The last message of its turn, which turn_ended takes: its text (read_reply's
    # rest) and its status.
    last_message: str = ""
    last_status: str = ""
    # What to type once the agent is idle, oldest first. A reopen rebuilds it from the
    # file, in room order: the unsent step, and the posts after heard.
    outbox: list[Outgoing] = field(default_factory=list)
    pasting: Paste | None = None
    heard: int = 0  # the room id of the last post typed into it
    posted: bool = False  # it posted to the room since pantheon typed it a turn
    answering: bool = False  # its turn is for a room post: any answer goes in the room
    hooked: bool = False  # a hook came from it: claude sends none until its dialogs end
    generation: int = 0  # how many times it started; each restart makes a new one
    waiting_since: float = 0.0  # when pantheon first found no input box to type into


def describe_tool(ev: dict) -> str:
    name = ev.get("tool_name") or "a tool"
    ti = ev.get("tool_input")
    if isinstance(ti, dict):
        for k in ("command", "file_path", "path", "url", "pattern"):
            if isinstance(ti.get(k), str):
                return f"{name}({shorten(ti[k], 80)})"
    return name


def describe_question(ev: dict) -> str:
    if ev.get("tool_name") == "ExitPlanMode":
        return "plan approval"
    ti = ev.get("tool_input") or {}
    questions = ti.get("questions") if isinstance(ti, dict) else None
    if questions and isinstance(questions[0], dict):
        return "question: " + shorten(str(questions[0].get("question", "")), 100)
    return "a question"


def compact_hook(ev: dict) -> dict:
    keep = (
        "session_id",
        "tool_name",
        "notification_type",
        "message",
        "error",
        "source",
        "model",
        "to_model",
        "effort",
        "agent_id",
    )
    out = {k: ev[k] for k in keep if k in ev}
    if isinstance(ev.get("last_assistant_message"), str):
        out["last_assistant_message"] = ev["last_assistant_message"][:4000]
    if "tool_input" in ev:
        out["tool_input"] = shorten(json.dumps(ev["tool_input"]), 300)
    return out


class Session:
    """One open session: its record, its tmux server, and its agents."""

    def __init__(self, slug: str, cfg: dict, term_size: Callable[[], tuple[int, int]]):
        self.slug, self.cfg, self.term_size = slug, cfg, term_size
        self.db = connect(db_path(slug))
        try:
            row = self.check_file()
            # A session file from another install opens read-only: its start dir, yolo
            # flag, and prompts come from whoever wrote it.
            origin = session_origin(row["slug"], row["created_at"])
            self.foreign = not hmac.compare_digest(row["origin"], origin)
            if not self.foreign:
                take_lock(self.db, slug)
        except BaseException:
            self.db.close()
            raise
        self.mode_name, self.mode = row["mode"], MODES[row["mode"]]
        self.task, self.workdir, self.base = row["task"], row["dir"], row["base_commit"]
        self.pre_existing = [line for line in row["pre_existing"].splitlines() if line]
        self.yolo, self.scramble = bool(row["yolo"]), bool(row["scramble"])
        self.stop_when_done = bool(row["stop_when_done"])
        self.state = row["state"]
        conf = tmux_conf(slug)
        if not self.foreign:
            private_dir(scratch_dir(slug))
            write_private(conf, TMUX_CONF)
        # Before the agents load: restore makes prompts, which name the room file.
        self.scratch = os.path.realpath(scratch_dir(slug))
        self.room_file = os.path.join(self.scratch, ROOM_FILE)
        self.room_changed = True  # so the first tick writes the room file
        self.roster = {
            r["key"]: r for r in self.db.execute("SELECT * FROM roster ORDER BY id")
        }
        self.keys = [k for k, r in self.roster.items() if r["listed"]]  # -a's, in order
        self.picks = {
            r["role"]: r["key"] for r in self.db.execute("SELECT * FROM picks")
        }
        self.agents = {
            r["name"]: AgentRun(
                r["id"],
                r["name"],
                r["role"],
                r["tool"],
                r["model"],
                r["effort"],
                r["native_id"],
                r["state"],
                r["reason"],
                heard=r["heard"],
                posted=bool(r["posted"]),
                answering=bool(r["answering"]),
            )
            for r in self.db.execute("SELECT * FROM agents ORDER BY id")
        }
        for a in self.agents.values():
            self.restore(a)
        self.tmux = Tmux(tmux_path(), tmux_name(slug), str(conf), clean_env())
        self.closed = False
        self.driving = not self.foreign  # false too once another pantheon takes over
        self.ending = False  # you ended the session; the engine stops the agents
        self.launch_failed: set[str] = set()  # retried when the session is reopened
        self.checked_server = False
        self.attached = ""  # the agent you are transported into
        self.attach_token: object = None  # the transport() call that set attached
        self.last_poll = self.last_beat = 0.0
        self.errors = 0

    def check_file(self):
        """The session row. A file from another schema version does not open, so no
        other code has to handle old files."""
        version = self.db.execute("PRAGMA user_version").fetchone()[0]
        if version != SCHEMA_VERSION:
            raise ValueError(
                f"{self.slug} has schema version {version}; this pantheon reads {SCHEMA_VERSION}"
            )
        row = self.db.execute("SELECT * FROM session").fetchone()
        if row is None or row["mode"] not in MODES:
            raise ValueError(f"{self.slug} has no mode this pantheon knows")
        return row

    def restore(self, a: AgentRun) -> None:
        """Rebuild what pantheon keeps in memory for an agent, after a reopen."""
        a.generation = self.db.execute(
            "SELECT COUNT(*) FROM events WHERE agent_id = ? AND kind = 'start'", (a.id,)
        ).fetchone()[0]
        if a.state == "starting":
            a.launched = time.time()  # so the startup watchdog still fires
        if a.tool == "agy" and a.state in ("working", "needs_you"):
            a.in_turn = True  # so poll_panes sees a turn that ended while closed
        if a.state == "needs_you":
            row = self.db.execute(
                "SELECT data FROM events WHERE agent_id = ? AND kind = 'needs'"
                " ORDER BY id DESC LIMIT 1",
                (a.id,),
            ).fetchone()
            data = json.loads(row["data"]) if row else {}
            a.typeable = bool(data.get("typeable") or data.get("remind"))
        row = self.db.execute(
            "SELECT data FROM events WHERE agent_id = ? AND kind = 'ran'"
            " ORDER BY id DESC LIMIT 1",
            (a.id,),
        ).fetchone()
        if row:  # so a reopen does not name the model again
            data = json.loads(row["data"])
            a.ran = (data.get("model", ""), data.get("effort", ""))
        # Only this process's hooks: a restart keeps the agent's row, and the old
        # process's hooks would let pantheon type into the new one's startup dialog.
        a.hooked = (
            self.db.execute(
                "SELECT 1 FROM events WHERE agent_id = ? AND kind = 'hook' AND id >"
                " (SELECT COALESCE(MAX(id), 0) FROM events WHERE agent_id = ?"
                " AND kind = 'start') LIMIT 1",
                (a.id, a.id),
            ).fetchone()
            is not None
        )
        # The file keeps no turn. A wait pantheon may type through, or a StopFailure's,
        # comes after one.
        a.in_turn = a.state == "working" or (
            a.state == "needs_you"
            and not a.typeable
            and not a.reason.startswith("error: ")
        )
        if a.state in ("new", "exited"):
            return
        # What was not typed into it yet, in room order: each post after heard but its
        # own, and its turn ahead of the posts made after its prompt; in a stopped
        # session too, which types a turn it gave out already, and which Resume finds
        # in place. Launch sets heard to the newest post before its first prompt,
        # which has the earlier posts in it, so that prompt goes before every post.
        self.queue_posts(a)
        step = self.db.execute(
            "SELECT id, prompt FROM steps WHERE agent_id = ? AND status = 'open'"
            " AND sent = 0",
            (a.id,),
        ).fetchone()
        if step is None:
            return
        prompt = self.db.execute(
            "SELECT id FROM events WHERE kind = 'prompt' AND agent_id = ?"
            " AND json_extract(data, '$.step') = ?",
            (a.id, step["id"]),
        ).fetchone()
        at = prompt["id"] if prompt else 0
        i = sum(o.event_id < at for o in a.outbox)  # the posts made before it
        a.outbox.insert(i, Outgoing(step["prompt"], "step", step["id"]))

    # -- records

    def event(
        self,
        kind: str,
        text: str,
        agent: AgentRun | None = None,
        data: dict | None = None,
    ) -> int:
        cur = self.db.execute(
            "INSERT INTO events (at, agent_id, kind, text, data) VALUES (?, ?, ?, ?, ?)",
            (
                now_iso(),
                agent.id if agent else None,
                kind,
                text,
                json.dumps(data or {}),
            ),
        )
        self.room_changed = self.room_changed or kind != "hook"
        return cur.lastrowid  # its room id

    def save_agent(self, a: AgentRun, **fields) -> None:
        for k, v in fields.items():
            setattr(a, k, v)
        sets = ", ".join(f"{k} = ?" for k in fields)
        self.db.execute(
            f"UPDATE agents SET {sets} WHERE id = ?", (*fields.values(), a.id)
        )

    def set_session_state(self, state: str) -> None:
        if state != self.state:
            self.state = state
            self.db.execute("UPDATE session SET state = ?", (state,))

    def refresh_session_state(self) -> None:
        if self.state not in ("running", "needs_you"):
            return
        needs = any(a.state == "needs_you" for a in self.agents.values())
        self.set_session_state("needs_you" if needs else "running")

    def set_state(self, a: AgentRun, state: str, reason: str = "") -> None:
        if a.state == state and a.reason == reason:
            return
        self.save_agent(a, state=state, reason=reason)
        if state != "needs_you":
            a.typeable = False
        self.refresh_session_state()

    def needs_you(
        self, a: AgentRun, reason: str, remind: bool = False, typeable: bool = False
    ) -> None:
        if a.state == "needs_you" and a.reason == reason:
            return
        self.set_state(a, "needs_you", reason)
        a.typeable = remind or typeable
        self.event("needs", reason, a, {"remind": remind, "typeable": a.typeable})

    def agent_by_id(self, agent_id: int | None) -> AgentRun | None:
        return next((a for a in self.agents.values() if a.id == agent_id), None)

    def step(self, step_id: int):
        return self.db.execute(
            "SELECT * FROM steps WHERE id = ?", (step_id,)
        ).fetchone()

    def open_step(self, a: AgentRun | None = None, sent_only: bool = False):
        sql, args = "SELECT * FROM steps WHERE status = 'open'", []
        if a is not None:
            sql, args = sql + " AND agent_id = ?", [a.id]
        if sent_only:  # a step still waiting in the outbox is not the agent's yet
            sql += " AND sent = 1"
        return self.db.execute(sql + " ORDER BY id DESC", args).fetchone()

    def report_path(self, step) -> str:
        """The file in which pantheon keeps a step's report, for the agents to read."""
        return os.path.join(self.scratch, step["name"])

    def lane(self, stage: str, track: int) -> int:
        """A step's lane: its track, in a stage on tracks; else 0. In a stage whose
        agents work together, track only tells a multi agent's instances apart."""
        return 0 if self.mode.stages[stage].together else track

    def step_label(self) -> tuple[AgentRun | None, str]:
        """The agent and turn under way; with more than one, how many, and their stage
        when they share one."""
        rows = self.db.execute(
            "SELECT * FROM steps WHERE status = 'open' ORDER BY id"
        ).fetchall()
        if not rows:
            return None, ""
        if len(rows) == 1:
            r = rows[0]
            lane = self.lane(r["stage"], r["track"])
            return self.agent_by_id(r["agent_id"]), turn_label(
                r["stage"], r["round"], lane
            )
        stages = {r["stage"] for r in rows}
        where = f"{rows[0]['stage']}: " if len(stages) == 1 else ""
        return None, f"{where}{len(rows)} turns under way"

    def live_agents(self) -> list[AgentRun]:
        return [a for a in self.agents.values() if a.state not in ("new", "exited")]

    def asks(self) -> int:
        """How many things wait on you: agents that need you, wait for an answer in
        the room, or could not start, and a stopped session's Resume."""
        agents = self.agents.values()
        waits = sum(a.state == "needs_you" or a.reason == ROOM_WAIT for a in agents)
        waits += len(self.launch_failed)  # until you fix it and reopen the session
        return waits + (self.state == "stopped" and self.driving)

    # -- the loop

    async def run(self) -> None:
        while not self.closed and self.driving:
            try:
                await self.tick()
                self.errors = 0
            except Exception as e:  # keep the session going, and show what broke
                self.errors += 1
                if self.errors <= 3 and not self.closed:
                    try:  # the traceback goes in the session file, with the rest
                        self.event(
                            "error",
                            f"pantheon: {type(e).__name__}: {e}",
                            data={"traceback": traceback.format_exc()},
                        )
                    except sqlite3.Error:
                        pass
            await asyncio.sleep(0.25)

    async def tick(self) -> None:
        if self.ending:  # here, so that no tick runs beside the stop
            self.ending = False
            await self.stop_agents()
            self.set_session_state("ended")
            self.event("note", "Ended the session and stopped its agents.")
            return
        now = time.time()
        if now - self.last_beat >= 5:
            self.last_beat = now
            self.heartbeat(now)
            if not self.driving:
                return
        if not self.checked_server:
            # Turns that ended while pantheon was closed count before any exit does.
            while self.db.execute("SELECT 1 FROM hooks LIMIT 1").fetchone():
                self.read_hooks()
            await self.check_server()
        self.read_hooks()
        if now - self.last_poll >= 0.5:
            self.last_poll = now
            await self.poll_panes(now)
        self.watchdogs(now)
        if self.room_changed and self.live_agents():  # only agents read it
            self.write_room()
        await self.send_pending(now)
        await self.advance()

    def heartbeat(self, now: float) -> None:
        cur = self.db.execute(
            "UPDATE lock SET heartbeat = ?, host = ? WHERE id = 1 AND pid = ?",
            (now, socket.gethostname(), os.getpid()),
        )
        if cur.rowcount:
            return
        try:  # another pantheon took the lock while this one stalled
            take_lock(self.db, self.slug)
        except Locked as e:
            self.driving = False
            self.event("error", f"{e}, so this window stopped driving the session.")

    async def check_server(self) -> None:
        self.checked_server = True
        live = self.live_agents()
        if not live or await self.server_alive():
            return
        self.event("note", "The agents' tmux server is gone, and the agents with it.")
        self.all_exited()

    def all_exited(self) -> None:
        """Every agent that runs exited at once. Those in a turn they had go first, so
        a stop comes before any turn goes back to the plan."""
        live = self.live_agents()
        for a in sorted(live, key=lambda a: self.open_step(a, sent_only=True) is None):
            self.exited(a, "")

    async def server_alive(self) -> bool:
        try:
            await self.tmux.run("list-sessions")
        except TmuxError:
            return False
        return True

    # -- signals

    def read_hooks(self) -> None:
        rows = self.db.execute(
            "SELECT id, agent, payload FROM hooks ORDER BY id LIMIT 500"
        ).fetchall()
        failed = None
        for row in rows:
            # One at a time, so a hook that fails loses only itself.
            self.db.execute("DELETE FROM hooks WHERE id = ?", (row["id"],))
            a = self.agents.get(row["agent"])
            try:
                ev = json.loads(row["payload"])
            except ValueError:
                continue
            if a is None or not isinstance(ev, dict):
                continue
            try:
                self.on_hook(a, ev)
            except Exception as e:
                failed = failed or e
        if failed is not None:
            raise failed  # once the rest are done; run puts it in the room

    def on_hook(self, a: AgentRun, ev: dict) -> None:
        name = ev.get("hook_event_name", "")
        self.event("hook", name, a, compact_hook(ev))
        # No process of its own runs, so the hook is an earlier one's, and must not
        # let pantheon type into the next one's startup dialog.
        if a.state in ("new", "exited"):
            return
        a.hooked = True
        if a.tool == "agy":
            self.on_agy_hook(a, name, ev)
            return
        # A subagent's hooks, or those of a thread of the tool's own (codex's memories),
        # have no transcript of the agent's: they name another model and effort.
        if not ev.get("agent_id") and ev.get("transcript_path"):
            self.hook_ran(a, name, ev)
        if name == "SessionStart":
            if a.tool == "codex" and ev.get("session_id") and not a.native_id:
                self.save_agent(a, native_id=ev["session_id"])
        elif name == "UserPromptSubmit":
            a.in_turn = True
            self.set_state(a, "working")
            self.turn_started(a, str(ev.get("prompt", "")))
        elif name in ("PostToolBatch", "PostToolUse"):
            # Claude can send one after its Stop; it must not undo the turn's end.
            if a.in_turn:
                self.set_state(a, "working")
        elif name == "PermissionRequest":
            self.needs_you(a, "permission: " + describe_tool(ev))
        elif name == "PreToolUse":  # AskUserQuestion or ExitPlanMode
            self.needs_you(a, describe_question(ev))
        elif name == "Notification":
            # Claude also says this after Esc ends a turn, which fires no Stop.
            if (
                a.state == "working"
                and ev.get("notification_type") in CLAUDE_NEEDS_NOTICES
            ):
                self.needs_you(a, ev.get("message") or "waiting for you")
        elif name == "Stop":
            message = ev.get("last_assistant_message")
            self.replied(a, message if isinstance(message, str) else "")
            # Claude may leave a background task (a dev server) running for good, so
            # wait for it only while the turn's step has no report yet. A turn with no
            # step has none to wait for.
            step = self.open_step(a, sent_only=True)
            if (
                ev.get("background_tasks")
                and step is not None
                and a.last_status not in step["statuses"].split()
            ):
                return
            a.in_turn = False
            self.turn_ended(a)
        elif name == "StopFailure":
            a.in_turn = False
            self.needs_you(a, f"error: {ev.get('error', 'unknown')}")

    def hook_ran(self, a: AgentRun, name: str, ev: dict) -> None:
        """The model and effort an agent really runs, from one of its own hooks. Every
        codex hook names its model; claude names it at SessionStart and PostModelSwitch,
        and its effort in its tool hooks and at Stop."""
        model = ev.get("to_model" if name == "PostModelSwitch" else "model")
        if name == "SessionStart" and ev.get("source") == "compact":
            model = None  # a subagent's compaction sends its model, with no agent_id
        effort = ev.get("effort")
        level = effort.get("level") if isinstance(effort, dict) else None
        if level == "high":
            if a.no_effort is None:  # once: it reads up to five settings files
                a.no_effort = claude_sends_no_effort(a, self.workdir)
            if a.no_effort:
                level = None
        self.note_ran(a, model, level)

    def note_ran(self, a: AgentRun, model=None, effort=None) -> None:
        """Name in the room the model and effort an agent really runs: once each is
        known, unless it is what pantheon asked for, and again each time it changes."""
        old_model, old_effort = a.ran
        if isinstance(model, str) and model:
            a.ran = (model, a.ran[1])
        if isinstance(effort, str) and effort:
            a.ran = (a.ran[0], effort)
        new_model, new_effort = a.ran
        data = {"model": new_model, "effort": new_effort}
        if new_model != old_model and (old_model or new_model != a.model):
            text = ("now runs " if old_model else "runs ") + new_model
            self.event("ran", text, a, data)
        if new_effort != old_effort and (old_effort or new_effort != a.effort):
            text = ("now runs" if old_effort else "runs") + f" at effort {new_effort}"
            self.event("ran", text, a, data)

    def replied(self, a: AgentRun, message: str) -> None:
        """The last message of an agent's turn: its posts go in the room, from the
        agent itself, since its own tool gave the message; turn_ended takes the rest,
        and the status."""
        # A lone surrogate, which JSON can hold, cannot go in the session file.
        message = message.encode("utf-8", "replace").decode()
        posts, a.last_status, a.last_message = read_reply(message)
        for text in posts:
            self.post(a.name, text)

    def on_agy_hook(self, a: AgentRun, name: str, ev: dict) -> None:
        """agy's hooks (AGY_HOOK_EVENTS), in camelCase. Each names the model it runs. A
        turn starts at its first PreInvocation; one that Esc ends sends no Stop, so
        on_agy_screen ends it."""
        self.note_ran(a, ev.get("modelName"))
        if name == "SessionStart":
            if ev.get("conversationId") and not a.native_id:
                self.save_agent(a, native_id=str(ev["conversationId"]))
        elif name == "PreInvocation" and ev.get("invocationNum", 0) == 0:
            a.in_turn, a.idle_since = True, 0.0
            if not a.dialog:
                self.set_state(a, "working")
            self.turn_started(a, str(ev.get("lastUserInput", "")))
        elif name in ("PreInvocation", "PostToolUse"):
            # agy runs on behind its trust prompt, so only the screen ends a dialog.
            if a.in_turn and not a.dialog:
                self.set_state(a, "working")
        elif name == "Stop":
            if not a.in_turn:
                return  # on_agy_screen ended it already
            if ev.get("terminationReason") == "ERROR":
                a.in_turn = False
                self.needs_you(a, f"error: {ev.get('error') or 'unknown'}")
                return
            self.replied(a, agy_reply(str(ev.get("transcriptPath") or "")))
            a.in_turn = False
            self.turn_ended(a)

    def on_agy_screen(self, a: AgentRun, screen: str, now: float) -> None:
        """agy's screen mid-turn, for what no hook of its says: a dialog that waits on
        you, or its input box, which an Esc leaves with no Stop."""
        why = agy_asks(screen)
        if why:
            a.dialog, a.idle_since = why, 0.0
            self.needs_you(a, why)
            return
        if a.dialog:  # you answered it
            a.dialog = ""
            if a.state == "needs_you":
                self.set_state(a, "working")
        if not any(m in screen for m in INPUT_MARKERS["agy"]):
            a.idle_since = 0.0
            return
        a.idle_since = a.idle_since or now
        if now - a.idle_since >= AGY_STOP_WAIT:  # its Stop would have come by now
            a.in_turn, a.idle_since = False, 0.0
            self.turn_ended(a)

    def turn_started(self, a: AgentRun, prompt: str) -> None:
        """A turn started, so a paste that this turn took is done. A turn that
        pantheon's Enter did not start is yours, by transport, and you may have entered
        a text pantheon pasted, even before a reopen. The hooks give the prompt, which
        then has the text's first line (it names the step or the post); with none, the
        turn counts as your Enter only if the paste showed in its input box while you
        were in. Another turn (one you queued, or a background task's) leaves the paste
        in the box, for check_paste to enter."""
        p, a.pasting = a.pasting, None
        if p is not None and p.entered:
            return
        if prompt:
            # Its reply is for you, unless you entered a post.
            self.save_agent(a, answering=False)
            item = next(
                (
                    o
                    for o in a.outbox
                    if clean_instructions(o.text, a.tool).split("\n", 1)[0] in prompt
                ),
                None,
            )
        else:
            item = p.item if p is not None and p.shown else None
        if item is not None:
            a.outbox = [o for o in a.outbox if o is not item]
            self.delivered(a, item)
        else:  # a prompt of your own
            self.more_work()
        if p is not None and item is not p.item:
            a.pasting = p  # it waits in the box until the agent is idle again

    def more_work(self) -> None:
        """You gave the team more work after its plan was done: the session is active,
        so pruning leaves it alone until it goes stale."""
        if self.state == "done":
            self.set_session_state("active")

    def turn_ended(self, a: AgentRun) -> None:
        answering = a.answering
        self.save_agent(a, answering=False)
        # Taken once, so no later turn takes this one's report.
        text, status = a.last_message, a.last_status
        a.last_message = a.last_status = ""
        step = self.open_step(a, sent_only=True)
        if step is None:  # a turn that a room post, or you by transport, started
            self.set_state(a, "idle")
            # An answer to a post goes in the room as a post; a reply to you, here.
            if text and not answering:
                self.event("note", "replied:\n" + text, a)
            return
        allowed = step["statuses"].split()
        if status not in allowed:
            # Only a turn with no status may wait for an answer: a wrong status means
            # the agent thinks it is done.
            if status or not a.posted:
                why = f"PANTHEON[status]: {status}, not " + " or ".join(allowed)
                why = why if status else "no PANTHEON[status]"
                self.needs_you(a, "ended its turn with " + why, remind=True)
                return
            # It asked the room, and the post that answers wakes it. Not "needs you",
            # since another agent may answer, so no Remind.
            if a.reason != ROOM_WAIT:
                self.event("note", "waits for an answer in the room", a)
            self.set_state(a, "idle", ROOM_WAIT)
            return
        self.db.execute(
            "UPDATE steps SET status = ?, report = ? WHERE id = ?",
            (status, text, step["id"]),
        )
        # And in a file, for the agents that take the next turns.
        write_private(Path(self.report_path(step)), text + "\n")
        a.outbox = [o for o in a.outbox if o.kind != "remind"]  # stale reminders
        self.set_state(a, "idle")
        self.event("report", step["name"], a, {"step": step["id"], "status": status})
        if note := self.loop_end(step["stage"], step["track"]):
            self.event("note", note)

    def loop_end(self, stage: str, track: int) -> str:
        """How a stage's loop ended on a step's lane, as a room line, or "" while it
        goes on (or the stage has no loop)."""
        st = self.mode.stages[stage]
        if st.loop is None:
            return ""
        lane = self.lane(stage, track)
        rows = self.db.execute(
            "SELECT s.track, s.status, s.round, a.name FROM steps s JOIN agents a"
            " ON a.id = s.agent_id WHERE s.stage = ? ORDER BY s.id",
            (stage,),
        ).fetchall()
        here = [r for r in rows if r["track"] == lane] if lane else rows
        start, busy, halted = walk_lane(self.mode, st, len(self.keys), lane, here)
        if start or busy:
            return ""
        label = turn_label(stage, 0, lane)
        if halted:
            return PROMPTS["halted"].format(
                label=label,
                agent=name_list([r["name"] for r in halted]),
                round=halted[0]["round"],
            )
        return PROMPTS["out_of_rounds"].format(label=label, n=st.loop.max_rounds)

    async def poll_panes(self, now: float) -> None:
        if not self.live_agents():
            return
        fmt = "#{session_name}\t#{pane_dead}\t#{pane_dead_status}\t#{window_activity}"
        try:
            out = await self.tmux.run("list-panes", "-a", "-F", fmt)
        except TmuxError:
            self.all_exited()
            return
        for line in out.splitlines():
            name, dead, status, activity = (line.split("\t", 3) + [""] * 4)[:4]
            a = self.agents.get(name)
            if a is None or a.state in ("new", "exited"):
                continue
            a.activity = float(activity) if activity.isdigit() else a.activity
            if dead == "1":
                # Keep its last words: a CLI that rejects a flag says why, then exits.
                screen = await self.tmux.run(
                    "capture-pane",
                    "-p",
                    "-J",
                    "-S",
                    "-40",
                    "-t",
                    pane(name),
                    check=False,
                )
                self.exited(a, status, last_lines(screen))
                continue
            # Once its turn started (no paste of pantheon's waits), and not while you
            # are in its screen.
            busy = a.in_turn and a.pasting is None and self.attached != a.name
            if a.tool == "agy" and busy:
                screen = await self.tmux.run(
                    "capture-pane", "-p", "-J", "-t", pane(name), check=False
                )
                self.on_agy_screen(a, screen, now)

    def exited(self, a: AgentRun, status: str, tail: str = "") -> None:
        self.read_hooks()  # a Stop that came just before the exit ends its turn first
        # A turn that never reached it goes back to the plan, which starts the agent
        # again, fresh, for it: while the session goes on, and only when the agent had
        # a report since it last started (a start that failed would only fail again).
        going = self.state in ("running", "needs_you")
        started = self.db.execute(
            "SELECT COALESCE(MAX(id), 0) FROM events WHERE agent_id = ? AND kind = 'start'",
            (a.id,),
        ).fetchone()[0]
        unsent = self.db.execute(
            "SELECT * FROM steps WHERE agent_id = ? AND status = 'open' AND sent = 0",
            (a.id,),
        ).fetchall()
        give_back = (
            going
            and unsent
            and self.db.execute(
                "SELECT 1 FROM events WHERE agent_id = ? AND kind = 'report' AND id > ?",
                (a.id, started),
            ).fetchone()
        )
        if give_back:
            self.db.execute(
                "DELETE FROM steps WHERE agent_id = ? AND status = 'open' AND sent = 0",
                (a.id,),
            )
        a.outbox, a.pasting = [], None
        self.save_agent(a, state="exited", reason="")
        note = "exited" + (f" with status {status}" if status else "")
        self.event("note", note + (f":\n{tail}" if tail else ""), a)
        for step in unsent if give_back else []:
            lane = self.lane(step["stage"], step["track"])
            label = turn_label(step["stage"], step["round"], lane)
            self.event("note", PROMPTS["given_back"].format(label=label), a)
        if self.open_step(a) is not None and going:
            self.set_session_state("stopped")
            self.event(
                "error",
                f"{a.name} exited during its turn, so the session stopped.",
                data={"resume": True},  # its room entry has a Resume button
            )
        self.refresh_session_state()

    def watchdogs(self, now: float) -> None:
        for a in self.agents.values():
            if (
                a.state == "starting"
                and a.launched
                and now - a.launched > STARTUP_TIMEOUT
            ):
                # A first prompt that waits in the outbox still goes once its input
                # box shows.
                queued = any(o.kind == "step" for o in a.outbox)
                self.needs_you(
                    a,
                    "no response since it started; a startup dialog may be waiting",
                    typeable=queued,
                )
            elif (
                a.state == "working"
                and a.tool in ("codex", "agy")
                and a.activity
                and now - a.activity > QUIET_TIMEOUT
            ):
                self.needs_you(
                    a, "no output for a minute; it may be stuck, or its turn failed"
                )

    # -- the room

    def write_room(self) -> None:
        """Write the room file that agents read: its newest entries, as text."""
        self.room_changed = False
        text = room_text(self.db, Path(self.scratch))
        write_private(Path(self.room_file), text)

    def post(self, sender: str, text: str) -> None:
        """Put a post in the room, and give it to every other agent that runs, which
        decides whether it needs to act. sender: an agent's name, or you (from
        pantheon's window alone)."""
        a = self.agents.get(sender)
        event_id = self.event("say", text, a, {"from": sender})
        if a is not None:
            self.save_agent(a, posted=True)
        if sender == "you":
            self.more_work()
        others = [b for b in self.live_agents() if b is not a]
        for b in others:
            b.outbox.append(self.post_item(b, event_id, sender, text))
        if not others:
            self.event("note", "No other agent runs now, so none got this post.")

    def post_item(self, a: AgentRun, event_id: int, sender: str, text: str) -> Outgoing:
        """Room post event_id as pantheon types it into agent a."""
        author = PROMPTS["user"] if sender == "you" else sender
        message = PROMPTS["post"].format(
            id=event_id, sender=author, text=text, room=self.room_again()
        )
        return Outgoing(message, "post", event_id=event_id)

    # -- driving the agents

    async def advance(self) -> None:
        if self.state not in ("running", "needs_you"):
            return
        unsent = self.db.execute(
            "SELECT * FROM steps WHERE status = 'open' AND sent = 0 ORDER BY id"
        ).fetchall()
        for step in unsent:
            if self.state in ("running", "needs_you"):
                await self.dispatch(step)
        if self.state not in ("running", "needs_you"):  # a dispatch stopped it
            return
        # Asked on each tick, so each track goes on as soon as its last turn is done.
        steps = self.db.execute("SELECT stage, track, status FROM steps ORDER BY id")
        turns = plan_turns(self.mode, len(self.keys), [tuple(r) for r in steps])
        if turns is None:
            await self.finish()
            return
        for stage, track, rnd, role in turns:
            a = self.agent_for(role, track)
            if self.open_step(a) is not None:  # a single agent: one track at a time
                continue
            if a.state == "exited" or self.renews(a):
                if a.name == self.attached:  # you are still in its screen
                    continue
                # It answers a post, or one is on its way to it: wait. (An exit
                # empties both.)
                if a.state not in ("idle", "exited") or a.pasting or a.outbox:
                    continue
                a = await self.restart(a)
            row = self.create_step(stage, track, rnd, a)
            if self.state in ("running", "needs_you"):
                await self.dispatch(row)

    def renews(self, a: AgentRun) -> bool:
        """Whether a fresh agent (see Agent.fresh) starts again for its next turn: it
        runs, and it started before. An agent pantheon never started runs nothing to
        end."""
        live = a.state not in ("new", "exited")
        return self.mode.agents[a.role].fresh and live and a.generation > 0

    async def restart(self, a: AgentRun) -> AgentRun:
        """Start an agent again, fresh, under its own name, for its next turn: one that
        exited after its last turn, or a fresh one, whose last run ends here. Its next
        prompt is a first prompt, which has the posts it missed."""
        if a.state != "exited":
            await self.end_panes("-s", "-t", f"={a.name}")
        await self.tmux.run("kill-session", "-t", f"={a.name}", check=False)
        return self.renew(a)

    def renew(self, a: AgentRun) -> AgentRun:
        """The record of an agent that starts again: a new generation, with nothing
        heard, posted, or asked yet, and none of the hooks its last run left."""
        self.db.execute("DELETE FROM hooks WHERE agent = ?", (a.name,))
        self.save_agent(
            a,
            state="new",
            reason="",
            native_id="",
            heard=0,
            posted=False,
            answering=False,
        )
        fresh = AgentRun(a.id, a.name, a.role, a.tool, a.model, a.effort, "", "new", "")
        # The model it ran stays known, so each generation does not name it again.
        fresh.generation, fresh.ran = a.generation, a.ran
        self.agents[a.name] = fresh
        n = a.generation + 1
        self.event(
            "note", f"starts again, fresh, for its next turn: generation {n}", fresh
        )
        return fresh

    def order(self, role: str) -> list[str]:
        """An agent's tools, track by track: -a's order, or with scramble, an order of
        its own. It comes from a hash, so it is the same each time the session opens,
        in any Python."""
        if not self.scramble:
            return list(self.keys)
        return sorted(
            self.keys,
            key=lambda k: hashlib.sha256(f"{self.slug}:{role}:{k}".encode()).digest(),
        )

    def key_for(self, role: str, track: int) -> str:
        """The roster key of role's instance on track: a multi agent's for the track,
        else --agent's pick, or the first of its order."""
        order = self.order(role)
        if self.mode.agents[role].multi:
            return order[track - 1]
        return self.picks.get(role, order[0])

    def team(self) -> list[tuple[str, str, int, str]]:
        """Every instance in the plan, started or not: (name, role, track, key)."""
        out = []
        for role, agent in self.mode.agents.items():
            for track in range(1, len(self.keys) + 1) if agent.multi else [0]:
                key = self.key_for(role, track)
                out.append((f"{role}-{key}", role, track, key))
        return out

    def agent_for(self, role: str, track: int) -> AgentRun:
        """role's instance on track, made for its first turn."""
        key = self.key_for(role, track)
        name = f"{role}-{key}"
        if name in self.agents:
            return self.agents[name]
        r = self.roster[key]
        cur = self.db.execute(
            "INSERT INTO agents (name, role, tool, model, effort) VALUES (?, ?, ?, ?, ?)",
            (name, role, r["tool"], r["model"], r["effort"]),
        )
        a = AgentRun(
            cur.lastrowid, name, role, r["tool"], r["model"], r["effort"], "", "new", ""
        )
        self.agents[name] = a
        return a

    def create_step(self, stage: str, track: int, rnd: int, a: AgentRun):
        """A turn for agent a, with its prompt, which goes in the room too. An agent
        keeps its context, so only the prompt it starts with has the intro."""
        st = self.mode.stages[stage]
        cur = self.db.execute(
            "INSERT INTO steps (agent_id, stage, round, track, statuses)"
            " VALUES (?, ?, ?, ?, ?)",
            (a.id, stage, rnd, track, " ".join(statuses_of(st, len(self.keys)))),
        )
        step_id = cur.lastrowid
        name = f"{step_id:02d}-{a.name}" + (f"-{rnd}" if rnd else "") + ".md"
        first = a.state == "new"
        parts = [PROMPTS["header"].format(step=step_id, agent=a.name)]
        if first:
            parts += self.intro(a)
        parts += self.turn_parts(a, stage, track, rnd)
        if not first:
            parts.append(self.room_again())
        parts.append(self.report_text(a, stage, rnd))
        parts.append(PROMPTS["step_end"].format(step=step_id))
        prompt = "\n\n".join(p for p in parts if p) + "\n"
        self.db.execute(
            "UPDATE steps SET name = ?, prompt = ? WHERE id = ?",
            (name, prompt, step_id),
        )
        # The label too: a turn given back (see exited) loses its step row.
        label = turn_label(stage, rnd, self.lane(stage, track))
        self.event("prompt", prompt, a, {"step": step_id, "label": label})
        return self.step(step_id)

    def turn_parts(self, a: AgentRun, stage: str, track: int, rnd: int) -> list[str]:
        """A turn's own part of its prompt: what to do, and the reports so far it may
        need. On a track, those are that track's and those of stages with no tracks
        (after a pick, every track's, since the picked build takes from the others);
        with no track, all of them, with how each loop ended."""
        st = self.mode.stages[stage]
        lane = self.lane(stage, track)
        label = turn_label(stage, rnd, lane)
        parts = [PROMPTS["turn"].format(label=label, goal=st.goal)]
        rows = self.db.execute(
            "SELECT s.id, s.stage, s.round, s.track, s.name, s.status,"
            " a.name AS agent, a.role FROM steps s JOIN agents a ON a.id = s.agent_id"
            " WHERE s.status != 'open' ORDER BY s.id"
        ).fetchall()
        lanes = {r["id"]: self.lane(r["stage"], r["track"]) for r in rows}
        rows.sort(key=lambda r: lanes[r["id"]])  # lane by lane, oldest first in each
        if lane and not after_pick(self.mode, stage):
            rows = [r for r in rows if lanes[r["id"]] in (0, lane)]
        if not rows:
            return parts
        # The reports that made it this agent's turn: on a track, the track's newest;
        # with no track, the stage's own newest, once it has one. Together, a turn is
        # each instance's report: the newest by another agent, and the rest of its
        # round and role.
        before = rows if lane else [r for r in rows if r["stage"] == stage]
        if st.together:
            before = [r for r in before if r["role"] != a.role]
        newest = max(before, key=lambda r: r["id"], default=None)
        came = [newest] if newest is not None and newest["agent"] != a.name else []
        if st.together and came:
            turn = (newest["round"], newest["role"])
            came = [r for r in before if (r["round"], r["role"]) == turn]
        if len(came) == 1:
            path = self.report_path(came[0])
            parts.append(PROMPTS["came_in"].format(agent=came[0]["agent"], path=path))
        elif came:
            each = [
                PROMPTS["came_in_line"].format(
                    agent=r["agent"], path=self.report_path(r), status=r["status"]
                )
                for r in came
            ]
            parts.append(PROMPTS["came_in_all"].format(lines="\n".join(each)))
        lines = []
        for i, r in enumerate(rows):
            lines.append(
                PROMPTS["work_line"].format(
                    label=turn_label(r["stage"], r["round"], lanes[r["id"]]),
                    agent=r["agent"],
                    path=self.report_path(r),
                    status=r["status"],
                )
            )
            after = rows[i + 1] if i + 1 < len(rows) else None
            group_ends = after is None or lanes[after["id"]] != lanes[r["id"]]
            group_ends = group_ends or after["stage"] != r["stage"]
            if (
                not lane
                and group_ends
                and (end := self.loop_end(r["stage"], r["track"]))
            ):
                lines.append(PROMPTS["work_note"].format(note=end))
        parts.append(PROMPTS["work"].format(lines="\n".join(lines)))
        return parts

    def report_text(self, a: AgentRun, stage: str, rnd: int) -> str:
        """What a turn's report is, and the PANTHEON[status] lines it may end with."""
        st = self.mode.stages[stage]
        statuses = statuses_of(st, len(self.keys))
        text = report_lines(st.agents[a.role], statuses)
        if st.loop:
            # Instances that take the turn at once each vote on the halt.
            each = st.together and self.mode.agents[a.role].multi and len(self.keys) > 1
            text += "\n\n" + PROMPTS["halt_together" if each else "halt"].format(
                until=st.loop.until, round=rnd, max=st.loop.max_rounds, agent=a.role
            )
        elif st.go_if:
            text += "\n\n" + PROMPTS["go"].format(go_if=st.go_if)
        elif st.pick:
            text += "\n\n" + PROMPTS["pick"].format(pick=st.pick)
        return text

    def intro(self, a: AgentRun) -> list[str]:
        """What an agent's first prompt starts with: who it is, its role, the task, the
        team, the plan, how to work, the facts, the room, and the posts made before it
        joined, since it gets only the later ones."""
        parts = [PROMPTS["who"].format(agent=a.name)]
        if a.generation:  # it ran before: this is its next generation
            parts.append(PROMPTS["again"].format(n=a.generation + 1, agent=a.name))
        parts.append(self.mode.agents[a.role].role)
        if self.task:
            parts.append(PROMPTS["task"].format(task=self.task))
        lines = []
        # A mode with no stage on tracks gives its agents none to name.
        tracked = any(on_tracks(self.mode, st) for st in self.mode.stages.values())
        for name, role, track, key in self.team():
            r = self.roster[key]
            on = PROMPTS["track"].format(track=track) if track and tracked else ""
            lines.append(
                PROMPTS["team_line"].format(
                    agent=name,
                    role=role,
                    track=on,
                    spec=spec_text(r["tool"], r["model"], r["effort"]),
                    you=PROMPTS["you"] if name == a.name else "",
                )
            )
        parts += [
            PROMPTS["team"].format(lines="\n".join(lines)),
            plan_text(self.mode),
            PROMPTS["how"],
        ]
        facts = PROMPTS["facts"].format(dir=self.workdir)
        if self.base:
            facts += PROMPTS["facts_git"].format(base=self.base)
        if self.base and self.pre_existing:
            facts += PROMPTS["facts_dirty"].format(files=name_list(self.pre_existing))
        parts.append(facts)
        parts.append(PROMPTS["room"].format(room=self.room_file))
        rows = self.db.execute(
            "SELECT text, data FROM events WHERE kind = 'say' ORDER BY id"
        ).fetchall()
        if not rows:
            return parts
        lines = []
        older = len(rows) - EARLIER_POSTS
        if older > 0:
            s = "" if older == 1 else "s"
            lines.append(PROMPTS["earlier_cut"].format(n=older, s=s))
        for r in rows[-EARLIER_POSTS:]:
            sender = json.loads(r["data"]).get("from", "you")
            author = PROMPTS["user"] if sender == "you" else sender
            text = "\n  ".join(r["text"].strip().splitlines())
            lines.append(PROMPTS["earlier_line"].format(sender=author, text=text))
        parts.append(PROMPTS["earlier"].format(posts="\n".join(lines)))
        return parts

    def room_again(self) -> str:
        return PROMPTS["room_again"].format(room=self.room_file)

    async def dispatch(self, step) -> None:
        a = self.agent_by_id(step["agent_id"])
        if a is None or a.state == "exited":
            self.set_session_state("stopped")
            self.event(
                "error",
                "The agent for the next turn is gone, so the session stopped.",
                data={"resume": True},
            )
            return
        if any(o.kind == "step" and o.step_id == step["id"] for o in a.outbox):
            return  # it waits to be typed
        item = Outgoing(step["prompt"], "step", step["id"])
        if a.state != "new":
            a.outbox.append(item)
        elif a.name not in self.launch_failed:
            await self.launch(a, item)

    async def launch(self, a: AgentRun, first: Outgoing) -> bool:
        """Start an agent. Its first prompt goes in its command line when the whole tmux
        command fits; else it waits in the outbox until the agent shows its input box."""
        try:
            if a.tool != "codex" and not a.native_id:  # codex's hook reports its own
                self.save_agent(a, native_id=str(uuid.uuid4()))
            argv, env = LAUNCHERS[a.tool](self, a)
            # tmux starts a pane even when the program is missing, and the pane just dies.
            exe = next((x for x in argv if os.path.isabs(x)), "")
            if exe and not os.access(exe, os.X_OK):
                raise OSError(f"{exe} cannot run")
            env = {
                "COLORTERM": "truecolor",
                "PANTHEON_DB": db_uri(db_path(self.slug)),
                "PANTHEON_AGENT": a.name,
                **env,
            }
            cols, rows = self.term_size()
            # tmux expands formats in -c, so a "#" in the path must be doubled.
            start_dir = self.workdir.replace("#", "##")
            cmd = ["new-session", "-d", "-s", a.name, "-x", str(cols), "-y", str(rows)]
            cmd += ["-c", start_dir]
            for k, v in env.items():
                cmd += ["-e", f"{k}={v}"]
            cmd = [tmux_arg(x) for x in [*cmd, *argv]]
            text = clean_instructions(first.text, a.tool)
            prompt = [tmux_arg(x) for x in prompt_args(a.tool, text)]
            # Measured here, since past the limit tmux fails with one of two messages.
            in_argv = sum(len(x.encode()) + 1 for x in cmd + prompt) <= TMUX_LIMIT
            await self.tmux.run(*cmd, *(prompt if in_argv else []))
        except (TmuxError, OSError, KeyError) as e:
            # The step stays unsent, so reopening the session after a fix tries again.
            self.launch_failed.add(a.name)
            self.event(
                "error",
                f"could not start {a.name} ({type(e).__name__}: {e}); fix it, then reopen this session",
                a,
            )
            return False
        self.started(a, first, in_argv, exe)
        return True

    def started(self, a: AgentRun, first: Outgoing, in_argv: bool, exe: str) -> None:
        """The agent runs now, from exe, with its first prompt in its command line
        (in_argv) or in its outbox."""
        # That prompt has the posts made before it, and the later ones follow it.
        heard = self.db.execute(
            "SELECT COALESCE(MAX(id), 0) FROM events WHERE kind = 'say' AND id <"
            " (SELECT id FROM events WHERE kind = 'prompt' AND agent_id = ?"
            " AND json_extract(data, '$.step') = ?)",
            (a.id, first.step_id),
        ).fetchone()[0]
        self.save_agent(a, state="starting", reason="", heard=heard)
        a.launched = time.time()
        a.generation += 1  # a reopen counts the start events
        # No hook of the new process came yet. A reopen before this start counts the
        # last run's hooks, which must not let pantheon type into a startup dialog.
        a.hooked = False
        spec = spec_text(a.tool, a.model, a.effort)
        self.event("start", f"joined ({spec}) from {short_home(exe)}", a)
        if in_argv:
            self.delivered(a, first)
        else:
            a.outbox.append(first)
        self.queue_posts(a)

    def queue_posts(self, a: AgentRun) -> None:
        """Queue each post after heard but the agent's own, oldest first."""
        rows = self.db.execute(
            "SELECT id, text, data FROM events WHERE kind = 'say' AND id > ?"
            " AND agent_id IS NOT ? ORDER BY id",
            (a.heard, a.id),
        )
        for r in rows:
            sender = json.loads(r["data"]).get("from", "you")
            a.outbox.append(self.post_item(a, r["id"], sender, r["text"]))

    def delivered(self, a: AgentRun, item: Outgoing) -> None:
        """The agent has item now, typed or in its command line."""
        self.save_agent(a, answering=item.kind == "post")
        if item.kind == "post":  # a reopen does not type it again
            self.save_agent(a, heard=item.event_id)
        if item.kind != "step":
            return
        self.db.execute("UPDATE steps SET sent = 1 WHERE id = ?", (item.step_id,))
        self.save_agent(a, posted=False)  # it posts about this step from now on

    def can_type(self, a: AgentRun, item: Outgoing) -> bool:
        """Whether pantheon may type item into the agent now."""
        if a.tool in ("claude", "ollama") and not a.hooked:
            return False  # its ❯ may mark a row in a startup dialog
        if a.state == "idle" or (a.state == "needs_you" and a.typeable):
            return True
        # A first prompt too long for the command line goes once the input box shows.
        return (
            a.state == "starting"
            and item.kind == "step"
            and self.open_step(a, sent_only=True) is None
        )

    async def send_pending(self, now: float) -> None:
        """Type each agent's next text: paste it, press Enter on a later tick once it
        shows, then watch for the turn it starts. Nothing here waits, so ticks stay
        short."""
        for a in list(self.agents.values()):
            p = a.pasting
            if self.attached == a.name:  # never type into an agent you are in
                if p is not None and not p.entered:
                    p.looked = True
                    # Kept once seen: your Enter empties the box before the turn's
                    # first hook comes.
                    if not p.shown:
                        screen = await self.tmux.run(
                            "capture-pane", "-p", "-J", "-t", pane(a.name), check=False
                        )
                        p.shown = paste_shown(a.tool, p.before, screen, p.text)
                continue
            if p is not None and p.entered:
                await self.check_turn(a, p, now)
            elif p is not None:
                await self.check_paste(a, p, now)
            elif a.outbox:
                await self.paste(a, now)

    async def paste(self, a: AgentRun, now: float) -> None:
        """Paste the agent's next text, once its input box shows."""
        item = a.outbox[0]
        if item.kind == "remind":
            step = self.step(item.step_id)
            if step is None or step["status"] != "open":
                a.outbox.pop(0)  # its step is done
                return
        if not self.can_type(a, item):
            return
        target = pane(a.name)
        screen = await self.tmux.run(
            "capture-pane", "-p", "-J", "-t", target, check=False
        )
        if not any(m in screen for m in INPUT_MARKERS[a.tool]):
            # agy says what its dialog asks; its trust prompt stays up even as its first
            # turn, from its command line, runs.
            if a.tool == "agy" and (why := agy_asks(screen)):
                self.needs_you(a, why, typeable=True)
                return
            # Never type on an unknown screen: a dialog would take the text, and some
            # take Enter as "No, exit". Past its start (the startup watchdog's), a
            # dialog that stays needs you.
            a.waiting_since = a.waiting_since or now
            if a.state != "starting" and now - a.waiting_since > 15:
                self.needs_you(
                    a,
                    "it has text in its input box, or a dialog open; transport to "
                    "clear it",
                    typeable=True,
                )
            return
        a.waiting_since = 0.0
        await self.leave_copy_mode(target)
        text = clean_instructions(item.text, a.tool)
        buffer = f"pantheon-{a.name}"
        await self.tmux.run("load-buffer", "-b", buffer, "-", data=text.encode())
        await self.tmux.run(
            "paste-buffer", "-p", "-r", "-d", "-b", buffer, "-t", target
        )
        a.pasting = Paste(item, text, screen, now)

    async def check_paste(self, a: AgentRun, p: Paste, now: float) -> None:
        """Press Enter once the paste shows in the input box, or ask you to look."""
        if not self.can_type(a, p.item):
            return  # a turn of yours runs, or it waits for you
        target = pane(a.name)
        screen = await self.tmux.run(
            "capture-pane", "-p", "-J", "-t", target, check=False
        )
        if paste_shown(a.tool, p.before, screen, p.text):
            if now - p.at < 0.1:  # an Enter so soon can count as a newline
                return
            await self.tmux.run("send-keys", "-t", target, "Enter")
            a.outbox = [o for o in a.outbox if o is not p.item]
            self.delivered(a, p.item)
            p.entered = now
            a.in_turn = True
            self.set_state(a, "working")
        elif now - p.at <= PASTE_TIMEOUT:
            return
        elif p.looked:
            a.pasting = None  # you were in since, and it is not in the box: again
        elif not p.missed:
            # A dialog took the paste (claude's ❯ marks a dialog's rows too), and would
            # take Enter as a choice. No second paste until you have looked: one into
            # a dialog that shows it would fill the dialog up.
            p.missed = True
            self.needs_you(
                a,
                "a dialog is open on its screen; transport to answer it",
                typeable=True,
            )

    async def check_turn(self, a: AgentRun, p: Paste, now: float) -> None:
        """After Enter, a turn starts (turn_started ends the wait). If none does, press
        Enter once more while the text still shows in the input box, then ask you."""
        if a.state != "working":  # another signal came first
            a.pasting = None
            return
        if now - p.entered < SUBMIT_TIMEOUT:
            return
        target = pane(a.name)
        screen = await self.tmux.run(
            "capture-pane", "-p", "-J", "-t", target, check=False
        )
        if not p.again and paste_shown(a.tool, p.before, screen, p.text):
            await self.tmux.run("send-keys", "-t", target, "Enter")
            p.again, p.entered = True, now
            return
        a.pasting = None
        self.needs_you(a, "what pantheon typed did not start a turn")

    async def leave_copy_mode(self, target: str) -> None:
        """A scroll during transport can leave tmux in copy mode, where keys only move
        in it."""
        mode = await self.tmux.run(
            "display-message", "-p", "-t", target, "#{pane_in_mode}", check=False
        )
        if mode.strip() == "1":
            await self.tmux.run("send-keys", "-t", target, "-X", "cancel", check=False)

    async def finish(self) -> None:
        """The plan is done: name the agents of the last stage's reports (each one's
        last on each track), or of the ones that stopped it, and the agents that never
        had a turn."""
        self.set_session_state("done")
        rows = self.db.execute(
            "SELECT s.stage, s.track, s.status, a.name AS agent FROM steps s"
            " JOIN agents a ON a.id = s.agent_id ORDER BY s.id"
        ).fetchall()
        stops = [r for r in rows if r["status"] == "stop"]
        last_stage = stops[0]["stage"] if stops else list(self.mode.stages)[-1]
        last = {(r["track"], r["agent"]): r for r in rows if r["stage"] == last_stage}
        shown = stops or list(last.values())
        agents = name_list(list(dict.fromkeys(r["agent"] for r in shown)))
        s = "" if len(shown) == 1 else "s"
        if stops:
            text = PROMPTS["stopped"].format(stage=last_stage, agents=agents, s=s)
        else:
            text = PROMPTS["done"].format(agents=agents, s=s)
        if not self.stop_when_done:
            text += PROMPTS["still_running"]
        unstarted = [
            name
            for name, *_ in self.team()
            if name not in self.agents or self.agents[name].state == "new"
        ]
        if unstarted:
            text += PROMPTS["never_started"].format(names=name_list(unstarted))
        self.event("done", text)
        if self.stop_when_done:
            await self.stop_agents()
            self.event("note", "Stopped the agents.")

    # -- actions from the UI

    def remind(self, a: AgentRun) -> None:
        step = self.open_step(a, sent_only=True)
        if step is None or any(o.kind == "remind" for o in a.outbox):
            return
        a.typeable = a.typeable or a.state == "needs_you"
        report = self.report_text(a, step["stage"], step["round"])
        # The note's room id ends the text, so an earlier reminder ends another way.
        note = self.event("note", f"You reminded {a.name} to finish step {step['id']}.")
        text = PROMPTS["remind"].format(
            step=step["id"], room=self.room_again(), report=report, id=note
        )
        a.outbox.append(Outgoing(text, "remind", step["id"]))

    def resume(self) -> None:
        """Go on with a stopped session: each turn that an agent that exited did not
        finish goes back to the plan, which starts the agent again, fresh, for it."""
        if self.state != "stopped" or not self.driving:
            return
        self.event("note", "You resumed the session.")
        for a in self.agents.values():
            if a.state != "exited":
                continue
            steps = self.db.execute(
                "SELECT * FROM steps WHERE agent_id = ? AND status = 'open'", (a.id,)
            ).fetchall()
            for step in steps:
                self.db.execute("DELETE FROM steps WHERE id = ?", (step["id"],))
                lane = self.lane(step["stage"], step["track"])
                label = turn_label(step["stage"], step["round"], lane)
                self.event("note", PROMPTS["retried"].format(label=label), a)
        self.set_session_state("running")
        self.refresh_session_state()

    async def fit(self, only: str = "") -> None:
        cols, rows = self.term_size()
        for a in self.live_agents():
            if not only or a.name == only:
                await self.tmux.run(
                    "resize-window",
                    "-t",
                    pane(a.name),
                    "-x",
                    str(cols),
                    "-y",
                    str(rows),
                    check=False,
                )

    async def stop_agents(self) -> None:
        """Stop every agent. The engine calls it, inside a tick, so no tick types into
        a dying agent or starts one, and no exit is news."""
        await self.end_panes("-a")
        await self.tmux.run("kill-server", check=False)
        self.tmux.socket.unlink(missing_ok=True)
        for a in self.live_agents():
            self.save_agent(a, state="exited", reason="")
        # The session file has it all.
        shutil.rmtree(self.scratch, ignore_errors=True)
        for path in private_files(self.slug):
            path.unlink(missing_ok=True)

    async def end_panes(self, *where: str) -> None:
        """End the programs in the panes that list-panes finds with where: TERM, and
        KILL for those still there 3 seconds later (a tool may ignore the hangup that
        kill-session sends)."""
        out = await self.tmux.run(
            "list-panes", *where, "-F", "#{pane_pid}\t#{pane_dead}", check=False
        )
        pids = [
            int(p)
            for p, _, dead in (line.partition("\t") for line in out.splitlines())
            if p.isdigit() and dead != "1"
        ]
        for pid in pids:
            signal_group(pid, signal.SIGTERM)
        for _ in range(30):
            if not any(signal_group(p, 0) for p in pids):
                break
            await asyncio.sleep(0.1)
        for pid in pids:
            signal_group(pid, signal.SIGKILL)

    def end(self) -> None:
        """End the session: the engine stops its agents on its next tick."""
        self.ending = True

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        if not self.foreign:
            try:
                self.db.execute(
                    "DELETE FROM lock WHERE id = 1 AND pid = ?", (os.getpid(),)
                )
            except sqlite3.Error:
                pass
        self.db.close()


# ------------------------------------------------------------------------------------- ui


def agent_color(a: AgentRun) -> str:
    if a.tool == "ollama":
        return OLLAMA_COLORS[
            int(hashlib.sha1(a.name.encode()).hexdigest(), 16) % len(OLLAMA_COLORS)
        ]
    return TOOL_COLORS.get(a.tool, "white")


def session_label(s: Session) -> Content:
    return Content(f"{SESSION_BADGES.get(s.state, '?')} {s.slug}")


def agent_title(a: AgentRun) -> str:
    """An agent's name, with its generation once it has started again: the same role
    instance, but not the same agent."""
    return a.name + (f" ({a.generation})" if a.generation > 1 else "")


def tab_label(a: AgentRun) -> Content:
    # An agent that waits for an answer in the room is idle, but not done.
    badge = "?" if a.reason == ROOM_WAIT else AGENT_BADGES.get(a.state, "?")
    return Content.assemble((f"{badge} {agent_title(a)}", agent_color(a)))


class Mirror(Static):
    """A live copy of an agent's screen. A short tab shows the screen's lower part."""

    DEFAULT_CSS = "Mirror { height: 1fr; overflow: hidden hidden; }"

    def set_screen(self, screen: str) -> None:
        lines = screen.split("\n")
        if lines and lines[-1] == "":
            lines.pop()
        height = self.size.height or len(lines)
        # Keep the bottom of a full screen, but the top of a short one.
        while len(lines) > height and not ANSI_RE.sub("", lines[-1]).strip():
            lines.pop()
        lines = lines[-height:]
        self.update(Text.from_ansi("\n".join(lines), no_wrap=True, overflow="crop"))


class AgentView(Vertical):
    DEFAULT_CSS = """
    AgentView { height: 1fr; }
    AgentView > .head { height: 1; background: $boost; }
    AgentView > .head > Static { width: 1fr; padding: 0 1; }
    """

    def __init__(self, session: Session, agent: str):
        super().__init__()
        self.session, self.agent = session, agent

    def compose(self) -> ComposeResult:
        with Horizontal(classes="head"):
            yield Static(classes="info")
            yield Button("Transport", compact=True, variant="primary")
        yield Mirror()

    def sync(self) -> None:
        a = self.session.agents[self.agent]
        parts = [
            a.role,
            a.tool,
            a.model,
            a.effort and "@" + a.effort,
            a.state.replace("_", " "),
        ]
        line = " · ".join(p for p in parts if p) + (f": {a.reason}" if a.reason else "")
        self.query_one(".info", Static).update(
            Content.assemble((agent_title(a), f"bold {agent_color(a)}"), " · ", line)
        )

    def on_button_pressed(self, event: Button.Pressed) -> None:
        event.stop()
        self.app.transport(self.session, self.agent)


class ActionEntry(Horizontal):
    """A room line with buttons, which go away once it is resolved."""

    DEFAULT_CSS = """
    ActionEntry { height: auto; background: $warning 20%; }
    ActionEntry.-resolved { background: transparent; }
    ActionEntry > Static { width: 1fr; }
    ActionEntry > Button { margin-left: 1; }
    """

    def __init__(
        self, line: Content, buttons: list[tuple[str, Callable[[], None]]], live: bool
    ):
        super().__init__(classes="" if live else "-resolved")
        self.text, self.buttons = line, buttons if live else []

    def compose(self) -> ComposeResult:
        yield Static(self.text)
        for i, (label, _) in enumerate(self.buttons):
            yield Button(
                label,
                compact=True,
                variant="primary" if i == 0 else "default",
                name=str(i),
            )

    def resolve(self) -> None:
        self.add_class("-resolved")
        self.query(Button).remove()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        event.stop()
        self.buttons[int(event.button.name or 0)][1]()


class Preview(Static):
    """The first lines of a collapsed entry. A click opens the rest."""

    def on_click(self) -> None:
        self.query_ancestor(Collapsible).collapsed = False


def long_entry(title: Content, body: str) -> Static | Collapsible:
    """title, then the body, of which a collapsed entry shows 3 lines, with no blank
    ones."""
    lines = [x for x in body.splitlines() if x.strip()]
    if not lines:
        return Static(title)
    return Collapsible(
        Preview(Text("\n".join(lines))),
        Static(Text(body.strip()), classes="full"),
        title=title,
        collapsed=True,
    )


class Room(VerticalScroll):
    # A long entry's header comes after its title's padding and ▶, 3 columns in, so
    # the other entries start there too, and every header lines up.
    DEFAULT_CSS = """
    Room { height: 1fr; padding: 0 1; }
    Room > * { height: auto; }
    Room > Static, Room > ActionEntry { padding-left: 3; }
    Room > Collapsible { border-top: none; padding: 0; }
    Room > Collapsible > Contents { padding: 0 0 0 3; }
    Room > Collapsible.-collapsed > Contents { display: block; }
    Room > Collapsible.-collapsed > Contents > .full { display: none; }
    Room Preview { display: none; }
    Room > Collapsible.-collapsed > Contents > Preview {
        display: block; max-height: 3; color: $text-muted;
    }
    """

    def on_mount(self) -> None:
        self.anchor()  # follow new entries until you scroll up


class SayBox(Input):
    """Where you post to the room. Escape leaves it, so [ and ] switch tabs again."""

    DEFAULT_CSS = "SayBox { background: $panel; }"

    def key_escape(self) -> None:
        self.screen.set_focus(None)


class SessionView(Vertical):
    DEFAULT_CSS = """
    SessionView { height: 1fr; }
    SessionView > TabbedContent { height: 1fr; }
    SessionView TabPane { padding: 0; height: 1fr; }
    """

    def __init__(self, session: Session, **kwargs):
        super().__init__(**kwargs)
        self.session = session
        # Only the newest entries, which are all the room keeps.
        row = session.db.execute(
            "SELECT id FROM events WHERE kind != 'hook' ORDER BY id DESC"
            " LIMIT 1 OFFSET ?",
            (ROOM_ENTRIES,),
        ).fetchone()
        self.last_event = row["id"] if row else 0
        # Fits every agent's name, so the room's columns line up.
        self.name_width = max(
            [12]
            + [len(f"{r}-{k}") for r in session.mode.agents for k in session.roster]
        )
        self.tabs: set[str] = set()
        self.needs: dict[str, ActionEntry] = {}  # agent -> its live "needs you" entry
        self.stop: ActionEntry | None = None  # the live entry of the session's stop

    def compose(self) -> ComposeResult:
        with TabbedContent():
            with TabPane("Room", id="room"):
                yield Room()
                if not self.session.foreign:  # read-only: no pantheon here drives it
                    yield SayBox(
                        placeholder="Say to the room; every agent gets it (ctrl+s)",
                        compact=True,
                    )

    def on_input_submitted(self, event: Input.Submitted) -> None:
        event.stop()
        text = event.value.strip()
        if not text:
            return
        if not self.session.driving:  # its posts would reach no agent
            self.app.notify("Another pantheon has this session now; post there.")
            return
        self.session.post("you", text)
        event.input.clear()

    def active_agent(self) -> str | None:
        active = self.query_one(TabbedContent).active
        return active.removeprefix("agent-") if active.startswith("agent-") else None

    def entry(self, row):
        s = self.session
        a = s.agent_by_id(row["agent_id"])
        style = f"bold {agent_color(a)}" if a else "bold"
        head = (
            (stamp(row["at"]) + " ", "dim"),
            (f"{a.name if a else 'pantheon':<{self.name_width}} ", style),
        )
        data = json.loads(row["data"] or "{}")
        kind, text = row["kind"], row["text"]
        if kind == "report":  # which reads like a post
            step = s.step(data.get("step", 0))
            first, _, rest = (step["report"] if step else "").partition("\n")
            status = (f"[{data.get('status', '')}] ", "bold")
            return long_entry(Content.assemble(*head, status, first), rest)
        if kind == "prompt" and a is not None:  # pantheon to the agent
            title = Content.assemble(
                head[0],
                (f"{'pantheon':<{self.name_width}} ", "bold"),
                "→ ",
                (a.name, style),
                f": {data.get('label', '')}",
            )
            return long_entry(title, text)
        if kind == "say":
            who = a.name if a else str(data.get("from") or "you")
            first, _, rest = text.partition("\n")
            title = Content.assemble(
                head[0], (f"{who:<{self.name_width}} ", style), first
            )
            return long_entry(title, rest)
        if kind == "needs" and a is not None:
            buttons = [("Transport", lambda: self.app.transport(s, a.name))]
            if data.get("remind"):
                buttons.append(("Remind", lambda: s.remind(a)))
            old = self.needs.pop(a.name, None)
            if old is not None:
                old.resolve()
            live = a.state == "needs_you" and not s.foreign
            entry = ActionEntry(
                Content.assemble(*head, ("needs you: ", "bold"), text), buttons, live
            )
            if live:
                self.needs[a.name] = entry
            return entry
        if kind == "error" and data.get("resume"):
            if self.stop is not None:
                self.stop.resolve()
            live = s.state == "stopped" and s.driving
            entry = ActionEntry(
                Content.assemble(*head, (text, "red")), [("Resume", s.resume)], live
            )
            self.stop = entry if live else None
            return entry
        styles = {"error": "red", "done": "bold green"}
        first, _, rest = text.partition("\n")
        return long_entry(Content.assemble(*head, (first, styles.get(kind, ""))), rest)

    async def sync(self) -> None:
        s = self.session
        tabs = self.query_one(TabbedContent)
        for a in list(s.agents.values()):  # the engine adds agents while this awaits
            if a.state != "new" and a.name not in self.tabs:
                self.tabs.add(a.name)
                label = tab_label(a)
                await tabs.add_pane(
                    TabPane(label, AgentView(s, a.name), id=f"agent-{a.name}")
                )
            if a.name in self.tabs:
                tab = tabs.get_tab(f"agent-{a.name}")
                label = tab_label(a)
                # Relabel only on change: it animates.
                if tab.label.plain != label.plain:
                    tab.label = label
                tab.set_class(a.state == "needs_you", "-needs")
        rows = s.db.execute(
            "SELECT * FROM events WHERE id > ? AND kind != 'hook' ORDER BY id LIMIT 200",
            (self.last_event,),
        ).fetchall()
        room = self.query_one(Room)
        for row in rows:
            self.last_event = row["id"]
            await room.mount(self.entry(row))
        extra = len(room.children) - ROOM_ENTRIES
        if extra > 0:
            await room.remove_children(room.children[:extra])
        for name, entry in list(self.needs.items()):
            if s.agents[name].state != "needs_you":
                entry.resolve()
                del self.needs[name]
        if self.stop is not None and (s.state != "stopped" or not s.driving):
            self.stop.resolve()
            self.stop = None
        for view in self.query(AgentView):
            view.sync()


class SwitcherScreen(ModalScreen):
    DEFAULT_CSS = """
    SwitcherScreen { align: center middle; }
    SwitcherScreen > Vertical {
        width: 110; max-width: 95%; height: auto; max-height: 85%;
        border: thick $accent; background: $surface; padding: 0 1;
    }
    SwitcherScreen OptionList { height: auto; max-height: 24; }
    """
    BINDINGS = [
        Binding("escape", "close", "Close"),
        Binding("n", "new", "New session"),
        Binding("d", "delete", "Delete session"),
    ]

    def __init__(self, open_sessions: dict[str, Session]):
        super().__init__()
        self.open_sessions = open_sessions

    def compose(self) -> ComposeResult:
        options = []
        for r in list_sessions():
            here = self.open_sessions.get(r["slug"])
            state = here.state if here else r["state"]
            badge = SESSION_BADGES.get(state, "?")
            if r["holder"] and not here:
                badge, state = "⋯", f"open in pid {r['holder']}"
            label = Text.assemble(
                f"{badge} ",
                (r["slug"], "bold"),
                f"  {r['mode']}  {state.replace('_', ' ')}  ",
                (first_line(r["task"], 50), "dim"),
            )
            options.append(
                Option(label, id=r["slug"], disabled=bool(r["holder"]) and not here)
            )
        with Vertical():
            yield Static(Text("Sessions", style="bold"))
            yield OptionList(*options) if options else Static("No sessions yet.")
            yield Static(
                Text(
                    "enter: open · n: new session · d: delete · esc: close", style="dim"
                )
            )

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        self.dismiss(event.option_id)

    def action_close(self) -> None:
        self.dismiss(None)

    def action_new(self) -> None:
        self.dismiss("+new")

    def action_delete(self) -> None:
        found = self.query(OptionList)
        option = found.first().highlighted_option if found else None
        if option is None or option.id is None:
            return
        if option.id in self.open_sessions:  # its engine runs in this window
            self.notify(f"{option.id} is open here; quit pantheon to delete it.")
            return
        question = (
            f"Delete {option.id} for good? Its agents stop, if they still run, and its "
            "record and reports go."
        )
        done = functools.partial(self.delete, option.id)
        self.app.push_screen(ConfirmScreen(question), done)

    async def delete(self, slug: str, yes: bool | None) -> None:
        if not yes:
            return
        if not await asyncio.to_thread(delete_session, slug):
            self.notify(
                f"{slug} is open in another pantheon, or busy.", severity="error"
            )
            return
        at = self.query_one(OptionList).highlighted or 0
        await self.recompose()
        for options in self.query(OptionList):  # none once the last session goes
            options.highlighted = min(at, options.option_count - 1)
            options.focus()


class NewSessionScreen(ModalScreen):
    DEFAULT_CSS = """
    NewSessionScreen { align: center middle; }
    NewSessionScreen > Vertical {
        width: 90; max-width: 95%; height: auto;
        border: thick $accent; background: $surface; padding: 0 1;
    }
    NewSessionScreen Horizontal { height: auto; }
    """
    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, yolo: bool):
        super().__init__()
        self.yolo = yolo

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Static(Text("New session", style="bold"))
            yield Select(
                [(name, name) for name in MODES],
                value="bakeoff",
                allow_blank=False,
                id="mode",
            )
            yield Input(
                placeholder="Task: text, an issue number, or an issue URL", id="task"
            )
            yield Input(
                placeholder="Agents: how many, or SPEC,SPEC,... (empty: the mode's default)",
                id="agents",
            )
            yield Select(
                [
                    ("Effort: the mode's level", "mode"),
                    ("Effort: each tool's own config", "default"),
                ]
                + [(f"Effort: {level}", level) for level in EFFORTS],
                value="mode",
                allow_blank=False,
                id="effort",
            )
            yield Input(value=os.getcwd(), placeholder="Start dir", id="dir")
            yield Checkbox(
                "yolo: start agents with permission checks off", self.yolo, id="yolo"
            )
            yield Checkbox(
                "stop when done: stop the agents once the plan is done", id="stop"
            )
            with Horizontal():
                yield Button("Start", variant="primary", id="start")
                yield Button("Cancel", id="cancel")

    def submit(self) -> None:
        effort = str(self.query_one("#effort", Select).value)
        self.dismiss(
            NewSession(
                mode=str(self.query_one("#mode", Select).value),
                task=self.query_one("#task", Input).value.strip(),
                dir=self.query_one("#dir", Input).value.strip(),
                yolo=self.query_one("#yolo", Checkbox).value,
                agents=self.query_one("#agents", Input).value.strip(),
                effort=None if effort == "mode" else effort_arg(effort),
                stop_when_done=self.query_one("#stop", Checkbox).value,
            )
        )

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "start":
            self.submit()
        else:
            self.dismiss(None)

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self.submit()

    def action_cancel(self) -> None:
        self.dismiss(None)


class ConfirmScreen(ModalScreen):
    DEFAULT_CSS = """
    ConfirmScreen { align: center middle; }
    ConfirmScreen > Vertical {
        width: 70; max-width: 95%; height: auto;
        border: thick $error; background: $surface; padding: 0 1;
    }
    ConfirmScreen Horizontal { height: auto; }
    """
    BINDINGS = [
        Binding("y", "yes", "Yes"),
        Binding("n", "no", "No"),
        Binding("escape", "no", "No"),
    ]
    AUTO_FOCUS = "#no"  # a stray Enter must not end or delete a session

    def __init__(self, question: str):
        super().__init__()
        self.question = question

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Static(Content(self.question))
            with Horizontal():
                yield Button("Yes (y)", variant="error", id="yes")
                yield Button("No (n)", id="no")

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")

    def action_yes(self) -> None:
        self.dismiss(True)

    def action_no(self) -> None:
        self.dismiss(False)


class PantheonApp(App):
    TITLE = "pantheon"
    CSS = """
    #top { height: 1; background: $primary 30%; }
    #sessions { width: 1fr; height: 1; }
    #sessions Underline { display: none; }
    #sessions Tab.-active { background: $primary 60%; text-style: bold; }
    #sessions Tab.-needs { background: $warning 50%; text-style: bold; }
    #header {
        width: auto; max-width: 60%; padding: 0 1;
        text-wrap: nowrap; text-overflow: ellipsis;
    }
    #yolo-badge { width: auto; padding: 0 1; background: $error; text-style: bold; display: none; }
    #yolo-badge.-on { display: block; }
    ContentSwitcher { height: 1fr; }
    ContentTab.-needs { background: $warning 50%; text-style: bold; }
    ContentTabs:focus ContentTab.-active { background: $surface; }
    """
    BINDINGS = [
        Binding("left_square_bracket", "tab(-1)", "Prev tab"),
        Binding("right_square_bracket", "tab(1)", "Next tab"),
        Binding("left_curly_bracket", "session(-1)", "Prev session", show=False),
        Binding("right_curly_bracket", "session(1)", "Next session", show=False),
        Binding("ctrl+t", "transport", "Transport"),
        Binding("ctrl+s", "say", "Say"),
        Binding("ctrl+o", "sessions", "Sessions"),
        Binding("ctrl+n", "new_session", "New"),
        Binding("ctrl+e", "end_session", "End session"),
        Binding("ctrl+q", "quit", "Quit", priority=True),
    ]

    def __init__(self, cfg: dict, slug: str | None, yolo_flag: bool | None = None):
        super().__init__()
        self.cfg, self.first_slug, self.yolo_flag = cfg, slug, yolo_flag
        self.yolo = setting(cfg, "yolo") if yolo_flag is None else yolo_flag
        self.sessions: dict[str, Session] = {}
        self.current = ""
        # The session, the agent, whether you came to answer it, and whether it ran.
        self.transporting: tuple[Session, str, bool, bool] | None = None
        self.detach_at = 0.0
        self.seen_needs: dict[str, int] = {}
        self.capturing = False

    def compose(self) -> ComposeResult:
        with Horizontal(id="top"):
            sessions = Tabs(id="sessions")
            sessions.can_focus = False  # ← and → stay with the agents' tabs
            yield sessions
            yield Static(id="header")
            badge = Static("⚠ YOLO", id="yolo-badge")
            badge.tooltip = "These agents run with their permission checks off."
            yield badge
        yield ContentSwitcher(id="views")
        yield Footer()

    async def on_mount(self) -> None:
        # get(): a THEME_ line that is commented out also means the default.
        colors = {
            "primary": globals().get("THEME_PRIMARY"),
            "accent": globals().get("THEME_ACCENT"),
        }
        overrides = {k: v for k, v in colors.items() if v is not None}
        self.register_theme(
            replace(BUILTIN_THEMES["textual-dark"], name="pantheon", **overrides)
        )
        self.theme = "pantheon"
        self.set_interval(0.25, self.refresh_ui)
        self.set_interval(0.125, self.refresh_mirror)
        if self.first_slug:
            await self.open_session(self.first_slug)
        else:
            self.action_sessions()

    def term_size(self) -> tuple[int, int]:
        # A row for tmux's status line, so going into an agent does not resize it.
        return max(self.size.width, 40), max(self.size.height - 1, 10)

    def current_view(self) -> SessionView | None:
        if not self.current:
            return None
        return self.query_one(ContentSwitcher).get_child_by_id(
            view_id(self.current), SessionView
        )

    async def open_session(self, slug: str) -> None:
        if slug not in self.sessions:
            try:
                s = Session(slug, self.cfg, self.term_size)
            except (Locked, ValueError, sqlite3.Error, OSError) as e:
                self.notify(str(e), severity="error")
                return
            self.sessions[slug] = s
            await self.query_one(ContentSwitcher).mount(
                SessionView(s, id=view_id(slug))
            )
            await self.query_one("#sessions", Tabs).add_tab(
                Tab(session_label(s), id=tab_id(slug))
            )
            if s.foreign:
                self.notify(
                    f"{slug} comes from another install, so it opens read-only."
                )
            else:
                self.run_worker(s.run(), group="engine", exit_on_error=False)
        self.show_session(slug)

    def show_session(self, slug: str) -> None:
        self.current = slug
        self.query_one(ContentSwitcher).current = view_id(slug)
        tabs = self.query_one("#sessions", Tabs)
        tabs.active = tab_id(slug)
        # Tabs scrolls to the tab it makes active, but a new tab has no place yet.
        tab = tabs.active_tab
        if tab is not None:
            self.call_after_refresh(tab.scroll_visible, animate=False, force=True)

    def on_tabs_tab_activated(self, event: Tabs.TabActivated) -> None:
        # A session's tab; each session's TabbedContent keeps its agents' tabs to itself.
        # Each switch posts one of these, so act only on the tab that is still active.
        if event.tabs.id != "sessions" or event.tab.id != event.tabs.active:
            return
        slug = next((x for x in self.sessions if tab_id(x) == event.tab.id), "")
        if slug and slug != self.current:
            self.show_session(slug)

    def action_session(self, step: int) -> None:
        slugs = list(self.sessions)
        if slugs:
            i = slugs.index(self.current) if self.current in slugs else 0
            self.show_session(slugs[(i + step) % len(slugs)])

    async def refresh_ui(self) -> None:
        if self.transporting:
            self.check_auto_return()
            return
        view = self.current_view()
        if view is not None:
            await view.sync()
        s = self.sessions.get(self.current)
        tabs = self.query_one("#sessions", Tabs)
        hidden = 0  # sessions that need you, with their tab out of view
        for slug, x in self.sessions.items():
            for tab in tabs.query(f"#{tab_id(slug)}").results(Tab):
                label = session_label(x)
                if tab.label_text != label.plain:
                    tab.label = label
                needs = slug != self.current and x.asks() > 0
                tab.set_class(needs, "-needs")
                if needs and not tabs.region.contains_region(tab.region):
                    hidden += 1
        # A long row of tabs can hide a marked one. First, so no ellipsis cuts it.
        pieces: list = [(f"⚑ {hidden} more · ", "bold") if hidden else ""]
        pieces.append("pantheon" if s is None else "")
        if s is not None:
            state = s.state.replace("_", " ") + (" (read-only)" if s.foreign else "")
            pieces += [f"{s.mode_name} · {state}"]
            agent, label = s.step_label()
            if agent is not None:
                pieces += [
                    " · ",
                    (agent.name, f"bold {agent_color(agent)}"),
                    f": {label}",
                ]
            elif label:
                pieces.append(f" · {label}")
        self.query_one("#header", Static).update(Content.assemble(*pieces))
        # The session in view decides: yolo is fixed when a session starts.
        self.query_one("#yolo-badge").set_class(s.yolo if s else self.yolo, "-on")
        for slug, x in self.sessions.items():
            n = x.asks()
            if slug != self.current and n > self.seen_needs.get(slug, 0):
                self.notify(f"{slug} needs you", severity="warning")
            self.seen_needs[slug] = n

    def check_auto_return(self) -> None:
        s, name, came_to_answer, was_live = self.transporting
        a = s.agents.get(name)
        gone = was_live and a is not None and a.state == "exited"
        moved_on = came_to_answer and a is not None and a.state != "needs_you"
        if not gone and not moved_on:
            self.detach_at = 0.0
            return
        now = time.time()
        if not self.detach_at:
            self.detach_at = now + 2  # unless it asks again right away
        elif now >= self.detach_at:
            self.detach_at = 0.0
            self.transporting = (s, name, False, False)
            self.run_worker(
                s.tmux.run("detach-client", "-s", f"={name}", check=False),
                exit_on_error=False,
            )

    async def refresh_mirror(self) -> None:
        if self.transporting or self.capturing:
            return
        view = self.current_view()
        name = view.active_agent() if view else None
        if view is None or name is None or view.session.agents[name].state == "new":
            return
        self.capturing = True
        try:
            screen = await view.session.tmux.run(
                "capture-pane", "-p", "-e", "-t", pane(name)
            )
        except (TmuxError, OSError):  # OSError: tmux itself went away
            return
        finally:
            self.capturing = False
        view.query_one(f"#agent-{name}").query_one(Mirror).set_screen(screen)

    def on_resize(self) -> None:
        if not self.transporting:
            for s in self.sessions.values():
                self.run_worker(s.fit(), group="fit", exit_on_error=False)

    def action_tab(self, step: int) -> None:
        view = self.current_view()
        if view is None:
            return
        tabs = view.query_one(TabbedContent)
        ids = [pane.id for pane in tabs.query(TabPane)]
        if ids:
            i = ids.index(tabs.active) if tabs.active in ids else 0
            tabs.active = ids[(i + step) % len(ids)]

    def action_transport(self) -> None:
        view = self.current_view()
        if view is None:
            self.notify("Open a session first (ctrl+o).")
            return
        s = view.session
        name = view.active_agent() or next(
            (a.name for a in s.agents.values() if a.state == "needs_you"), None
        )
        if name is None:
            self.notify("Pick an agent tab first.")
            return
        self.transport(s, name)

    def action_say(self) -> None:
        view = self.current_view()
        if view is None:
            self.notify("Open a session first (ctrl+o).")
            return
        if view.session.foreign:
            self.notify("This session is read-only here.")
            return
        view.query_one(TabbedContent).active = "room"
        view.query_one(SayBox).focus()

    @work(exclusive=True, group="transport", exit_on_error=False)
    async def transport(self, s: Session, name: str) -> None:
        a = s.agents.get(name)
        if a is None or a.state == "new":
            self.notify(f"{name} has not started.")
            return
        token = object()
        s.attached, s.attach_token = name, token  # first, so restart() leaves it alone
        error: BaseException | None = None
        try:
            try:  # restart() kills an exited agent's session, and a server can die
                await s.tmux.run("has-session", "-t", f"={name}")
            except TmuxError:
                self.notify(f"{name} has stopped, so its screen is gone.")
                return
            await s.fit(name)
            # resize-window pinned the window's size; let it follow your terminal there.
            await s.tmux.run(
                "set-option",
                "-w",
                "-t",
                pane(name),
                "window-size",
                "latest",
                check=False,
            )
            await s.tmux.run(
                "set-option", "-t", pane(name), "@color", agent_color(a), check=False
            )
            self.transporting = (s, name, a.state == "needs_you", a.state != "exited")
            self.detach_at = 0.0
            # batch_update keeps refreshes from piling up while Textual is suspended.
            with self.batch_update(), self.suspend():
                try:
                    proc = await asyncio.create_subprocess_exec(
                        *s.tmux.base, "attach-session", "-t", f"={name}", env=s.tmux.env
                    )
                    await proc.wait()
                except BaseException as e:
                    error = e  # Textual never comes back if one crosses suspend()
        except SuspendNotSupported:
            self.notify("This terminal cannot hand over to an agent.", severity="error")
        finally:
            if s.attach_token is token:  # else a newer press owns them
                self.transporting = None
                s.attached = ""
        await s.fit(name)
        if isinstance(error, asyncio.CancelledError):
            raise error
        if error is not None:
            self.notify(f"Transport failed: {error}", severity="error")

    def action_sessions(self) -> None:
        self.push_screen(SwitcherScreen(self.sessions), self.picked_session)

    async def picked_session(self, choice: str | None) -> None:
        if choice == "+new":
            self.action_new_session()
        elif choice:
            await self.open_session(choice)

    def action_new_session(self) -> None:
        if self.yolo_flag is None:  # you may have changed the setting since
            try:
                self.yolo = setting(load_config(), "yolo")
            except SystemExit as e:  # from die(): config.toml has a bad key
                self.notify(str(e.code), severity="error")
                return
        self.push_screen(NewSessionScreen(self.yolo), self.new_session)

    def new_session(self, req: NewSession | None) -> None:
        if req is not None:
            self.create_session(req)

    @work(exit_on_error=False)
    async def create_session(self, req: NewSession) -> None:
        self.notify(f"Starting {req.mode}...")
        try:
            self.cfg = load_config()  # a setting may have changed since the UI opened
        except SystemExit as e:  # from die(): config.toml has a bad key
            self.notify(str(e.code), severity="error")
            return
        try:
            # Pressing Start accepts a dirty work tree.
            slug, _ = await asyncio.to_thread(
                prepare, self.cfg, req, lambda files, note: True
            )
        except PrepError as e:
            self.notify(str(e), severity="error")
            return
        except Exception as e:  # bad JSON from gh, a full disk: say so, not nothing
            self.notify(f"{type(e).__name__}: {e}", severity="error")
            return
        await self.open_session(slug)

    def action_end_session(self) -> None:
        s = self.sessions.get(self.current)
        if s is None or s.state == "ended":
            self.notify("No open session to end.")
            return
        if not s.driving:  # its engine, which would stop the agents, does not run here
            where = "is read-only here" if s.foreign else "is open in another pantheon"
            self.notify(f"{s.slug} {where}.")
            return
        question = f"End {s.slug} and stop its agents? You can still read its room."
        self.push_screen(ConfirmScreen(question), lambda yes: yes and s.end())

    def on_unmount(self) -> None:
        for s in self.sessions.values():
            s.close()


def name_tmux_window(pane: str) -> bool:
    """Name your tmux window "pantheon", which tmux would call uv, unless you named it.
    Return whether it did, so the name can go back to tmux when pantheon quits."""
    rc, out, _ = run_cmd(["tmux", "display", "-p", "-t", pane, "#{automatic-rename}"])
    if rc != 0 or out.strip() != "1":
        return False
    return run_cmd(["tmux", "rename-window", "-t", pane, "pantheon"])[0] == 0


def run_ui(cfg: dict, slug: str | None, yolo_flag: bool | None = None) -> int:
    app = PantheonApp(cfg, slug, yolo_flag)
    pane = os.environ.get("TMUX_PANE", "")
    named = bool(pane) and name_tmux_window(pane)
    try:
        app.run()
    finally:
        if named:
            run_cmd(["tmux", "set", "-w", "-t", pane, "automatic-rename", "on"])
    for s in app.sessions.values():
        if s.state != "ended" and s.live_agents() and not s.foreign:
            print(
                f"pantheon: {s.slug} still has agents running; reopen it with: pantheon session {s.slug}"
            )
    return app.return_code or 0


# --------------------------------------------------------------------------------- update


def program_path() -> Path:
    return Path(__file__).absolute()


def in_upstream_repo(path: Path) -> bool:
    """Whether the real file (links followed) is in a clone of UPSTREAM_REPO, through
    any host name (an SSH alias, GitHub's port 443). A fork has another owner, so it
    still gets updates from upstream."""
    real = os.path.dirname(os.path.realpath(path))
    rc, out, _ = git(real, "remote", "get-url", "origin")
    if rc:
        return False
    try:
        _, repo = parse_remote(out)
    except PrepError:
        return False
    return repo.lower() == UPSTREAM_REPO


def version_key(version: str) -> tuple[int, ...]:
    return tuple(int(n) for n in re.findall(r"\d+", version))


def upstream_version(text: str) -> str:
    m = re.search(r'^VERSION = "([^"\n]+)"', text, re.M)
    return m[1] if m else ""


def fetch_upstream() -> str:
    """GitHub's pantheon, checked so a bad download never replaces a working one."""
    req = urllib.request.Request(
        UPSTREAM_URL, headers={"User-Agent": f"pantheon/{VERSION}"}
    )
    with urllib.request.urlopen(req, timeout=5) as r:
        data = r.read(8_000_000)
        # read(n) does not raise when the body stops short.
        if getattr(r, "length", None):
            raise ValueError("the download was cut off")
    text = data.decode("utf-8")
    if not text.startswith("#!/usr/bin/env -S uv run --script"):
        raise ValueError("that is not a pantheon program")
    if '\nif __name__ == "__main__":\n    sys.exit(main())' not in text:
        raise ValueError("it was cut off, or it has no main guard")  # a cut can compile
    if not upstream_version(text):
        raise ValueError("it has no VERSION")
    compile(text, UPSTREAM_URL, "exec")  # a broken file fails here
    write_private(UPSTREAM_CACHE, text)
    return text


def offline(e: BaseException) -> bool:
    """A network that is down or slow, which a start should not complain about."""
    if isinstance(e, urllib.error.HTTPError):
        return False
    e = getattr(e, "reason", e)
    return isinstance(e, OSError) and not isinstance(e, ssl.SSLError)


def cached_upstream() -> tuple[str, bool]:
    """GitHub's pantheon from a cache at most UPSTREAM_MAX_AGE old; True if just fetched."""
    try:
        if time.time() - UPSTREAM_CACHE.stat().st_mtime < UPSTREAM_MAX_AGE:
            return UPSTREAM_CACHE.read_text(encoding="utf-8"), False
    except (OSError, ValueError):
        pass
    try:
        UPSTREAM_CACHE.touch()  # first, so a failed or stopped check waits out the age too
    except OSError:
        return "", False
    got: list = []

    def fetch() -> None:
        try:
            got.append(fetch_upstream())
        except FETCH_ERRORS as e:
            got.append(e)

    # urlopen's timeout is per socket call, and DNS has none, so cap the wait here.
    worker = threading.Thread(target=fetch, daemon=True)
    worker.start()
    worker.join(UPSTREAM_WAIT)
    if got and isinstance(got[0], str):
        return got[0], True
    if got and not offline(got[0]):  # at most once per max age, thanks to the touch
        print(f"pantheon: could not check GitHub for a newer version ({got[0]})")
    try:
        return UPSTREAM_CACHE.read_text(encoding="utf-8"), False
    except (OSError, ValueError):
        return "", False


def install_program(text: str) -> Path:
    """Replace this program in one step and keep its mode. Through a link it writes the
    real file, so a fork's checkout gets the new version and the link stays."""
    path = Path(os.path.realpath(program_path()))
    mode = stat.S_IMODE(path.stat().st_mode)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise
    return path


def cmd_update() -> int:
    path = program_path()
    if in_upstream_repo(path):
        die(f"{os.path.realpath(path)} is in a clone of {UPSTREAM_REPO}; use git pull")
    try:
        text = fetch_upstream()
    except FETCH_ERRORS as e:
        die(f"could not get pantheon from GitHub: {e}")
    if text == read_text(os.path.realpath(path)):
        print(f"pantheon {VERSION} is up to date.")
        return 0
    try:
        written = install_program(text)
    except OSError as e:
        die(f"could not replace {path}: {e}")
    print(f"pantheon: updated {written} from {VERSION} to {upstream_version(text)}")
    return 0


def offer_update(argv: list[str]) -> None:
    """Offer a newer pantheon from GitHub: ask once per fetch, then only remind."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return  # a script cannot answer
    path = program_path()
    if in_upstream_repo(path):
        return  # git updates it
    text, fresh = cached_upstream()
    new = upstream_version(text)
    if not new or version_key(new) <= version_key(VERSION):
        return
    if not fresh:
        print(f"pantheon: {new} is out (you have {VERSION}); run: pantheon update")
        return
    real = os.path.realpath(path)
    answer = ask(f"pantheon {new} is out (you have {VERSION}). Replace {real}? [y/N] ")
    if not answer.lower().startswith("y"):
        return
    try:
        install_program(text)
    except OSError as e:
        print(f"pantheon: could not update {path}: {e}")
        return
    print(f"pantheon: updated to {new}")
    if not os.access(path, os.X_OK):
        sys.exit("pantheon: run it again to use the new version")
    os.execv(path, [str(path), *argv])


# ------------------------------------------------------------------------------------ cli


def confirm_dirty(files: list[str], note: str) -> bool:
    print("pantheon: the work tree already has changes:")
    for name in files[:20]:
        print(f"  {name}")
    if len(files) > 20:
        print(f"  ... and {len(files) - 20} more")
    print(note)
    return sys.stdin.isatty() and ask("Continue? [y/N] ").lower().startswith("y")


def cmd_sessions(prune: int | None) -> None:
    rows = list_sessions()
    if prune is not None:
        for r in rows:
            # A finished session goes after prune days; any session, once stale. An
            # active one (you gave its team more work after its plan) is not finished,
            # nor is a stopped one, which Resume goes on with.
            idle = idle_days(r["last"])
            finished = r["state"] in ("done", "ended")
            if r["holder"] or not (idle > STALE_DAYS or (finished and idle > prune)):
                continue
            # One opened since the list, or busy, waits for the next prune.
            if delete_session(r["slug"]):
                print(f"deleted {r['slug']}")
        rows = list_sessions()
    if not rows:
        print("No sessions yet. Start one with: pantheon start MODE TASK")
        return
    print("pantheon: sessions, newest first, with the time since each one's last entry")
    for r in rows:
        state = r["state"].replace("_", " ") + (
            f" (open in pid {r['holder']})" if r["holder"] else ""
        )
        if idle_days(r["last"]) > STALE_DAYS:
            state += " (stale)"
        task = first_line(r["task"], 50)
        print(
            f"{r['slug']:<42} {r['mode']:<10} {state:<26} {age(r['last']):>4}  {short_home(r['dir'])}  {task}"
        )


def cmd_show(slug: str, name: str) -> None:
    path = db_path(slug)
    db = None
    try:
        db = connect(path)
        version = db.execute("PRAGMA user_version").fetchone()[0]
        if version != SCHEMA_VERSION:  # as Session.check_file: no code reads old files
            raise sqlite3.DatabaseError(
                f"it has schema version {version}; this pantheon reads {SCHEMA_VERSION}"
            )
        s = db.execute("SELECT * FROM session").fetchone()
        if s is None:
            raise sqlite3.DatabaseError("it has no session record")
        steps = db.execute(
            "SELECT s.*, a.name AS agent FROM steps s JOIN agents a ON a.id = s.agent_id ORDER BY s.id"
        ).fetchall()
        if name:
            done = [r for r in steps if r["status"] != "open"]
            hits = [r for r in done if r["name"] in (name, f"{name}.md")] or [
                r for r in done if name in r["name"]
            ]
            if len(hits) != 1:
                names = ", ".join(r["name"] for r in done) or "none yet"
                die(f"{name!r} matches {len(hits)} reports; this session has: {names}")
            sys.stdout.write(hits[0]["report"].rstrip("\n") + "\n")
            return
        room = room_entries(db, run_dir_of(path), full=True)
        roster = db.execute("SELECT * FROM roster WHERE listed = 1 ORDER BY id")
        tools = [spec_text(r["tool"], r["model"], r["effort"]) for r in roster]
    except sqlite3.Error as e:  # a file from another pantheon, say
        die(f"cannot read {slug} ({e})")
    finally:
        if db is not None:
            db.close()
    print(
        f"{slug} · {s['mode']} · {s['state'].replace('_', ' ')} · {short_home(s['dir'])}"
    )
    if s["source"]:
        print(s["source"])
    print("tools: " + ", ".join(tools))
    names = max([12] + [len(r["name"]) for r in steps])
    width = max([12] + [len(r["agent"]) for r in steps])
    if steps:
        print("\nReports (pantheon show SLUG NAME prints one):")
        for r in steps:
            print(f"  {r['name']:<{names}} {r['agent']:<{width}} {r['status']}")
    print("\nRoom:")
    for entry in room:
        print(textwrap.indent(entry, "  "))


def run_dir_of(path: Path) -> Path:
    """A session file's run dir: HOME/sessions/<slug>.sqlite3 -> HOME/run/<slug>."""
    return path.parent.parent / "run" / path.stem


def room_entries(
    db: sqlite3.Connection, run_dir: Path, last: int = 0, full: bool = False
) -> list[str]:
    """The room as text, oldest first: an entry for each event but hooks, with a
    report's first line and the file that holds all of it, and a prompt by its step;
    or with full, both in full. last: only the last N entries."""
    events = db.execute(
        "SELECT e.*, a.name AS agent FROM events e LEFT JOIN agents a ON a.id = e.agent_id"
        " WHERE e.kind != 'hook' ORDER BY e.id DESC LIMIT ?",
        (last if last > 0 else -1,),
    ).fetchall()
    steps = {r["id"]: r for r in db.execute("SELECT id, name, report FROM steps")}
    out = []
    for e in reversed(events):
        data = json.loads(e["data"] or "{}")
        who, kind = e["agent"] or "pantheon", e["kind"]
        first, _, rest = e["text"].partition("\n")
        head = f"{who}: {first}"
        if kind == "report":  # a long one would push the rest of the room out
            step = steps.get(data.get("step"))
            first, _, rest = (step["report"] if step else "").partition("\n")
            head = f"{who} reports [{data.get('status', '')}]: {first}"
            if rest.strip() and not full:
                rest = str(run_dir / step["name"])
        elif kind == "prompt":  # each first prompt holds the task: too long for agents
            what = f"{data.get('label', '')} (step {data.get('step')})"
            head, rest = f"pantheon → {who}: {what}", e["text"] if full else ""
        elif kind == "say":  # agents read this too, so you are the user
            author = e["agent"] or data.get("from", "you")
            head = f"{PROMPTS['user'] if author == 'you' else author} says: {first}"
        elif kind == "needs":
            head = f"{who}: needs you: {first}"
        body = [f"    {x}" if x.strip() else "" for x in rest.strip("\n").splitlines()]
        out.append("\n".join([f"#{e['id']} {stamp(e['at'])} {head}", *body]))
    return out


def room_text(db: sqlite3.Connection, run_dir: Path) -> str:
    """The room file: the newest entries that fit in ROOM_CHARS, oldest first, after a
    line that says how many it left out."""
    kept, size = [], 0
    for entry in reversed(room_entries(db, run_dir, ROOM_ENTRIES)):
        if size + len(entry) + 1 > ROOM_CHARS:
            if not kept:  # one entry is too long on its own
                kept.append(entry[: ROOM_CHARS - 2] + " …")
            break
        kept.append(entry)
        size += len(entry) + 1
    total = db.execute("SELECT COUNT(*) FROM events WHERE kind != 'hook'").fetchone()[0]
    left = total - len(kept)
    cut = PROMPTS["room_cut"].format(n=left, y="y" if left == 1 else "ies")
    return "".join(line + "\n" for line in ([cut] if left else []) + kept[::-1])


def mode_description(mode: Mode) -> str:
    width = max(map(len, mode.agents))
    lines = [mode.help, "", "agents:"]
    for name, agent in mode.agents.items():
        each = "one for each tool" if agent.multi else "one"
        fresh = ", started again, fresh, for each of its turns" if agent.fresh else ""
        lines.append(f"  {name:<{width}}  {each}{fresh}")
    lines += ["", "the plan, as the agents read it:"]
    for para in plan_text(mode).split("\n"):
        indent = "     " if para[:1].isdigit() else "  "  # under a stage's text
        lines.append(
            textwrap.fill(para, 80, initial_indent="  ", subsequent_indent=indent)
        )
    level = (
        f"Effort level: {mode.effort}."
        if mode.effort
        else "No effort level: each tool's own config decides."
    )
    about = (
        f"{level} -a N takes the first N tools in the agents setting that can run here "
        f"(default: {count_help(mode)}). Each multi agent has an instance for each of "
        "them, in that order, and each single agent takes the first, unless the "
        "scramble setting gives each agent a random order. SPEC is "
        "TOOL[:MODEL][@EFFORT], where TOOL is claude, codex, agy, or ollama. "
        "pantheon agents MODE shows what it would pick here."
    )
    return "\n".join(lines) + "\n\n" + textwrap.fill(about, 80)


def mode_problems() -> list[str]:
    """Mistakes in MODES that would break pantheon in ways hard to trace: names go in
    tmux targets and file names, a stage's agents must be the mode's, a loop's
    statuses leave no room for go_if's, and a pick is one turn's."""
    out = []
    for name, mode in MODES.items():
        for part in [*mode.agents, *mode.stages]:
            if not MODE_NAME_RE.fullmatch(part):
                out.append(f"{name}: {part!r} needs lowercase letters and '-'")
        for stage, st in mode.stages.items():
            missing = [role for role in st.agents if role not in mode.agents]
            out += [
                f"{name}.{stage}: the mode has no agent {role!r}" for role in missing
            ]
            if st.loop and st.go_if:
                out.append(f"{name}.{stage}: a stage with a loop can't have go_if")
            multi = any(
                mode.agents[role].multi for role in st.agents if role not in missing
            )
            if st.pick and (st.loop or st.go_if or len(st.agents) != 1 or multi):
                out.append(
                    f"{name}.{stage}: a stage that picks a track has one single agent, "
                    "and no loop or go_if"
                )
    return out


def add_modes(
    parser: argparse.ArgumentParser, common: argparse.ArgumentParser, start: bool
) -> dict[str, argparse.ArgumentParser]:
    """parser's MODE argument, for start or a test scenario: a parser for each mode,
    with its options; for start, help MODE too."""
    modes = parser.add_subparsers(
        dest="mode", metavar="MODE", title="modes", required=True
    )
    out = {}
    for name, mode in MODES.items():
        out[name] = modes.add_parser(
            name,
            parents=[common],
            help=mode.help,
            description=mode_description(mode),
            formatter_class=argparse.RawDescriptionHelpFormatter,
            allow_abbrev=False,  # so --agent never stands for --agents
        )
        add_mode_options(out[name], mode, start)
    if start:
        modes.add_parser(
            "help", help="show the modes, or one mode's options"
        ).add_argument("topic", nargs="?", choices=list(MODES), metavar="MODE")
    return out


def add_mode_options(p: argparse.ArgumentParser, mode: Mode, start: bool) -> None:
    """A mode's options: start's, or a test scenario's, which makes its own dir and
    task."""
    if start:
        p.add_argument(
            "-C", "--dir", default=".", metavar="DIR", help="start in DIR (default: .)"
        )
    p.add_argument(
        "-a",
        "--agents",
        default="",
        metavar="N|SPEC,...",
        help=f"how many tools, or which ones in order (default: {count_help(mode)})",
    )
    singles = [r for r, agent in mode.agents.items() if not agent.multi]
    p.add_argument(
        "--agent",
        action="append",
        default=[],
        metavar="ROLE=SPEC",
        help="the tool for one single agent: "
        + (", ".join(singles) or "none in this mode"),
    )
    p.add_argument(
        "--effort",
        choices=[*EFFORTS, "default"],
        metavar="LEVEL",
        help=f"an effort level ({', '.join(EFFORTS)}), or default for the tools' own "
        f"config (this mode: {mode.effort or 'default'})",
    )
    p.add_argument(
        "--stop-when-done",
        action="store_true",
        help="stop the agents once the plan is done: a one-shot run (else they keep "
        "running, for more work in the room)",
    )
    if start:
        p.add_argument(
            "task",
            nargs="+" if mode.needs_task else "*",
            metavar="TASK",
            help="free text, an issue number (123, #123), or an issue URL",
        )


def build_parser() -> tuple[argparse.ArgumentParser, dict]:
    # -y works before or after the command; SUPPRESS keeps a subcommand from resetting it.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "-y",
        "--yolo",
        action=argparse.BooleanOptionalAction,
        default=argparse.SUPPRESS,
        help="start agents with permission checks off, or on (default: the yolo setting)",
    )
    parser = argparse.ArgumentParser(
        prog="pantheon",
        parents=[common],
        description="Run a team of AI coding agents that work together, in one terminal.",
        epilog="With no command, pantheon opens the session switcher.",
    )
    sub = parser.add_subparsers(dest="command", metavar="COMMAND", title="commands")
    subs = {}
    subs["start"] = sub.add_parser(
        "start",
        parents=[common],
        help="start a session",
        description="Start a session in one of these modes.",
    )
    subs.update(add_modes(subs["start"], common, start=True))  # for help MODE
    subs["test"] = sub.add_parser(
        "test",
        help="run pantheon's unit tests, or try a mode on a toy task",
        description="Run pantheon's unit tests, or try a mode on a toy task: a "
        "scenario starts a session of the mode on its task, in a new, empty git repo in "
        "a temp dir, which stays after pantheon exits.",
    )
    scenarios = subs["test"].add_subparsers(
        dest="scenario", metavar="SCENARIO", title="scenarios", required=True
    )
    unit = scenarios.add_parser(
        "unit",
        help="run pantheon's own unit tests, which start no agents",
        description="Run pantheon's own unit tests. They start no agents and no tmux, "
        "and keep their files in a scratch dir, apart from yours.",
    )
    unit.add_argument("-v", "--verbose", action="store_true", help="name each test")
    unit.add_argument(
        "-k",
        dest="patterns",
        action="append",
        default=[],
        metavar="PATTERN",
        help="run only the tests whose names match PATTERN, as unittest's -k does",
    )
    for name, task in SCENARIOS.items():
        about = (
            "Start a session of MODE on this task, in a new, empty git repo in a temp "
            "dir, which stays after pantheon exits:"
        )
        p = scenarios.add_parser(
            name,
            parents=[common],
            help=f"try a mode on the {name} task",
            description=textwrap.fill(about, 80) + "\n\n" + textwrap.fill(task, 80),
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        add_modes(p, common, start=False)
    subs["session"] = sub.add_parser("session", help="open a session")
    subs["session"].add_argument(
        "slug", metavar="SLUG", help="the session (a unique part is enough)"
    )
    subs["sessions"] = sub.add_parser("sessions", help="list sessions")
    subs["sessions"].add_argument(
        "--prune",
        type=int,
        metavar="DAYS",
        help="delete finished sessions with no room entry for DAYS days, and stale "
        f"ones: any with none for {STALE_DAYS} days (an open one stays)",
    )
    subs["show"] = sub.add_parser(
        "show", help="print a session's room, or one of its reports"
    )
    subs["show"].add_argument(
        "slug", metavar="SLUG", help="the session (a unique part is enough)"
    )
    subs["show"].add_argument(
        "name",
        nargs="?",
        default="",
        metavar="NAME",
        help="a report's file name, or a unique part of it",
    )
    subs["config"] = sub.add_parser(
        "config",
        help="show or change the settings in config.toml",
        description="Show or change the settings in config.toml.",
        epilog="settings:\n"
        + "\n".join(f"  {k:<17} {v.help}" for k, v in SETTINGS.items()),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    actions = subs["config"].add_subparsers(
        dest="action", metavar="ACTION", required=True
    )
    actions.add_parser("show", help="list the settings, with yours marked")
    p = actions.add_parser(
        "set",
        help="change a setting; agents takes TOOL,TOOL,... and ollama_models "
        "LEVEL=MODEL,...",
    )
    p.add_argument("key", metavar="KEY")
    p.add_argument("value", metavar="VALUE")
    p = actions.add_parser("unset", help="put settings back to their defaults")
    p.add_argument("keys", nargs="+", metavar="KEY")
    subs["agents"] = sub.add_parser(
        "agents",
        help="show the agents and models a mode would get here",
        description="Show what pantheon start MODE would pick here, with no session: "
        "each agent's tools, track by track, the flags each tool gets, and what each "
        "tool's own config says about the rest. With no MODE: the tools, and the effort "
        "levels.",
    )
    p = subs["agents"]
    p.add_argument("mode", nargs="?", choices=list(MODES), metavar="MODE")
    p.add_argument("-C", "--dir", default=".", metavar="DIR", help="as for start")
    p.add_argument(
        "-a", "--agents", default="", metavar="N|SPEC,...", help="as for start"
    )
    p.add_argument(
        "--agent",
        action="append",
        default=[],
        metavar="ROLE=SPEC",
        help="as for start",
    )
    p.add_argument(
        "--effort",
        choices=[*EFFORTS, "default"],
        metavar="LEVEL",
        help="one effort level, or default (default: show each)",
    )
    subs["tools"] = sub.add_parser(
        "tools", help="show the claude, codex, agy, and tmux found now"
    )
    subs["update"] = sub.add_parser(
        "update", help="replace this program with the newest one on GitHub"
    )
    subs["help"] = sub.add_parser("help", help="show help for a command")
    subs["help"].add_argument(
        "topic", nargs="?", metavar="COMMAND", help="a command or a mode"
    )
    return parser, subs


def main(argv: list[str] | None = None) -> int:
    # First: each mode's help is made from the mode.
    problems = mode_problems()
    if problems:
        die("MODES has mistakes: " + "; ".join(problems))
    parser, subs = build_parser()
    args = parser.parse_args(argv)
    command, yolo_flag = args.command, getattr(args, "yolo", None)
    if command == "help":
        (subs.get(args.topic) or parser).print_help()
        return 0
    if command == "start" and args.mode == "help":
        subs[args.topic or "start"].print_help()
        return 0
    if command == "test" and args.scenario == "unit":  # before pantheon uses its home
        return cmd_unit_tests(args.verbose, args.patterns)
    try:
        for path in (HOME, SESSIONS, RUN):
            private_dir(path)
    except ValueError as e:
        die(str(e))
    if command == "update":
        return cmd_update()
    try:
        offer_update(sys.argv[1:] if argv is None else argv)
    except KeyboardInterrupt:  # Ctrl-C while it checks or asks: you want out
        return 130
    if (
        command in (None, "start", "test", "session")
        or getattr(args, "prune", None) is not None
    ):
        tmux_path()  # these run agents: fail now, before a session starts
    if command in (None, "start", "test", "session"):
        try:  # here, so a bad key file stops pantheon with its message, not a traceback
            install_key()
        except (OSError, ValueError) as e:
            die(str(e))
    if command == "config":
        return cmd_config(args)
    if command == "show":
        cmd_show(resolve_slug(args.slug), args.name)
        return 0
    if command == "sessions":
        cmd_sessions(args.prune)
        return 0
    cfg = load_config()
    if command == "tools":
        cmd_tools(cfg)
        return 0
    if command == "agents":
        cmd_agents(cfg, args)
        return 0
    if command == "session":
        slug = resolve_slug(args.slug)
        holder = session_holder(db_path(slug))
        if holder:
            die(f"{slug} is open in another pantheon (pid {holder})")
        return run_ui(cfg, slug, yolo_flag)
    if command in ("start", "test"):
        yolo = setting(cfg, "yolo") if yolo_flag is None else yolo_flag
        try:
            if command == "test":
                workdir = scenario_repo()
                task = SCENARIOS[args.scenario] if MODES[args.mode].needs_task else ""
                print(f"pantheon: {args.scenario} for {args.mode}, in {workdir}")
            else:
                workdir, task = args.dir, " ".join(args.task)
            req = NewSession(
                args.mode,
                task,
                workdir,
                yolo,
                args.agents,
                args.agent,
                effort_arg(args.effort),
                args.stop_when_done,
            )
            slug, notes = prepare(cfg, req, confirm_dirty)
        except PrepError as e:
            die(str(e))
        for note in notes:
            print(f"pantheon: {note}")
        return run_ui(cfg, slug, yolo_flag)
    return run_ui(cfg, None, yolo_flag)


# ------------------------------------------------------------------------------ unit tests

# pantheon test unit runs these: no agents, no tmux, and their files in a scratch home.
MODULE = sys.modules[__name__]  # for the patches


def cmd_unit_tests(verbose: bool, patterns: list[str]) -> int:
    """Run the unit tests below. Pantheon reads its home once, as it loads, so a new
    pantheon runs them, with its home in a new scratch dir."""
    scratch = os.environ.get("PANTHEON_UNIT_HOME", "")
    if not scratch or HOME != Path(scratch):
        with tempfile.TemporaryDirectory(prefix="pantheon-tests-") as scratch:
            env = {
                **os.environ,
                "PANTHEON_HOME": scratch,
                "PANTHEON_UNIT_HOME": scratch,
            }
            argv = ["test", "unit", *(["-v"] if verbose else [])]
            argv += [x for p in patterns for x in ("-k", p)]
            cmd = [sys.executable, "-I", "-B", str(program_path()), *argv]
            return subprocess.run(cmd, env=env).returncode
    for folder in (HOME, SESSIONS, RUN):  # as main makes them
        private_dir(folder)
    loader = unittest.TestLoader()
    # As unittest's own -k: a pattern with no * matches any part of a name.
    loader.testNamePatterns = [p if "*" in p else f"*{p}*" for p in patterns] or None
    suite = loader.loadTestsFromModule(MODULE)
    result = unittest.TextTestRunner(verbosity=2 if verbose else 1).run(suite)
    return 0 if result.wasSuccessful() else 1


BAKEOFF = MODES["bakeoff"]
DEVELOP = MODES["develop"]

FINE = "Fine.\nPANTHEON[status]: go"  # the last message of a check that goes on

# A mode for the session tests. Its agents get turns and prompts, but none starts.
FAKE = Mode(
    help="a test mode",
    agents={"checker": Agent("You check."), "builder": Agent("You build.", True)},
    stages={
        "check": Stage("The checker checks.", {"checker": "your check"}, go_if="ok"),
        "build": Stage("Each builder builds.", {"builder": "your build"}),
    },
    needs_task=False,
    needs_git=False,
)


class PlanTest(unittest.TestCase):
    def test_modes_have_no_problems(self):
        self.assertEqual(mode_problems(), [])

    def test_a_loop_with_go_if_is_a_problem(self):
        build = replace(BAKEOFF.stages["build"], go_if="ok")
        stages = {**BAKEOFF.stages, "build": build}
        MODES["bad"] = replace(BAKEOFF, stages=stages)
        try:
            self.assertEqual(
                mode_problems(), ["bad.build: a stage with a loop can't have go_if"]
            )
        finally:
            del MODES["bad"]

    def test_a_pick_is_one_turn(self):
        compare = replace(BAKEOFF.stages["compare"], agents={"architect": "x"})
        stages = {**BAKEOFF.stages, "compare": compare}
        MODES["bad"] = replace(BAKEOFF, stages=stages)
        try:
            self.assertEqual(
                mode_problems(),
                [
                    "bad.compare: a stage that picks a track has one single agent, "
                    "and no loop or go_if"
                ],
            )
        finally:
            del MODES["bad"]

    def test_statuses(self):
        st = BAKEOFF.stages
        self.assertEqual(statuses_of(st["check"], 3), ("go", "stop"))
        self.assertEqual(statuses_of(st["design"], 3), ("done",))
        self.assertEqual(statuses_of(st["build"], 3), ("continue", "halt"))
        self.assertEqual(
            statuses_of(st["compare"], 3), ("track-1", "track-2", "track-3", "stop")
        )

    def test_bakeoff_checks_first(self):
        self.assertEqual(
            plan_turns(BAKEOFF, 3, []), [("check", 0, 0, "chief-architect")]
        )
        self.assertEqual(plan_turns(BAKEOFF, 3, [("check", 0, "open")]), [])

    def test_go_starts_the_design(self):
        self.assertEqual(
            plan_turns(BAKEOFF, 3, [("check", 0, "go")]),
            [("design", t, 0, "architect") for t in (1, 2, 3)],
        )

    def test_stop_ends_the_plan(self):
        self.assertIsNone(plan_turns(BAKEOFF, 3, [("check", 0, "stop")]))

    def built(self):
        """The steps of a bakeoff on two tracks, up to its compare stage."""
        steps = [("check", 0, "go"), ("design", 1, "done"), ("design", 2, "done")]
        # Track 1 halts in round 2; track 2 runs out of its 5 rounds.
        steps += [("build", 1, s) for s in ("continue",) * 3 + ("halt",)]
        steps += [("build", 2, "continue")] * 10
        return steps

    def test_bakeoff_runs_to_the_end(self):
        steps = self.built()[:-1]
        self.assertEqual(plan_turns(BAKEOFF, 2, steps), [("build", 2, 5, "reviewer")])
        steps = self.built()
        compare = [("compare", 0, 0, "chief-architect")]
        self.assertEqual(plan_turns(BAKEOFF, 2, steps), compare)
        steps.append(("compare", 0, "track-2"))
        refine = [("refine", 0, 0, "chief-architect")]
        self.assertEqual(plan_turns(BAKEOFF, 2, steps), refine)
        steps.append(("refine", 0, "done"))
        # The finish runs on the picked track alone.
        self.assertEqual(plan_turns(BAKEOFF, 2, steps), [("finish", 2, 1, "developer")])
        steps += [("finish", 2, "continue")]
        self.assertEqual(plan_turns(BAKEOFF, 2, steps), [("finish", 2, 1, "reviewer")])
        self.assertIsNone(plan_turns(BAKEOFF, 2, steps + [("finish", 2, "halt")]))

    def test_a_compare_stop_ends_the_plan(self):
        steps = self.built() + [("compare", 0, "stop")]
        self.assertIsNone(plan_turns(BAKEOFF, 2, steps))

    def test_a_stop_waits_for_every_track(self):
        mode = replace(
            FAKE,
            stages={
                "check": Stage("g", {"builder": "x"}, go_if="ok"),
                "next": Stage("g", {"checker": "y"}),
            },
        )
        self.assertEqual(
            plan_turns(mode, 2, [("check", 1, "stop")]), [("check", 2, 0, "builder")]
        )
        self.assertEqual(
            plan_turns(mode, 2, [("check", 1, "stop"), ("check", 2, "open")]), []
        )
        self.assertIsNone(
            plan_turns(mode, 2, [("check", 1, "stop"), ("check", 2, "go")])
        )
        self.assertEqual(
            plan_turns(mode, 2, [("check", 1, "go"), ("check", 2, "go")]),
            [("next", 0, 0, "checker")],
        )

    def test_develop_reviewers_review_at_once(self):
        self.assertEqual(plan_turns(DEVELOP, 3, []), [("build", 0, 1, "developer")])
        steps = [("build", 0, "continue")]
        self.assertEqual(
            plan_turns(DEVELOP, 3, steps),
            [("build", t, 1, "reviewer") for t in (1, 2, 3)],
        )
        steps += [("build", 1, "halt"), ("build", 2, "open"), ("build", 3, "halt")]
        self.assertEqual(plan_turns(DEVELOP, 3, steps), [])

    def test_develop_halts_only_when_every_reviewer_does(self):
        steps = [("build", 0, "continue")]
        steps += [("build", 1, "halt"), ("build", 2, "continue"), ("build", 3, "halt")]
        self.assertEqual(plan_turns(DEVELOP, 3, steps), [("build", 0, 2, "developer")])
        steps += [("build", 0, "continue")] + [("build", t, "halt") for t in (1, 2, 3)]
        self.assertIsNone(plan_turns(DEVELOP, 3, steps))

    def test_develop_halts_when_the_developer_does(self):
        steps = [("build", 0, "continue")] + [("build", t, "continue") for t in (1, 2)]
        self.assertIsNone(plan_turns(DEVELOP, 2, steps + [("build", 0, "halt")]))

    def test_develop_runs_out_of_rounds(self):
        steps = [("build", t, "continue") for t in (0, 1, 2)] * 5
        self.assertIsNone(plan_turns(DEVELOP, 2, steps))
        self.assertEqual(
            plan_turns(DEVELOP, 2, steps[:-1]), [("build", 2, 5, "reviewer")]
        )

    def test_develop_starts_a_reviewer_that_lost_its_turn(self):
        # Track 2's turn went back to the plan (see exited), so its step is gone.
        steps = [("build", 0, "continue"), ("build", 1, "halt"), ("build", 3, "open")]
        self.assertEqual(plan_turns(DEVELOP, 3, steps), [("build", 2, 1, "reviewer")])

    def test_hello(self):
        hello = MODES["hello"]
        self.assertEqual(
            plan_turns(hello, 2, [("hello", 1, "done")]), [("hello", 2, 0, "greeter")]
        )
        steps = [("hello", 1, "done"), ("hello", 2, "done")]
        self.assertEqual(
            plan_turns(hello, 2, steps), [("reply", t, 0, "greeter") for t in (1, 2)]
        )

    def test_plan_text(self):
        text = plan_text(BAKEOFF)
        self.assertTrue(text.startswith("The plan: check the task, design"))
        self.assertIn("1. check: chief-architect. The chief architect checks", text)
        go = PROMPTS["plan_go"].format(go_if=BAKEOFF.stages["check"].go_if)
        self.assertEqual(text.count(go), 1)
        self.assertIn("2. design: architect, on each track.", text)
        self.assertIn("Its agent picks the track with the build to keep:", text)
        self.assertIn("6. finish: developer, then reviewer, on the picked track.", text)
        self.assertNotIn("The plan goes on only if", plan_text(MODES["hello"]))

    def test_develop_plan_text(self):
        text = plan_text(DEVELOP)
        self.assertIn("1. build: developer, then every reviewer at once.", text)
        self.assertIn(PROMPTS["plan_together"], text)
        self.assertNotIn("track", text.split("\n\n", 1)[1])

    def test_turn_label(self):
        self.assertEqual(turn_label("build", 2, 1), "build round 2, track 1")
        self.assertEqual(turn_label("check", 0, 0), "check")

    def test_on_this_machine(self):
        local = ("http://127.0.0.1:11434", "http://localhost", "http://[::1]:11434")
        for url in local:
            self.assertTrue(on_this_machine(url), url)
        remote = (
            "http://10.0.0.5:11434",
            "https://ollama.example.com",
            "http://mac.lan",
        )
        for url in remote:
            self.assertFalse(on_this_machine(url), url)


class ReplyTest(unittest.TestCase):
    """The last message of an agent's turn, as read_reply reads it: its posts, its
    status, and the rest, which is the turn's report."""

    def test_a_report(self):
        text = "All clear.\n\nPANTHEON[status]: go\n"
        self.assertEqual(read_reply(text), ([], "go", "All clear."))

    def test_the_status(self):
        for line in ("pantheon [Status]: Stop", "**PANTHEON[status]:** `stop`"):
            self.assertEqual(read_reply(line)[1], "stop", line)
        self.assertEqual(read_reply("PANTHEON[status]: Track-2")[1], "track-2")
        both = "PANTHEON[status]: go\nPANTHEON[status]: stop"
        self.assertEqual(read_reply(both)[1], "stop")  # the last one counts
        for none in ("Done, as in PANTHEON[status]: go", "PANTHEON[status]:"):
            self.assertEqual(read_reply(none)[1], "", none)

    def test_a_post_ends_the_message(self):
        text = "I checked it.\n\nPANTHEON[say]: builder-codex: the tests fail on main."
        self.assertEqual(
            read_reply(text),
            (["builder-codex: the tests fail on main."], "", "I checked it."),
        )

    def test_a_post_can_have_more_lines(self):
        text = "Done.\nPANTHEON[say]: Two problems:\n\n- one\n- two\n"
        self.assertEqual(read_reply(text)[0], ["Two problems:\n\n- one\n- two"])

    def test_each_marker_starts_a_post_or_ends_one(self):
        text = "PANTHEON[say]: one\nPANTHEON[say]:\ntwo\nPANTHEON[status]: done\nafter"
        self.assertEqual(read_reply(text), (["one", "two"], "done", "after"))

    def test_models_dress_it_up(self):
        for line in (
            "**PANTHEON[say]:** hi",
            "> pantheon [Say]: hi",
            "- PANTHEON[say]: hi",
        ):
            self.assertEqual(read_reply(line)[0], ["hi"], line)

    def test_a_quoted_marker_is_text(self):
        text = (
            "Agents end with these lines:\n\n```\nPANTHEON[say]: your message\n"
            "PANTHEON[status]: done\n```\n\nOr in a sentence, as PANTHEON[say]: x."
        )
        self.assertEqual(read_reply(text), ([], "", text))
        # But a code block in a post is part of it.
        post = "PANTHEON[say]: Run:\n```\nmake test\nPANTHEON[say]: no\n```"
        self.assertEqual(read_reply(post)[0], [post.removeprefix("PANTHEON[say]: ")])

    def test_an_empty_post_is_none(self):
        self.assertEqual(read_reply("Hi.\nPANTHEON[say]:   \n"), ([], "", "Hi."))

    def test_report_lines(self):
        text = report_lines("your check", ("go", "stop"))
        self.assertIn("write your check as your report: the last message", text)
        self.assertTrue(text.endswith("PANTHEON[status]: go\nPANTHEON[status]: stop"))


class KeyTest(unittest.TestCase):
    def test_a_key_pantheon_cannot_read_stays(self):
        path = HOME / "key"
        good = install_key()
        try:
            path.write_text("not a key\n")
            with self.assertRaises(ValueError):
                install_key()
            self.assertEqual(path.read_text(), "not a key\n")
            path.unlink()
            made = install_key()
            self.assertEqual(len(made), 32)
            self.assertEqual(install_key(), made)
        finally:
            path.write_text(good.hex() + "\n")


class RoomTest(unittest.TestCase):
    def test_every_header_lines_up(self):
        """A long entry's header comes after its ▶. A short entry's, and that of a line
        with buttons, start in the same column, as does a long entry's body."""
        head = Content("10:42 builder-claude ")
        short, long, action = (
            long_entry(head, ""),
            long_entry(head, "the body"),
            ActionEntry(head, [("Transport", lambda: None)], True),
        )

        class RoomApp(App):
            def compose(self):
                yield Room(short, long, action)

        async def columns():
            async with RoomApp().run_test() as pilot:
                await pilot.pause()
                title = long.query_one("CollapsibleTitle")
                return [
                    short.content_region.x,
                    title.content_region.x + str(title.render()).index("10:42"),
                    long.query_one(Preview).content_region.x,
                    action.query_one(Static).content_region.x,
                ]

        columns = asyncio.run(columns())
        self.assertEqual(len(set(columns)), 1, columns)


# agy's screens, as capture-pane showed them from agy 1.4.12: idle, mid-turn, and with
# a permission prompt.
RULE = "─" * 60
AGY_IDLE = f"  OK\n{RULE}\n>\n{RULE}\n? for shortcuts{' ' * 40}Gemini 3.8 Flash · high"
AGY_WORKING = (
    f"⣾  Working...\n{RULE}\n>\n{RULE}\nesc to cancel{' ' * 40}Gemini 3.8 Flash · high"
)
AGY_TRUST = "\n".join(
    [
        "Accessing workspace:",
        "/tmp/work",
        "Do you trust the contents of this project?",
        "Antigravity CLI requires permission to read, edit, and execute files here.",
        "> Yes, I trust this folder",
        "  No, exit",
        "  ↑/↓ Navigate · enter Confirm",
        f"{' ' * 60}Gemini 3.8 Flash · high",
    ]
)
AGY_ASKS = "\n".join(
    [
        "> Create a file named hello.txt containing hi, using a shell command.",
        '● Ran (echo "hi" > hello.txt) (ctrl+o to expand)',
        "Command",
        RULE,
        "Requesting permission for:",
        '   echo "hi" > hello.txt',
        "Run this command?",
        "> 1. Yes, run command",
        "  2. Yes, and always allow in this conversation for commands that start with",
        "  4. No, cancel",
        "  ↑/↓ Navigate · tab Amend · ctrl+g edit/expand command",
        f"esc to cancel{' ' * 40}Gemini 3.8 Flash · high",
    ]
)


def agy_transcript(*records) -> str:
    """A transcript as agy keeps one, in the tests' scratch home: one step a line."""
    fd, path = tempfile.mkstemp(dir=HOME, suffix=".jsonl")
    with os.fdopen(fd, "w") as f:
        f.write("".join(json.dumps(r) + "\n" for r in records))
    return path


PROMPT = {
    "type": "USER_INPUT",
    "content": "<USER_REQUEST>\nYour turn.\n</USER_REQUEST>",
}


class AgyTest(unittest.TestCase):
    def test_its_reply(self):
        path = agy_transcript(
            PROMPT,
            {"type": "PLANNER_RESPONSE", "tool_calls": [{"name": "run_command"}]},
            {"type": "GENERIC", "status": "DONE", "content": "the tool's output"},
            {"type": "PLANNER_RESPONSE", "content": FINE, "thinking": "..."},
        )
        self.assertEqual(agy_reply(path), FINE)

    def test_a_turn_with_no_reply(self):
        old = {"type": "PLANNER_RESPONSE", "content": "Old news."}
        self.assertEqual(agy_reply(agy_transcript(old, PROMPT)), "")
        self.assertEqual(agy_reply(str(HOME / "none.jsonl")), "")

    def test_its_dialogs(self):
        self.assertEqual(agy_asks(AGY_ASKS), 'permission: echo "hi" > hello.txt')
        trust = "Do you trust the contents of this project?"
        self.assertEqual(agy_asks(AGY_TRUST), trust)
        self.assertEqual((agy_asks(AGY_IDLE), agy_asks(AGY_WORKING)), ("", ""))
        # One that its history shows, with the input box under it, is gone.
        self.assertEqual(agy_asks(AGY_ASKS + "\n" + AGY_IDLE), "")

    def test_its_hooks(self):
        spec = json.loads(agy_hooks())["pantheon"]
        self.assertEqual(tuple(spec), AGY_HOOK_EVENTS)  # never PreToolUse
        self.assertEqual(spec["PostToolUse"][0]["matcher"], "*")
        stop = spec["Stop"][0]["command"]
        self.assertIn(" Stop 2>/dev/null || true", stop)
        self.assertTrue(stop.endswith("; echo '{}'"))

    def test_its_pastes(self):
        self.assertFalse(collapses("agy", "row\n" * 6))  # its lines do not count
        self.assertTrue(collapses("agy", "x" * 1001))
        for shown in ("[Pasted text #1 1001 chars]", "[Pasted text #2 +31 lines]"):
            self.assertTrue(paste_shown("agy", "> ", "> " + shown, "x" * 1001), shown)


class SessionCase(unittest.TestCase):
    """A session of MODE, which pantheon opens as it would any session."""

    MODE, TASK, AGENTS, YOLO = "fake", "", "claude,codex", False

    def setUp(self):
        MODES.update(TEST_MODES)
        every = dict.fromkeys(TOOLS, "")  # every tool can run: no PATH lookups
        self.enterContext(mock.patch.object(MODULE, "tool_problems", lambda cfg: every))
        self.dir = tempfile.mkdtemp(dir=HOME)
        req = NewSession(self.MODE, self.TASK, self.dir, self.YOLO, agents=self.AGENTS)
        slug, _ = prepare({}, req, lambda files, note: True)
        self.s = Session(slug, {}, lambda: (80, 24))

    def tearDown(self):
        self.s.close()
        for name in TEST_MODES:
            del MODES[name]

    def room(self, kind):
        rows = self.s.db.execute("SELECT text FROM events WHERE kind = ?", (kind,))
        return [r["text"] for r in rows]

    def give(self, step):
        """The step's turn as its agent has it: typed in, and under way."""
        self.s.db.execute("UPDATE steps SET sent = 1 WHERE id = ?", (step["id"],))
        a = self.s.agent_by_id(step["agent_id"])
        a.outbox = [o for o in a.outbox if o.step_id != step["id"]]  # as typing does
        self.s.save_agent(a, state="working")
        return a

    def end(self, step, status, text="Done."):
        """The step's agent ends its turn with a last message: text, then status."""
        a = self.give(step)
        self.s.replied(a, f"{text}\nPANTHEON[status]: {status}")
        self.s.turn_ended(a)

    def advance(self):
        """The turns the engine starts now, each as (stage, track, round, agent)."""
        asyncio.run(self.s.advance())
        rows = self.s.db.execute(
            "SELECT * FROM steps WHERE status = 'open' ORDER BY id"
        ).fetchall()
        return rows, [
            (r["stage"], r["track"], r["round"], self.s.agent_by_id(r["agent_id"]).name)
            for r in rows
        ]

    def all_idle(self):
        """Every agent in the plan, made and idle, so its turns wait in its outbox
        rather than start it."""
        for _, role, track, _ in self.s.team():
            self.s.save_agent(self.s.agent_for(role, track), state="idle")


class SessionTest(SessionCase):
    def check_step(self):
        return self.s.create_step("check", 0, 0, self.s.agent_for("checker", 0))

    def test_the_check_prompt(self):
        prompt = self.check_step()["prompt"]
        self.assertIn(
            "The plan goes on only if this is true: ok; else it ends here.", prompt
        )
        self.assertIn("PANTHEON[status]: go\nPANTHEON[status]: stop", prompt)
        self.assertIn(PROMPTS["go"].format(go_if="ok"), prompt)
        self.assertIn("- builder-codex (builder, track 2): codex", prompt)
        self.assertIn(f"    {self.s.room_file}\n\nTo post to the room", prompt)
        self.assertIn("\n\nPANTHEON[say]: your message\n\n", prompt)
        self.assertEqual(self.room("prompt"), [prompt])

    def test_a_stop_ends_the_session(self):
        step = self.check_step()
        # The record of a turn that ended with a stop.
        self.s.db.execute(
            "UPDATE steps SET status = 'stop' WHERE id = ?", (step["id"],)
        )
        self.s.save_agent(self.s.agents["checker-claude"], state="idle")
        asyncio.run(self.s.advance())
        self.assertEqual(self.s.state, "done")
        done = (
            "The plan stopped after check. Read why in the report by checker-claude. "
            "The agents still run: post in the room (ctrl+s) to "
            "give them more work. No turn came for builder-claude, builder-codex, "
            "so they never started."
        )
        self.assertEqual(self.room("done"), [done])
        count = self.s.db.execute("SELECT COUNT(*) FROM agents").fetchone()[0]
        self.assertEqual(count, 1)  # the builders never got a row

    def test_a_report(self):
        step = self.check_step()
        self.end(step, "go", "All clear.")
        done = self.s.step(step["id"])
        self.assertEqual((done["status"], done["report"]), ("go", "All clear."))
        self.assertEqual(self.s.agents["checker-claude"].state, "idle")
        self.assertEqual(self.room("report"), ["01-checker-claude.md"])
        # In a file too, for the agents that take the next turns.
        self.assertEqual(Path(self.s.report_path(done)).read_text(), "All clear.\n")

    def test_the_room_file_has_each_report(self):
        short, long = self.check_step(), self.check_step()
        self.end(short, "go", "All clear.")
        self.end(long, "stop", "Not clear.\nThe details.")
        self.s.write_room()
        text = Path(self.s.room_file).read_text()
        self.assertIn("checker-claude reports [go]: All clear.\n#", text)  # all of it
        # A longer one by its first line, and the file that holds all of it.
        path = self.s.report_path(self.s.step(long["id"]))
        last = f"checker-claude reports [stop]: Not clear.\n    {path}\n"
        self.assertTrue(text.endswith(last), text)

    def test_a_turn_with_no_status_asks_you(self):
        a = self.give(self.check_step())
        self.s.replied(a, "All clear.")
        self.s.turn_ended(a)
        reason = "ended its turn with no PANTHEON[status]"
        self.assertEqual((a.state, a.reason), ("needs_you", reason))
        needs = self.s.db.execute("SELECT data FROM events WHERE kind = 'needs'")
        self.assertTrue(json.loads(needs.fetchone()["data"])["remind"])
        self.assertEqual(self.s.state, "needs_you")
        # A status the step does not take, too; and the turn's message counts once.
        for message in ("Done.\nPANTHEON[status]: done", None):
            if message is not None:
                self.s.replied(a, message)
            self.s.turn_ended(a)
        reason = "ended its turn with PANTHEON[status]: done, not go or stop"
        self.assertEqual(
            self.room("needs")[1:], [reason, "ended its turn with no PANTHEON[status]"]
        )

    def test_resume_gives_back_a_turn_cut_short(self):
        step = self.check_step()
        self.give(step)
        self.s.all_exited()  # its tmux server went away, say
        self.assertEqual(self.s.state, "stopped")
        stop = self.s.db.execute("SELECT data FROM events WHERE kind = 'error'")
        self.assertTrue(json.loads(stop.fetchone()["data"])["resume"])
        self.assertEqual(self.s.asks(), 1)  # its Resume waits on you
        self.s.resume()
        self.assertEqual((self.s.state, self.s.asks()), ("running", 0))
        self.assertIsNone(self.s.open_step())
        retried = "check did not finish, so it gets that turn again, fresh."
        self.assertIn(retried, self.room("note"))
        steps = [
            tuple(r)
            for r in self.s.db.execute("SELECT stage, track, status FROM steps")
        ]
        self.assertEqual(plan_turns(FAKE, 2, steps), [("check", 0, 0, "checker")])

    def test_an_exit_after_the_report_is_no_stop(self):
        step = self.check_step()
        a = self.give(step)
        # Its Stop hook came just before the exit, and waits to be read.
        stop = {"hook_event_name": "Stop", "last_assistant_message": FINE}
        self.s.db.execute(
            "INSERT INTO hooks (agent, payload) VALUES (?, ?)",
            (a.name, json.dumps(stop)),
        )
        self.s.exited(a, "0")
        self.assertEqual((self.s.state, a.state), ("running", "exited"))
        self.assertEqual(self.s.step(step["id"])["status"], "go")

    def test_an_exit_gives_back_a_turn_that_never_reached_it(self):
        self.end(self.check_step(), "go")  # a report since its start: a start works
        a = self.s.agents["checker-claude"]
        later = self.s.create_step("check", 0, 0, a)  # still in its outbox
        self.s.exited(a, "1")
        self.assertIsNone(self.s.step(later["id"]))
        given = "check never reached it, so it gets that turn again, fresh."
        self.assertIn(given, self.room("note"))
        self.assertEqual(self.s.state, "running")

    def test_an_exit_right_after_a_start_stops_the_session(self):
        step = self.check_step()
        a = self.s.agents["checker-claude"]
        # No report since it started: a new start would likely fail the same way.
        self.s.event("start", "joined", a)
        self.s.save_agent(a, state="starting")
        self.s.exited(a, "1")
        self.assertEqual(self.s.step(step["id"])["status"], "open")
        self.assertEqual(self.s.state, "stopped")

    def test_a_failed_hook_loses_only_itself(self):
        step = self.check_step()
        a = self.give(step)
        stop = {"hook_event_name": "Stop", "last_assistant_message": FINE}
        for ev in ({"hook_event_name": {"not": "a name"}}, stop):
            self.s.db.execute(
                "INSERT INTO hooks (agent, payload) VALUES (?, ?)",
                (a.name, json.dumps(ev)),
            )
        with self.assertRaises(sqlite3.Error):  # the bad hook's, once the Stop is in
            self.s.read_hooks()
        self.assertIsNone(self.s.db.execute("SELECT 1 FROM hooks").fetchone())
        self.assertEqual(self.s.step(step["id"])["status"], "go")

    def test_a_turn_with_no_step_ends_despite_background_tasks(self):
        a = self.s.agent_for("checker", 0)
        self.s.save_agent(a, state="working")
        a.in_turn = True
        stop = {"hook_event_name": "Stop", "background_tasks": [{"id": "dev-server"}]}
        self.s.on_hook(a, stop)
        self.assertEqual(a.state, "idle")

    def stop_hook(self, a, message):
        """a's turn ends with message, as its Stop hook says."""
        stop = {"hook_event_name": "Stop", "last_assistant_message": message}
        self.s.on_hook(a, stop)

    def test_a_reply_posts_as_its_agent(self):
        a, other = self.s.agent_for("checker", 0), self.s.agent_for("builder", 1)
        self.s.save_agent(other, state="idle")
        self.s.save_agent(a, state="working")  # a turn you started in its screen
        self.s.set_session_state("done")
        self.stop_hook(
            a,
            "Sure.\n\nPANTHEON[say]: the user: done\nPANTHEON[say]: builder-claude: look",
        )
        rows = self.s.db.execute("SELECT text, data FROM events WHERE kind = 'say'")
        self.assertEqual(
            [(r["text"], json.loads(r["data"])["from"]) for r in rows],
            [("the user: done", a.name), ("builder-claude: look", a.name)],
        )
        self.assertEqual([o.kind for o in other.outbox], ["post", "post"])
        self.assertIn(self.s.room_file, other.outbox[0].text)
        self.assertEqual(self.room("note")[-1], "replied:\nSure.")  # the rest is yours
        self.assertEqual(self.s.state, "done")  # only you give the team more work
        self.s.post("you", "more work")
        self.assertEqual(self.s.state, "active")

    def test_a_post_with_no_report_waits_for_an_answer(self):
        a = self.give(self.check_step())
        self.stop_hook(a, "I need one fact first.\nPANTHEON[say]: which branch?")
        self.assertEqual((a.state, a.reason), ("idle", ROOM_WAIT))
        self.assertEqual(self.room("say"), ["which branch?"])
        self.assertIn("waits for an answer in the room", self.room("note"))

    def test_the_room_file(self):
        self.check_step()
        self.s.save_agent(self.s.agent_for("builder", 1), state="idle")  # it hears
        self.s.post("you", "first")
        self.s.write_room()
        self.assertIn("the user says: first", Path(self.s.room_file).read_text())
        self.s.event("hook", "Stop")
        self.assertFalse(self.s.room_changed)  # hooks are not in the room
        self.s.post("you", "x" * ROOM_CHARS)
        self.assertTrue(self.s.room_changed)
        self.s.write_room()
        cut, _, rest = Path(self.s.room_file).read_text().partition("\n")
        self.assertRegex(cut, r"^\(\d+ older entries left out, to keep this short\)$")
        self.assertTrue(rest.endswith("x …\n"))  # an entry too long on its own
        self.assertEqual(len(rest), ROOM_CHARS + 1)

    def test_a_late_launch_gets_the_posts_it_missed(self):
        self.s.post("you", "before the prompt")
        step = self.check_step()
        self.s.post("you", "after the prompt")
        a = self.s.agents["checker-claude"]
        # What launch does once tmux has the agent, with a prompt too long for argv.
        first = Outgoing(step["prompt"], "step", step["id"])
        self.s.started(a, first, False, "/bin/claude")
        self.assertEqual([o.kind for o in a.outbox], ["step", "post"])
        self.assertIn("after the prompt", a.outbox[1].text)
        self.assertIn("- the user: before the prompt", step["prompt"])
        # A reopen, even of a stopped session, keeps that order.
        self.s.set_session_state("stopped")
        again = Session(self.s.slug, {}, lambda: (80, 24))
        try:
            outbox = again.agents["checker-claude"].outbox
            self.assertEqual([o.kind for o in outbox], ["step", "post"])
            self.assertIn("after the prompt", outbox[1].text)
        finally:
            again.close()

    def test_a_first_prompt_in_argv_is_sent(self):
        step = self.check_step()
        self.s.post("you", "after the prompt")
        a = self.s.agents["checker-claude"]
        self.s.started(a, Outgoing(step["prompt"], "step", step["id"]), True, "/x")
        self.assertEqual(self.s.step(step["id"])["sent"], 1)
        self.assertEqual([o.kind for o in a.outbox], ["post"])

    def test_a_failed_start_leaves_no_file(self):
        key, before = HOME / "key", set(SESSIONS.iterdir())
        good = key.read_text()
        try:
            key.write_text("not a key\n")  # the session row cannot be signed
            req = NewSession("fake", "", self.dir, False, agents="claude")
            with self.assertRaises(ValueError):
                prepare({}, req, lambda files, note: True)
        finally:
            key.write_text(good)
        self.assertEqual(set(SESSIONS.iterdir()), before)

    def test_a_remote_ollama_needs_your_yes_at_launch_too(self):
        cfg = {"ollama_url": "http://10.0.0.5:11434"}
        self.assertIn("is not on this machine", ollama_problem(cfg))
        self.assertEqual(ollama_problem({**cfg, "ollama_remote": True}), "")
        self.assertEqual(ollama_problem({"ollama_url": "http://localhost:1"}), "")
        a = self.s.agent_for("checker", 0)
        self.s.cfg = cfg  # as a reopen with another config would have it
        # Its own error, not one from a later step, such as no claude on PATH.
        with self.assertRaisesRegex(OSError, "is not on this machine"):
            launch_ollama(self.s, a)

    def test_a_failed_launch_waits_on_you(self):
        self.assertEqual(self.s.asks(), 0)
        self.s.launch_failed.add("checker-claude")  # as launch records it
        self.assertEqual(self.s.asks(), 1)

    def test_a_one_shot_session(self):
        self.assertFalse(self.s.stop_when_done)
        req = NewSession("fake", "", self.dir, False, "claude", stop_when_done=True)
        slug, _ = prepare({}, req, lambda files, note: True)
        s = Session(slug, {}, lambda: (80, 24))
        try:
            self.assertTrue(s.stop_when_done)  # a reopen keeps it, from the file
            opening = s.db.execute("SELECT text FROM events ORDER BY id").fetchone()
            stops = "; the agents stop once the plan is done."
            self.assertTrue(opening["text"].endswith(stops), opening["text"])
        finally:
            s.close()

    def test_resolve_roster(self):
        roster, picks, _ = resolve_roster({}, "develop", "", ["developer=codex"])
        self.assertEqual([r[0] for r in roster if r[4]], ["claude", "codex", "agy"])
        self.assertEqual(picks, {"developer": "codex"})
        with self.assertRaises(PrepError):
            resolve_roster({}, "develop", "", ["reviewer=codex"])
        with self.assertRaises(PrepError):  # codex has no such effort
            resolve_roster({}, "develop", "codex@huge", [])

    def test_agy_takes_effort_only_for_its_gemini_models(self):
        roster, _, notes = resolve_roster({}, "develop", "agy@high", [])
        self.assertEqual((roster[0][3], notes), ("high", []))
        with self.assertRaises(PrepError):  # its gemini models stop at high
            resolve_roster({}, "develop", "agy@max", [])
        roster, _, notes = resolve_roster({}, "develop", "agy:claude-opus-4-6@low", [])
        self.assertEqual(roster[0][3], "")
        self.assertIn("so @low is ignored for claude-opus-4-6", notes[0])
        # A level's effort goes quietly; and a model that names its level takes none.
        spec = "agy:gemini-3.8-flash-low"
        roster, _, notes = resolve_roster({}, "develop", spec, [], "high")
        self.assertEqual((roster[0][2:4], notes), (("gemini-3.8-flash-low", ""), []))

    def test_a_mode_takes_every_tool_that_can_run(self):
        # Here every tool can run (setUp), but ollama only with a model.
        for mode in ("bakeoff", "develop"):
            roster, _, notes = resolve_roster({}, mode, "", [])
            self.assertEqual([r[1] for r in roster], ["claude", "codex", "agy"])
            self.assertIn("ollama: no ollama_model is set", notes[0])
        cfg = {"ollama_model": "qwen3:8b"}
        roster, _, _ = resolve_roster(cfg, "bakeoff", "", [])
        self.assertEqual(roster[-1][1:3], ("ollama", "qwen3:8b"))
        roster, _, _ = resolve_roster(cfg, "hello", "", [])
        self.assertEqual(len(roster), 2)  # its own count


class TestCommandTest(SessionCase):
    """pantheon test: its scenarios and their options, and the repo a scenario starts
    in; not a scenario's session, whose agents would start."""

    def test_its_options(self):
        parser, _ = build_parser()
        args = parser.parse_args(
            ["test", "fizzbuzz", "develop", "-a", "2", "--stop-when-done"]
        )
        self.assertEqual(
            (args.scenario, args.mode, args.agents, args.stop_when_done),
            ("fizzbuzz", "develop", "2", True),
        )
        args = parser.parse_args(["test", "unit", "-v", "-k", "Reply"])
        self.assertEqual(
            (args.scenario, args.verbose, args.patterns), ("unit", True, ["Reply"])
        )
        # A scenario comes first, and has its own task.
        for wrong in (["test", "develop"], ["test", "odd_or_even", "develop", "x"]):
            with contextlib.redirect_stderr(io.StringIO()):
                with self.assertRaises(SystemExit):
                    parser.parse_args(wrong)
        args = parser.parse_args(["start", "develop", "Add a flag."])  # as before
        self.assertEqual((args.dir, args.task), (".", ["Add a flag."]))

    def test_its_repo(self):
        tempfile.tempdir, before = str(HOME), tempfile.tempdir
        try:
            repo = scenario_repo()
        finally:
            tempfile.tempdir = before
        self.assertEqual(git(repo, "log", "--format=%an: %s")[1], "pantheon: Start.\n")
        self.assertEqual(git(repo, "ls-files")[1], "")  # empty
        self.assertEqual(dirty_files(repo), [])
        for name, task in SCENARIOS.items():
            for mode in ("bakeoff", "develop"):  # both need a git repo, and a task
                req = NewSession(mode, task, repo, False, "claude,codex")
                slug, _ = prepare({}, req, lambda files, note: self.fail(files))
                db = connect(db_path(slug))
                saved = db.execute("SELECT task FROM session").fetchone()["task"]
                db.close()
                self.assertEqual(saved, task, name)


class DevelopTest(SessionCase):
    MODE, TASK = "develop-test", "Add a flag."

    def test_the_team_has_no_tracks(self):
        a = self.s.agent_for("reviewer", 2)
        intro = "\n".join(self.s.intro(a))
        self.assertIn("- developer-claude (developer): claude\n", intro)
        self.assertIn("- reviewer-codex (reviewer): codex (that is you)", intro)

    def test_a_fresh_reviewer_starts_again_for_each_turn(self):
        reviewer, developer = (
            self.s.agent_for("reviewer", 1),
            self.s.agent_for("developer", 0),
        )
        self.assertFalse(self.s.renews(reviewer))  # new: its first turn starts it
        for a in (reviewer, developer):
            self.s.save_agent(a, state="idle")
            a.generation = 1  # it started once
        self.assertTrue(self.s.renews(reviewer))
        self.assertFalse(self.s.renews(developer))  # not fresh: it keeps its context
        reviewer.generation = 0  # never started, like the session tests' idle agents
        self.assertFalse(self.s.renews(reviewer))

    def test_a_new_generation(self):
        a = self.s.agent_for("reviewer", 1)
        self.s.save_agent(a, state="idle")
        a.generation, a.ran = 2, ("gpt-9", "high")  # it started twice, and said so
        hook = {"hook_event_name": "Stop"}  # one its last run left
        self.s.db.execute(
            "INSERT INTO hooks (agent, payload) VALUES (?, ?)",
            (a.name, json.dumps(hook)),
        )
        fresh = self.s.renew(a)
        self.assertIs(self.s.agents[a.name], fresh)
        self.assertEqual((fresh.id, fresh.state, fresh.generation), (a.id, "new", 2))
        self.assertEqual(fresh.ran, ("gpt-9", "high"))  # not named again in the room
        self.assertIsNone(self.s.db.execute("SELECT 1 FROM hooks").fetchone())
        note = "starts again, fresh, for its next turn: generation 3"
        self.assertIn(note, self.room("note"))
        prompt = self.s.create_step("build", 1, 2, fresh)["prompt"]
        self.assertIn(
            "You are generation 3 of reviewer-claude: you start fresh", prompt
        )
        self.assertIn("The task:\n\nAdd a flag.", prompt)  # a whole first prompt
        # Its tab names the generation once it runs: the same instance, a new agent.
        fresh.generation = 3
        self.assertEqual(tab_label(fresh).plain, "· reviewer-claude (3)")
        self.assertEqual(
            tab_label(self.s.agent_for("reviewer", 2)).plain, "· reviewer-codex"
        )

    def test_a_reopen_counts_the_generations(self):
        a = self.s.agent_for("reviewer", 1)
        for _ in range(2):
            self.s.event("start", "joined", a)
        self.s.save_agent(a, state="idle")
        again = Session(self.s.slug, {}, lambda: (80, 24))
        try:
            self.assertEqual(again.agents[a.name].generation, 2)
        finally:
            again.close()

    def test_an_old_runs_hooks_are_not_a_new_ones(self):
        a = self.s.agent_for("reviewer", 1)  # new: no process of its own runs
        self.s.on_hook(a, {"hook_event_name": "SessionStart"})
        self.assertEqual((a.hooked, a.state), (False, "new"))
        # A reopen may count them, from before its last start; its next start does not.
        a.hooked = True
        step = self.s.create_step("build", 1, 1, a)
        self.s.started(a, Outgoing(step["prompt"], "step", step["id"]), False, "/x")
        self.assertFalse(a.hooked)
        self.assertFalse(self.s.can_type(a, a.outbox[0]))  # until a hook of its own

    def test_fresh_reviewers_wait_until_they_are_free(self):
        self.all_idle()
        for _ in range(3):  # the developer's round 1, the reviewers', then its round 2
            rows, _ = self.advance()
            for row in rows:
                self.end(row, "continue")
        claude, codex = (
            self.s.agents["reviewer-claude"],
            self.s.agents["reviewer-codex"],
        )
        for a in (claude, codex):
            a.generation = 1  # they ran, so each would start again for its next turn
        self.s.tmux = None  # a restart would need tmux: none may come
        self.s.save_agent(claude, state="working")  # it answers a post
        self.s.attached = codex.name  # you are in its screen
        self.assertEqual(self.advance()[1], [])
        self.s.attached = ""
        codex.outbox.append(Outgoing("Room post #1 ...", "post", event_id=1))
        self.assertEqual(self.advance()[1], [])  # one is on its way to it

    def test_the_help_names_fresh_agents(self):
        text = mode_description(DEVELOP)
        self.assertIn(
            "reviewer   one for each tool, started again, fresh, for each", text
        )
        self.assertIn("developer  one\n", text)

    def test_a_run(self):
        self.all_idle()
        rows, turns = self.advance()
        self.assertEqual(turns, [("build", 0, 1, "developer-claude")])
        self.assertIn(
            "Write halt if this is now true: the reviewers", rows[0]["prompt"]
        )
        self.end(rows[0], "continue")
        rows, turns = self.advance()
        reviewers = [
            ("build", 1, 1, "reviewer-claude"),
            ("build", 2, 1, "reviewer-codex"),
        ]
        self.assertEqual(turns, reviewers)
        prompt = rows[1]["prompt"]
        self.assertIn("Your turn: build round 1. The developer builds", prompt)
        self.assertIn(
            "It is your turn since developer-claude's report came in: ", prompt
        )
        self.assertIn("Every reviewer takes this turn at once", prompt)
        self.end(rows[1], "continue")  # the last made, but not the last one in
        self.end(rows[0], "halt")
        rows, turns = self.advance()
        self.assertEqual(turns, [("build", 0, 2, "developer-claude")])
        prompt = rows[0]["prompt"]
        # Its turn came from every review, so it names them all.
        self.assertIn("It is your turn since all of these came in:", prompt)
        self.assertRegex(
            prompt, r"- reviewer-claude: \S+/02-reviewer-claude-1.md \(halt\)"
        )
        self.assertRegex(
            prompt, r"- reviewer-codex: \S+/03-reviewer-codex-1.md \(continue\)"
        )
        self.assertIn("- build round 1, by reviewer-claude:", prompt)
        self.assertIn("- build round 1, by reviewer-codex:", prompt)
        self.end(rows[0], "continue")
        rows, _ = self.advance()
        for row in rows:
            self.end(row, "halt")
        halted = "build: reviewer-claude, reviewer-codex halted it in round 2."
        self.assertIn(halted, self.room("note"))
        _, turns = self.advance()
        self.assertEqual((turns, self.s.state), ([], "done"))
        done = self.room("done")[0]
        last = "by developer-claude, reviewer-claude, reviewer-codex."
        self.assertTrue(
            done.startswith(f"The plan is done. Read its last reports, {last}")
        )

    def test_a_run_out_of_rounds(self):
        self.all_idle()
        for _ in range(5 * 2):  # each round: the developer's turn, then the reviewers'
            rows, _ = self.advance()
            for row in rows:
                self.end(row, "continue")
        self.assertIn(
            "build: it ran out of rounds (5), and no one halted it.", self.room("note")
        )
        self.advance()
        self.assertEqual(self.s.state, "done")


class BakeoffTest(SessionCase):
    MODE, TASK = "bakeoff-test", "Add a flag."

    def test_a_run(self):
        self.all_idle()
        rows, turns = self.advance()
        self.assertEqual(turns, [("check", 0, 0, "chief-architect-claude")])
        self.end(rows[0], "go")
        rows, turns = self.advance()
        self.assertEqual([t[:2] for t in turns], [("design", 1), ("design", 2)])
        for row in rows:
            self.end(row, "done")
        for status in ("continue", "halt"):  # each track's build, in one round
            rows, _ = self.advance()
            for row in rows:
                self.end(row, status)
        rows, turns = self.advance()
        self.assertEqual(turns, [("compare", 0, 0, "chief-architect-claude")])
        prompt = rows[0]["prompt"]
        lines = (f"PANTHEON[status]: {s}" for s in ("track-1", "track-2", "stop"))
        self.assertIn("\n".join(lines), prompt)
        self.assertIn("Write track-N for the track with the build to keep", prompt)
        for t in (1, 2):  # how each track's build ended, for the pick
            self.assertIn(f"- build, track {t}: reviewer-", prompt)
        self.end(rows[0], "track-2")
        rows, turns = self.advance()
        self.assertEqual(turns, [("refine", 0, 0, "chief-architect-claude")])
        self.end(rows[0], "done")
        rows, turns = self.advance()
        self.assertEqual(turns, [("finish", 2, 1, "developer-codex")])
        prompt = rows[0]["prompt"]
        self.assertIn("Your turn: finish round 1, track 2.", prompt)
        self.assertIn("- refine, by chief-architect-claude:", prompt)
        # The other tracks' work too, which refine says what to take from.
        self.assertIn("- design, track 1, by architect-claude:", prompt)
        self.assertIn("- build round 1, track 1, by developer-claude:", prompt)
        self.assertIn("with the chief architect's changes", prompt)  # its own halt
        self.end(rows[0], "continue")
        rows, turns = self.advance()
        self.assertEqual(turns, [("finish", 2, 1, "reviewer-codex")])
        self.end(rows[0], "halt")
        self.assertIn(
            "finish, track 2: reviewer-codex halted it in round 1.", self.room("note")
        )
        _, turns = self.advance()
        self.assertEqual((turns, self.s.state), ([], "done"))
        # The developer's summary too: it has the build's branch, and how to check it.
        self.assertTrue(
            self.room("done")[0].startswith(
                "The plan is done. Read its last reports, by developer-codex, "
                "reviewer-codex."
            )
        )

    def test_no_pick_ends_the_plan(self):
        self.all_idle()
        for status in ("go", "done", "continue", "halt"):
            rows, _ = self.advance()
            for row in rows:
                self.end(row, status)
        rows, _ = self.advance()
        self.end(rows[0], "stop")
        self.advance()
        self.assertEqual(self.s.state, "done")
        self.assertTrue(
            self.room("done")[0].startswith("The plan stopped after compare.")
        )


class AgySessionTest(SessionCase):
    """An agy agent in its check step, typed in, as its hooks and screen tell it."""

    AGENTS = "agy"

    def setUp(self):
        super().setUp()
        self.a = self.s.agent_for("checker", 0)
        self.step = self.s.create_step("check", 0, 0, self.a)
        self.give(self.step)

    def hook(self, name, **fields):
        ev = {"conversationId": "c-1", "modelName": "gemini-3.8-flash-high", **fields}
        self.s.on_hook(self.a, {"hook_event_name": name, **ev})

    def start_turn(self):
        self.hook("SessionStart")
        self.hook("PreInvocation", invocationNum=0, lastUserInput="Pantheon step 1")

    def test_a_turn(self):
        self.start_turn()
        self.assertEqual((self.a.native_id, self.a.state), ("c-1", "working"))
        self.assertIn("runs gemini-3.8-flash-high", self.room("ran"))
        path = agy_transcript(PROMPT, {"type": "PLANNER_RESPONSE", "content": FINE})
        self.hook("Stop", terminationReason="NO_TOOL_CALL", transcriptPath=path)
        done = self.s.step(self.step["id"])
        self.assertEqual((done["status"], done["report"]), ("go", "Fine."))
        self.assertEqual(self.a.state, "idle")

    def test_a_question_in_the_room(self):
        self.start_turn()
        reply = {"type": "PLANNER_RESPONSE", "content": "PANTHEON[say]: which branch?"}
        self.hook("Stop", transcriptPath=agy_transcript(PROMPT, reply))
        self.assertEqual(self.room("say"), ["which branch?"])
        self.assertEqual((self.a.state, self.a.reason), ("idle", ROOM_WAIT))

    def test_a_dialog_needs_you_until_it_goes(self):
        self.start_turn()
        self.s.on_agy_screen(self.a, AGY_ASKS, 100)
        reason = 'permission: echo "hi" > hello.txt'
        self.assertEqual((self.a.state, self.a.reason), ("needs_you", reason))
        # agy runs on behind its trust prompt: its hooks keep the dialog's needs-you.
        self.s.on_agy_screen(self.a, AGY_TRUST, 101)
        self.hook("PostToolUse", toolCall={"name": "run_command"})
        self.s.on_agy_screen(self.a, AGY_TRUST, 102)
        self.assertEqual(self.a.state, "needs_you")
        self.assertEqual(len(self.room("needs")), 2)  # one for each dialog
        self.s.on_agy_screen(self.a, AGY_WORKING, 103)  # you answered it
        self.assertEqual(self.a.state, "working")

    def test_an_esc_ends_its_turn_with_no_stop(self):
        self.start_turn()
        self.s.on_agy_screen(self.a, AGY_IDLE, 100)
        self.s.on_agy_screen(self.a, AGY_WORKING, 101)  # it went on
        self.s.on_agy_screen(self.a, AGY_IDLE, 102)
        self.assertEqual(self.a.state, "working")
        self.s.on_agy_screen(self.a, AGY_IDLE, 102 + AGY_STOP_WAIT)
        reason = "ended its turn with no PANTHEON[status]"
        self.assertEqual((self.a.state, self.a.reason), ("needs_you", reason))
        self.hook("Stop", terminationReason="USER_CANCELED")  # late: it counts not
        self.assertEqual(self.s.step(self.step["id"])["status"], "open")

    def test_an_error_needs_you(self):
        self.start_turn()
        self.hook("Stop", terminationReason="ERROR", error="quota exceeded")
        self.assertEqual(self.a.reason, "error: quota exceeded")

    def test_its_hook_command(self):
        """The command in agy's hooks.json, run as agy runs it: sh -c, JSON in."""
        command = json.loads(agy_hooks())["pantheon"]["Stop"][0]["command"]
        env = {
            **os.environ,
            "PANTHEON_DB": db_uri(db_path(self.s.slug)),
            "PANTHEON_AGENT": self.a.name,
        }
        out = subprocess.run(
            ["sh", "-c", command],
            input=b'{"conversationId": "c-1"}',
            env=env,
            capture_output=True,
        )
        self.assertEqual(out.stdout, b"{}\n")  # agy's "go on"
        row = self.s.db.execute("SELECT agent, payload FROM hooks").fetchone()
        payload = json.loads(row["payload"])
        self.assertEqual(
            (row["agent"], payload),
            (self.a.name, {"conversationId": "c-1", "hook_event_name": "Stop"}),
        )


class SwitcherTest(SessionCase):
    """The session switcher, in an app with no screen, over a session no pantheon has
    open. A delete stops no tmux server here: tests start none."""

    def setUp(self):
        super().setUp()
        self.s.close()
        self.enterContext(
            mock.patch.object(MODULE, "stop_server_sync", lambda slug: None)
        )

    def press(self, *keys, open_sessions=None, deletes=False):
        """Press keys in the switcher, on this test's session; give back the sessions
        it lists then."""
        slug = self.s.slug

        class SwitcherApp(App):
            def on_mount(self):
                self.push_screen(SwitcherScreen(open_sessions or {}))

        async def run():
            app = SwitcherApp()
            async with app.run_test() as pilot:
                options = app.screen.query_one(OptionList)
                options.highlighted = options.get_option_index(slug)
                await pilot.press(*keys)
                for _ in range(200 if deletes else 0):  # the delete runs in a thread
                    await pilot.pause(0.01)
                    if not db_path(slug).exists():
                        break
                await pilot.pause()
                self.assertIsInstance(app.screen, SwitcherScreen)
                return [o.id for o in app.screen.query_one(OptionList).options]

        return asyncio.run(run())

    def test_d_deletes_a_session(self):
        listed = self.press("d", "y", deletes=True)
        self.assertNotIn(self.s.slug, listed)
        self.assertFalse(db_path(self.s.slug).exists())
        self.assertFalse(scratch_dir(self.s.slug).exists())

    def test_no_keeps_it(self):
        self.assertIn(self.s.slug, self.press("d", "n"))
        self.assertTrue(db_path(self.s.slug).exists())

    def test_a_session_open_here_stays(self):
        listed = self.press("d", "y", open_sessions={self.s.slug: self.s})
        self.assertIn(self.s.slug, listed)  # it asked nothing; y did nothing
        self.assertTrue(db_path(self.s.slug).exists())


# Session tests run these; the real modes, but with no git repo.
TEST_MODES = {
    "fake": FAKE,
    "develop-test": replace(DEVELOP, needs_git=False),
    "bakeoff-test": replace(BAKEOFF, needs_git=False),
}


