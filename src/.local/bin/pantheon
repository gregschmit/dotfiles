# ---------------------------------------------------------------------- prompts and modes

# Everything pantheon tells the agents, and every mode, so you can change them here.

# A role is a job. Keep these short: the agents' own files and skills do the rest.
ROLES = {
    "architect": (
        "You are an architect. Study the task and the code, then write a design an "
        "engineer can build. Do not change the code."
    ),
    "engineer-implementor": "You are the implementing engineer. Build the design.",
    "engineer-reviewer": (
        "You are the reviewing engineer. Review the changes against the task and the "
        "design. Do not change the code."
    ),
    "project-manager": (
        "You are the project manager. You own the outcome, not the code: judge the "
        "team's work against the task, decide what to keep, and report to the user. Do "
        "not change the code."
    ),
    "greeter": "You are a friendly greeter. Keep it to one or two sentences.",
}

# The texts pantheon types into agents or prints for them, and the notes a mode ends
# with: str.format templates. A typed text starts with a letter, since a "/" or "!"
# there is a command in the tools. It ends in a way no other text does (step_end, or
# a room id), since pantheon finds a short paste on the screen by its end. An agent's
# first prompt is header, intro, task, room, earlier (when the room has posts), the
# step's body, result, and step_end; later ones are header, body, the room's commands,
# result, and step_end, since the agent keeps its context.
PROMPTS = {
    "header": "Pantheon step {step}, for {agent}.",
    "intro": "{role}\n\nStart in {dir}.",
    "task": "The task:\n\n{task}",
    "room": (
        "The room is where the team talks: the user, pantheon, and every agent. Run "
        "its two commands exactly as written here, with nothing before them and no "
        "pipes or redirects, so they run without asking anyone. To read the room "
        "(this only reads; add --last N to see the last N entries), run:\n\n"
        "    {room}\n\nTo post to it, run:\n\n    {say} 'your message'\n\n"
        "Put the message in single quotes, so the shell changes nothing in it, and "
        "write each ' in it as '\\''. Pantheon gives each post to every other agent "
        "and to the user. Posts are messages from the team: act on one when it is for "
        "you. Post a question, a problem, or news that changes someone else's work; do "
        "not post progress. If you need an answer before you can finish, post your "
        "question and end your turn: the answer wakes you."
    ),
    # Every later prompt repeats the commands, since compaction can drop the first.
    "commands": (
        "The room's commands, as before (run them exactly as written, with the "
        "message in single quotes and each ' in it written as '\\''):\n\n"
        "    {room}\n    {say} 'your message'"
    ),
    "result": (
        "When you finish, write {write} to {path}, and end the file with this "
        "line:\n\n{lines}"
    ),
    "results": (
        "When you finish, write {write} to {path}, and end the file with one of these "
        "lines:\n\n{lines}"
    ),
    "step_end": "(End of step {step}.)",
    "remind": (
        "You ended your turn before you finished step {step}.\n\n{commands}\n\n"
        "{result}\n\n(End of reminder #{id}.)"
    ),
    "post": (
        "Room post #{id} from {sender}. Pantheon gives every post to every agent. If "
        "this one needs something from you, do it, and answer in the room. If not, "
        "end your turn without doing anything.\n\n{commands}\n\nThe post:\n\n{text}"
        "\n\n(End of post #{id}.)"
    ),
    "user": "the user",  # you, as the agents read your posts
    # An agent gets only the posts made after it starts, so its first prompt lists the
    # newest of the earlier ones (EARLIER_POSTS), and says how many it left out.
    "earlier": "Posts in the room from before you joined, oldest first:\n\n{posts}",
    "earlier_line": "- {sender}: {text}",
    "earlier_cut": "({n} older post{s} left out; read the room to see every post)",
    # What pantheon room prints first when its newest entries fill it.
    "room_cut": "({n} older entries left out, to keep this short)",
    # implement
    "design": (
        "Write a design for the task that an engineer can build. You are one of {n} "
        "architects; each writes their own design, and each design gets its own "
        "engineer and reviewer."
    ),
    "design_dirty": (
        " These files have uncommitted changes, so the engineers' branches will not "
        "have them: {files}."
    ),
    "build": (
        "Build design {track}, by {architect}. It is in {design}. Work in your own git "
        "worktree, on a new branch whose name ends in -{key}, from commit {base}, and "
        "commit your work. In your summary, name the branch and the worktree, and say "
        "what changed. {reviewer} reviews it next."
    ),
    "review": (
        "Review {engineer}'s build of design {track}. The design is in {design}; the "
        "engineer's summary, in {summary}, names the branch and the worktree. The "
        "branch started from commit {base}. Review every change on it, including "
        "uncommitted files. Approve it if it is good to keep; if not, ask for "
        "changes, and say exactly what and why."
    ),
    "review_again": " Your last review is in {last}.",
    "fix": (
        "{reviewer} reviewed your build of design {track} and asked for changes; the "
        "review is in {review}. The design is in {design}, and your last summary, in "
        "{summary}, names your branch and worktree. Make the changes on your branch, "
        "and commit. If you think a change is wrong, you may refuse it: say why in "
        "your summary, and end it with PANTHEON: refused instead."
    ),
    "compare": (
        "Each design was built on its own branch and reviewed. Here is a line for "
        "each build, which starts with its key:\n\n{tracks}\n\nCompare the builds "
        "against the task: read each design, summary, and review, and check out each "
        "branch. Pick the one to keep, and say what it should take from the others, "
        "if anything. Then write your report for the user: what the chosen build "
        "does, how to check it, and which branches and worktrees they can delete. "
        "Your status is the key of the build you pick, or none if no build is good "
        "enough."
    ),
    "compare_track": (
        "- {key}: design {track} by {architect} ({design}), built by {engineer} "
        "(summary: {summary}), reviewed by {reviewer} (last review: {review}): "
        "{outcome}"
    ),
    "approved": "approved in round {round}",
    "refused": "the engineer refused round {round}'s changes",
    "unapproved": "not approved after {n} review{s}",
    "picked": "The project manager picked {key}'s build; its report is above.",
    "picked_none": "The project manager picked no build; its report is above.",
    # hello
    "hello": "Say hello to the other agents, and say which tool and model you are.",
    "reply": "The others said hello:\n\n{hellos}\n\nReply to them.",
    "hello_line": "- {agent}: {text}",
    "said_hello": "Everyone said hello.",
}


def define_modes() -> dict[str, Mode]:
    # A function, so this section can come before the classes it uses.
    return {
        "implement": Mode(
            help="design the change several ways, build and review each, keep the best",
            stages={
                "design": Stage("architect", "your design", team=True),
                "build": Stage(
                    "engineer-implementor",
                    "a short summary of your work (its branch, its worktree, and what "
                    "changed)",
                    team=True,
                    reuse=True,
                ),
                "review": Stage(
                    "engineer-reviewer",
                    "your review",
                    ("approved", "changes"),
                    team=True,
                    reuse=True,
                ),
                "compare": Stage("project-manager", "your comparison and report"),
            },
            flow=flow_implement,
            count=3,
            approve=(),  # e.g. ("design",) to OK each design before it is built
        ),
        "hello": Mode(
            help="the agents say hello at once, then the first one replies (a quick test)",
            stages={"hello": Stage("greeter", "your message", team=True, reuse=True)},
            flow=flow_hello,
            count=2,
            effort="low",
            needs_task=False,
            needs_git=False,
            stop_when_done=True,
        ),
    }


def flow_implement(f: Flow) -> list[Step] | Finish:
    # Each track: a design, a build, then a review and a fix until the reviewer
    # approves, the engineer refuses, or max_rounds reviews are done. Then the compare.
    designs = {r.track: r for r in f.results("design")}
    if not designs and not f.busy("design"):
        body = PROMPTS["design"].format(n=len(f.keys))
        if f.pre_existing:
            body += PROMPTS["design_dirty"].format(files=name_list(f.pre_existing))
        return [Step("design", 0, body)]  # no track: one step on each track
    steps = []
    for t in f.tracks():
        if t not in designs or f.busy(track=t):
            continue
        design, last = designs[t], f.last_in(t)
        builds, reviews = f.results("build", t), f.results("review", t)
        if last.stage == "design":
            body = PROMPTS["build"].format(
                track=t,
                architect=design.agent,
                design=design.path,
                key=f.player("build", t),
                base=f.base,
                reviewer=f.name("review", t),
            )
            steps.append(Step("build", 1, body, track=t))
        elif last.stage == "build" and last.status == "done":
            body = PROMPTS["review"].format(
                engineer=last.agent,
                track=t,
                design=design.path,
                summary=last.path,
                base=f.base,
            )
            if reviews:
                body += PROMPTS["review_again"].format(last=reviews[-1].path)
            steps.append(Step("review", len(reviews) + 1, body, track=t))
        elif last.status == "changes" and len(reviews) < f.max_rounds:
            body = PROMPTS["fix"].format(
                reviewer=last.agent,
                track=t,
                review=last.path,
                design=design.path,
                summary=builds[-1].path,  # a new instance or a compaction lost it
            )
            statuses = ("done", "refused")  # the engineer may refuse the changes
            steps.append(
                Step("build", len(builds) + 1, body, track=t, statuses=statuses)
            )
        # else the track is over: approved, refused, or out of rounds
    if steps or f.open:
        return steps
    pick = f.latest("compare")
    if pick is None:
        built = [t for t in f.tracks() if f.results("build", t)]
        lines = "\n".join(track_line(f, t) for t in built)
        keys = [f.results("build", t)[-1].key for t in built]
        body = PROMPTS["compare"].format(tracks=lines)
        return [Step("compare", 0, body, statuses=(*keys, "none"))]
    if pick.status == "none":
        return Finish("done", PROMPTS["picked_none"])
    return Finish("done", PROMPTS["picked"].format(key=pick.status))


def track_line(f: Flow, t: int) -> str:
    """A track's line in compare's prompt: who did what, and how it ended."""
    design = f.results("design", t)[-1]
    build = f.results("build", t)[-1]
    reviews = f.results("review", t)
    last = f.last_in(t)
    if last.status == "approved":
        outcome = PROMPTS["approved"].format(round=last.round)
    elif last.status == "refused":
        outcome = PROMPTS["refused"].format(round=reviews[-1].round)
    else:
        n = len(reviews)
        outcome = PROMPTS["unapproved"].format(n=n, s="" if n == 1 else "s")
    return PROMPTS["compare_track"].format(
        key=build.key,
        track=t,
        architect=design.agent,
        design=design.path,
        engineer=build.agent,
        summary=build.path,
        reviewer=reviews[-1].agent,
        review=reviews[-1].path,
        outcome=outcome,
    )


def flow_hello(f: Flow) -> list[Step] | Finish:
    if f.open:
        return []
    hellos = f.results("hello")
    if not hellos:
        return [Step("hello", 1, PROMPTS["hello"])]  # no track: one on each track
    if all(r.round == 1 for r in hellos):  # track 1's agent replies to the others
        others = "\n".join(
            PROMPTS["hello_line"].format(agent=r.agent, text=quoted(r.text))
            for r in hellos
            if r.track != 1
        )
        return [Step("hello", 2, PROMPTS["reply"].format(hellos=others), track=1)]
    return Finish("done", PROMPTS["said_hello"])


def quoted(text: str) -> str:
    """A result's text for a list in a prompt: no PANTHEON line, later lines indented."""
    lines = [line.rstrip() for line in text.strip().splitlines()]
    if lines and STATUS_RE.search(lines[-1]):
        lines.pop()
    return "\n  ".join(lines).strip()


# ----------------------------------------------------------------------- tools and stages


# The tools pantheon runs, in the order it picks them: the agents setting's default.
# -a N takes the first N that can run here. They take the tracks in that order, and the
# first plays every single-agent stage, unless the scramble setting shuffles them. An
# agent's model and effort come from the tool's own config, unless a SPEC or an effort
# level sets them.
TOOLS = ("claude", "codex", "gemini", "ollama")  # SPEC: TOOL[:MODEL][@EFFORT]

# Effort levels, for a mode (Mode.effort) or a run (--effort): the (model, effort) each
# tool gets, where "" leaves that part to the tool. Aliases, not model IDs, so the table
# keeps up with new models; codex's model names change too often to name one.
EFFORTS = {
    "low": {
        "claude": ("haiku", "low"),
        "codex": ("", "low"),
        "gemini": ("flash", ""),  # gemini has no effort: its model is the only knob
        "ollama": ("", "low"),  # its think level, if the model has one
    },
    "medium": {
        "claude": ("sonnet", "medium"),
        "codex": ("", "medium"),
        "gemini": ("auto", ""),  # gemini picks flash or pro for each turn
        "ollama": ("", ""),  # models read medium differently, so each keeps its own
    },
    "high": {
        "claude": ("", "high"),  # your model
        "codex": ("", "high"),  # every codex model takes high
        "gemini": ("pro", ""),  # as at max: nothing lies between auto and pro
        "ollama": ("", "high"),  # a model without high gets its own default
    },
    "max": {
        "claude": ("", "max"),  # your model, at its top effort
        "codex": ("", "xhigh"),  # every codex model takes xhigh; older ones lack max
        "gemini": ("pro", ""),  # an account without pro gets a dialog on its first turn
        "ollama": ("", "max"),  # a model without max gets its default; gpt-oss: high
    },
}

# The effort words each tool takes. Pantheon checks them because the tools check late:
# claude only warns on stderr, and codex fails on the first turn.
TOOL_EFFORTS = {
    "claude": ("low", "medium", "high", "xhigh", "max", "ultracode"),
    "codex": ("none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"),
    "gemini": (),
    "ollama": ("low", "medium", "high", "xhigh", "max"),  # claude passes them on
}


@dataclass(frozen=True)
class Stage:
    role: str
    write: str  # what the agent writes, e.g. "your design"
    statuses: tuple[str, ...] = ("done",)
    # Every agent does the stage, one on each track, so a later stage can compare their
    # work. The agents take the tracks in the order of -a, or with scramble, in an order
    # of the stage's own.
    team: bool = False
    # When the stage runs again on a track (a later round), send it to the instance that
    # did it last time. False starts a new instance, free of its bias.
    reuse: bool = False


@dataclass(frozen=True)
class Step:
    """What a flow asks for next."""

    stage: str
    round: int  # part of the result's name: NN-<stage>[-<round>]-<key>.md
    body: str
    agent: str = ""  # a roster key, e.g. codex-2; "" means the stage's own agents
    statuses: tuple[str, ...] = ()  # () means the stage's
    track: int = 0  # 1 to N; 0 on a team stage means a step on each track


@dataclass(frozen=True)
class Finish:
    state: str  # done
    note: str


@dataclass(frozen=True)
class Mode:
    help: str
    stages: dict[str, Stage]
    flow: Callable[[Flow], list[Step] | Finish]
    count: int = 1  # agents with no -a: up to this many that can run here
    effort: str = ""  # an EFFORTS level, or "": each tool's own config
    approve: tuple[str, ...] = ()  # stages whose results wait for your OK
    needs_task: bool = True
    needs_git: bool = True
    stop_when_done: bool = False
    max_rounds: int = 5  # reviews on each track

    @property
    def team(self) -> bool:
        return any(st.team for st in self.stages.values())

    @property
    def least(self) -> int:
        """The fewest agents it runs with: a team needs two."""
        return 2 if self.team else 1


MODES = define_modes()

# ------------------------------------------------------------------------------- settings


@dataclass(frozen=True)
class Setting:
    default: object  # its type is the setting's type
    help: str


# config.toml holds only the settings you change: pantheon config set KEY VALUE.
SETTINGS = {
    "agents": Setting(TOOLS, "the tools to pick agents from, in order"),
    "yolo": Setting(False, "start agents with permission checks off (-y, --no-yolo)"),
    "scramble": Setting(False, "give each stage the agents in a new random order"),
    "disable_claude": Setting(False, "keep claude agents out of new sessions"),
    "disable_codex": Setting(False, "keep codex agents out of new sessions"),
    "disable_gemini": Setting(False, "keep gemini agents out of new sessions"),
    "disable_ollama": Setting(False, "keep ollama agents out of new sessions"),
    "ollama_url": Setting("", "the ollama server (empty: $OLLAMA_HOST, else local)"),
    "ollama_model": Setting("", "a plain ollama's model, unless ollama_models has one"),
    "ollama_models": Setting(
        {}, "a model per level, like low=qwen3.5:4b,max=qwen3.8:27b"
    ),
    "ollama_context": Setting(32768, "the context size the server gives ollama models"),
    "ollama_token_env": Setting("", "an env var with a bearer token for the server"),
}

# --------------------------------------------------------------------------------- schema

SCHEMA_VERSION = 4

SCHEMA = """
CREATE TABLE session (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    slug TEXT NOT NULL DEFAULT '',
    mode TEXT NOT NULL DEFAULT '',
    task TEXT NOT NULL DEFAULT '',          -- the task text the agents get
    source TEXT NOT NULL DEFAULT '',        -- the issue URL, when the task came from one
    dir TEXT NOT NULL DEFAULT '',           -- where the agents start
    base_commit TEXT NOT NULL DEFAULT '',
    pre_existing TEXT NOT NULL DEFAULT '',  -- files with changes before the session, one per line
    yolo INTEGER NOT NULL DEFAULT 0,
    scramble INTEGER NOT NULL DEFAULT 0,    -- the scramble setting when the session started
    max_rounds INTEGER NOT NULL DEFAULT 0,
    state TEXT NOT NULL DEFAULT 'running',  -- running, needs_you, waiting, done, stopped, ended
    origin TEXT NOT NULL DEFAULT '',        -- this install's signature; files from elsewhere open read-only
    created_at TEXT NOT NULL DEFAULT '',
    updated_at TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE lock (                         -- the pantheon that has this session open
    id INTEGER PRIMARY KEY CHECK (id = 1),
    pid INTEGER NOT NULL DEFAULT 0,
    host TEXT NOT NULL DEFAULT '',
    heartbeat REAL NOT NULL DEFAULT 0       -- unix time; a stale lock is free
) STRICT;

CREATE TABLE roster (                       -- the agents this session may start, in order
    id INTEGER PRIMARY KEY,                 -- the first listed one is the primary
    key TEXT NOT NULL UNIQUE,               -- claude, codex, codex-2: part of agent and file names
    tool TEXT NOT NULL DEFAULT '',
    model TEXT NOT NULL DEFAULT '',
    effort TEXT NOT NULL DEFAULT '',
    listed INTEGER NOT NULL DEFAULT 1       -- from -a; 0: only --agent named it
) STRICT;

CREATE TABLE stage_agents (                 -- --agent STAGE=SPEC
    stage TEXT NOT NULL PRIMARY KEY,
    key TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE agents (                       -- one per process, made when a stage needs it
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,              -- <stage>[<instance>]-<key>, e.g. review2-claude
    stage TEXT NOT NULL DEFAULT '',
    key TEXT NOT NULL DEFAULT '',
    role TEXT NOT NULL DEFAULT '',
    tool TEXT NOT NULL DEFAULT '',          -- claude, codex, gemini, or ollama
    model TEXT NOT NULL DEFAULT '',
    effort TEXT NOT NULL DEFAULT '',
    native_id TEXT NOT NULL DEFAULT '',     -- the tool's own session id
    state TEXT NOT NULL DEFAULT 'new',      -- new, starting, working, needs_you, idle, exited
    reason TEXT NOT NULL DEFAULT '',        -- why it needs you
    heard INTEGER NOT NULL DEFAULT 0,       -- the room id of the last post typed into it
    posted INTEGER NOT NULL DEFAULT 0,      -- it posted since pantheon typed it a step
    answering INTEGER NOT NULL DEFAULT 0,   -- its turn is for a room post
    started_at TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE steps (
    id INTEGER PRIMARY KEY,
    agent_id INTEGER NOT NULL REFERENCES agents(id),
    stage TEXT NOT NULL DEFAULT '',
    round INTEGER NOT NULL DEFAULT 0,
    track INTEGER NOT NULL DEFAULT 0,       -- 1 to N on a team stage; 0: none
    name TEXT NOT NULL DEFAULT '',          -- the result's file name, e.g. 01-design-claude.md
    brief TEXT NOT NULL DEFAULT '',         -- the prompt: what the agent was asked to do
    result TEXT NOT NULL DEFAULT '',        -- what it wrote: the step's artifact
    statuses TEXT NOT NULL DEFAULT '',      -- allowed statuses, space separated
    status TEXT NOT NULL DEFAULT 'open',    -- open, or the status the result ends with
    sent INTEGER NOT NULL DEFAULT 0,        -- the prompt reached the agent
    gate INTEGER NOT NULL DEFAULT 0,        -- the result waits for your OK
    approved INTEGER NOT NULL DEFAULT 0,
    started_at TEXT NOT NULL DEFAULT '',
    ended_at TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE hooks (                        -- raw hook events from claude and codex, until read
    id INTEGER PRIMARY KEY,
    agent TEXT NOT NULL DEFAULT '',
    payload TEXT NOT NULL DEFAULT ''
) STRICT;

CREATE TABLE events (                       -- the room, plus hook summaries (kind = hook)
    id INTEGER PRIMARY KEY,
    at TEXT NOT NULL DEFAULT '',
    agent_id INTEGER REFERENCES agents(id), -- NULL: pantheon or you
    kind TEXT NOT NULL DEFAULT '',          -- note, start, prompt, say, ran, result, needs, approve, done, error, hook
    text TEXT NOT NULL DEFAULT '',
    data TEXT NOT NULL DEFAULT '{}'
) STRICT;
"""

# ---------------------------------------------------------------------------------- tools

# Text that shows an agent's input box (codex's and gemini's: an empty one); pantheon
# types only when it shows. No dialog shows codex's or gemini's. Claude's ❯ also marks a
# dialog's chosen row, so a claude agent gets no text before its first hook
# (SessionStart), which comes after its startup dialogs.
INPUT_MARKERS = {
    "claude": ("❯",),
    "codex": ("Ask Codex to do anything", "Ask a follow-up question"),
    "gemini": ("Type your message",),
    "ollama": ("❯",),
}

# What a tool shows in its input box for a long paste (see collapses), as matched on a
# screen with TYPED_NOISE_RE's spaces and box edges taken out.
CLAUDE_PASTED = (
    r"\[Pastedtext#\d+(?:\+\d+lines)?\]|\[\.\.\.Truncatedtext#\d+\+\d+lines\.\.\.\]"
)
PASTED_RE = {
    "claude": re.compile(CLAUDE_PASTED),
    "codex": re.compile(r"\[PastedContent\d+chars\](?:#\d+)?"),
    "gemini": re.compile(r"\[PastedText:\d+(?:lines|chars)(?:#\d+)?\]"),
    "ollama": re.compile(CLAUDE_PASTED),
}

# Claude and codex hooks run this to add the hook's JSON to the session file.
HOOK_PROGRAM = (
    "import os, sqlite3, sys; "
    'd = sys.stdin.buffer.read().decode("utf-8", "replace"); '
    'c = sqlite3.connect(os.environ["PANTHEON_DB"], uri=True, timeout=10); '
    'c.execute("INSERT INTO hooks (agent, payload) VALUES (?, ?)", '
    '(os.environ["PANTHEON_AGENT"], d)); '
    "c.commit()"
)

CLAUDE_HOOK_EVENTS = (
    "SessionStart",
    "UserPromptSubmit",
    "PermissionRequest",
    "PostToolBatch",
    "Notification",
    "Stop",
    "StopFailure",
    "SessionEnd",
    "PostModelSwitch",  # never PreModelSwitch: a hook there holds up the switch
)
CLAUDE_NEEDS_NOTICES = {
    "permission_prompt",
    "elicitation_dialog",
    "elicitation_url_dialog",
    "idle_prompt",
    "agent_needs_input",
}
CODEX_HOOK_LABELS = {
    "SessionStart": "session_start",
    "UserPromptSubmit": "user_prompt_submit",
    "PermissionRequest": "permission_request",
    "PostToolUse": "post_tool_use",
    "Stop": "stop",
}
GEMINI_WORKING = ("✦", "⏲")

STARTUP_TIMEOUT = (
    20  # seconds without a first signal: a startup dialog is likely waiting
)
QUIET_TIMEOUT = 60  # seconds without output while working (codex and gemini)
PASTE_TIMEOUT = 3  # seconds for a paste to show in the input box; else a dialog took it
SUBMIT_TIMEOUT = 10  # seconds after Enter for the agent's turn to start
LOCK_STALE = 30  # seconds without a heartbeat before a session lock counts as free
TMUX_LIMIT = 16364  # bytes in one tmux command: new-session and all its arguments

TMUX_CONF = """\
# Written by pantheon. Agents run in this private server; `tmux attach` is transport.
set -g status on
set -g status-position bottom
set -g status-style "bg=colour236,fg=colour252"
set -g status-format[0] "#[range=left,reverse,bold] ◀ back to pantheon: click or Ctrl-] #[norange,noreverse,nobold]  #[fg=#{@color},bold]#{session_name}#[default] · quitting ends the agent"
set -g prefix None
set -g escape-time 0
set -g focus-events on
set -g extended-keys on
set -g history-limit 10000
set -g remain-on-exit on
set -g mouse on
set -g window-size latest
set -as terminal-features ",*:RGB"
bind -n C-] detach-client
bind -n MouseDown1StatusLeft detach-client
"""


def hook_cmd() -> str:
    # Silent, because hook output can reach the model, and never a failure, so a broken
    # hook cannot get in an agent's way.
    return f"{shlex.quote(sys.executable)} -I -c {shlex.quote(HOOK_PROGRAM)} 2>/dev/null || true"


def claude_settings() -> dict:
    hook = [{"type": "command", "command": hook_cmd(), "timeout": 10}]
    hooks: dict = {event: [{"hooks": hook}] for event in CLAUDE_HOOK_EVENTS}
    hooks["PreToolUse"] = [{"matcher": "AskUserQuestion|ExitPlanMode", "hooks": hook}]
    # Agent view (the ← key on an empty prompt) would take over the agent's terminal.
    return {"disableAgentView": True, "hooks": hooks}


def codex_hook_args() -> list[str]:
    # Codex runs -c hooks only when they are trusted. Passing their trust hashes too (the
    # same hash as codex 0.158's hook_hash) avoids its review screen and writes nothing
    # to ~/.codex.
    cmd = hook_cmd()
    args, state = [], []
    for event, label in CODEX_HOOK_LABELS.items():
        hook = '[{hooks=[{type="command",command=%s,timeout=10}]}]' % json.dumps(cmd)
        args += ["-c", f"hooks.{event}={hook}"]
        ident = {
            "event_name": label,
            "hooks": [
                {"async": False, "command": cmd, "timeout": 10, "type": "command"}
            ],
        }
        blob = json.dumps(
            ident, sort_keys=True, separators=(",", ":"), ensure_ascii=False
        )
        digest = hashlib.sha256(blob.encode()).hexdigest()
        key = json.dumps(f"/<session-flags>/config.toml:{label}:0:0")
        state.append('%s={trusted_hash="sha256:%s"}' % (key, digest))
    return args + ["-c", "hooks.state={" + ",".join(state) + "}"]


def claude_fullscreen() -> bool:
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    try:
        return (
            json.loads((home / "settings.json").read_text(encoding="utf-8")).get("tui")
            == "fullscreen"
        )
    except (OSError, ValueError, AttributeError):
        return False


def tool_path(tool: str) -> str:
    """The program a tool runs, found on PATH at each launch; ollama runs claude."""
    path = shutil.which("claude" if tool == "ollama" else tool)
    if not path:
        raise OSError(f"{tool} is not on your PATH")
    return path


def model_args(tool: str, model: str, effort: str) -> list[str]:
    """The flags that give an agent its model and effort (ollama's go to claude)."""
    if tool == "codex":
        argv = ["-m", model] if model else []
        flag = f"model_reasoning_effort={json.dumps(effort)}"
        return argv + (["-c", flag] if effort else [])
    if tool == "gemini":  # gemini takes effort only through its model
        return ["-m", model] if model else []
    return (["--model", model] if model else []) + (
        ["--effort", effort] if effort else []
    )


def prompt_args(tool: str, text: str) -> list[str]:
    """The arguments that give a tool its first prompt. Gemini's -i would read a text
    that starts with "-" as a flag."""
    if tool == "gemini":
        return [f"--prompt-interactive={text}"]
    return ["--", text]


def launch_claude(
    s: Session, a: AgentRun, route: dict | None = None
) -> tuple[list[str], dict]:
    # A settings file's env (user, project, local) beats the env claude starts with, and
    # claude applies --settings after those files (only managed settings come later). So
    # pantheon's own values go in --settings: the effort, which would also beat
    # --effort, and an ollama agent's route.
    values = dict(route or {})
    if a.effort or a.tool == "ollama":
        values["CLAUDE_CODE_EFFORT_LEVEL"] = a.effort or "auto"  # auto: not your effort
    settings = claude_settings()
    # The room's commands run without asking you, with any arguments; your deny and ask
    # rules still win. In yolo too, where they do no harm.
    room = [room_command(s.slug), say_command(s.slug, a.name)]
    settings["permissions"] = {"allow": [f"Bash({c} *)" for c in room]}
    if values:
        settings["env"] = values
    if route:  # "": no apiKeyHelper, whose key claude would send this host as X-Api-Key
        settings["apiKeyHelper"] = ""
    text = json.dumps(settings)
    if route:  # it can hold a real token, which must not show in ps
        file = claude_settings_file(s.slug, a.name)
        write_private(file, text)
        text = str(file)
    argv = [tool_path("claude"), "--session-id", a.native_id]
    argv += ["--name", f"pantheon-{s.slug}-{a.name}", "--add-dir", s.scratch]
    argv += ["--settings", text]
    argv += model_args("claude", a.model, a.effort)
    if s.yolo:
        argv.append("--dangerously-skip-permissions")
    env = {"DISABLE_AUTOUPDATER": "1"}
    if claude_fullscreen():
        # Otherwise a claude stopped in its first 10 s counts as a failed fullscreen start.
        env["CLAUDE_CODE_NO_FLICKER"] = "1"
    return argv, env


def claude_settings_file(slug: str, agent: str) -> Path:
    # Outside run/<slug>, which agents can write to: it holds the room's allow rules,
    # and an ollama agent's token.
    return RUN / f"{slug}.{agent}.claude-settings.json"


def claude_sends_no_effort(a: AgentRun, workdir: str) -> bool:
    """Whether CLAUDE_CODE_EFFORT_LEVEL comes to auto or unset for a claude agent, so
    claude sends no effort, though its hooks say high."""
    var = "CLAUDE_CODE_EFFORT_LEVEL"
    managed, *files = [
        text_of(dig(read_jsonc(path), "env", var))
        for path in claude_settings_files(workdir)
    ]
    ours = a.effort or ("auto" if a.tool == "ollama" else "")  # what launch_claude sets
    # Managed settings beat pantheon's --settings, which beats your files and your shell.
    order = (managed, ours, *files, clean_env().get(var, ""))
    return next((v for v in order if v), "").lower() in ("auto", "unset")


def codex_writable_roots() -> list[str]:
    """The writable roots in your codex config.toml, which a -c list would replace."""
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    try:
        cfg = tomllib.loads((home / "config.toml").read_text(encoding="utf-8"))
        roots = cfg["sandbox_workspace_write"]["writable_roots"]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    if not isinstance(roots, list):
        return []
    # Codex reads a relative root from the config file's dir, and expands ~.
    return [str(home / os.path.expanduser(r)) for r in roots if isinstance(r, str)]


def launch_codex(s: Session, a: AgentRun) -> tuple[list[str], dict]:
    # The room's commands need no rule here: in a folder you trust, codex runs them in
    # its sandbox without asking (only its rules files could change what it asks).
    argv = [tool_path("codex"), "--no-daemon", "-C", s.workdir]
    # --add-dir would quit in a folder you have not trusted yet (codex runs it
    # read-only); these roots wait until you trust it. -c replaces your own list, so
    # it carries yours too.
    roots = toml_value([*codex_writable_roots(), s.scratch])
    argv += ["-c", f"sandbox_workspace_write.writable_roots={roots}"]
    argv += ["-c", "check_for_update_on_startup=false"]
    # No folder-trust override: trusting a repo loads its .codex config (MCP servers,
    # sandbox), so codex asks you once per repo, through the startup watchdog.
    argv += codex_hook_args()
    argv += model_args("codex", a.model, a.effort)
    if s.yolo:
        argv.append("--dangerously-bypass-approvals-and-sandbox")
    return argv, {}


def launch_gemini(s: Session, a: AgentRun) -> tuple[list[str], dict]:
    # Gemini 0.64 reads injected settings only from root-owned files, so it gets no hooks;
    # pantheon follows its window title instead. No --skip-trust: gemini asks you once per
    # repo before it loads the repo's .gemini settings.
    argv = [tool_path("gemini"), "--session-id", a.native_id]
    argv += ["--include-directories", s.scratch]
    argv += model_args("gemini", a.model, a.effort)
    if s.yolo:
        argv += ["--approval-mode", "yolo"]
    # The room's commands run without asking you; in yolo too, since gemini turns yolo
    # off in a folder you have not trusted. A --policy flag replaces your own policy
    # paths, so they go too. Never --allowed-tools: it denies every other shell command,
    # even in yolo.
    policy = gemini_policy(s.slug)
    write_private(policy, gemini_rules(s.slug))
    for path in [str(policy), *gemini_policy_paths()]:
        argv += ["--policy", path]
    return argv, {}


def gemini_policy(slug: str) -> Path:
    # Outside run/<slug>, which agents can write to.
    return RUN / f"{slug}.gemini-policy.toml"


def gemini_rules(slug: str) -> str:
    """A gemini policy that runs the room's commands without asking. Priority 320 beats
    the denies gemini adds for a tools.allowed or tools.core list in your settings, but
    not your tools.exclude, your confirmationRequired, or an admin's policy."""
    rule = '[[rule]]\ntoolName = "run_shell_command"\ncommandPrefix = {}\n'
    rule += 'decision = "allow"\npriority = 320\n'
    # say with any --from, so one file serves each gemini agent in the session
    say = shlex.join(agent_command(slug, "say"))
    return "\n".join(rule.format(toml_value(c)) for c in (room_command(slug), say))


def gemini_policy_paths() -> list[str]:
    """The policy paths gemini would read without --policy: policyPaths in your
    settings, else its own policies dir. Gemini expands a ~ in them itself."""
    paths = read_jsonc(gemini_home() / "settings.json").get("policyPaths")
    if not isinstance(paths, list):
        paths = []
    paths = [p for p in paths if isinstance(p, str) and p]
    return paths or [str(gemini_home() / "policies")]


def gemini_model(native_id: str) -> str:
    """The model of gemini's last reply in a session, from the chat file it keeps, or "".
    With -m auto, gemini picks the model again for each prompt."""
    home, pattern = gemini_home(), f"tmp/*/chats/session-*-{native_id[:8]}.jsonl"
    # gemini in its macOS sandbox cannot write ~/.gemini, so it keeps them in ~/.cache.
    sandboxed = home.parent / ".cache" / ".gemini"
    files = []
    for f in [*home.glob(pattern), *sandboxed.glob(pattern)]:
        try:  # the name has only 8 characters of the id; the first line has all of it
            with f.open(encoding="utf-8") as fh:
                if json.loads(fh.readline()).get("sessionId") == native_id:
                    files.append((f.stat().st_mtime, f))
        except (OSError, ValueError, AttributeError):
            continue
    if not files:
        return ""
    try:  # the newest: gemini can start a second file for the same session
        with max(files)[1].open("rb") as fh:
            size = fh.seek(0, os.SEEK_END)
            fh.seek(max(0, size - 1_000_000))  # its last reply is near the end
            lines = fh.read().splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        if b'"model"' not in line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:  # the first line, cut by the seek, or one being written
            continue
        if not isinstance(rec, dict) or rec.get("type") != "gemini":
            continue
        model = rec.get("model")
        # "auto" means its router failed, so the line names no real model.
        if isinstance(model, str) and model and not model.startswith("auto"):
            return model
    return ""


# claude's provider switches. It reads "" as unset, so neither your shell nor your
# settings can send an ollama agent to Bedrock and the like.
CLAUDE_PROVIDERS = (
    "CLAUDE_CODE_USE_BEDROCK",
    "CLAUDE_CODE_USE_VERTEX",
    "CLAUDE_CODE_USE_FOUNDRY",
    "CLAUDE_CODE_USE_ANTHROPIC_AWS",
    "CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD",
    "CLAUDE_CODE_USE_MANTLE",
    "CLAUDE_CODE_USE_GATEWAY",
)


def launch_ollama(s: Session, a: AgentRun) -> tuple[list[str], dict]:
    model = a.model  # resolve_roster fills it in from ollama_models or ollama_model
    token_env = setting(s.cfg, "ollama_token_env")
    route = {
        "ANTHROPIC_BASE_URL": ollama_server(s.cfg),
        # Always set a token: without one, claude sends your claude.ai login to this host.
        "ANTHROPIC_AUTH_TOKEN": (os.environ.get(token_env) if token_env else "")
        or "ollama",
        "ANTHROPIC_API_KEY": "",
        **dict.fromkeys(CLAUDE_PROVIDERS, ""),
        "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
        "ANTHROPIC_DEFAULT_FABLE_MODEL": model,
        "CLAUDE_CODE_SUBAGENT_MODEL": model,
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": str(setting(s.cfg, "ollama_context")),
        "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    }
    return launch_claude(s, a, route)


LAUNCHERS = {
    "claude": launch_claude,
    "codex": launch_codex,
    "gemini": launch_gemini,
    "ollama": launch_ollama,
}

# ------------------------------------------------------------------------------- basics

STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state")
HOME = Path(os.environ.get("PANTHEON_HOME") or STATE_HOME / "pantheon")
CONFIG_PATH = HOME / "config.toml"
SESSIONS = HOME / "sessions"
RUN = HOME / "run"
UPSTREAM_REPO = (
    "gregschmit/dotfiles"  # on github.com; its master has the newest pantheon
)
UPSTREAM_URL = (
    f"https://raw.githubusercontent.com/{UPSTREAM_REPO}/master/src/.local/bin/pantheon"
)
UPSTREAM_CACHE = (
    HOME / "upstream"
)  # the last copy from GitHub; its mtime is the last check
UPSTREAM_MAX_AGE = 12 * 3600  # seconds between checks
UPSTREAM_WAIT = (
    3  # seconds a start waits for GitHub; a slower fetch fills the cache later
)


class PrepError(Exception):
    """A new session cannot start; the message says why."""


class Locked(Exception):
    """Another pantheon has the session open."""


class TmuxError(Exception):
    pass


def die(message: str) -> None:
    raise SystemExit(f"pantheon: {message}")


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp(iso: str) -> str:
    try:
        return datetime.fromisoformat(iso).astimezone().strftime("%H:%M")
    except ValueError:
        return "--:--"


def age(iso: str) -> str:
    try:
        seconds = time.time() - datetime.fromisoformat(iso).timestamp()
    except ValueError:
        return "?"
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= size:
            return f"{int(seconds // size)}{unit}"
    return "now"


def shorten(text: str, width: int) -> str:
    text = " ".join(text.split())
    return text if len(text) <= width else text[: width - 1] + "…"


def name_list(names: list[str], limit: int = 20) -> str:
    more = len(names) - limit
    return ", ".join(names[:limit]) + (f", and {more} more" if more > 0 else "")


def first_line(text: str, width: int = 80) -> str:
    return shorten(
        next((line for line in text.splitlines() if line.strip()), ""), width
    )


def short_home(path: str) -> str:
    home = str(Path.home())
    return (
        "~" + path[len(home) :] if path == home or path.startswith(home + "/") else path
    )


def read_text(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


NAME_RE = re.compile(
    r"[A-Za-z][A-Za-z0-9_-]*"
)  # agent names: tmux targets and widget ids
STEP_NAME_RE = re.compile(r"\d{2,}-[a-z0-9-]+\.md")  # result file names
WORD_RE = re.compile(r"[a-z][a-z0-9-]*")  # agent keys and statuses: parts of names
# No digits: agent names are <stage>[<instance>]-<key>, so "review2" must mean instance 2.
STAGE_RE = re.compile(r"[a-z](?:[a-z-]*[a-z])?")
ANSI_RE = re.compile(r"\x1b\[[0-9;:?]*[A-Za-z]")
TYPED_NOISE_RE = re.compile(r"[\s│┃┆┊╎╏|]+")  # wrapping and box edges in an input box
# ESC above all: an ESC[201~ in a paste ends it early. And lone surrogates, which UTF-8
# cannot hold.
CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f\ud800-\udfff]")
# An image path that ends a line, or comes before " /": claude attaches the image and
# changes the text around it.
CLAUDE_IMAGE_RE = re.compile(
    r"""(['"]?)([^\s`'"]+\.(?:png|jpe?g|gif|webp))\1(?=[ \t]*$|[ \t]+/)""",
    re.IGNORECASE | re.MULTILINE,
)


def private_dir(path: Path) -> None:
    """Make path a directory only you can use; refuse a planted symlink or a foreign owner."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        path.mkdir(mode=0o700)
    except FileExistsError:
        pass
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise ValueError(f"{path} is not a directory of yours; remove it")
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)


def clean_instructions(text: str, tool: str) -> str:
    """text as pantheon gives it to a tool, typed or on its command line: as plain text
    to the tool, with nothing in it that the tool would act on."""
    text = CONTROL_RE.sub("", text.replace("\r\n", "\n").replace("\r", "\n"))
    if tool == "gemini":  # gemini's own escapeAtSymbols: "@path" would add a file
        text = re.sub(r"(?<!\\)@", r"\\@", text)
    if tool in ("claude", "ollama"):
        text = CLAUDE_IMAGE_RE.sub(lambda m: f"`{m[2]}`", text)
    # One newline at the end: tmux keeps a last ";", gemini keeps Enter after a last
    # "\", and Enter cannot take a completion the text's last word opened.
    return text.strip("\n") + "\n"


def collapses(tool: str, text: str) -> bool:
    """Whether the tool shows a paste of text as a placeholder in its input box."""
    units = len(text.encode("utf-16-le")) // 2  # how JavaScript counts a string
    if tool in ("claude", "ollama"):  # claude counts a tab as 4 spaces
        return units + 3 * text.count("\t") > 800 or text.count("\n") > 2
    if tool == "codex":
        return len(text) > 1000
    return len(text.split("\n")) > 5 or units > 500  # gemini


def paste_shown(tool: str, before: str, after: str, text: str) -> bool:
    """Whether a paste of text shows on screen: the tool's placeholder shows more often
    than before, or, for a text that shows as text, its end does. The end, since a box
    can scroll its start out of view."""
    b, a = TYPED_NOISE_RE.sub("", before), TYPED_NOISE_RE.sub("", after)
    pasted = PASTED_RE[tool]
    if len(pasted.findall(a)) > len(pasted.findall(b)):
        return True
    if collapses(tool, text):
        return False  # a long text shows only as a placeholder, never as its end
    tail = TYPED_NOISE_RE.sub("", text)[-60:]
    return bool(tail) and a.count(tail) > b.count(tail)


def last_lines(screen: str, n: int = 8) -> str:
    lines = [line.rstrip() for line in screen.splitlines() if line.strip()]
    lines = [line for line in lines if not line.startswith("Pane is dead")]
    return "\n".join(lines[-n:])


def write_private(path: Path, text: str) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")  # mode 0600
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, str):
        # JSON strings are TOML basic strings, except that TOML also forbids a raw DEL.
        # ensure_ascii=False: TOML rejects the surrogate pairs JSON writes for emoji.
        return json.dumps(v, ensure_ascii=False).replace("\x7f", "\\u007f")
    if isinstance(v, list) and all(isinstance(x, str) for x in v):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return (
            "{"
            + ", ".join(f"{toml_key(k)} = {toml_value(x)}" for k, x in v.items())
            + "}"
        )
    raise TypeError(f"cannot write {type(v).__name__} to TOML")


def toml_key(k: str) -> str:
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else json.dumps(k)


def toml_dumps(data: dict) -> str:
    """Write str, bool, int, list[str], and tables of them, one key a line (tomllib
    only reads)."""
    text = "".join(f"{toml_key(k)} = {toml_value(v)}\n" for k, v in data.items())
    if tomllib.loads(text) != data:  # never write a file that reads back differently
        raise ValueError("TOML round trip failed")
    return text


def read_jsonc(path: Path) -> dict:
    """Read a JSON file that may have // and /* */ comments (gemini's settings)."""
    try:
        # Like gemini (Node), read a bad byte as U+FFFD, so we see the settings it uses.
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {}
    out, i, in_string = [], 0, False
    while i < len(text):
        c = text[i]
        if in_string:
            out.append(c)
            if c == "\\":
                out.append(text[i + 1 : i + 2])
                i += 1
            elif c == '"':
                in_string = False
        elif c == '"':
            in_string = True
            out.append(c)
        elif text.startswith("//", i):
            i = text.find("\n", i)
            i = len(text) if i < 0 else i
            continue
        elif text.startswith("/*", i):
            i = text.find("*/", i + 2)
            i = len(text) if i < 0 else i + 2
            continue
        else:
            out.append(c)
        i += 1
    try:
        data = json.loads("".join(out))
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def clean_env() -> dict[str, str]:
    """The environment agents start with: yours, minus what uv and a parent Claude add."""
    env = dict(os.environ)
    if sys.prefix != sys.base_prefix:  # running in uv's venv: keep agents out of it
        venv_bin = os.path.realpath(os.path.join(sys.prefix, "bin"))
        paths = env.get("PATH", "").split(os.pathsep)
        env["PATH"] = os.pathsep.join(
            p for p in paths if p and os.path.realpath(p) != venv_bin
        )
    for k in (
        "VIRTUAL_ENV",
        "UV",
        "UV_RUN_RECURSION_DEPTH",
        "CI",
        "GITHUB_ACTIONS",
        "TMUX",
        "TMUX_PANE",
    ):
        env.pop(k, None)
    for k in [k for k in env if k.startswith("TERM_PROGRAM")]:
        del env[k]
    if "CLAUDECODE" in env:  # pantheon itself runs inside Claude Code
        for k in list(env):
            claude = k.startswith(("CLAUDE_CODE_", "CLAUDE_AGENT_SDK"))
            if claude or k in ("CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT"):
                del env[k]
    return env


def run_cmd(
    argv: list[str], cwd=None, timeout: float = 30, env=None
) -> tuple[int, str, str]:
    try:
        p = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=cwd,
            env=env,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr


def git(workdir: str, *args: str) -> tuple[int, str, str]:
    # Fail instead of waiting for a password behind the UI.
    env = {
        **os.environ,
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_SSH_COMMAND": "ssh -o BatchMode=yes",
    }
    return run_cmd(["git", "-C", workdir, *args], env=env)


def ask(prompt: str, default: str = "") -> str:
    try:
        answer = input(prompt).strip()
    except EOFError:
        answer = ""
    return answer or default


# ------------------------------------------------------------------------------ discovery


def setting(cfg: dict, key: str):
    return cfg.get(key, SETTINGS[key].default)


# How each setting type reads in an error.
TYPE_WORDS = {bool: "true or false", int: "a whole number", str: "text in quotes"}


def as_written(value) -> str:
    """value about as config.toml shows it, for an error."""
    return json.dumps(value, ensure_ascii=False, default=str)


def check_setting(key: str, value):
    """value as the setting's type; ValueError says why it cannot be."""
    default = SETTINGS[key].default
    if isinstance(default, tuple):  # agents: tool names
        if not isinstance(value, (list, tuple)) or not value:
            got = as_written(value)
            raise ValueError(f'{key} is a list of tools, like ["codex"], not {got}')
        for tool in value:
            if tool in TOOLS:
                continue
            why = f"{key} takes tool names ({', '.join(TOOLS)}), not {as_written(tool)}"
            if isinstance(tool, str) and tool.startswith("ollama:"):
                why += ". An ollama model goes in ollama_model, or in -a"
            elif isinstance(tool, str) and re.search(r"[:@]", tool):
                why += ". A model or effort goes in the tool's own config, or in -a"
            raise ValueError(why)
        return tuple(value)
    if isinstance(default, dict):  # ollama_models: level = model
        items = value.items() if isinstance(value, dict) else None
        if items is None:
            got = as_written(value)
            raise ValueError(
                f'{key} is a table, like {{low = "qwen3.5:4b"}}, not {got}'
            )
        for level, model in items:
            if level in SETTINGS:  # written below a [table] line, so it is in the table
                raise ValueError(
                    f"{key}: {level} is inside this table; move it above [{key}]"
                )
            if level not in EFFORTS:
                raise ValueError(
                    f"{key}: no effort level {level!r}; use {', '.join(EFFORTS)}"
                )
            if not isinstance(model, str) or not model or re.search(r"[\s,]", model):
                raise ValueError(
                    f"{key}.{level} is a model name, not {as_written(model)}"
                )
        return dict(value)
    if type(value) is not type(default):
        got = as_written(value)
        if isinstance(value, str):  # yolo = "true": the quotes make it text
            got = f"the text {got}"
        raise ValueError(f"{key} is {TYPE_WORDS[type(default)]}, not {got}")
    if key == "ollama_url" and value:
        if re.search(r"\s", value):
            raise ValueError("ollama_url has a space in it")
        try:
            parts = urllib.parse.urlsplit(value)
            _ = parts.port  # a bad port raises only when read
        except ValueError:
            parts = None
        if not parts or parts.scheme not in ("http", "https") or not parts.hostname:
            raise ValueError("ollama_url is an http or https URL")
        if parts.username or parts.password:
            raise ValueError("ollama_url takes no password; use ollama_token_env")
    if key == "ollama_token_env" and value:
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", value):
            raise ValueError("ollama_token_env is the name of an env var")
    if key == "ollama_context" and value < 2048:
        raise ValueError("ollama_context is 2048 or more")
    return value


def parse_setting(key: str, text: str):
    """A value typed on the command line, as the setting's type."""
    default = SETTINGS[key].default
    t = text.strip()
    if isinstance(default, bool):
        if t.lower() in ("true", "yes", "on", "1"):
            return True
        if t.lower() in ("false", "no", "off", "0"):
            return False
        raise ValueError(f"{key} is true or false")
    if isinstance(default, int):
        if not t.isdecimal():
            raise ValueError(f"{key} is a whole number")
        return int(t)
    if isinstance(default, dict):
        table = {}
        for item in (x.strip() for x in t.split(",") if x.strip()):
            level, sep, model = (x.strip() for x in item.partition("="))
            if not sep:
                raise ValueError(f"{key} takes LEVEL=MODEL,..., like low=qwen3.5:4b")
            table[level] = model
        return table
    if isinstance(default, tuple):
        tools = tuple(x.strip() for x in t.split(",") if x.strip())
        if not tools:
            raise ValueError(f"{key} is a list of tools, like claude,codex")
        return tools
    return t


def read_config_file() -> dict:
    try:
        return tomllib.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        die(f"cannot read {CONFIG_PATH} ({e}); fix it, or delete it to start over")
        return {}


def read_settings() -> tuple[dict, dict[str, str]]:
    """The good settings in config.toml, and why each other key is bad."""
    cfg, bad = {}, {}
    for key, value in read_config_file().items():
        try:
            if key not in SETTINGS:
                raise ValueError(f"{key} is not a setting")
            cfg[key] = check_setting(key, value)
        except ValueError as e:
            bad[key] = str(e)
    return cfg, bad


def drop_hint(bad: dict[str, str]) -> str:
    them = "it" if len(bad) == 1 else "them"
    return f"To drop {them}: pantheon config unset {' '.join(map(shlex.quote, bad))}"


def load_config() -> dict:
    """The settings you changed. A bad key stops pantheon, so a typo never quietly
    leaves a setting as it was."""
    cfg, bad = read_settings()
    if bad:
        die(f"{CONFIG_PATH}: {'; '.join(bad.values())}. {drop_hint(bad)}")
    return cfg


def save_config(cfg: dict) -> None:
    # An empty table is the default, and TOML would not keep it.
    data = {
        k: list(v) if isinstance(v, tuple) else v for k, v in cfg.items() if v != {}
    }
    head = "# pantheon settings. Change them with: pantheon config set KEY VALUE\n"
    write_private(CONFIG_PATH, head + toml_dumps(data))


def shown(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, tuple):
        return ",".join(value)
    if isinstance(value, dict):
        return ",".join(f"{k}={v}" for k, v in value.items()) or "{}"
    return str(value) if value != "" else '""'


def cmd_config(args) -> int:
    cfg, bad = read_settings()  # not load_config: these commands fix a bad file
    if args.action == "show":
        width = max(map(len, SETTINGS))
        print(f"pantheon: settings ({short_home(str(CONFIG_PATH))})")
        for key in SETTINGS:
            mark = "bad" if key in bad else "yours" if key in cfg else "default"
            print(f"  {key:<{width}}  {shown(setting(cfg, key)):<30} {mark}")
        for why in bad.values():
            print(f"  ! {why}")
        if bad:
            print(f"  {drop_hint(bad)}")
        return 0
    if args.action == "set":
        if args.key not in SETTINGS:
            die(f"no setting {args.key!r}; pantheon config show lists them")
        try:
            cfg[args.key] = check_setting(args.key, parse_setting(args.key, args.value))
        except ValueError as e:
            die(str(e))
        keys = [args.key]
    else:
        keys = args.keys
        for key in keys:
            if key not in SETTINGS and key not in bad:
                die(f"no setting {key!r}; pantheon config show lists them")
            cfg.pop(key, None)
    save_config(cfg)  # only good settings, so the bad keys go too
    for key, why in bad.items():
        if key not in keys:
            print(f"  dropped: {why}")
    for key in keys:
        if key in SETTINGS:
            print(f"  {key} = {shown(setting(cfg, key))}")
        else:
            print(f"  dropped {key}")
    return 0


def ollama_server(cfg: dict) -> str:
    url = setting(cfg, "ollama_url") or ollama_url(os.environ.get("OLLAMA_HOST", ""))
    return url.replace("://0.0.0.0", "://127.0.0.1")


def gemini_home() -> Path:
    return Path(os.environ.get("GEMINI_CLI_HOME") or Path.home()) / ".gemini"


def dig(d, *keys):
    """d[k1][k2]..., or None when a level is missing or is not an object. For JSON
    that you wrote by hand."""
    for k in keys:
        if not isinstance(d, dict):
            return None
        d = d.get(k)
    return d


def tool_problems(cfg: dict) -> dict[str, str]:
    """Why each tool cannot run here, or "" when it can. Cheap, so it runs every start."""
    out: dict[str, str] = {}
    for tool in TOOLS:
        if setting(cfg, f"disable_{tool}"):
            out[tool] = f"disabled by disable_{tool}"
        elif tool == "ollama" and not shutil.which("claude"):
            out[tool] = "ollama agents run claude, which is not installed"
        elif tool == "ollama":
            named = setting(cfg, "ollama_url") or os.environ.get("OLLAMA_HOST")
            if not (shutil.which("ollama") or named):
                out[tool] = "not installed, and no ollama_url or OLLAMA_HOST is set"
            else:
                out[tool] = ""
        elif not shutil.which(tool):
            out[tool] = "not installed"
        else:
            out[tool] = ""
    # pantheon follows gemini by its window title.
    settings = read_jsonc(gemini_home() / "settings.json")
    if not out["gemini"] and dig(settings, "ui", "dynamicWindowTitle") is False:
        out["gemini"] = "ui.dynamicWindowTitle is off, so pantheon cannot follow it"
    if not out["gemini"] and dig(settings, "ui", "hideWindowTitle"):
        out["gemini"] = "ui.hideWindowTitle is on, so pantheon cannot follow it"
    return out


def find_tmux() -> tuple[str, str]:
    """tmux's path and its version line, each "" if not found."""
    path = shutil.which("tmux") or ""
    rc, out, _ = run_cmd([path, "-V"]) if path else (1, "", "")
    return path, out.strip() if rc == 0 else ""


def tmux_problem(version: str) -> str:
    """Why a tmux with this version line cannot host agents, or "" when it can."""
    m = re.search(r"(\d+)\.(\d+)", version)
    if m and (int(m[1]), int(m[2])) >= (3, 2):
        return ""
    return "tmux 3.2 or later is required" + (f" (found {version})" if version else "")


@functools.cache
def tmux_path() -> str:
    """The tmux that hosts the agents, found on each run rather than kept in config."""
    path, version = find_tmux()
    if why := tmux_problem(version):
        die(why)
    return path


def detect_claude() -> dict:
    path = shutil.which("claude")
    if not path:
        return {"note": "not installed"}
    # Never give claude a positional argument here: without a TTY it sends it as a prompt.
    rc, out, _ = run_cmd([path, "--version"], env=clean_env())
    version = out.split()[0] if rc == 0 and out.split() else ""
    rc, out, _ = run_cmd([path, "auth", "status"], env=clean_env())
    try:
        auth = json.loads(out).get("authMethod", "")
    except (ValueError, AttributeError):
        auth = ""
    note = "" if rc == 0 else "not logged in (claude auth login)"
    return {
        "path": path,
        "version": version,
        "auth": auth,
        "note": note,
    }


def detect_codex() -> dict:
    path = shutil.which("codex")
    if not path:
        return {"note": "not installed"}
    rc, out, _ = run_cmd([path, "--version"])
    version = out.split()[-1] if rc == 0 and out.split() else ""
    rc, out, err = run_cmd([path, "login", "status"])
    text = (err.strip() or out.strip()).splitlines()
    m = re.match(r"Logged in using (?:an? )?(.+?)(?: -|$)", text[0] if text else "")
    auth = m.group(1).lower() if m else ""  # never keep the masked key that may follow
    note = "" if rc == 0 else "not logged in (codex login)"
    return {
        "path": path,
        "version": version,
        "auth": auth,
        "note": note,
    }


def gemini_auth(home: Path) -> tuple[str, bool]:
    settings = read_jsonc(home / "settings.json")
    auth = dig(settings, "security", "auth", "selectedType")
    auth = auth if isinstance(auth, str) else ""
    if not auth:
        if os.environ.get("GOOGLE_GENAI_USE_GCA") == "true":
            auth = "oauth-personal"
        elif os.environ.get("GOOGLE_GENAI_USE_VERTEXAI") == "true":
            auth = "vertex-ai"
        elif os.environ.get("GEMINI_API_KEY"):
            auth = "gemini-api-key"
    if auth == "oauth-personal":
        encrypted = os.environ.get("GEMINI_FORCE_ENCRYPTED_FILE_STORAGE") == "true"
        return auth, encrypted or (home / "oauth_creds.json").exists()
    if auth == "gemini-api-key":
        return auth, bool(os.environ.get("GEMINI_API_KEY"))
    if auth == "vertex-ai":
        project = os.environ.get("GOOGLE_CLOUD_PROJECT") and os.environ.get(
            "GOOGLE_CLOUD_LOCATION"
        )
        return auth, bool(os.environ.get("GOOGLE_API_KEY") or project)
    return auth, auth in ("compute-default-credentials", "gateway", "cloud-shell")


def detect_gemini() -> dict:
    path = shutil.which("gemini")
    if not path:
        return {"note": "not installed"}
    # Every gemini run registers its cwd as a gemini project, so run it from pantheon's dir.
    rc, out, _ = run_cmd([path, "--version"], cwd=HOME, env=clean_env(), timeout=60)
    version = out.strip().splitlines()[-1] if rc == 0 and out.strip() else ""
    auth, ok = gemini_auth(gemini_home())
    note = "" if ok else "not signed in (run gemini once)"
    return {"path": path, "version": version, "auth": auth, "note": note}


def ollama_get(url: str, path: str, token_env: str = "", timeout: float = 3.0):
    request = urllib.request.Request(url.rstrip("/") + path)
    if token_env and os.environ.get(token_env):
        request.add_header("Authorization", f"Bearer {os.environ[token_env]}")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as r:
            return json.loads(r.read() or b"null")
    except (OSError, ValueError, http.client.HTTPException):
        return None


def ollama_url(text: str) -> str:
    text = text.strip().rstrip("/")
    if "://" in text:
        return text
    host = text or "127.0.0.1"
    return f"http://{host}" if re.search(r":\d+$", host) else f"http://{host}:11434"


def agent_file_warnings(problems: dict[str, str]) -> list[str]:
    shared = Path.home() / ".agents" / "AGENTS.md"
    files = {
        "claude": Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
        / "CLAUDE.md",
        "codex": Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
        / "AGENTS.md",
        "gemini": Path(os.environ.get("GEMINI_CLI_HOME") or Path.home())
        / ".gemini"
        / "GEMINI.md",
    }
    out = []
    for tool, path in files.items():
        if problems[tool] or path.exists():
            continue
        hint = f" (for example: ln -s {shared} {path})" if shared.exists() else ""
        out.append(f"{tool} cannot see a global agent file at {path}{hint}")
    return out


def cmd_tools(cfg: dict) -> None:
    """What pantheon finds now: the program, version, and sign-in for each tool."""
    problems = tool_problems(cfg)
    found = {
        "claude": detect_claude(),
        "codex": detect_codex(),
        "gemini": detect_gemini(),
    }
    server, answer = ollama_server(cfg), None
    if not problems["ollama"]:
        answer = ollama_get(server, "/api/version", setting(cfg, "ollama_token_env"))
    found["ollama"] = {
        "path": shutil.which("ollama") or "",
        "version": (answer or {}).get("version", ""),
        "model": " ".join(
            x
            for x in (
                setting(cfg, "ollama_model"),
                shown(setting(cfg, "ollama_models")),
            )
            if x and x != "{}"
        ),
        "note": f"no server answers at {server}" if answer is None else server,
    }
    print("pantheon: found now (off: it cannot run, or you disabled it)")
    for name, t in found.items():
        mark = "off" if problems[name] else "on "
        detail = " ".join(
            x for x in (t.get("version"), t.get("auth"), t.get("model")) if x
        )
        where = short_home(t.get("path", ""))
        note = problems[name] or t.get("note", "")
        print(f"  {mark} {name:<7} {detail:<30} {where}  {note}".rstrip())
    path, version = find_tmux()
    note = tmux_problem(version)
    print(f"      tmux    {version:<30} {short_home(path)}  {note}".rstrip())
    for warning in agent_file_warnings(problems):
        print(f"  ! {warning}")


CLAUDE_MANAGED = (
    Path("/Library/Application Support/ClaudeCode")
    if sys.platform == "darwin"
    else Path("/etc/claude-code")
) / "managed-settings.json"


def claude_local_dir(workdir: str) -> Path:
    """Where claude reads settings.local.json first: the repo's top, a linked worktree's
    main checkout, or, in a bare repo's worktree, the start dir. It reads the start dir's
    copy too, which loses."""
    top = repo_dirs(workdir)[-1]
    try:  # a worktree's .git file names its git dir, whose commondir is the main .git
        text = (top / ".git").read_text(encoding="utf-8")
        gitdir = top / text.removeprefix("gitdir:").strip()
        common = gitdir / (gitdir / "commondir").read_text(encoding="utf-8").strip()
        if common.resolve().name == ".git":
            top = common.resolve().parent
        elif not (common / ".git").exists():
            # claude takes the bare repo as the top, finds no .git there to check its
            # owner, and falls back to the start dir.
            return Path(workdir)
    except (OSError, ValueError):
        pass
    # With your home dir as the top, claude keeps the start dir's file.
    home = os.path.realpath(Path.home())
    return Path(workdir) if os.path.realpath(top) == home else top


def claude_settings_files(workdir: str) -> list[Path]:
    """claude's settings files, the one that wins first, each real file once."""
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    project = Path(workdir) / ".claude"
    local = claude_local_dir(workdir) / ".claude" / "settings.local.json"
    files = [CLAUDE_MANAGED, local, project / "settings.local.json"]
    files.append(project / "settings.json")
    out, seen = [], set()
    for path in [*files, home / "settings.json"]:
        if os.path.realpath(path) not in seen:
            seen.add(os.path.realpath(path))
            out.append(path)
    return out


def repo_dirs(workdir: str) -> list[Path]:
    """workdir and its parents up to its git repo's top, nearest first; outside a repo,
    workdir alone."""
    dirs = []
    for d in [Path(workdir), *Path(workdir).parents]:
        dirs.append(d)
        if (d / ".git").exists():
            return dirs
    return dirs[:1]


def text_of(value) -> str:
    return value if isinstance(value, str) else ""


def tool_defaults(tool: str, workdir: str) -> dict[str, str]:
    """What a tool's own config says about its model and effort, the value that wins
    first. A guide only: pantheon cannot see an account's default, or the model behind
    an alias."""
    trusted = ", if you trust this folder"
    if tool == "claude":
        files = [(path, read_jsonc(path)) for path in claude_settings_files(workdir)]
        home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
        user = os.path.realpath(home / "settings.json")
        kept = clean_env()  # inside Claude Code, agents get no CLAUDE_CODE_ vars
        model, effort = [], []
        # A settings file's env beats your shell's, and both beat the settings.
        for var, found in (
            ("ANTHROPIC_MODEL", model),
            ("CLAUDE_CODE_EFFORT_LEVEL", effort),
        ):
            for path, d in files:
                if value := text_of(dig(d, "env", var)):
                    found.append(f"{value} (env in {short_home(str(path))})")
            if value := os.environ.get(var):
                lost = "" if var in kept else ", but agents started here do not get it"
                found.append(f"{value} (${var}{lost})")
        for path, d in files:
            where = short_home(str(path))
            if value := text_of(d.get("model")):
                model.append(f"{value} ({where})")
            per = d.get("modelSettings")
            for name, v in per.items() if isinstance(per, dict) else ():
                if value := text_of(dig(v, "effortLevel")):
                    effort.append(f"{value} for {name} ({where})")
            if value := text_of(d.get("effortLevel")):
                if os.path.realpath(path) == user:  # the older /effort key
                    value += " for models before Opus 5.5"
                effort.append(f"{value} ({where})")
        return {
            "model": " over ".join(model) or "your account's default",
            "effort": " over ".join(effort) or "the model's default",
        }
    if tool == "codex":
        home = (
            Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "config.toml"
        )
        # In a folder you trust, codex also reads .codex/config.toml from the repo's top
        # down to the start dir, and the nearest wins.
        files = [
            (d / ".codex" / "config.toml", trusted)
            for d in repo_dirs(workdir)
            if (d / ".codex").is_dir()  # codex skips a .codex that is not a folder
        ]
        model, effort = [], []
        for path, note in [*files, (home, "")]:
            if note and os.path.realpath(path) == os.path.realpath(home):
                continue
            where = short_home(str(path)) + note
            try:
                conf = tomllib.loads(path.read_text(encoding="utf-8"))
            except FileNotFoundError:
                continue
            except (OSError, ValueError):  # codex cannot start with it either
                model.append(f"unknown (cannot read {where})")
                effort.append(f"unknown (cannot read {where})")
                continue
            if value := text_of(conf.get("model")):
                model.append(f"{value} ({where})")
            if value := text_of(conf.get("model_reasoning_effort")):
                effort.append(f"{value} ({where})")
        return {
            "model": " over ".join(model) or "codex's default",
            "effort": " over ".join(effort) or "the model's default",
        }
    if tool == "gemini":
        model = []
        if value := os.environ.get("GEMINI_MODEL"):
            model.append(f"{value} ($GEMINI_MODEL)")
        user = gemini_home() / "settings.json"
        workspace = Path(workdir) / ".gemini" / "settings.json"
        for path, note in ((workspace, trusted), (user, "")):
            if note and os.path.realpath(path) == os.path.realpath(user):
                continue
            if value := text_of(dig(read_jsonc(path), "model", "name")):
                model.append(f"{value} ({short_home(str(path))}{note})")
        return {"model": " over ".join(model) or "auto, gemini's default"}
    return {}  # ollama: pantheon always passes its model


def shown_flags(tool: str, model: str, effort: str) -> str:
    """What pantheon passes an agent for its model and effort, as you would type it."""
    text = shlex.join(model_args(tool, model, effort)) or "nothing"
    if tool == "ollama" and not effort:
        text += ", and CLAUDE_CODE_EFFORT_LEVEL=auto (no effort)"
    return text


def stage_players(mode: Mode, roster: list, picks: dict[str, str]) -> dict[str, list]:
    """The agents that play each stage, track by track, before any scramble."""
    keys = [r[0] for r in roster if r[4]]
    return {
        stage: keys if st.team else [picks.get(stage, keys[0])]
        for stage, st in mode.stages.items()
    }


def cmd_agents(cfg: dict, args) -> None:
    """What pantheon start would pick here, and what each tool's config says."""
    workdir = os.path.realpath(os.path.expanduser(args.dir))
    if not os.path.isdir(workdir):
        die(f"{args.dir} is not a directory")
    if not args.mode:
        if args.agents or args.agent or args.effort:
            die("-a, --agent, and --effort need a MODE")
        cmd_pool(cfg, workdir)
        return
    mode, given = MODES[args.mode], effort_arg(args.effort)
    for level in [given] if given is not None else ["", *EFFORTS]:
        title = f"{args.mode} at {level}" if level else f"{args.mode} with no level"
        if given is None and level == mode.effort:
            title += " (what start uses)"
        try:
            roster, picks, notes = resolve_roster(
                cfg, args.mode, args.agents, args.agent, level
            )
        except PrepError as e:
            print(f"pantheon: {title}: {e}")
            continue
        print(f"pantheon: {title}")
        for stage, keys in stage_players(mode, roster, picks).items():
            each = " (one on each track)" if mode.stages[stage].team else ""
            print(f"  {stage:<10} {', '.join(keys)}{each}")
        if setting(cfg, "scramble"):
            print(
                "  (scramble is on: a session gives each stage these agents in a random "
                "order, which comes from the session's name)"
            )
        for key, tool, model, effort, _ in roster:
            print(f"  {key:<10} passes {shown_flags(tool, model, effort)}")
            given_parts = {"model": model, "effort": effort}
            left = [
                f"{part} {how}"
                for part, how in tool_defaults(tool, workdir).items()
                if not given_parts[part]
            ]
            if left:
                print(f"  {'':<10} {tool}'s config: {'; '.join(left)}")
        for note in notes:
            print(f"  ({note})")


def cmd_pool(cfg: dict, workdir: str) -> None:
    """The tools pantheon picks from, in order, and the effort levels."""
    problems = tool_problems(cfg)
    pool = setting(cfg, "agents")
    print(f"pantheon: the agents setting, in order: {', '.join(pool)}")
    for tool in dict.fromkeys(pool):
        why = problems[tool]
        ollama = setting(cfg, "ollama_model") or setting(cfg, "ollama_models")
        if not why and tool == "ollama" and not ollama:
            why = "no ollama_model or ollama_models is set"
        print(f"  {tool:<10} {'cannot run: ' + why if why else 'can run'}")
        if why:
            continue
        if tool == "ollama":
            model = setting(cfg, "ollama_model") or "none"
            per = ", ".join(
                f"{k} {v}" for k, v in setting(cfg, "ollama_models").items()
            )
            print(
                f"  {'':<10} model {model} (ollama_model); {per or 'none'} (ollama_models)"
            )
            print(f"  {'':<10} at {ollama_server(cfg)}")
            continue
        found = "; ".join(f"{k} {v}" for k, v in tool_defaults(tool, workdir).items())
        print(f"  {'':<10} its config: {found}")
    print("effort levels (a mode's, or start --effort LEVEL):")
    for level, cells in EFFORTS.items():
        for i, tool in enumerate(TOOLS):
            model, effort = cells.get(tool, ("", ""))
            if tool == "ollama":
                model = model or ollama_model_for(cfg, level)
            flags = shown_flags(tool, model, effort)
            if tool == "ollama" and not model:  # start skips a plain ollama here
                flags = (
                    f"cannot run: no ollama_model is set, and no ollama_models.{level}"
                )
            name = level if i == 0 else ""
            print(f"  {name:<10} {tool:<7} {flags}")


# ---------------------------------------------------------------------------------- store


def db_path(slug: str) -> Path:
    return SESSIONS / f"{slug}.sqlite3"


def scratch_dir(slug: str) -> Path:
    return RUN / slug


def db_uri(path: Path, mode: str = "rw") -> str:
    # mode: rw; rwc, which can create the file; or ro, which only reads.
    return f"file:{urllib.parse.quote(os.path.realpath(path))}?mode={mode}"


def connect(path: Path, mode: str = "rw") -> sqlite3.Connection:
    # isolation_level=None: autocommit, so no read transaction stays open between polls.
    # The default rollback journal keeps a closed session in this one file.
    db = sqlite3.connect(
        db_uri(path, mode), uri=True, timeout=10.0, isolation_level=None
    )
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA foreign_keys = ON")
    return db


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def lock_holder(db: sqlite3.Connection) -> int:
    """The pid of another live pantheon that has this session open, or 0."""
    row = db.execute("SELECT pid, host, heartbeat FROM lock WHERE id = 1").fetchone()
    if row is None or not row["pid"] or row["pid"] == os.getpid():
        return 0
    if time.time() - row["heartbeat"] > LOCK_STALE:
        return 0
    # Host names change under a live pantheon (macOS renames hosts by network), so a fresh
    # heartbeat counts for any host; on this host the pid must be alive too.
    if row["host"] == socket.gethostname() and not pid_alive(row["pid"]):
        return 0
    return row["pid"]


def take_lock(db: sqlite3.Connection, slug: str) -> None:
    db.execute("BEGIN IMMEDIATE")
    try:
        holder = lock_holder(db)
        if holder:
            raise Locked(f"{slug} is open in another pantheon (pid {holder})")
        db.execute(
            "INSERT OR REPLACE INTO lock (id, pid, host, heartbeat) VALUES (1, ?, ?, ?)",
            (os.getpid(), socket.gethostname(), time.time()),
        )
    except BaseException:
        db.execute("ROLLBACK")
        raise
    db.execute("COMMIT")


def install_key() -> bytes:
    """This install's secret. It signs the session files the install creates."""
    path = HOME / "key"
    try:
        return bytes.fromhex(path.read_text().strip())
    except (OSError, ValueError):
        key = os.urandom(32)
        write_private(path, key.hex() + "\n")
        return key


def session_origin(slug: str, created_at: str) -> str:
    message = f"{slug}\n{created_at}".encode()
    return hmac.new(install_key(), message, "sha256").hexdigest()


def view_id(slug: str) -> str:
    # Widget ids allow fewer characters than file names do.
    return "s-" + hashlib.sha1(slug.encode()).hexdigest()[:12]


def tab_id(slug: str) -> str:
    return "tab-" + view_id(slug)


def session_holder(path: Path) -> int:
    try:
        db = connect(path)
    except sqlite3.Error:
        return 0
    try:
        return lock_holder(db)
    except sqlite3.Error:  # not a session, or a crashed one a sandbox cannot repair
        return 0
    finally:
        db.close()


def make_slug(words: str) -> str:
    stem = re.sub(r"[^a-z0-9]+", "-", words.lower()).strip("-")
    base = datetime.now().strftime("%Y%m%d") + (f"-{stem}" if stem else "")
    if len(base) > 40:  # keeps tmux and file names short
        base = base[:40].rsplit("-", 1)[0]
    slug, n = base, 2
    while db_path(slug).exists() or scratch_dir(slug).exists():
        slug, n = f"{base}-{n}", n + 1
    return slug


def list_sessions() -> list[dict]:
    out = []
    for path in SESSIONS.glob("*.sqlite3"):
        try:
            db = connect(path)
            row = db.execute("SELECT * FROM session").fetchone()
            holder = lock_holder(db)
            version = db.execute("PRAGMA user_version").fetchone()[0]
            db.close()
        except sqlite3.Error:
            continue
        if row is not None:
            out.append(
                {**dict(row), "slug": path.stem, "holder": holder, "version": version}
            )
    return sorted(out, key=lambda s: s["created_at"], reverse=True)


def resolve_slug(text: str) -> str:
    slugs = [p.stem for p in SESSIONS.glob("*.sqlite3")]
    if text in slugs:
        return text
    hits = sorted(s for s in slugs if text in s)
    if not hits:
        die(f"no session matches {text!r}")
    if len(hits) > 1:
        die(f"{text!r} matches several sessions: {', '.join(hits)}")
    return hits[0]


def parse_spec(spec: str) -> tuple[str, str, str]:
    if re.search(r"[\s,]", spec):  # a lost comma would hide an agent in a model name
        raise PrepError(f"{spec!r} has a space or comma in it, so it is not one SPEC")
    rest, _, effort = spec.partition("@")
    tool, _, model = rest.partition(":")
    if tool not in TOOLS:
        raise PrepError(
            f"unknown tool {tool!r} in {spec!r}; use one of {', '.join(TOOLS)}"
        )
    return tool, model, effort


def spec_text(tool: str, model: str, effort: str) -> str:
    return tool + (f":{model}" if model else "") + (f"@{effort}" if effort else "")


def count_help(mode: Mode) -> str:
    """How many agents a mode takes with no -a, for its help."""
    if mode.count == mode.least:
        return str(mode.count)
    return f"up to {mode.count}, at least {mode.least}"


def effort_arg(text: str | None) -> str | None:
    """--effort as typed: None if not given, "" for default (no level), else a level."""
    return None if text is None else "" if text == "default" else text


def effort_level(mode: Mode, effort: str | None) -> str:
    """The level a run uses: --effort's ("": none), else the mode's."""
    return mode.effort if effort is None else effort


def ollama_model_for(cfg: dict, level: str) -> str:
    """The model a plain ollama gets: ollama_models' for the level, else ollama_model."""
    return setting(cfg, "ollama_models").get(level, "") or setting(cfg, "ollama_model")


def resolve_roster(
    cfg: dict,
    mode_name: str,
    agents: str,
    picks: list[str],
    level: str | None = None,
) -> tuple[list[tuple[str, str, str, str, int]], dict[str, str], list[str]]:
    """Read -a, --agent, and --effort's level (None: the mode's). Returns the roster as
    (key, tool, model, effort, listed), the --agent picks as {stage: key}, and notes."""
    mode = MODES[mode_name]
    level = effort_level(mode, level)
    if level and level not in EFFORTS:
        raise PrepError(
            f"no effort level {level!r}; use {', '.join(EFFORTS)}, or default"
        )
    problems = tool_problems(cfg)
    notes: list[str] = []
    text = agents.strip()
    if not text or text.isdecimal():
        # -a N needs N. With no -a, up to the mode's count will do, down to its least.
        n = int(text) if text else mode.count
        least = n if text else mode.least
        pool = setting(cfg, "agents")
        specs, skipped = [], []
        for tool in pool:  # the first n that can run here, in order
            if len(specs) == n:
                break
            why = problems[tool]
            if not why and tool == "ollama" and not ollama_model_for(cfg, level):
                why = "no ollama_model is set" + (
                    f", and no ollama_models.{level}" if level else ""
                )
            if why:
                skipped.append(f"{tool}: {why}")
            else:
                specs.append(tool)
        if n and len(specs) < least:
            why = f" Skipped: {'; '.join(skipped)}." if skipped else ""
            again = (
                ",".join(specs[i % len(specs)] for i in range(least)) if specs else ""
            )
            hint = (
                f" To run {least} anyway, give the agents (-a) as {again}"
                if again
                else ""
            )
            raise PrepError(
                f"this needs {least} agent{'s' if least != 1 else ''} that can run "
                f"here, and the agents setting ({', '.join(pool)}) has {len(specs)}."
                f"{why}{hint}"
            )
        if skipped:
            notes.append(f"skipped, since they cannot run here: {'; '.join(skipped)}")
    else:
        specs = [x.strip() for x in text.split(",")]
    if not specs or not all(specs):
        raise PrepError(f"-a takes a number above 0 or a list of SPECs, not {agents!r}")
    for spec in specs:
        parse_spec(spec)  # a bad SPEC says more than a count would
    if len(specs) < mode.least:
        raise PrepError(
            f"{mode_name} has a stage that every agent plays, so it needs "
            f"{mode.least} or more agents"
        )
    roster: list[tuple[str, str, str, str, int]] = []

    def add(spec: str, listed: bool) -> str:
        tool, model, effort = parse_spec(spec)
        if problems[tool]:
            raise PrepError(f"{tool} cannot run here: {problems[tool]}")
        if tool == "gemini" and effort:
            note = (
                f"gemini takes effort only through its model, so @{effort} is ignored"
            )
            notes.extend([note] if note not in notes else [])
            effort = ""
        if effort and effort not in TOOL_EFFORTS[tool]:
            raise PrepError(
                f"{tool} takes effort {', '.join(TOOL_EFFORTS[tool])}, not {effort!r}"
            )
        # Your SPEC's parts win, the level fills the blanks, and the tool does the rest.
        cell = EFFORTS[level].get(tool, ("", "")) if level else ("", "")
        model, effort = model or cell[0], effort or cell[1]
        if tool == "ollama" and not model:
            model = ollama_model_for(cfg, level)
            if not model:
                per_level = ","
                if level:  # config set replaces the whole table, so keep its levels
                    levels = shown({**setting(cfg, "ollama_models"), level: "MODEL"})
                    per_level = f", run pantheon config set ollama_models {levels},"
                raise PrepError(
                    f"ollama needs a model: write ollama:MODEL{per_level} or run "
                    "pantheon config set ollama_model MODEL"
                )
        if not listed:  # an agent -a has already keeps its key
            for row in roster:
                if row[1:4] == (tool, model, effort):
                    return row[0]
        taken = {row[0] for row in roster}
        key, n = tool, 2
        while key in taken:
            key, n = f"{tool}-{n}", n + 1
        roster.append((key, tool, model, effort, int(listed)))
        return key

    for spec in specs:
        add(spec, True)
    singles = [name for name, st in mode.stages.items() if not st.team]
    stage_keys: dict[str, str] = {}
    for item in picks:
        stage, sep, spec = (x.strip() for x in item.partition("="))
        if stage in mode.stages and stage not in singles:
            raise PrepError(
                f"{stage} runs every agent from -a, so --agent cannot set it"
            )
        if not sep or not spec or stage not in singles:
            raise PrepError(
                f"bad --agent {item!r}; use STAGE=SPEC, where STAGE is one of: "
                + (", ".join(singles) or "none in this mode")
            )
        stage_keys[stage] = add(spec, False)
    return roster, stage_keys, notes


# --------------------------------------------------------------------------------- issues


def parse_issue_ref(text: str) -> dict | None:
    t = text.strip()
    if m := re.fullmatch(r"#?(\d+)", t):
        return {"number": int(m[1])}
    if m := re.fullmatch(r"https?://github\.com/([^/\s]+/[^/\s]+)/issues/(\d+)/?", t):
        return {"number": int(m[2]), "host": "github.com", "path": m[1]}
    if m := re.fullmatch(
        r"https?://(?:[^@/\s]+@)?([^/\s]+)/(.+?)/-/(?:issues|work_items)/(\d+)/?", t
    ):
        return {"number": int(m[3]), "host": m[1], "path": m[2]}
    return None


def parse_remote(url: str) -> tuple[str, str]:
    url = url.strip()
    if "://" not in url:  # scp-like: git@host:group/project.git
        m = re.fullmatch(r"(?:[^@/\s]+@)?([^:/\s]+):(.+?)(?:\.git)?/?", url)
        if m:
            return m[1], m[2]
    u = urllib.parse.urlsplit(url)  # drops the user part, which can hold a token
    if u.hostname:
        return u.hostname, u.path.strip("/").removesuffix(".git")
    raise PrepError(
        "cannot read the origin remote"
    )  # never echo it: it can hold a token


def forge_error(tool: str, rc: int, err: str) -> PrepError:
    line = first_line(err, 200) or f"exit status {rc}"
    if rc == 4 or re.search(r"401|403|auth|log ?in|token", err, re.I):
        return PrepError(
            f"{tool} could not sign in ({line}); fix its login and try again"
        )
    return PrepError(f"{tool}: {line}")


def fetch_issue(workdir: str, ref: dict) -> dict:
    host, path = ref.get("host", ""), ref.get("path", "")
    if not host:
        rc, out, _ = git(workdir, "remote", "get-url", "origin")
        if rc:
            raise PrepError("an issue number needs an origin remote")
        host, path = parse_remote(out)
    n = str(ref["number"])
    if host == "github.com":
        fields = "number,title,body,labels,comments,url,state"
        rc, out, err = run_cmd(
            ["gh", "issue", "view", n, "-R", path, "--json", fields], cwd=workdir
        )
        if rc:
            raise forge_error("gh", rc, err)
        data = json.loads(out)
        if "/pull/" in data.get("url", ""):  # issues and pull requests share numbers
            raise PrepError(f"#{n} is a pull request, not an issue")
        comments = [
            {
                "author": (c.get("author") or {}).get("login", ""),
                "at": c.get("createdAt", ""),
                "body": c.get("body", ""),
            }
            for c in data.get("comments", [])
        ]
        return {
            "title": data["title"],
            "url": data["url"],
            "body": data.get("body") or "",
            "comments": comments,
        }
    repo = f"{host}/{path}"  # always name the host, or glab falls back to gitlab.com
    rc, out, err = run_cmd(
        ["glab", "issue", "view", n, "--output", "json", "--repo", repo], cwd=workdir
    )
    if rc:
        raise forge_error("glab", rc, err)
    data = json.loads(out)
    notes_path = (
        f"projects/:id/issues/{n}/notes?sort=asc&order_by=created_at&per_page=100"
    )
    rc, out, err = run_cmd(
        ["glab", "api", "--repo", repo, "--paginate", "--output", "ndjson", notes_path],
        cwd=workdir,
    )
    if rc:
        raise forge_error("glab", rc, err)
    comments = []
    for line in out.splitlines():
        note = json.loads(line) if line.strip() else {}
        if note and not note.get("system"):
            author = (note.get("author") or {}).get("username", "")
            comments.append(
                {
                    "author": author,
                    "at": note.get("created_at", ""),
                    "body": note.get("body", ""),
                }
            )
    body = data.get("description") or ""
    return {
        "title": data["title"],
        "url": data.get("web_url", ""),
        "body": body,
        "comments": comments,
    }


def format_issue(issue: dict) -> str:
    parts = [issue["title"], issue["url"], issue["body"].strip() or "(no description)"]
    if issue["comments"]:
        parts.append("Comments:")
        for c in issue["comments"]:
            parts.append(f"{c['author']} ({c['at'][:10]}):\n{c['body'].strip()}")
    return "\n\n".join(parts)


# ------------------------------------------------------------------------- new sessions


@dataclass
class NewSession:
    mode: str
    task: str  # as typed: text, an issue number, or an issue URL
    dir: str
    yolo: bool
    agents: str = ""  # -a: how many, or SPEC,SPEC,...
    stage_agents: list[str] = field(default_factory=list)  # --agent STAGE=SPEC
    effort: str | None = None  # --effort: a level, or "" for none; None: the mode's


def dirty_files(workdir: str) -> list[str]:
    rc, out, _ = git(workdir, "status", "--porcelain")
    return [line[3:] for line in out.splitlines() if line.strip()] if rc == 0 else []


def prepare(
    cfg: dict, req: NewSession, confirm: Callable[[list[str], str], bool]
) -> tuple[str, list[str]]:
    """Check the start dir, read the task, pick the agents, and write the session file."""
    mode = MODES[req.mode]
    workdir = os.path.realpath(os.path.expanduser(req.dir or "."))
    if not os.path.isdir(workdir):
        raise PrepError(f"{req.dir} is not a directory")
    roster, picks, notes = resolve_roster(
        cfg, req.mode, req.agents, req.stage_agents, req.effort
    )
    base, pre_existing = "", []
    if mode.needs_git:
        if git(workdir, "rev-parse", "--show-toplevel")[0]:
            raise PrepError(f"{workdir} is not in a git repo")
        rc, out, _ = git(workdir, "rev-parse", "HEAD")
        if rc:
            raise PrepError(f"{workdir} has no commits yet")
        base = out.strip()
        pre_existing = dirty_files(workdir)
        note = (
            "The team's branches start from the last commit, so they will not have "
            "these changes. The agents that work in the start dir see them."
            if mode.team
            else "The agents will see these changes too."
        )
        if pre_existing and not confirm(pre_existing, note):
            raise PrepError("stopped: the work tree has uncommitted changes")
        if pre_existing:
            notes.append(f"Uncommitted changes: {name_list(pre_existing)}. {note}")
        busy = [
            s["slug"]
            for s in list_sessions()
            if s["dir"] == workdir and s["state"] in ("running", "needs_you")
        ]
        if busy:
            notes.append(
                f"another running session starts in this dir too: {', '.join(busy)}"
            )
    task, source, title = req.task.strip(), "", req.task.strip()
    ref = parse_issue_ref(task) if task else None
    if ref:
        issue = fetch_issue(workdir, ref)
        task, source, title = format_issue(issue), issue["url"], issue["title"]
    if mode.needs_task and not task:
        raise PrepError(f"{req.mode} needs a task")
    slug = make_slug(first_line(title, 60) if title else req.mode)
    # A copy of the setting: changing it later must not reshuffle a running session.
    scramble = bool(setting(cfg, "scramble"))
    db = connect(db_path(slug), "rwc")
    try:
        db.executescript(
            f"BEGIN; {SCHEMA} PRAGMA user_version = {SCHEMA_VERSION}; COMMIT;"
        )
        now = now_iso()
        db.execute(
            "INSERT INTO session (id, slug, mode, task, source, dir, base_commit, pre_existing,"
            " yolo, scramble, max_rounds, state, origin, created_at, updated_at)"
            " VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'running', ?, ?, ?)",
            (
                slug,
                req.mode,
                task,
                source,
                workdir,
                base,
                "\n".join(pre_existing),
                int(req.yolo),
                int(scramble),
                mode.max_rounds,
                session_origin(slug, now),
                now,
                now,
            ),
        )
        db.executemany(
            "INSERT INTO roster (key, tool, model, effort, listed) VALUES (?, ?, ?, ?, ?)",
            roster,
        )
        db.executemany(
            "INSERT INTO stage_agents (stage, key) VALUES (?, ?)", picks.items()
        )
        specs = {
            key: spec_text(tool, model, effort)
            for key, tool, model, effort, _ in roster
        }
        opening = f"Started {req.mode} in {short_home(workdir)}" + (
            f" at {base[:9]}" if base else ""
        )
        if source:
            opening += f" for {source}"
        opening += " with " + ", ".join(specs[r[0]] for r in roster if r[4])
        opening += ", in a random order for each stage" if scramble else ""
        opening += "".join(f"; {stage}: {specs[key]}" for stage, key in picks.items())
        level = effort_level(mode, req.effort)
        opening += f" (effort {level})" if level else ""
        for text in [opening + ".", *notes]:
            db.execute(
                "INSERT INTO events (at, kind, text) VALUES (?, 'note', ?)", (now, text)
            )
    finally:
        db.close()
    return slug, notes


def git_summary(workdir: str, base: str) -> str:
    _, diff, _ = git(workdir, "diff", "--stat", base)
    _, status, _ = git(workdir, "status", "--short")
    if not diff.strip() and not status.strip():
        return ""  # nothing changed in the start dir
    text = f"In {short_home(workdir)} since {base[:9]}:\n" + (
        diff.strip() or "no changes to tracked files"
    )
    return text + (f"\n\n{status.rstrip()}" if status.strip() else "")


# ----------------------------------------------------------- flow view and agent commands


@dataclass
class StepRecord:
    stage: str
    round: int
    track: int  # 1 to N on a team stage; 0: none
    key: str  # the agent's roster key, e.g. codex-2
    agent: str  # the agent's name, e.g. build2-codex-2
    status: str  # open, or the status its result ends with
    path: str  # the result file, which later agents read
    text: str


@dataclass
class Flow:
    """What a flow function sees: the session and its steps, oldest first. Pantheon
    asks the flow again while steps are open, so a flow returns only steps that are
    neither open nor done: it checks busy() and results()."""

    task: str
    dir: str
    base: str  # the commit the session started from, or "" outside git
    pre_existing: list[str]  # files with uncommitted changes when it started
    max_rounds: int
    keys: list[str]  # the agents from -a, in order
    done: list[StepRecord]
    open: list[StepRecord]  # with no result yet
    orders: dict[str, list[str]]  # each stage's agents, track by track

    @property
    def primary(self) -> str:
        return self.keys[0]

    def tracks(self) -> range:
        return range(1, len(self.keys) + 1)

    def results(self, stage: str, track: int | None = None) -> list[StepRecord]:
        return [r for r in self.done if r.stage == stage and track in (None, r.track)]

    def latest(self, stage: str) -> StepRecord | None:
        return next((r for r in reversed(self.done) if r.stage == stage), None)

    def last_in(self, track: int) -> StepRecord | None:
        """The track's newest result, of any stage."""
        return next((r for r in reversed(self.done) if r.track == track), None)

    def busy(self, stage: str | None = None, track: int | None = None) -> bool:
        """Whether an open step matches."""
        return any(
            stage in (None, r.stage) and track in (None, r.track) for r in self.open
        )

    def player(self, stage: str, track: int) -> str:
        """The key that plays a track of a stage."""
        return self.orders[stage][track - 1]

    def name(self, stage: str, track: int) -> str:
        return f"{stage}-{self.player(stage, track)}"


def result_lines(write: str, path: str, statuses) -> str:
    """The end of a prompt: where the result goes, and the line it ends with."""
    lines = "\n".join(f"PANTHEON: {s}" for s in statuses)
    key = "result" if len(statuses) == 1 else "results"
    return PROMPTS[key].format(write=write, path=path, lines=lines)


def agent_command(slug: str, command: str) -> list[str]:
    """A pantheon command as an agent runs it: pantheon's own python (the uv shebang
    fails in codex's sandbox) on this file, with the session file's path, since codex
    may drop PANTHEON_HOME from the agent's environment. The prompts, claude's rules,
    and gemini's policy all use this text."""
    path = os.path.realpath(db_path(slug))
    return [sys.executable, "-I", "-B", str(program_path()), command, path]


def room_command(slug: str) -> str:
    """What an agent runs to read the room."""
    return shlex.join(agent_command(slug, "room"))


def say_command(slug: str, agent: str) -> str:
    """What an agent runs to post to the room, with its name, since codex may drop
    PANTHEON_AGENT too."""
    return shlex.join([*agent_command(slug, "say"), "--from", agent])


STATUS_RE = re.compile(r"PANTHEON:\s*([A-Za-z][A-Za-z0-9-]*)", re.I)


def parse_status(text: str | None, name: str, allowed: list[str]) -> tuple[str, str]:
    """The status a result ends with, or the problem with it."""
    if text is None:
        return "", f"ended its turn without writing {name}"
    for line in reversed([line for line in text.splitlines() if line.strip()][-3:]):
        m = STATUS_RE.search(line)
        if m:
            status = m.group(1).lower()
            if status in allowed:
                return status, ""
            return (
                "",
                f"{name} ends with PANTHEON: {status}, not {' or '.join(allowed)}",
            )
    return "", f"{name} has no PANTHEON line at the end"


# -------------------------------------------------------------------------------- runtime


class Tmux:
    """The private tmux server of one session."""

    def __init__(self, path: str, name: str, conf: str, env: dict[str, str]):
        self.base = [path, "-L", name, "-f", conf]
        tmpdir = os.environ.get("TMUX_TMPDIR") or "/tmp"
        self.socket = Path(tmpdir) / f"tmux-{os.getuid()}" / name
        self.env = (
            env  # the server takes its environment from the command that starts it
        )

    async def run(
        self, *args: str, data: bytes | None = None, check: bool = True
    ) -> str:
        proc = await asyncio.create_subprocess_exec(
            *self.base,
            *args,
            stdin=asyncio.subprocess.PIPE
            if data is not None
            else asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
            env=self.env,
        )
        out, err = await proc.communicate(data)
        if check and proc.returncode:
            raise TmuxError(
                err.decode(errors="replace").strip() or f"tmux {args[0]} failed"
            )
        return out.decode(errors="replace")

    def run_sync(self, *args: str) -> str:
        return run_cmd([*self.base, *args], env=self.env)[1]


def pane(agent: str) -> str:
    # "=name" matches a session name exactly; the ":" then picks its current pane.
    return f"={agent}:"


def tmux_arg(arg: str) -> str:
    """arg as tmux must get it: tmux reads a ";" at the end of any argument as the end
    of its command, but reads "\\;" there as a ";"."""
    return arg[:-1] + "\\;" if arg.endswith(";") else arg


def tmux_conf(slug: str) -> Path:
    # Outside run/<slug>, which agents can write to.
    return RUN / f"{slug}.tmux.conf"


def private_files(slug: str) -> list[Path]:
    """The files a session keeps beside run/<slug>: its tmux conf, gemini's policy,
    and each ollama agent's claude settings."""
    settings = RUN.glob(glob.escape(slug) + ".*.claude-settings.json")
    return [tmux_conf(slug), gemini_policy(slug), *settings]


def tmux_name(slug: str) -> str:
    digest = hashlib.sha1(os.path.realpath(db_path(slug)).encode()).hexdigest()[:6]
    return f"pantheon-{slug}-{digest}"


def signal_group(pid: int, sig: int) -> bool:
    """Signal a pane's process group (gemini ignores hangups). False if it is gone."""
    try:
        os.killpg(pid, sig)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def stop_server_sync(slug: str) -> None:
    tmux = Tmux(tmux_path(), tmux_name(slug), os.devnull, clean_env())
    for path in private_files(slug):
        path.unlink(missing_ok=True)
    pids = [
        int(p)
        for p, _, dead in (
            line.partition("\t")
            for line in tmux.run_sync(
                "list-panes", "-a", "-F", "#{pane_pid}\t#{pane_dead}"
            ).splitlines()
        )
        if p.isdigit()
        and dead != "1"  # a dead pane's pid may belong to someone else now
    ]
    for pid in pids:
        signal_group(pid, signal.SIGTERM)
    deadline = time.time() + 3
    while time.time() < deadline and any(signal_group(p, 0) for p in pids):
        time.sleep(0.1)
    for pid in pids:
        signal_group(pid, signal.SIGKILL)
    tmux.run_sync("kill-server")
    tmux.socket.unlink(missing_ok=True)


@dataclass
class Outgoing:
    """A text pantheon will type into an agent."""

    text: str
    kind: str  # step (a step's prompt), remind, or post (a room post)
    step_id: int = 0  # for step and remind
    event_id: int = 0  # for post: its room event


@dataclass
class Paste:
    """A text pantheon pasted into an agent, until a turn it started is seen. Kept
    so that pantheon never pastes a text twice into one input box."""

    item: Outgoing  # the head of the outbox until Enter
    text: str  # what went in: item.text, cleaned for the tool
    before: str  # the screen before the paste
    at: float  # when pantheon pasted it
    missed: bool = False  # it did not show in time: a dialog may have taken it
    looked: bool = False  # you went into the agent since the paste
    shown: bool = False  # it showed in the input box while you were in
    entered: float = 0.0  # when pantheon pressed Enter
    again: bool = False  # pantheon pressed Enter a second time


# An idle agent's reason when it asked the room and ended its turn with no result: a
# post wakes it. Not "needs you", since another agent may answer.
ROOM_WAIT = "waiting for the room"

# The most posts from before an agent joined that its first prompt lists: the newest.
EARLIER_POSTS = 20


@dataclass
class AgentRun:
    id: int
    name: str
    role: str
    tool: str
    model: str
    effort: str
    native_id: str
    state: str
    reason: str
    launched: float = 0.0  # time.time() at launch, for the startup watchdog
    activity: float = 0.0  # tmux #{window_activity}
    title: str = ""
    typeable: bool = False  # it needs you, but pantheon may still type to it
    saw_work: bool = False  # gemini showed its working title since its last turn ended
    in_turn: bool = False  # from a prompt to its Stop: tool hooks count only then
    ran: tuple[str, str] = ("", "")  # the model and effort it reports, as last known
    last_message: str = ""
    # What to type once the agent is idle, oldest first. A reopen rebuilds it from the
    # file, in room order: the unsent step, and the posts after heard.
    outbox: list[Outgoing] = field(default_factory=list)
    pasting: Paste | None = None
    heard: int = 0  # the room id of the last post typed into it
    posted: bool = False  # it posted to the room since pantheon typed it a step
    answering: bool = False  # its turn is for a room post: any answer goes in the room
    hooked: bool = False  # a hook came from it: claude sends none until its dialogs end
    waiting_since: float = 0.0
    waiting_noted: bool = False
    stage: str = ""  # the stage it plays
    key: str = ""  # its roster key


def describe_tool(ev: dict) -> str:
    name = ev.get("tool_name") or "a tool"
    ti = ev.get("tool_input")
    if isinstance(ti, dict):
        for k in ("command", "file_path", "path", "url", "pattern"):
            if isinstance(ti.get(k), str):
                return f"{name}({shorten(ti[k], 80)})"
    return name


def describe_question(ev: dict) -> str:
    if ev.get("tool_name") == "ExitPlanMode":
        return "plan approval"
    ti = ev.get("tool_input") or {}
    questions = ti.get("questions") if isinstance(ti, dict) else None
    if questions and isinstance(questions[0], dict):
        return "question: " + shorten(str(questions[0].get("question", "")), 100)
    return "a question"


def compact_hook(ev: dict) -> dict:
    keep = (
        "session_id",
        "tool_name",
        "notification_type",
        "message",
        "error",
        "source",
        "model",
        "to_model",
        "effort",
        "agent_id",
    )
    out = {k: ev[k] for k in keep if k in ev}
    if isinstance(ev.get("last_assistant_message"), str):
        out["last_assistant_message"] = ev["last_assistant_message"][:4000]
    if "tool_input" in ev:
        out["tool_input"] = shorten(json.dumps(ev["tool_input"]), 300)
    return out


class Session:
    """One open session: its record, its tmux server, and its agents."""

    def __init__(self, slug: str, cfg: dict, term_size: Callable[[], tuple[int, int]]):
        self.slug, self.cfg, self.term_size = slug, cfg, term_size
        self.db = connect(db_path(slug))
        try:
            row = self.check_file()
            # A session file from another install opens read-only: its start dir, yolo
            # flag, and prompts come from whoever wrote it.
            origin = session_origin(row["slug"], row["created_at"])
            self.foreign = not hmac.compare_digest(row["origin"], origin)
            if not self.foreign:
                take_lock(self.db, slug)
        except BaseException:
            self.db.close()
            raise
        self.mode_name, self.mode = row["mode"], MODES[row["mode"]]
        self.task, self.workdir, self.base = row["task"], row["dir"], row["base_commit"]
        self.pre_existing = [line for line in row["pre_existing"].splitlines() if line]
        self.yolo, self.max_rounds = bool(row["yolo"]), row["max_rounds"]
        self.scramble = bool(row["scramble"])
        self.state = row["state"]
        self.roster = {
            r["key"]: r for r in self.db.execute("SELECT * FROM roster ORDER BY id")
        }
        self.keys = [k for k, r in self.roster.items() if r["listed"]]  # -a's, in order
        self.picks = {
            r["stage"]: r["key"] for r in self.db.execute("SELECT * FROM stage_agents")
        }
        self.agents = {
            r["name"]: AgentRun(
                r["id"],
                r["name"],
                r["role"],
                r["tool"],
                r["model"],
                r["effort"],
                r["native_id"],
                r["state"],
                r["reason"],
                heard=r["heard"],
                posted=bool(r["posted"]),
                answering=bool(r["answering"]),
                stage=r["stage"],
                key=r["key"],
            )
            for r in self.db.execute("SELECT * FROM agents ORDER BY id")
        }
        for a in self.agents.values():
            self.restore(a)
        conf = tmux_conf(slug)
        if not self.foreign:
            private_dir(scratch_dir(slug))
            private_dir(scratch_dir(slug) / "posts")
            write_private(conf, TMUX_CONF)
        self.scratch = os.path.realpath(scratch_dir(slug))
        if not self.foreign:
            self.materialize()
        self.tmux = Tmux(tmux_path(), tmux_name(slug), str(conf), clean_env())
        self.closed = False
        self.driving = not self.foreign  # false too once another pantheon takes over
        self.stopping = False  # stop_agents is tearing the agents down
        self.launch_failed: set[str] = set()  # retried when the session is reopened
        self.replaced: list[AgentRun] = []  # instances a new one took over from
        self.checked_server = False
        self.attached = ""  # the agent you are transported into
        self.attach_token: object = None  # the transport() call that set attached
        self.last_poll = self.last_beat = 0.0
        self.errors = 0

    def check_file(self):
        """Read the session row, and refuse a file this pantheon could not have written."""
        version = self.db.execute("PRAGMA user_version").fetchone()[0]
        if version != SCHEMA_VERSION:
            raise ValueError(
                f"{self.slug} has schema version {version}; this pantheon reads {SCHEMA_VERSION}"
            )
        row = self.db.execute("SELECT * FROM session").fetchone()
        if row is None or row["mode"] not in MODES:
            raise ValueError(f"{self.slug} has no mode this pantheon knows")
        stages = MODES[row["mode"]].stages
        keys = set()
        for r in self.db.execute("SELECT key, tool, listed FROM roster ORDER BY id"):
            if not WORD_RE.fullmatch(r["key"]) or r["tool"] not in TOOLS:
                raise ValueError(f"{self.slug} has a bad agent key: {r['key']!r}")
            keys.add(r["key"])
        if not self.db.execute("SELECT 1 FROM roster WHERE listed = 1").fetchone():
            raise ValueError(f"{self.slug} has no agents")
        for r in self.db.execute("SELECT stage, key FROM stage_agents"):
            if r["stage"] not in stages or r["key"] not in keys:
                raise ValueError(f"{self.slug} has a bad --agent: {r['stage']!r}")
        for r in self.db.execute("SELECT name, tool, stage, key FROM agents"):
            ok = NAME_RE.fullmatch(r["name"]) and r["tool"] in TOOLS
            if not ok or r["stage"] not in stages or r["key"] not in keys:
                raise ValueError(f"{self.slug} has a bad agent: {r['name']!r}")
        for r in self.db.execute("SELECT name, stage FROM steps"):
            if r["stage"] not in stages:  # the mode changed since: its flow would break
                raise ValueError(
                    f"{self.slug} has a stage this pantheon lacks: {r['stage']!r}"
                )
            if r["name"] and not STEP_NAME_RE.fullmatch(r["name"]):  # it becomes a path
                raise ValueError(f"{self.slug} has a bad step name: {r['name']!r}")
        return row

    def restore(self, a: AgentRun) -> None:
        """Rebuild what pantheon keeps in memory for an agent, after a reopen."""
        if a.state == "starting":
            a.launched = time.time()  # so the startup watchdog still fires
        if a.tool == "gemini" and a.state in ("working", "needs_you"):
            a.saw_work = (
                True  # its next ◇ title ends the turn, even one ended while closed
            )
        if a.state == "needs_you":
            row = self.db.execute(
                "SELECT data FROM events WHERE agent_id = ? AND kind = 'needs'"
                " ORDER BY id DESC LIMIT 1",
                (a.id,),
            ).fetchone()
            data = json.loads(row["data"]) if row else {}
            a.typeable = bool(data.get("typeable") or data.get("remind"))
        row = self.db.execute(
            "SELECT data FROM events WHERE agent_id = ? AND kind = 'ran'"
            " ORDER BY id DESC LIMIT 1",
            (a.id,),
        ).fetchone()
        if row:  # so a reopen does not name the model again
            data = json.loads(row["data"])
            a.ran = (data.get("model", ""), data.get("effort", ""))
        a.hooked = (
            self.db.execute(
                "SELECT 1 FROM events WHERE agent_id = ? AND kind = 'hook' LIMIT 1",
                (a.id,),
            ).fetchone()
            is not None
        )
        # The file keeps no turn. A wait pantheon may type through, or a StopFailure's,
        # comes after one.
        a.in_turn = a.state == "working" or (
            a.state == "needs_you"
            and not a.typeable
            and not a.reason.startswith("error: ")
        )
        if a.state in ("new", "exited"):
            return
        # What was not typed into it yet, in room order: each post after heard but its
        # own, and its step (unless the session stopped) ahead of the posts made after
        # its prompt. Launch sets heard to the newest post, so a first prompt (its role,
        # the task, and the room) goes before every post.
        rows = self.db.execute(
            "SELECT id, text, data FROM events WHERE kind = 'say' AND id > ?"
            " AND agent_id IS NOT ? ORDER BY id",
            (a.heard, a.id),
        )
        for r in rows:
            sender = json.loads(r["data"]).get("from", "you")
            a.outbox.append(self.post_item(a, r["id"], sender, r["text"]))
        step = self.db.execute(
            "SELECT id, brief FROM steps WHERE agent_id = ? AND status = 'open'"
            " AND sent = 0",
            (a.id,),
        ).fetchone()
        if step is None or self.state not in ("running", "needs_you", "waiting"):
            return
        prompt = self.db.execute(
            "SELECT id FROM events WHERE kind = 'prompt' AND agent_id = ?"
            " AND json_extract(data, '$.step') = ?",
            (a.id, step["id"]),
        ).fetchone()
        at = prompt["id"] if prompt else 0
        i = sum(o.event_id < at for o in a.outbox)  # the posts made before it
        a.outbox.insert(i, Outgoing(step["brief"], "step", step["id"]))

    # -- records

    def event(
        self,
        kind: str,
        text: str,
        agent: AgentRun | None = None,
        data: dict | None = None,
    ) -> int:
        cur = self.db.execute(
            "INSERT INTO events (at, agent_id, kind, text, data) VALUES (?, ?, ?, ?, ?)",
            (
                now_iso(),
                agent.id if agent else None,
                kind,
                text,
                json.dumps(data or {}),
            ),
        )
        return cur.lastrowid  # its room id

    def save_agent(self, a: AgentRun, **fields) -> None:
        for k, v in fields.items():
            setattr(a, k, v)
        sets = ", ".join(f"{k} = ?" for k in fields)
        self.db.execute(
            f"UPDATE agents SET {sets} WHERE id = ?", (*fields.values(), a.id)
        )

    def set_session_state(self, state: str) -> None:
        if state != self.state:
            self.state = state
            self.db.execute(
                "UPDATE session SET state = ?, updated_at = ?", (state, now_iso())
            )

    def refresh_session_state(self) -> None:
        if self.state not in ("running", "needs_you"):
            return
        needs = any(a.state == "needs_you" for a in self.agents.values())
        self.set_session_state("needs_you" if needs else "running")

    def set_state(self, a: AgentRun, state: str, reason: str = "") -> None:
        if a.state == state and a.reason == reason:
            return
        self.save_agent(a, state=state, reason=reason)
        if state != "needs_you":
            a.typeable = False
        self.refresh_session_state()

    def needs_you(
        self, a: AgentRun, reason: str, remind: bool = False, typeable: bool = False
    ) -> None:
        if a.state == "needs_you" and a.reason == reason:
            return
        self.set_state(a, "needs_you", reason)
        a.typeable = remind or typeable
        self.event("needs", reason, a, {"remind": remind, "typeable": a.typeable})

    def agent_by_id(self, agent_id: int | None) -> AgentRun | None:
        return next((a for a in self.agents.values() if a.id == agent_id), None)

    def step(self, step_id: int):
        return self.db.execute(
            "SELECT * FROM steps WHERE id = ?", (step_id,)
        ).fetchone()

    def open_step(self, a: AgentRun | None = None, sent_only: bool = False):
        sql, args = "SELECT * FROM steps WHERE status = 'open'", []
        if a is not None:
            sql, args = sql + " AND agent_id = ?", [a.id]
        if sent_only:  # a step still waiting in the outbox is not the agent's yet
            sql += " AND sent = 1"
        return self.db.execute(sql + " ORDER BY id DESC", args).fetchone()

    def result_path(self, step) -> str:
        return os.path.join(self.scratch, step["name"])

    def result_of(self, step) -> tuple[str, str, str | None]:
        """The step's status, the problem with its result file, and the file's text."""
        path = self.result_path(step)
        text = read_text(path) if os.path.exists(path) else None
        status, problem = parse_status(text, step["name"], step["statuses"].split())
        return status, problem, text

    def materialize(self) -> None:
        """Write the results agents read, when the scratch dir lacks them."""
        for step in self.db.execute("SELECT * FROM steps WHERE result != ''"):
            path = self.result_path(step)
            if step["name"] and not os.path.lexists(path):
                write_private(Path(path), step["result"])

    def step_label(self) -> tuple[AgentRun | None, str]:
        """The agent and step under way; for a batch, no agent and its progress; for
        steps of different stages or rounds, how many are open."""
        rows = self.db.execute(
            "SELECT * FROM steps WHERE status = 'open' ORDER BY id"
        ).fetchall()
        if not rows:
            return None, ""
        step = rows[0]
        if any(
            (r["stage"], r["round"]) != (step["stage"], step["round"]) for r in rows
        ):
            return None, f"{len(rows)} steps open"
        label = step["stage"] + (f" round {step['round']}" if step["round"] else "")
        total = self.db.execute(
            "SELECT COUNT(*) FROM steps WHERE stage = ? AND round = ?",
            (step["stage"], step["round"]),
        ).fetchone()[0]
        if total > 1:
            label += f" ({total - len(rows)} of {total} done)"
        return (self.agent_by_id(step["agent_id"]) if len(rows) == 1 else None), label

    def live_agents(self) -> list[AgentRun]:
        return [a for a in self.agents.values() if a.state not in ("new", "exited")]

    def asks(self) -> int:
        """How much waits on you: agents that need you, or that wait for an answer in
        the room, and a result that waits for your OK."""
        agents = self.agents.values()
        n = sum(a.state == "needs_you" or a.reason == ROOM_WAIT for a in agents)
        return n + (self.state == "waiting")

    # -- the loop

    async def run(self) -> None:
        while not self.closed and self.driving:
            try:
                await self.tick()
                self.errors = 0
            except Exception as e:  # keep the session going, and show what broke
                self.errors += 1
                if self.errors <= 3 and not self.closed:
                    try:  # the traceback goes in the session file, with the rest
                        self.event(
                            "error",
                            f"pantheon: {type(e).__name__}: {e}",
                            data={"traceback": traceback.format_exc()},
                        )
                    except sqlite3.Error:
                        pass
            await asyncio.sleep(0.25)

    async def tick(self) -> None:
        if self.stopping:
            return
        now = time.time()
        if now - self.last_beat >= 5:
            self.last_beat = now
            self.heartbeat(now)
            if not self.driving:
                return
        if not self.checked_server:
            # Turns that ended while pantheon was closed count before any exit does.
            while self.db.execute("SELECT 1 FROM hooks LIMIT 1").fetchone():
                self.read_hooks()
            await self.check_server()
        self.read_posts()  # first: an agent posts before its turn ends
        self.read_hooks()
        if now - self.last_poll >= 0.5:
            self.last_poll = now
            await self.poll_panes()
        self.watchdogs(now)
        await self.send_pending(now)
        await self.advance()

    def heartbeat(self, now: float) -> None:
        cur = self.db.execute(
            "UPDATE lock SET heartbeat = ?, host = ? WHERE id = 1 AND pid = ?",
            (now, socket.gethostname(), os.getpid()),
        )
        if cur.rowcount:
            return
        try:  # another pantheon took the lock while this one stalled
            take_lock(self.db, self.slug)
        except Locked as e:
            self.driving = False
            self.event("error", f"{e}, so this window stopped driving the session.")

    async def check_server(self) -> None:
        self.checked_server = True
        live = self.live_agents()
        if not live or await self.server_alive():
            return
        self.event("note", "The agents' tmux server is gone, and the agents with it.")
        for a in live:
            self.exited(a, "")

    async def server_alive(self) -> bool:
        try:
            await self.tmux.run("list-sessions")
        except TmuxError:
            return False
        return True

    # -- signals

    def read_hooks(self) -> None:
        rows = self.db.execute(
            "SELECT id, agent, payload FROM hooks ORDER BY id LIMIT 500"
        ).fetchall()
        if not rows:
            return
        self.db.execute("DELETE FROM hooks WHERE id <= ?", (rows[-1]["id"],))
        for row in rows:
            a = self.agents.get(row["agent"])
            try:
                ev = json.loads(row["payload"])
            except ValueError:
                continue
            if a is not None and isinstance(ev, dict):
                self.on_hook(a, ev)

    def on_hook(self, a: AgentRun, ev: dict) -> None:
        name = ev.get("hook_event_name", "")
        self.event("hook", name, a, compact_hook(ev))
        a.hooked = True
        if a.state == "exited":
            return
        # A subagent's hooks, or those of a thread of the tool's own (codex's memories),
        # have no transcript of the agent's: they name another model and effort.
        if not ev.get("agent_id") and ev.get("transcript_path"):
            self.hook_ran(a, name, ev)
        if name == "SessionStart":
            if a.tool == "codex" and ev.get("session_id") and not a.native_id:
                self.save_agent(a, native_id=ev["session_id"])
        elif name == "UserPromptSubmit":
            a.in_turn = True
            self.set_state(a, "working")
            self.turn_started(a, str(ev.get("prompt", "")))
        elif name in ("PostToolBatch", "PostToolUse"):
            # Claude can send one after its Stop; it must not undo the turn's end.
            if a.in_turn:
                self.set_state(a, "working")
        elif name == "PermissionRequest":
            self.needs_you(a, "permission: " + describe_tool(ev))
        elif name == "PreToolUse":  # AskUserQuestion or ExitPlanMode
            self.needs_you(a, describe_question(ev))
        elif name == "Notification":
            # Claude also says this after Esc ends a turn, which fires no Stop.
            if (
                a.state == "working"
                and ev.get("notification_type") in CLAUDE_NEEDS_NOTICES
            ):
                self.needs_you(a, ev.get("message") or "waiting for you")
        elif name == "Stop":
            a.last_message = ev.get("last_assistant_message") or ""
            # Claude may leave a background task (a dev server) running for good, so
            # wait for it only while the step's result is not ready.
            step = self.open_step(a, sent_only=True)
            if ev.get("background_tasks") and (
                step is None or not self.result_of(step)[0]
            ):
                return
            a.in_turn = False
            self.turn_ended(a)
        elif name == "StopFailure":
            a.in_turn = False
            self.needs_you(a, f"error: {ev.get('error', 'unknown')}")

    def hook_ran(self, a: AgentRun, name: str, ev: dict) -> None:
        """The model and effort an agent really runs, from one of its own hooks. Every
        codex hook names its model; claude names it at SessionStart and PostModelSwitch,
        and its effort in its tool hooks and at Stop."""
        model = ev.get("to_model" if name == "PostModelSwitch" else "model")
        if name == "SessionStart" and ev.get("source") == "compact":
            model = None  # a subagent's compaction sends its model, with no agent_id
        effort = ev.get("effort")
        level = effort.get("level") if isinstance(effort, dict) else None
        if level == "high" and claude_sends_no_effort(a, self.workdir):
            level = None
        self.note_ran(a, model, level)

    def note_ran(self, a: AgentRun, model=None, effort=None) -> None:
        """Name in the room the model and effort an agent really runs: once each is
        known, unless it is what pantheon asked for, and again each time it changes."""
        old_model, old_effort = a.ran
        if isinstance(model, str) and model:
            a.ran = (model, a.ran[1])
        if isinstance(effort, str) and effort:
            a.ran = (a.ran[0], effort)
        new_model, new_effort = a.ran
        data = {"model": new_model, "effort": new_effort}
        if new_model != old_model and (old_model or new_model != a.model):
            text = ("now runs " if old_model else "runs ") + new_model
            self.event("ran", text, a, data)
        if new_effort != old_effort and (old_effort or new_effort != a.effort):
            text = ("now runs" if old_effort else "runs") + f" at effort {new_effort}"
            self.event("ran", text, a, data)

    def on_title(self, a: AgentRun, title: str) -> None:
        glyph = title.strip()[:1]
        if glyph in GEMINI_WORKING:
            a.saw_work = True
            self.set_state(a, "working")
            self.turn_started(a, "")
        elif glyph == "✋":
            a.saw_work = True
            self.turn_started(a, "")
            self.needs_you(a, "action required")
        elif glyph == "◇" and a.saw_work:  # gemini shows ◇ at startup too
            a.saw_work = False
            self.note_ran(a, gemini_model(a.native_id))  # before the step's result
            self.turn_ended(a)

    def turn_started(self, a: AgentRun, prompt: str) -> None:
        """A turn started, so a paste that this turn took is done. A turn that
        pantheon's Enter did not start is yours, by transport, and you may have entered
        a text pantheon pasted, even before a reopen. Claude's and codex's hooks give
        the prompt, which then has the text's first line (it names the step or the
        post). Gemini's give none, so its turn counts as your Enter only if the paste
        showed in its input box while you were in. Another turn (one you queued, or a
        background task's) leaves the paste in the box, for check_paste to enter."""
        p, a.pasting = a.pasting, None
        if p is not None and p.entered:
            return
        if prompt:  # claude and codex
            # Its reply is for you, unless you entered a post.
            self.save_agent(a, answering=False)
            item = next(
                (
                    o
                    for o in a.outbox
                    if clean_instructions(o.text, a.tool).split("\n", 1)[0] in prompt
                ),
                None,
            )
        else:  # gemini
            item = p.item if p is not None and p.shown else None
        if item is not None:
            a.outbox = [o for o in a.outbox if o is not item]
            self.delivered(a, item)
        if p is not None and item is not p.item:
            a.pasting = p  # it waits in the box until the agent is idle again

    def turn_ended(self, a: AgentRun) -> None:
        answering = a.answering
        self.save_agent(a, answering=False)
        step = self.open_step(a, sent_only=True)
        if step is None:  # a turn that a room post, or you by transport, started
            self.set_state(a, "idle")
            # An answer to a post goes in the room by say; a reply to you, here.
            if a.last_message and not answering:
                self.event("note", "replied:\n" + a.last_message.strip(), a)
            return
        status, problem, text = self.result_of(step)
        if problem:
            self.read_posts()  # a post from this turn may wait in posts/ still
            # Only an agent with no result may wait for an answer: a result with a
            # wrong or missing PANTHEON line means it thinks it is done.
            if text is not None or not a.posted:
                self.needs_you(a, problem, remind=True)
                return
            # It asked the room, and the post that answers wakes it. Not "needs you",
            # since another agent may answer, so no Remind.
            if a.reason != ROOM_WAIT:
                self.event("note", "waits for an answer in the room", a)
            self.set_state(a, "idle", ROOM_WAIT)
            return
        gate = int(step["stage"] in self.mode.approve)
        self.db.execute(
            "UPDATE steps SET status = ?, result = ?, gate = ?, ended_at = ? WHERE id = ?",
            (status, text, gate, now_iso(), step["id"]),
        )
        a.outbox = [o for o in a.outbox if o.kind != "remind"]  # stale reminders
        self.set_state(a, "idle")
        self.event("result", step["name"], a, {"step": step["id"], "status": status})
        if gate:  # advance() waits for your OK before it asks the flow again
            self.event(
                "approve", f"{step['name']} waits for your OK.", a, {"step": step["id"]}
            )

    async def poll_panes(self) -> None:
        if not self.live_agents():
            return
        fmt = "#{session_name}\t#{pane_dead}\t#{pane_dead_status}\t#{window_activity}\t#{pane_title}"
        try:
            out = await self.tmux.run("list-panes", "-a", "-F", fmt)
        except TmuxError:
            for a in self.live_agents():
                self.exited(a, "")
            return
        for line in out.splitlines():
            name, dead, status, activity, title = (line.split("\t", 4) + [""] * 5)[:5]
            a = self.agents.get(name)
            if a is None or a.state in ("new", "exited"):
                continue
            a.activity = float(activity) if activity.isdigit() else a.activity
            if dead == "1":
                # Keep its last words: a CLI that rejects a flag says why, then exits.
                screen = await self.tmux.run(
                    "capture-pane",
                    "-p",
                    "-J",
                    "-S",
                    "-40",
                    "-t",
                    pane(name),
                    check=False,
                )
                self.exited(a, status, last_lines(screen))
                continue
            if a.tool == "gemini" and title != a.title:
                self.on_title(a, title)
            a.title = title

    def exited(self, a: AgentRun, status: str, tail: str = "") -> None:
        if self.stopping:  # stop_agents is ending it on purpose
            return
        step = self.open_step(a, sent_only=True)
        if step is not None and self.result_of(step)[0]:
            if a.tool == "gemini":  # it exited before its ◇ title could end the turn
                self.note_ran(a, gemini_model(a.native_id))
            self.turn_ended(a)  # it wrote its result first (gemini has no hooks)
        self.save_agent(a, state="exited", reason="")
        note = "exited" + (f" with status {status}" if status else "")
        self.event("note", note + (f":\n{tail}" if tail else ""), a)
        # A gate's wait counts too: the other tracks' steps go on while it waits.
        going = self.state in ("running", "needs_you", "waiting")
        if self.open_step(a) is not None and going:
            self.set_session_state("stopped")
            self.event(
                "error", f"{a.name} exited during its step, so the session stopped."
            )
        self.refresh_session_state()

    def watchdogs(self, now: float) -> None:
        for a in self.agents.values():
            if (
                a.state == "starting"
                and a.launched
                and now - a.launched > STARTUP_TIMEOUT
            ):
                # A first prompt that waits in the outbox still goes once its input
                # box shows.
                queued = any(o.kind == "step" for o in a.outbox)
                self.needs_you(
                    a,
                    "no response since it started; a startup dialog may be waiting",
                    typeable=queued,
                )
            elif (
                a.state == "working"
                and a.tool in ("codex", "gemini")
                and a.activity
                and now - a.activity > QUIET_TIMEOUT
            ):
                self.needs_you(
                    a, "no output for a minute; it may be stuck, or its turn failed"
                )

    # -- the room

    def read_posts(self) -> None:
        """Post what pantheon say left in posts/, oldest first. Agents write files, not
        the session file, since codex's sandbox cannot write that."""
        folder = os.path.join(self.scratch, "posts")
        try:
            st = os.lstat(folder)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
                return  # an agent put something else there
            names = sorted(n for n in os.listdir(folder) if n.endswith(".json"))
        except OSError:
            return
        for name in names:
            path = os.path.join(folder, name)
            raw = b""
            try:  # never follow a link, nor wait on a pipe, that an agent put here
                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd, "rb") as f:
                    if stat.S_ISREG(os.fstat(f.fileno()).st_mode):
                        raw = f.read(1_000_000)
            except OSError:
                pass
            try:
                os.unlink(path)
            except OSError:
                continue  # a post that stays would go out on every tick
            try:
                post = json.loads(raw)
                sender, text = str(post["from"]), post["text"].strip()
                # A lone surrogate (bad UTF-8 given to say) cannot go in the session file.
                text = text.encode("utf-8", "replace").decode()
            except (ValueError, TypeError, KeyError, AttributeError):
                sender, text = "", ""
            if not text:
                self.event("error", f"could not read the room post {name}")
                continue
            self.post(sender if NAME_RE.fullmatch(sender) else "someone", text)

    def post(self, sender: str, text: str) -> None:
        """Put a post in the room, and give it to every other agent that runs, which
        decides whether it needs to act. sender: an agent's name, or you."""
        a = self.agents.get(sender)
        event_id = self.event("say", text, a, {"from": sender})
        if a is not None:
            self.save_agent(a, posted=True)
        others = [b for b in self.live_agents() if b is not a]
        for b in others:
            b.outbox.append(self.post_item(b, event_id, sender, text))
        if not others:
            self.event("note", "No other agent runs now, so none got this post.")

    def post_item(self, a: AgentRun, event_id: int, sender: str, text: str) -> Outgoing:
        """Room post event_id as pantheon types it into agent a."""
        author = PROMPTS["user"] if sender == "you" else sender
        message = PROMPTS["post"].format(
            id=event_id, sender=author, text=text, commands=self.commands(a)
        )
        return Outgoing(message, "post", event_id=event_id)

    # -- driving the agents

    async def advance(self) -> None:
        if self.state not in ("running", "needs_you"):
            return
        unsent = self.db.execute(
            "SELECT * FROM steps WHERE status = 'open' AND sent = 0 ORDER BY id"
        ).fetchall()
        for step in unsent:
            if self.state in ("running", "needs_you"):
                await self.dispatch(step)
        # Gates stay global: a result that waits for your OK holds every track.
        if self.db.execute(
            "SELECT 1 FROM steps WHERE gate = 1 AND approved = 0"
        ).fetchone():
            self.set_session_state("waiting")
            return
        if self.state not in ("running", "needs_you"):  # a dispatch stopped it
            return
        # Asked on each tick, so each track goes on as soon as its last step is done.
        nxt = self.mode.flow(self.flow_view())
        if isinstance(nxt, Finish):
            if self.open_step() is None:  # the steps under way end first
                await self.finish(nxt)
            return
        for step in nxt:
            for row in self.create_steps(step):
                if self.state in ("running", "needs_you"):
                    await self.dispatch(row)
        while self.replaced:
            await self.retire(self.replaced.pop())

    async def retire(self, a: AgentRun) -> None:
        """Stop an instance a new one replaced."""
        if a.name == self.attached:  # you went in after agent_for picked it
            return
        self.save_agent(a, state="exited", reason="")  # first, so its end is not news
        out = await self.tmux.run(
            "display-message", "-p", "-t", pane(a.name), "#{pane_pid}", check=False
        )
        if out.strip().isdigit():
            signal_group(int(out.strip()), signal.SIGTERM)
        await self.tmux.run("kill-session", "-t", f"={a.name}", check=False)
        self.event("note", "stopped: a new instance took over", a)

    def flow_view(self) -> Flow:
        # A result that waits for your OK is neither open nor done, so it is left out.
        # Asked on each tick, so only what a StepRecord holds: no prompts.
        rows = self.db.execute(
            "SELECT s.stage, s.round, s.track, s.status, s.name, s.result,"
            " a.name AS agent_name, a.key AS agent_key FROM steps s"
            " JOIN agents a ON a.id = s.agent_id"
            " WHERE s.gate = 0 OR s.approved = 1 ORDER BY s.id"
        )
        records = [
            StepRecord(
                r["stage"],
                r["round"],
                r["track"],
                r["agent_key"],
                r["agent_name"],
                r["status"],
                self.result_path(r),
                r["result"],
            )
            for r in rows
        ]
        return Flow(
            self.task,
            self.workdir,
            self.base,
            self.pre_existing,
            self.max_rounds,
            self.keys,
            [r for r in records if r.status != "open"],
            [r for r in records if r.status == "open"],
            {stage: self.order(stage) for stage in self.mode.stages},
        )

    def order(self, stage: str) -> list[str]:
        """A stage's agents, track by track: -a's order, or with scramble, an order of
        the stage's own. It comes from a hash, so it is the same each time the session
        opens, in any Python."""
        if not self.scramble:
            return list(self.keys)
        return sorted(
            self.keys,
            key=lambda k: hashlib.sha256(f"{self.slug}:{stage}:{k}".encode()).digest(),
        )

    def step_keys(self, step: Step) -> list[tuple[str, int]]:
        """Who does a step, on which track: --agent's pick, else the flow's, else the
        stage's own. A team stage's step with no track goes to every track."""
        if step.stage in self.picks:
            return [(self.picks[step.stage], step.track)]
        if step.agent:
            if step.agent not in self.roster:
                raise ValueError(
                    f"the flow asked for an agent this session lacks: {step.agent}"
                )
            return [(step.agent, step.track)]
        order = self.order(step.stage)
        if not 0 <= step.track <= len(order):
            raise ValueError(
                f"the flow asked for a track this session lacks: {step.track}"
            )
        if not self.mode.stages[step.stage].team:
            return [(order[0], step.track)]
        if step.track:
            return [(order[step.track - 1], step.track)]
        return [(key, track) for track, key in enumerate(order, 1)]

    def agent_for(self, stage: str, key: str) -> AgentRun:
        """The agent to play stage for key: the last one if the stage reuses, else new."""
        st = self.mode.stages[stage]
        mine = [a for a in self.agents.values() if a.stage == stage and a.key == key]
        if mine and st.reuse and mine[-1].state != "exited":
            return mine[-1]
        if mine and mine[-1].state == "idle" and mine[-1].name != self.attached:
            self.replaced.append(mine[-1])
        n = len(mine) + 1
        name = f"{stage}{n if n > 1 else ''}-{key}"
        r = self.roster[key]
        cur = self.db.execute(
            "INSERT INTO agents (name, stage, key, role, tool, model, effort, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            (name, stage, key, st.role, r["tool"], r["model"], r["effort"], now_iso()),
        )
        a = AgentRun(
            cur.lastrowid,
            name,
            st.role,
            r["tool"],
            r["model"],
            r["effort"],
            "",
            "new",
            "",
            stage=stage,
            key=key,
        )
        self.agents[name] = a
        return a

    def create_steps(self, step: Step) -> list:
        """One step for each agent that does it. Each gets its prompt, which goes in
        the room too."""
        st = self.mode.stages[step.stage]
        statuses = step.statuses or st.statuses
        rows = []
        for key, track in self.step_keys(step):
            a = self.agent_for(step.stage, key)
            first = not self.db.execute(
                "SELECT 1 FROM steps WHERE agent_id = ?", (a.id,)
            ).fetchone()
            cur = self.db.execute(
                "INSERT INTO steps (agent_id, stage, round, track, statuses, started_at)"
                " VALUES (?, ?, ?, ?, ?, ?)",
                (a.id, step.stage, step.round, track, " ".join(statuses), now_iso()),
            )
            step_id = cur.lastrowid
            rnd = f"-{step.round}" if step.round else ""
            name = f"{step_id:02d}-{step.stage}{rnd}-{key}.md"
            parts = [PROMPTS["header"].format(step=step_id, agent=a.name)]
            if first:  # an agent keeps its context, so these go once
                parts += self.intro(a)
            parts.append(step.body)
            if not first:
                parts.append(self.commands(a))
            path = os.path.join(self.scratch, name)
            parts.append(result_lines(st.write, path, statuses))
            parts.append(PROMPTS["step_end"].format(step=step_id))
            prompt = "\n\n".join(p for p in parts if p) + "\n"
            self.db.execute(
                "UPDATE steps SET name = ?, brief = ? WHERE id = ?",
                (name, prompt, step_id),
            )
            self.event("prompt", prompt, a, {"step": step_id})
            rows.append(self.step(step_id))
        return rows

    def intro(self, a: AgentRun) -> list[str]:
        """What an agent's first prompt starts with: its role, the task, the room, and
        the posts made before it joined, since it gets only the later ones."""
        parts = [PROMPTS["intro"].format(role=ROLES[a.role], dir=self.workdir)]
        if self.task:
            parts.append(PROMPTS["task"].format(task=self.task))
        room, say = room_command(self.slug), say_command(self.slug, a.name)
        parts.append(PROMPTS["room"].format(room=room, say=say))
        rows = self.db.execute(
            "SELECT text, data FROM events WHERE kind = 'say' ORDER BY id"
        ).fetchall()
        if not rows:
            return parts
        lines = []
        older = len(rows) - EARLIER_POSTS
        if older > 0:
            s = "" if older == 1 else "s"
            lines.append(PROMPTS["earlier_cut"].format(n=older, s=s))
        for r in rows[-EARLIER_POSTS:]:
            sender = json.loads(r["data"]).get("from", "you")
            author = PROMPTS["user"] if sender == "you" else sender
            text = "\n  ".join(r["text"].strip().splitlines())
            lines.append(PROMPTS["earlier_line"].format(sender=author, text=text))
        parts.append(PROMPTS["earlier"].format(posts="\n".join(lines)))
        return parts

    def commands(self, a: AgentRun) -> str:
        room, say = room_command(self.slug), say_command(self.slug, a.name)
        return PROMPTS["commands"].format(room=room, say=say)

    async def dispatch(self, step) -> None:
        a = self.agent_by_id(step["agent_id"])
        if a is None or a.state == "exited":
            self.set_session_state("stopped")
            self.event(
                "error", "The agent for the next step is gone, so the session stopped."
            )
            return
        if any(o.kind == "step" and o.step_id == step["id"] for o in a.outbox):
            return  # it waits to be typed
        item = Outgoing(step["brief"], "step", step["id"])
        if a.state != "new":
            a.outbox.append(item)
        elif a.name not in self.launch_failed:
            await self.launch(a, item)

    async def launch(self, a: AgentRun, first: Outgoing) -> bool:
        """Start an agent. Its first prompt goes in its command line when the whole tmux
        command fits; else it waits in the outbox until the agent shows its input box."""
        try:
            if a.tool != "codex" and not a.native_id:  # codex's hook reports its own
                self.save_agent(a, native_id=str(uuid.uuid4()))
            argv, env = LAUNCHERS[a.tool](self, a)
            # tmux starts a pane even when the program is missing, and the pane just dies.
            exe = next((x for x in argv if os.path.isabs(x)), "")
            if exe and not os.access(exe, os.X_OK):
                raise OSError(f"{exe} cannot run")
            env = {
                "COLORTERM": "truecolor",
                "PANTHEON_DB": db_uri(db_path(self.slug)),
                "PANTHEON_AGENT": a.name,
                **env,
            }
            cols, rows = self.term_size()
            # tmux expands formats in -c, so a "#" in the path must be doubled.
            start_dir = self.workdir.replace("#", "##")
            cmd = ["new-session", "-d", "-s", a.name, "-x", str(cols), "-y", str(rows)]
            cmd += ["-c", start_dir]
            for k, v in env.items():
                cmd += ["-e", f"{k}={v}"]
            cmd = [tmux_arg(x) for x in [*cmd, *argv]]
            text = clean_instructions(first.text, a.tool)
            prompt = [tmux_arg(x) for x in prompt_args(a.tool, text)]
            # Measured here, since past the limit tmux fails with one of two messages.
            in_argv = sum(len(x.encode()) + 1 for x in cmd + prompt) <= TMUX_LIMIT
            await self.tmux.run(*cmd, *(prompt if in_argv else []))
        except (TmuxError, OSError, KeyError) as e:
            # The step stays unsent, so reopening the session after a fix tries again.
            self.launch_failed.add(a.name)
            self.event(
                "error",
                f"could not start {a.name} ({type(e).__name__}: {e}); fix it, then reopen this session",
                a,
            )
            return False
        # It gets the posts from now on; its first prompt has the older ones.
        newest = self.db.execute(
            "SELECT COALESCE(MAX(id), 0) FROM events WHERE kind = 'say'"
        ).fetchone()[0]
        self.save_agent(
            a, state="starting", reason="", started_at=now_iso(), heard=newest
        )
        a.launched = time.time()
        spec = spec_text(a.tool, a.model, a.effort)
        self.event("start", f"joined ({spec}) from {short_home(exe)}", a)
        if in_argv:
            self.delivered(a, first)
        else:
            a.outbox.append(first)
        return True

    def delivered(self, a: AgentRun, item: Outgoing) -> None:
        """The agent has item now, typed or in its command line."""
        self.save_agent(a, answering=item.kind == "post")
        if item.kind == "post":  # a reopen does not type it again
            self.save_agent(a, heard=item.event_id)
        if item.kind != "step":
            return
        self.db.execute("UPDATE steps SET sent = 1 WHERE id = ?", (item.step_id,))
        self.save_agent(a, posted=False)  # it posts about this step from now on

    def can_type(self, a: AgentRun, item: Outgoing) -> bool:
        """Whether pantheon may type item into the agent now."""
        if a.tool in ("claude", "ollama") and not a.hooked:
            return False  # its ❯ may mark a row in a startup dialog
        if a.state == "idle" or (a.state == "needs_you" and a.typeable):
            return True
        # A first prompt too long for the command line goes once the input box shows.
        return (
            a.state == "starting"
            and item.kind == "step"
            and self.open_step(a, sent_only=True) is None
        )

    async def send_pending(self, now: float) -> None:
        """Type each agent's next text: paste it, press Enter on a later tick once it
        shows, then watch for the turn it starts. Nothing here waits, so ticks stay
        short."""
        for a in list(self.agents.values()):
            p = a.pasting
            if self.attached == a.name:  # never type into an agent you are in
                if p is not None and not p.entered:
                    p.looked = True
                    # Kept once seen: your Enter empties the box before gemini's title
                    # shows the turn.
                    if not p.shown:
                        screen = await self.tmux.run(
                            "capture-pane", "-p", "-J", "-t", pane(a.name), check=False
                        )
                        p.shown = paste_shown(a.tool, p.before, screen, p.text)
                continue
            if p is not None and p.entered:
                await self.check_turn(a, p, now)
            elif p is not None:
                await self.check_paste(a, p, now)
            elif a.outbox:
                await self.paste(a, now)

    async def paste(self, a: AgentRun, now: float) -> None:
        """Paste the agent's next text, once its input box shows."""
        item = a.outbox[0]
        if item.kind == "remind":
            step = self.step(item.step_id)
            if step is None or step["status"] != "open":
                a.outbox.pop(0)  # its step is done
                return
        if not self.can_type(a, item):
            return
        target = pane(a.name)
        screen = await self.tmux.run(
            "capture-pane", "-p", "-J", "-t", target, check=False
        )
        if not any(m in screen for m in INPUT_MARKERS[a.tool]):
            # Never type on an unknown screen: a dialog would take the text, and some
            # take Enter as "No, exit".
            a.waiting_since = a.waiting_since or now
            if now - a.waiting_since > 15 and not a.waiting_noted:
                a.waiting_noted = True
                self.event(
                    "note", "waiting for its empty input box to show before typing", a
                )
            return
        a.waiting_since, a.waiting_noted = 0.0, False
        # A scroll during transport can leave tmux in copy mode, where Enter only ends
        # copy mode.
        mode = await self.tmux.run(
            "display-message", "-p", "-t", target, "#{pane_in_mode}", check=False
        )
        if mode.strip() == "1":
            await self.tmux.run("send-keys", "-t", target, "-X", "cancel", check=False)
        text = clean_instructions(item.text, a.tool)
        buffer = f"pantheon-{a.name}"
        await self.tmux.run("load-buffer", "-b", buffer, "-", data=text.encode())
        await self.tmux.run(
            "paste-buffer", "-p", "-r", "-d", "-b", buffer, "-t", target
        )
        a.pasting = Paste(item, text, screen, now)

    async def check_paste(self, a: AgentRun, p: Paste, now: float) -> None:
        """Press Enter once the paste shows in the input box, or ask you to look."""
        if not self.can_type(a, p.item):
            return  # a turn of yours runs, or it waits for you
        target = pane(a.name)
        screen = await self.tmux.run(
            "capture-pane", "-p", "-J", "-t", target, check=False
        )
        if paste_shown(a.tool, p.before, screen, p.text):
            if now - p.at < 0.1:  # gemini takes an Enter so soon as a newline
                return
            await self.tmux.run("send-keys", "-t", target, "Enter")
            a.outbox = [o for o in a.outbox if o is not p.item]
            self.delivered(a, p.item)
            p.entered = now
            a.in_turn = True
            self.set_state(a, "working")
        elif now - p.at <= PASTE_TIMEOUT:
            return
        elif p.looked:
            a.pasting = None  # you were in since, and it is not in the box: again
        elif not p.missed:
            # A dialog took the paste (claude's ❯ marks a dialog's rows too), and would
            # take Enter as a choice. No second paste until you have looked: one into
            # a dialog that shows it would fill the dialog up.
            p.missed = True
            self.needs_you(
                a,
                "a dialog is open on its screen; transport to answer it",
                typeable=True,
            )

    async def check_turn(self, a: AgentRun, p: Paste, now: float) -> None:
        """After Enter, a turn starts (turn_started ends the wait). If none does, press
        Enter once more while the text still shows in the input box, then ask you."""
        if a.state != "working":  # another signal came first
            a.pasting = None
            return
        if now - p.entered < SUBMIT_TIMEOUT:
            return
        target = pane(a.name)
        screen = await self.tmux.run(
            "capture-pane", "-p", "-J", "-t", target, check=False
        )
        if not p.again and paste_shown(a.tool, p.before, screen, p.text):
            await self.tmux.run("send-keys", "-t", target, "Enter")
            p.again, p.entered = True, now
            return
        a.pasting = None
        self.needs_you(a, "what pantheon typed did not start a turn")

    async def finish(self, fin: Finish) -> None:
        self.set_session_state(fin.state)
        text = fin.note
        if self.mode.needs_git and self.base and not self.mode.team:
            summary = git_summary(self.workdir, self.base)
            text += f"\n\n{summary}" if summary else ""
        self.event("done", text)
        if self.mode.stop_when_done:
            await self.stop_agents()
            self.event("note", "Stopped the agents.")

    # -- actions from the UI

    def remind(self, a: AgentRun) -> None:
        step = self.open_step(a, sent_only=True)
        if step is None or any(o.kind == "remind" for o in a.outbox):
            return
        a.typeable = a.typeable or a.state == "needs_you"
        write = self.mode.stages[step["stage"]].write
        result = result_lines(write, self.result_path(step), step["statuses"].split())
        # The note's room id ends the text, so an earlier reminder ends another way.
        note = self.event("note", f"You reminded {a.name} to finish step {step['id']}.")
        text = PROMPTS["remind"].format(
            step=step["id"], commands=self.commands(a), result=result, id=note
        )
        a.outbox.append(Outgoing(text, "remind", step["id"]))

    def approve(self, step_id: int) -> None:
        step = self.step(step_id)
        if step is None or step["approved"]:
            return
        # You may have had the agent revise its result by transport, so read it again.
        path = self.result_path(step)
        text = read_text(path) if os.path.exists(path) else step["result"]
        status, _ = parse_status(text, step["name"], step["statuses"].split())
        status = status or step["status"]
        self.db.execute(
            "UPDATE steps SET approved = 1, result = ?, status = ? WHERE id = ?",
            (text, status, step_id),
        )
        if text != step["result"]:  # show the version you approved, too
            a = self.agent_by_id(step["agent_id"])
            data = {"step": step_id, "status": status}
            self.event("result", f"{step['name']} (revised)", a, data)
        self.event("note", f"You approved {step['name']}.")
        if self.state == "waiting":
            self.set_session_state("running")
            self.refresh_session_state()

    async def fit(self, only: str = "") -> None:
        cols, rows = self.term_size()
        for a in self.live_agents():
            if not only or a.name == only:
                await self.tmux.run(
                    "resize-window",
                    "-t",
                    pane(a.name),
                    "-x",
                    str(cols),
                    "-y",
                    str(rows),
                    check=False,
                )

    async def stop_agents(self) -> None:
        self.read_posts()  # the rmtree below would lose them; they go in the room
        self.stopping = True  # the engine stands still, and exits are not news
        try:
            out = await self.tmux.run(
                "list-panes", "-a", "-F", "#{pane_pid}\t#{pane_dead}", check=False
            )
            pids = [
                int(p)
                for p, _, dead in (line.partition("\t") for line in out.splitlines())
                if p.isdigit() and dead != "1"
            ]
            for pid in pids:
                signal_group(pid, signal.SIGTERM)
            for _ in range(30):
                if not any(signal_group(p, 0) for p in pids):
                    break
                await asyncio.sleep(0.1)
            for pid in pids:
                signal_group(pid, signal.SIGKILL)
            await self.tmux.run("kill-server", check=False)
            self.tmux.socket.unlink(missing_ok=True)
            for a in self.live_agents():
                self.save_agent(a, state="exited", reason="")
            shutil.rmtree(
                self.scratch, ignore_errors=True
            )  # the session file has it all
            for path in private_files(self.slug):
                path.unlink(missing_ok=True)
        finally:
            self.stopping = False

    async def end(self) -> None:
        await self.stop_agents()
        self.set_session_state("ended")
        self.event("note", "Ended the session and stopped its agents.")

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        if not self.foreign:
            try:
                self.db.execute(
                    "DELETE FROM lock WHERE id = 1 AND pid = ?", (os.getpid(),)
                )
            except sqlite3.Error:
                pass
        self.db.close()


# ------------------------------------------------------------------------------------- ui

# Agents wear their tool's brand color. Ollama has none, so each ollama agent gets one of
# these, picked by its name so it stays put.
TOOL_COLORS = {"claude": "#d97757", "codex": "#3b82f6", "gemini": "#a855f7"}
OLLAMA_COLORS = ("#eab308", "#ef4444", "#22c55e")
AGENT_BADGES = {
    "new": "·",
    "starting": "○",
    "working": "●",
    "needs_you": "⚑",
    "idle": "✓",
    "exited": "✗",
}
SESSION_BADGES = {
    "running": "●",
    "needs_you": "⚑",
    "waiting": "⚑",
    "done": "✓",
    "stopped": "○",
    "ended": "○",
}


def agent_color(a: AgentRun) -> str:
    if a.tool == "ollama":
        return OLLAMA_COLORS[
            int(hashlib.sha1(a.name.encode()).hexdigest(), 16) % len(OLLAMA_COLORS)
        ]
    return TOOL_COLORS.get(a.tool, "white")


def session_label(s: Session) -> Content:
    return Content(f"{SESSION_BADGES.get(s.state, '?')} {s.slug}")


def tab_label(a: AgentRun) -> Content:
    # An agent that waits for an answer in the room is idle, but not done.
    badge = "?" if a.reason == ROOM_WAIT else AGENT_BADGES.get(a.state, "?")
    return Content.assemble((f"{badge} {a.name}", agent_color(a)))


class Mirror(Static):
    """A live copy of an agent's screen. A short tab shows the screen's lower part."""

    DEFAULT_CSS = "Mirror { height: 1fr; overflow: hidden hidden; }"

    def set_screen(self, screen: str) -> None:
        lines = screen.split("\n")
        if lines and lines[-1] == "":
            lines.pop()
        height = self.size.height or len(lines)
        # Keep the bottom of a full screen, but the top of a short one.
        while len(lines) > height and not ANSI_RE.sub("", lines[-1]).strip():
            lines.pop()
        lines = lines[-height:]
        self.update(Text.from_ansi("\n".join(lines), no_wrap=True, overflow="crop"))


class AgentView(Vertical):
    DEFAULT_CSS = """
    AgentView { height: 1fr; }
    AgentView > .head { height: 1; background: $boost; }
    AgentView > .head > Static { width: 1fr; padding: 0 1; }
    """

    def __init__(self, session: Session, agent: str):
        super().__init__()
        self.session, self.agent = session, agent

    def compose(self) -> ComposeResult:
        with Horizontal(classes="head"):
            yield Static(classes="info")
            yield Button("Transport", compact=True, variant="primary")
        yield Mirror()

    def sync(self) -> None:
        a = self.session.agents[self.agent]
        parts = [
            a.role,
            a.tool,
            a.model,
            a.effort and "@" + a.effort,
            a.state.replace("_", " "),
        ]
        line = " · ".join(p for p in parts if p) + (f": {a.reason}" if a.reason else "")
        self.query_one(".info", Static).update(
            Content.assemble((a.name, f"bold {agent_color(a)}"), " · ", line)
        )

    def on_button_pressed(self, event: Button.Pressed) -> None:
        event.stop()
        self.app.transport(self.session, self.agent)


class ActionEntry(Horizontal):
    """A room line with buttons, which go away once it is resolved."""

    DEFAULT_CSS = """
    ActionEntry { height: auto; background: $warning 20%; }
    ActionEntry.-resolved { background: transparent; }
    ActionEntry > Static { width: 1fr; }
    ActionEntry > Button { margin-left: 1; }
    """

    def __init__(
        self, line: Content, buttons: list[tuple[str, Callable[[], None]]], live: bool
    ):
        super().__init__(classes="" if live else "-resolved")
        self.text, self.buttons = line, buttons if live else []

    def compose(self) -> ComposeResult:
        yield Static(self.text)
        for i, (label, _) in enumerate(self.buttons):
            yield Button(
                label,
                compact=True,
                variant="primary" if i == 0 else "default",
                name=str(i),
            )

    def resolve(self) -> None:
        self.add_class("-resolved")
        self.query(Button).remove()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        event.stop()
        self.buttons[int(event.button.name or 0)][1]()


class Preview(Static):
    """The first lines of a collapsed entry. A click opens the rest."""

    def on_click(self) -> None:
        self.query_ancestor(Collapsible).collapsed = False


def long_entry(title: Content, body: str) -> Static | Collapsible:
    """title, then the body, of which a collapsed entry shows 3 lines. Blank lines
    and the PANTHEON status line (the title has the status) do not count."""
    lines = [
        x for x in body.splitlines() if x.strip() and not STATUS_RE.fullmatch(x.strip())
    ]
    if not lines:
        return Static(title)
    return Collapsible(
        Preview(Text("\n".join(lines))),
        Static(Text(body.strip()), classes="full"),
        title=title,
        collapsed=True,
    )


class Room(VerticalScroll):
    DEFAULT_CSS = """
    Room { height: 1fr; padding: 0 1; }
    Room > * { height: auto; }
    Room > Collapsible { border-top: none; padding: 0; }
    Room > Collapsible > Contents { padding: 0 0 0 3; }
    Room > Collapsible.-collapsed > Contents { display: block; }
    Room > Collapsible.-collapsed > Contents > .full { display: none; }
    Room Preview { display: none; }
    Room > Collapsible.-collapsed > Contents > Preview {
        display: block; max-height: 3; color: $text-muted;
    }
    """

    def on_mount(self) -> None:
        self.anchor()  # follow new entries until you scroll up


class SayBox(Input):
    """Where you post to the room. Escape leaves it, so [ and ] switch tabs again."""

    DEFAULT_CSS = "SayBox { background: $panel; }"

    def key_escape(self) -> None:
        self.screen.set_focus(None)


class SessionView(Vertical):
    DEFAULT_CSS = """
    SessionView { height: 1fr; }
    SessionView > TabbedContent { height: 1fr; }
    SessionView TabPane { padding: 0; height: 1fr; }
    """

    def __init__(self, session: Session, **kwargs):
        super().__init__(**kwargs)
        self.session = session
        self.last_event = 0
        # Fits names like review2-codex-2, so the room's columns line up.
        self.name_width = max(
            [12]
            + [len(f"{st}2-{k}") for st in session.mode.stages for k in session.roster]
        )
        self.tabs: set[str] = set()
        self.needs: dict[str, ActionEntry] = {}  # agent -> its live "needs you" entry
        self.gates: dict[int, ActionEntry] = {}  # step id -> its live approve entry

    def compose(self) -> ComposeResult:
        with TabbedContent():
            with TabPane("Room", id="room"):
                yield Room()
                if not self.session.foreign:  # read-only: no pantheon here drives it
                    yield SayBox(
                        placeholder="Say to the room; every agent gets it (ctrl+s)",
                        compact=True,
                    )

    def on_input_submitted(self, event: Input.Submitted) -> None:
        event.stop()
        text = event.value.strip()
        if not text:
            return
        if not self.session.driving:  # its posts would reach no agent
            self.app.notify("Another pantheon has this session now; post there.")
            return
        self.session.post("you", text)
        event.input.clear()

    def active_agent(self) -> str | None:
        active = self.query_one(TabbedContent).active
        return active.removeprefix("agent-") if active.startswith("agent-") else None

    def entry(self, row):
        s = self.session
        a = s.agent_by_id(row["agent_id"])
        style = f"bold {agent_color(a)}" if a else "bold"
        head = (
            (stamp(row["at"]) + " ", "dim"),
            (f"{a.name if a else 'pantheon':<{self.name_width}} ", style),
        )
        data = json.loads(row["data"] or "{}")
        kind, text = row["kind"], row["text"]
        if kind == "result":
            step = s.step(data.get("step", 0))
            title = Content.assemble(
                *head, (f"{text} → {data.get('status', '')}", "bold")
            )
            return long_entry(title, step["result"] if step else "")
        if kind == "prompt" and a is not None:  # pantheon to the agent
            step = s.step(data.get("step", 0))
            what = ""
            if step is not None:
                what = step["stage"] + (
                    f" round {step['round']}" if step["round"] else ""
                )
            title = Content.assemble(
                head[0],
                (f"{'pantheon':<{self.name_width}} ", "bold"),
                "→ ",
                (a.name, style),
                f": {what}",
            )
            return long_entry(title, text)
        if kind == "say":
            who = a.name if a else str(data.get("from") or "you")
            first, _, rest = text.partition("\n")
            title = Content.assemble(
                head[0], (f"{who:<{self.name_width}} ", style), first
            )
            return long_entry(title, rest)
        if kind == "needs" and a is not None:
            buttons = [("Transport", lambda: self.app.transport(s, a.name))]
            if data.get("remind"):
                buttons.append(("Remind", lambda: s.remind(a)))
            old = self.needs.pop(a.name, None)
            if old is not None:
                old.resolve()
            live = a.state == "needs_you" and not s.foreign
            entry = ActionEntry(
                Content.assemble(*head, ("needs you: ", "bold"), text), buttons, live
            )
            if live:
                self.needs[a.name] = entry
            return entry
        if kind == "approve" and a is not None:
            step_id = data.get("step", 0)
            step = s.step(step_id)
            live = step is not None and not step["approved"] and not s.foreign
            live = live and s.state in ("running", "needs_you", "waiting")
            buttons = [
                ("Approve", lambda: s.approve(step_id)),
                ("Transport", lambda: self.app.transport(s, a.name)),
            ]
            entry = ActionEntry(Content.assemble(*head, (text, "bold")), buttons, live)
            if live:
                self.gates[step_id] = entry
            return entry
        styles = {"error": "red", "done": "bold green"}
        first, _, rest = text.partition("\n")
        return long_entry(Content.assemble(*head, (first, styles.get(kind, ""))), rest)

    async def sync(self) -> None:
        s = self.session
        tabs = self.query_one(TabbedContent)
        for a in list(s.agents.values()):  # the engine adds agents while this awaits
            if a.state != "new" and a.name not in self.tabs:
                self.tabs.add(a.name)
                label = tab_label(a)
                await tabs.add_pane(
                    TabPane(label, AgentView(s, a.name), id=f"agent-{a.name}")
                )
            if a.name in self.tabs:
                tab = tabs.get_tab(f"agent-{a.name}")
                label = tab_label(a)
                if (
                    tab.label.plain != label.plain
                ):  # relabel only on change: it animates
                    tab.label = label
                tab.set_class(a.state == "needs_you", "-needs")
        rows = s.db.execute(
            "SELECT * FROM events WHERE id > ? AND kind != 'hook' ORDER BY id LIMIT 200",
            (self.last_event,),
        ).fetchall()
        room = self.query_one(Room)
        for row in rows:
            self.last_event = row["id"]
            await room.mount(self.entry(row))
        extra = len(room.children) - 500
        if extra > 0:
            await room.remove_children(room.children[:extra])
        for name, entry in list(self.needs.items()):
            if s.agents[name].state != "needs_you":
                entry.resolve()
                del self.needs[name]
        going = s.state in ("running", "needs_you", "waiting")
        for step_id, entry in list(self.gates.items()):
            step = s.step(step_id)
            if step is None or step["approved"] or not going:
                entry.resolve()
                del self.gates[step_id]
        for view in self.query(AgentView):
            view.sync()


class SwitcherScreen(ModalScreen):
    DEFAULT_CSS = """
    SwitcherScreen { align: center middle; }
    SwitcherScreen > Vertical {
        width: 110; max-width: 95%; height: auto; max-height: 85%;
        border: thick $accent; background: $surface; padding: 0 1;
    }
    SwitcherScreen OptionList { height: auto; max-height: 24; }
    """
    BINDINGS = [Binding("escape", "close", "Close"), Binding("n", "new", "New session")]

    def __init__(self, open_sessions: dict[str, Session]):
        super().__init__()
        self.open_sessions = open_sessions

    def compose(self) -> ComposeResult:
        options = []
        for r in list_sessions():
            here = self.open_sessions.get(r["slug"])
            state = here.state if here else r["state"]
            badge = SESSION_BADGES.get(state, "?")
            if r["holder"] and not here:
                badge, state = "⋯", f"open in pid {r['holder']}"
            label = Text.assemble(
                f"{badge} ",
                (r["slug"], "bold"),
                f"  {r['mode']}  {state.replace('_', ' ')}  ",
                (first_line(r["task"], 50), "dim"),
            )
            options.append(
                Option(label, id=r["slug"], disabled=bool(r["holder"]) and not here)
            )
        with Vertical():
            yield Static(Text("Sessions", style="bold"))
            yield OptionList(*options) if options else Static("No sessions yet.")
            yield Static(Text("enter: open · n: new session · esc: close", style="dim"))

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        self.dismiss(event.option_id)

    def action_close(self) -> None:
        self.dismiss(None)

    def action_new(self) -> None:
        self.dismiss("+new")


class NewSessionScreen(ModalScreen):
    DEFAULT_CSS = """
    NewSessionScreen { align: center middle; }
    NewSessionScreen > Vertical {
        width: 90; max-width: 95%; height: auto;
        border: thick $accent; background: $surface; padding: 0 1;
    }
    NewSessionScreen Horizontal { height: auto; }
    """
    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, yolo: bool):
        super().__init__()
        self.yolo = yolo

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Static(Text("New session", style="bold"))
            yield Select(
                [(name, name) for name in MODES],
                value="implement",
                allow_blank=False,
                id="mode",
            )
            yield Input(
                placeholder="Task: text, an issue number, or an issue URL", id="task"
            )
            yield Input(
                placeholder="Agents: how many, or SPEC,SPEC,... (empty: the mode's default)",
                id="agents",
            )
            yield Select(
                [
                    ("Effort: the mode's level", "mode"),
                    ("Effort: each tool's own config", "default"),
                ]
                + [(f"Effort: {level}", level) for level in EFFORTS],
                value="mode",
                allow_blank=False,
                id="effort",
            )
            yield Input(value=os.getcwd(), placeholder="Start dir", id="dir")
            yield Checkbox(
                "yolo: start agents with permission checks off", self.yolo, id="yolo"
            )
            with Horizontal():
                yield Button("Start", variant="primary", id="start")
                yield Button("Cancel", id="cancel")

    def submit(self) -> None:
        effort = str(self.query_one("#effort", Select).value)
        self.dismiss(
            NewSession(
                mode=str(self.query_one("#mode", Select).value),
                task=self.query_one("#task", Input).value.strip(),
                dir=self.query_one("#dir", Input).value.strip(),
                yolo=self.query_one("#yolo", Checkbox).value,
                agents=self.query_one("#agents", Input).value.strip(),
                effort=None if effort == "mode" else effort_arg(effort),
            )
        )

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "start":
            self.submit()
        else:
            self.dismiss(None)

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self.submit()

    def action_cancel(self) -> None:
        self.dismiss(None)


class ConfirmScreen(ModalScreen):
    DEFAULT_CSS = """
    ConfirmScreen { align: center middle; }
    ConfirmScreen > Vertical {
        width: 70; max-width: 95%; height: auto;
        border: thick $error; background: $surface; padding: 0 1;
    }
    ConfirmScreen Horizontal { height: auto; }
    """
    BINDINGS = [Binding("escape", "no", "No")]
    AUTO_FOCUS = "#no"  # a stray Enter must not end a session

    def __init__(self, question: str):
        super().__init__()
        self.question = question

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Static(Content(self.question))
            with Horizontal():
                yield Button("Yes", variant="error", id="yes")
                yield Button("No", id="no")

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")

    def action_no(self) -> None:
        self.dismiss(False)


class PantheonApp(App):
    TITLE = "pantheon"
    CSS = """
    #top { height: 1; background: $primary 30%; }
    #sessions { width: 1fr; height: 1; }
    #sessions Underline { display: none; }
    #sessions Tab.-active { background: $primary 60%; text-style: bold; }
    #sessions Tab.-needs { background: $warning 50%; text-style: bold; }
    #header {
        width: auto; max-width: 60%; padding: 0 1;
        text-wrap: nowrap; text-overflow: ellipsis;
    }
    #yolo-badge { width: auto; padding: 0 1; background: $error; text-style: bold; display: none; }
    #yolo-badge.-on { display: block; }
    ContentSwitcher { height: 1fr; }
    ContentTab.-needs { background: $warning 50%; text-style: bold; }
    ContentTabs:focus ContentTab.-active { background: $surface; }
    """
    BINDINGS = [
        Binding("left_square_bracket", "tab(-1)", "Prev tab"),
        Binding("right_square_bracket", "tab(1)", "Next tab"),
        Binding("left_curly_bracket", "session(-1)", "Prev session", show=False),
        Binding("right_curly_bracket", "session(1)", "Next session", show=False),
        Binding("ctrl+t", "transport", "Transport"),
        Binding("ctrl+s", "say", "Say"),
        Binding("ctrl+o", "sessions", "Sessions"),
        Binding("ctrl+n", "new_session", "New"),
        Binding("ctrl+e", "end_session", "End session"),
        Binding("ctrl+q", "quit", "Quit", priority=True),
    ]

    def __init__(self, cfg: dict, slug: str | None, yolo_flag: bool | None = None):
        super().__init__()
        self.cfg, self.first_slug, self.yolo_flag = cfg, slug, yolo_flag
        self.yolo = setting(cfg, "yolo") if yolo_flag is None else yolo_flag
        self.sessions: dict[str, Session] = {}
        self.current = ""
        self.transporting: tuple[Session, str, bool, bool] | None = (
            None  # session, agent, came to answer
        )
        self.detach_at = 0.0
        self.seen_needs: dict[str, int] = {}
        self.capturing = False

    def compose(self) -> ComposeResult:
        with Horizontal(id="top"):
            sessions = Tabs(id="sessions")
            sessions.can_focus = False  # ← and → stay with the agents' tabs
            yield sessions
            yield Static(id="header")
            badge = Static("⚠ YOLO", id="yolo-badge")
            badge.tooltip = "These agents run with their permission checks off."
            yield badge
        yield ContentSwitcher(id="views")
        yield Footer()

    async def on_mount(self) -> None:
        # get(): a THEME_ line that is commented out also means the default.
        colors = {
            "primary": globals().get("THEME_PRIMARY"),
            "accent": globals().get("THEME_ACCENT"),
        }
        overrides = {k: v for k, v in colors.items() if v is not None}
        self.register_theme(
            replace(BUILTIN_THEMES["textual-dark"], name="pantheon", **overrides)
        )
        self.theme = "pantheon"
        self.set_interval(0.25, self.refresh_ui)
        self.set_interval(0.125, self.refresh_mirror)
        if self.first_slug:
            await self.open_session(self.first_slug)
        else:
            self.action_sessions()

    def term_size(self) -> tuple[int, int]:
        # A row for tmux's status line, so going into an agent does not resize it.
        return max(self.size.width, 40), max(self.size.height - 1, 10)

    def current_view(self) -> SessionView | None:
        if not self.current:
            return None
        return self.query_one(ContentSwitcher).get_child_by_id(
            view_id(self.current), SessionView
        )

    async def open_session(self, slug: str) -> None:
        if slug not in self.sessions:
            try:
                s = Session(slug, self.cfg, self.term_size)
            except (Locked, ValueError, sqlite3.Error, OSError) as e:
                self.notify(str(e), severity="error")
                return
            self.sessions[slug] = s
            await self.query_one(ContentSwitcher).mount(
                SessionView(s, id=view_id(slug))
            )
            await self.query_one("#sessions", Tabs).add_tab(
                Tab(session_label(s), id=tab_id(slug))
            )
            if s.foreign:
                self.notify(
                    f"{slug} comes from another install, so it opens read-only."
                )
            else:
                self.run_worker(s.run(), group="engine", exit_on_error=False)
        self.show_session(slug)

    def show_session(self, slug: str) -> None:
        self.current = slug
        self.query_one(ContentSwitcher).current = view_id(slug)
        tabs = self.query_one("#sessions", Tabs)
        tabs.active = tab_id(slug)
        # Tabs scrolls to the tab it makes active, but a new tab has no place yet.
        tab = tabs.active_tab
        if tab is not None:
            self.call_after_refresh(tab.scroll_visible, animate=False, force=True)

    def on_tabs_tab_activated(self, event: Tabs.TabActivated) -> None:
        # A session's tab; each session's TabbedContent keeps its agents' tabs to itself.
        # Each switch posts one of these, so act only on the tab that is still active.
        if event.tabs.id != "sessions" or event.tab.id != event.tabs.active:
            return
        slug = next((x for x in self.sessions if tab_id(x) == event.tab.id), "")
        if slug and slug != self.current:
            self.show_session(slug)

    def action_session(self, step: int) -> None:
        slugs = list(self.sessions)
        if slugs:
            i = slugs.index(self.current) if self.current in slugs else 0
            self.show_session(slugs[(i + step) % len(slugs)])

    async def refresh_ui(self) -> None:
        if self.transporting:
            self.check_auto_return()
            return
        view = self.current_view()
        if view is not None:
            await view.sync()
        s = self.sessions.get(self.current)
        tabs = self.query_one("#sessions", Tabs)
        hidden = 0  # sessions that need you, with their tab out of view
        for slug, x in self.sessions.items():
            for tab in tabs.query(f"#{tab_id(slug)}").results(Tab):
                label = session_label(x)
                if tab.label_text != label.plain:
                    tab.label = label
                needs = slug != self.current and x.asks() > 0
                tab.set_class(needs, "-needs")
                if needs and not tabs.region.contains_region(tab.region):
                    hidden += 1
        # A long row of tabs can hide a marked one. First, so no ellipsis cuts it.
        pieces: list = [(f"⚑ {hidden} more · ", "bold") if hidden else ""]
        pieces.append("pantheon" if s is None else "")
        if s is not None:
            state = s.state.replace("_", " ") + (" (read-only)" if s.foreign else "")
            pieces += [f"{s.mode_name} · {state}"]
            agent, label = s.step_label()
            if agent is not None:
                pieces += [
                    " · ",
                    (agent.name, f"bold {agent_color(agent)}"),
                    f": {label}",
                ]
            elif label:
                pieces.append(f" · {label}")
        self.query_one("#header", Static).update(Content.assemble(*pieces))
        # The session in view decides: yolo is fixed when a session starts.
        self.query_one("#yolo-badge").set_class(s.yolo if s else self.yolo, "-on")
        for slug, x in self.sessions.items():
            n = x.asks()
            if slug != self.current and n > self.seen_needs.get(slug, 0):
                self.notify(f"{slug} needs you", severity="warning")
            self.seen_needs[slug] = n

    def check_auto_return(self) -> None:
        s, name, came_to_answer, was_live = self.transporting
        a = s.agents.get(name)
        gone = was_live and a is not None and a.state == "exited"
        moved_on = came_to_answer and a is not None and a.state != "needs_you"
        if not gone and not moved_on:
            self.detach_at = 0.0
            return
        now = time.time()
        if not self.detach_at:
            self.detach_at = now + 2  # unless it asks again right away
        elif now >= self.detach_at:
            self.detach_at = 0.0
            self.transporting = (s, name, False, False)
            self.run_worker(
                s.tmux.run("detach-client", "-s", f"={name}", check=False),
                exit_on_error=False,
            )

    async def refresh_mirror(self) -> None:
        if self.transporting or self.capturing:
            return
        view = self.current_view()
        name = view.active_agent() if view else None
        if view is None or name is None or view.session.agents[name].state == "new":
            return
        self.capturing = True
        try:
            screen = await view.session.tmux.run(
                "capture-pane", "-p", "-e", "-t", pane(name)
            )
        except (TmuxError, OSError):  # OSError: tmux itself went away
            return
        finally:
            self.capturing = False
        view.query_one(f"#agent-{name}").query_one(Mirror).set_screen(screen)

    def on_resize(self) -> None:
        if not self.transporting:
            for s in self.sessions.values():
                self.run_worker(s.fit(), group="fit", exit_on_error=False)

    def action_tab(self, step: int) -> None:
        view = self.current_view()
        if view is None:
            return
        tabs = view.query_one(TabbedContent)
        ids = [pane.id for pane in tabs.query(TabPane)]
        if ids:
            i = ids.index(tabs.active) if tabs.active in ids else 0
            tabs.active = ids[(i + step) % len(ids)]

    def action_transport(self) -> None:
        view = self.current_view()
        if view is None:
            self.notify("Open a session first (ctrl+o).")
            return
        s = view.session
        name = view.active_agent() or next(
            (a.name for a in s.agents.values() if a.state == "needs_you"), None
        )
        if name is None:
            self.notify("Pick an agent tab first.")
            return
        self.transport(s, name)

    def action_say(self) -> None:
        view = self.current_view()
        if view is None:
            self.notify("Open a session first (ctrl+o).")
            return
        if view.session.foreign:
            self.notify("This session is read-only here.")
            return
        view.query_one(TabbedContent).active = "room"
        view.query_one(SayBox).focus()

    @work(exclusive=True, group="transport", exit_on_error=False)
    async def transport(self, s: Session, name: str) -> None:
        a = s.agents.get(name)
        if a is None or a.state == "new":
            self.notify(f"{name} has not started.")
            return
        token = object()
        s.attached, s.attach_token = name, token  # first, so retire() leaves it alone
        error: BaseException | None = None
        try:
            try:  # retire() kills a replaced instance's session, and a server can die
                await s.tmux.run("has-session", "-t", f"={name}")
            except TmuxError:
                self.notify(f"{name} has stopped, so its screen is gone.")
                return
            await s.fit(name)
            # resize-window pinned the window's size; let it follow your terminal there.
            await s.tmux.run(
                "set-option",
                "-w",
                "-t",
                pane(name),
                "window-size",
                "latest",
                check=False,
            )
            await s.tmux.run(
                "set-option", "-t", pane(name), "@color", agent_color(a), check=False
            )
            self.transporting = (s, name, a.state == "needs_you", a.state != "exited")
            self.detach_at = 0.0
            # batch_update keeps refreshes from piling up while Textual is suspended.
            with self.batch_update(), self.suspend():
                try:
                    proc = await asyncio.create_subprocess_exec(
                        *s.tmux.base, "attach-session", "-t", f"={name}", env=s.tmux.env
                    )
                    await proc.wait()
                except (
                    BaseException
                ) as e:  # Textual never comes back if one crosses suspend()
                    error = e
        except SuspendNotSupported:
            self.notify("This terminal cannot hand over to an agent.", severity="error")
        finally:
            if s.attach_token is token:  # else a newer press owns them
                self.transporting = None
                s.attached = ""
        await s.fit(name)
        if isinstance(error, asyncio.CancelledError):
            raise error
        if error is not None:
            self.notify(f"Transport failed: {error}", severity="error")

    def action_sessions(self) -> None:
        self.push_screen(SwitcherScreen(self.sessions), self.picked_session)

    async def picked_session(self, choice: str | None) -> None:
        if choice == "+new":
            self.action_new_session()
        elif choice:
            await self.open_session(choice)

    def action_new_session(self) -> None:
        if self.yolo_flag is None:  # you may have changed the setting since
            try:
                self.yolo = setting(load_config(), "yolo")
            except SystemExit as e:  # from die(): config.toml has a bad key
                self.notify(str(e.code), severity="error")
                return
        self.push_screen(NewSessionScreen(self.yolo), self.new_session)

    def new_session(self, req: NewSession | None) -> None:
        if req is not None:
            self.create_session(req)

    @work(exit_on_error=False)
    async def create_session(self, req: NewSession) -> None:
        self.notify(f"Starting {req.mode}...")
        try:
            self.cfg = load_config()  # a setting may have changed since the UI opened
        except SystemExit as e:  # from die(): config.toml has a bad key
            self.notify(str(e.code), severity="error")
            return
        try:
            # Pressing Start accepts a dirty work tree.
            slug, _ = await asyncio.to_thread(
                prepare, self.cfg, req, lambda files, note: True
            )
        except PrepError as e:
            self.notify(str(e), severity="error")
            return
        await self.open_session(slug)

    def action_end_session(self) -> None:
        s = self.sessions.get(self.current)
        if s is None or s.state == "ended":
            self.notify("No open session to end.")
            return
        question = f"End {s.slug} and stop its agents? You can still read its room."
        self.push_screen(
            ConfirmScreen(question),
            lambda yes: yes and self.run_worker(s.end(), exit_on_error=False),
        )

    def on_unmount(self) -> None:
        for s in self.sessions.values():
            s.close()


def run_ui(cfg: dict, slug: str | None, yolo_flag: bool | None = None) -> int:
    app = PantheonApp(cfg, slug, yolo_flag)
    app.run()
    for s in app.sessions.values():
        if s.state != "ended" and s.live_agents() and not s.foreign:
            print(
                f"pantheon: {s.slug} still has agents running; reopen it with: pantheon session {s.slug}"
            )
    return app.return_code or 0


# --------------------------------------------------------------------------------- update


def program_path() -> Path:
    return Path(__file__).absolute()


def in_upstream_repo(path: Path) -> bool:
    """Whether the real file (links followed) is in a clone of UPSTREAM_REPO, through
    any host name (an SSH alias, GitHub's port 443). A fork has another owner, so it
    still gets updates from upstream."""
    real = os.path.dirname(os.path.realpath(path))
    rc, out, _ = git(real, "remote", "get-url", "origin")
    if rc:
        return False
    try:
        _, repo = parse_remote(out)
    except PrepError:
        return False
    return repo.lower() == UPSTREAM_REPO


def version_key(version: str) -> tuple[int, ...]:
    return tuple(int(n) for n in re.findall(r"\d+", version))


def upstream_version(text: str) -> str:
    m = re.search(r'^VERSION = "([^"\n]+)"', text, re.M)
    return m[1] if m else ""


def fetch_upstream() -> str:
    """GitHub's pantheon, checked so a bad download never replaces a working one."""
    req = urllib.request.Request(
        UPSTREAM_URL, headers={"User-Agent": f"pantheon/{VERSION}"}
    )
    with urllib.request.urlopen(req, timeout=5) as r:
        data = r.read(8_000_000)
        if getattr(
            r, "length", None
        ):  # read(n) does not raise when the body stops short
            raise ValueError("the download was cut off")
    text = data.decode("utf-8")
    if not text.startswith("#!/usr/bin/env -S uv run --script"):
        raise ValueError("that is not a pantheon program")
    if '\nif __name__ == "__main__":\n    sys.exit(main())' not in text:
        raise ValueError("it was cut off, or it has no main guard")  # a cut can compile
    if not upstream_version(text):
        raise ValueError("it has no VERSION")
    compile(text, UPSTREAM_URL, "exec")  # a broken file fails here
    write_private(UPSTREAM_CACHE, text)
    return text


FETCH_ERRORS = (OSError, ValueError, SyntaxError, http.client.HTTPException)


def offline(e: BaseException) -> bool:
    """A network that is down or slow, which a start should not complain about."""
    if isinstance(e, urllib.error.HTTPError):
        return False
    e = getattr(e, "reason", e)
    return isinstance(e, OSError) and not isinstance(e, ssl.SSLError)


def cached_upstream() -> tuple[str, bool]:
    """GitHub's pantheon from a cache at most UPSTREAM_MAX_AGE old; True if just fetched."""
    try:
        if time.time() - UPSTREAM_CACHE.stat().st_mtime < UPSTREAM_MAX_AGE:
            return UPSTREAM_CACHE.read_text(encoding="utf-8"), False
    except (OSError, ValueError):
        pass
    try:
        UPSTREAM_CACHE.touch()  # first, so a failed or stopped check waits out the age too
    except OSError:
        return "", False
    got: list = []

    def fetch() -> None:
        try:
            got.append(fetch_upstream())
        except FETCH_ERRORS as e:
            got.append(e)

    # urlopen's timeout is per socket call, and DNS has none, so cap the wait here.
    worker = threading.Thread(target=fetch, daemon=True)
    worker.start()
    worker.join(UPSTREAM_WAIT)
    if got and isinstance(got[0], str):
        return got[0], True
    if got and not offline(got[0]):  # at most once per max age, thanks to the touch
        print(f"pantheon: could not check GitHub for a newer version ({got[0]})")
    try:
        return UPSTREAM_CACHE.read_text(encoding="utf-8"), False
    except (OSError, ValueError):
        return "", False


def install_program(text: str) -> Path:
    """Replace this program in one step and keep its mode. Through a link it writes the
    real file, so a fork's checkout gets the new version and the link stays."""
    path = Path(os.path.realpath(program_path()))
    mode = stat.S_IMODE(path.stat().st_mode)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise
    return path


def cmd_update() -> int:
    path = program_path()
    if in_upstream_repo(path):
        die(f"{os.path.realpath(path)} is in a clone of {UPSTREAM_REPO}; use git pull")
    try:
        text = fetch_upstream()
    except FETCH_ERRORS as e:
        die(f"could not get pantheon from GitHub: {e}")
    if text == read_text(os.path.realpath(path)):
        print(f"pantheon {VERSION} is up to date.")
        return 0
    try:
        written = install_program(text)
    except OSError as e:
        die(f"could not replace {path}: {e}")
    print(f"pantheon: updated {written} from {VERSION} to {upstream_version(text)}")
    return 0


def offer_update(argv: list[str]) -> None:
    """Offer a newer pantheon from GitHub: ask once per fetch, then only remind."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return  # a script cannot answer
    path = program_path()
    if in_upstream_repo(path):
        return  # git updates it
    text, fresh = cached_upstream()
    new = upstream_version(text)
    if not new or version_key(new) <= version_key(VERSION):
        return
    if not fresh:
        print(f"pantheon: {new} is out (you have {VERSION}); run: pantheon update")
        return
    real = os.path.realpath(path)
    answer = ask(f"pantheon {new} is out (you have {VERSION}). Replace {real}? [y/N] ")
    if not answer.lower().startswith("y"):
        return
    try:
        install_program(text)
    except OSError as e:
        print(f"pantheon: could not update {path}: {e}")
        return
    print(f"pantheon: updated to {new}")
    if not os.access(path, os.X_OK):
        sys.exit("pantheon: run it again to use the new version")
    os.execv(path, [str(path), *argv])


# ------------------------------------------------------------------------------------ cli


def confirm_dirty(files: list[str], note: str) -> bool:
    print("pantheon: the work tree already has changes:")
    for name in files[:20]:
        print(f"  {name}")
    if len(files) > 20:
        print(f"  ... and {len(files) - 20} more")
    print(note)
    return sys.stdin.isatty() and ask("Continue? [y/N] ").lower().startswith("y")


def cmd_sessions(prune: int | None) -> None:
    rows = list_sessions()
    if prune is not None:
        cutoff = time.time() - prune * 86400
        for r in rows:
            try:
                created = datetime.fromisoformat(r["created_at"]).timestamp()
            except ValueError:
                continue
            # This pantheon cannot open an older session to end it.
            old = r["version"] < SCHEMA_VERSION
            if (
                r["holder"]
                or (r["state"] not in ("done", "stopped", "ended") and not old)
                or created > cutoff
            ):
                continue
            stop_server_sync(r["slug"])
            shutil.rmtree(scratch_dir(r["slug"]), ignore_errors=True)
            for path in private_files(r["slug"]):
                path.unlink(missing_ok=True)
            for suffix in ("", "-journal", "-wal", "-shm"):
                Path(f"{db_path(r['slug'])}{suffix}").unlink(missing_ok=True)
            print(f"deleted {r['slug']}")
        rows = list_sessions()
    if not rows:
        print("No sessions yet. Start one with: pantheon start MODE TASK")
        return
    for r in rows:
        state = r["state"].replace("_", " ") + (
            f" (open in pid {r['holder']})" if r["holder"] else ""
        )
        if r["version"] < SCHEMA_VERSION:
            state += " (old: prune it)"
        elif r["version"] > SCHEMA_VERSION:
            state += " (from a newer pantheon)"
        task = first_line(r["task"], 50)
        print(
            f"{r['slug']:<42} {r['mode']:<10} {state:<26} {age(r['created_at']):>4}  {short_home(r['dir'])}  {task}"
        )


def cmd_show(slug: str, name: str) -> None:
    path = db_path(slug)
    db = connect(path)
    try:
        s = db.execute("SELECT * FROM session").fetchone()
        steps = db.execute(
            "SELECT s.*, a.name AS agent FROM steps s JOIN agents a ON a.id = s.agent_id ORDER BY s.id"
        ).fetchall()
        if name:
            done = [r for r in steps if r["result"]]
            hits = [r for r in done if r["name"] in (name, f"{name}.md")] or [
                r for r in done if name in r["name"]
            ]
            if len(hits) != 1:
                names = ", ".join(r["name"] for r in done) or "none yet"
                die(f"{name!r} matches {len(hits)} results; this session has: {names}")
            sys.stdout.write(hits[0]["result"].rstrip("\n") + "\n")
            return
        room = room_entries(db, run_dir_of(path), full=True)
        try:
            roster = db.execute("SELECT * FROM roster WHERE listed = 1 ORDER BY id")
            agents = [spec_text(r["tool"], r["model"], r["effort"]) for r in roster]
        except sqlite3.OperationalError:  # a session from before rosters
            agents = []
    finally:
        db.close()
    print(
        f"{slug} · {s['mode']} · {s['state'].replace('_', ' ')} · {short_home(s['dir'])}"
    )
    if s["source"]:
        print(s["source"])
    if agents:
        print("agents: " + ", ".join(agents))
    width = max([12] + [len(r["agent"]) for r in steps])
    if steps:
        print("\nResults (pantheon show SLUG NAME prints one):")
        for r in steps:
            print(f"  {r['name']:<28} {r['agent']:<{width}} {r['status']}")
    print("\nRoom:")
    for entry in room:
        print(textwrap.indent(entry, "  "))


# Under claude's 30,000: past that, claude shows the agent only the output's start.
ROOM_CHARS = 20_000


def session_file(target: str) -> Path:
    """A session file from its path, which agents give (codex may drop PANTHEON_HOME
    from their environment), or from its slug, which people give."""
    if os.sep not in target:
        return db_path(resolve_slug(target))
    path = Path(target)
    # say writes beside it, in ../../run/<slug>/posts, so it must be a session file.
    named = path.suffix == ".sqlite3" and path.parent.name == "sessions"
    if not named or not path.is_file():
        die(f"no session file at {target}")
    return path


def run_dir_of(path: Path) -> Path:
    """A session file's run dir: HOME/sessions/<slug>.sqlite3 -> HOME/run/<slug>."""
    return path.parent.parent / "run" / path.stem


def room_entries(
    db: sqlite3.Connection, run_dir: Path, last: int = 0, full: bool = False
) -> list[str]:
    """The room as text, oldest first: an entry for each event but hooks, with a
    result by its file, and a prompt by its step, or with full, in full. last: only
    the last N entries."""
    events = db.execute(
        "SELECT e.*, a.name AS agent FROM events e LEFT JOIN agents a ON a.id = e.agent_id"
        " WHERE e.kind != 'hook' ORDER BY e.id DESC LIMIT ?",
        (last if last > 0 else -1,),
    ).fetchall()
    steps = {r["id"]: r for r in db.execute("SELECT id, name, stage, round FROM steps")}
    out = []
    for e in reversed(events):
        data = json.loads(e["data"] or "{}")
        who, kind = e["agent"] or "pantheon", e["kind"]
        first, _, rest = e["text"].partition("\n")
        head = f"{who}: {first}"
        step = steps.get(data.get("step"))
        if kind == "result":
            head = f"{who}: {e['text']} → {data.get('status', '')}"
            rest = str(run_dir / step["name"]) if step is not None else ""
        elif kind == "prompt":  # each first prompt holds the task: too long for agents
            what = f"step {data.get('step')}"
            if step is not None:
                rnd = f" round {step['round']}" if step["round"] else ""
                what = f"{step['stage']}{rnd} ({what})"
            head, rest = f"pantheon → {who}: {what}", e["text"] if full else ""
        elif kind == "say":  # agents read this too, so you are the user
            author = e["agent"] or data.get("from", "you")
            head = f"{PROMPTS['user'] if author == 'you' else author} says: {first}"
        elif kind == "needs":
            head = f"{who}: needs you: {first}"
        body = [f"    {x}" if x.strip() else "" for x in rest.strip("\n").splitlines()]
        out.append("\n".join([f"#{e['id']} {stamp(e['at'])} {head}", *body]))
    return out


def cmd_room(target: str, last: int) -> int:
    """Print the room's last entries, for an agent. It opens the session file
    read-only and takes no lock, so it runs beside the pantheon that has the session
    open, and in a sandbox that cannot write the file."""
    path = session_file(target)
    try:
        db = connect(path, "ro")
        try:
            entries = room_entries(db, run_dir_of(path), last)
        finally:
            db.close()  # before printing: an open read would hold up pantheon's writes
    except sqlite3.Error as e:
        if getattr(e, "sqlite_errorname", "") == "SQLITE_READONLY_ROLLBACK":
            die(
                "the session file needs repair after a crash; reopening the session in "
                "pantheon repairs it"
            )
        if "no such table" in str(e):  # an empty file: trying again does not help
            die(f"{path} is not a session file")
        die(f"cannot read the room ({e}); try again in a moment")
    kept, size = [], 0  # the newest entries that fit
    for entry in reversed(entries):
        if size + len(entry) + 1 > ROOM_CHARS:
            if not kept:  # one entry is too long on its own
                kept.append(entry[: ROOM_CHARS - 2] + " …")
            break
        kept.append(entry)
        size += len(entry) + 1
    left = len(entries) - len(kept)
    lines = ([PROMPTS["room_cut"].format(n=left)] if left else []) + kept[::-1]
    try:
        sys.stdout.write("".join(line + "\n" for line in lines))  # in one write
        sys.stdout.flush()
    except BrokenPipeError:  # the reader stopped early
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    return 0


def cmd_say(target: str, sender: str, words: list[str]) -> int:
    """Post to the room. The post goes in a file for the pantheon that has the session
    open, since codex's sandbox cannot write the session file."""
    path = session_file(target)
    text = (sys.stdin.read() if words == ["-"] else " ".join(words)).strip()
    if not text:
        die("say needs a message")
    sender = sender or os.environ.get("PANTHEON_AGENT") or "you"
    post = {"from": sender, "text": text, "at": now_iso()}
    folder = run_dir_of(path) / "posts"
    try:
        private_dir(folder)
        # Named by time, so posts go out in order. write_private renames the file into
        # place, so pantheon never reads half a post.
        write_private(folder / f"{time.time_ns()}-{os.getpid()}.json", json.dumps(post))
    except (OSError, ValueError) as e:
        die(f"cannot post to {path.stem}: {e}")
    if session_holder(path):
        print("pantheon: posted to the room")
    else:
        print(f"pantheon: posted; it waits until a pantheon opens {path.stem}")
    return 0


def mode_description(mode: Mode) -> str:
    width = max(map(len, mode.stages))
    lines = [mode.help, "", "stages:"]
    for name, st in mode.stages.items():
        how = "every agent, one on each track" if st.team else "one agent"
        how += "; the same instance in later rounds" if st.reuse else ""
        lines.append(f"  {name:<{width}}  {st.role} ({how})")
    level = (
        f"Effort level: {mode.effort}."
        if mode.effort
        else "No effort level: each tool's own config decides."
    )
    about = (
        f"{level} -a N takes the first N tools in the agents setting that can run here "
        f"(default: {count_help(mode)}). They take the tracks in that order, and the "
        "first plays each one-agent stage, unless the scramble setting gives each stage "
        "a random order. SPEC is TOOL[:MODEL][@EFFORT], where TOOL is claude, codex, "
        "gemini, or ollama. pantheon agents MODE shows what it would pick here."
    )
    return "\n".join(lines) + "\n\n" + textwrap.fill(about, 80)


def mode_problems() -> list[str]:
    """Mistakes in MODES that would otherwise show only once a session runs."""
    out = []
    for name, mode in MODES.items():
        for stage, st in mode.stages.items():
            if not STAGE_RE.fullmatch(stage):
                out.append(f"{name}: stage {stage!r} needs lowercase letters and '-'")
            if st.role not in ROLES:
                out.append(f"{name}.{stage}: ROLES has no {st.role!r}")
            if not st.statuses or not all(map(WORD_RE.fullmatch, st.statuses)):
                out.append(f"{name}.{stage}: bad statuses {st.statuses!r}")
        out += [
            f"{name}: approve names no stage {x!r}"
            for x in mode.approve
            if x not in mode.stages
        ]
        if mode.effort and mode.effort not in EFFORTS:
            out.append(f"{name}: no effort level {mode.effort!r}")
        if mode.count < mode.least:
            out.append(
                f"{name}: count {mode.count} is below {mode.least}, the fewest agents "
                "it runs with"
            )
    for level, cells in EFFORTS.items():
        for tool, (_, effort) in cells.items():
            if tool not in TOOLS:
                out.append(f"EFFORTS[{level!r}]: no tool {tool!r}")
            elif effort and effort not in TOOL_EFFORTS[tool]:
                out.append(f"EFFORTS[{level!r}]: {tool} takes no effort {effort!r}")
    return out


def build_parser() -> tuple[argparse.ArgumentParser, dict]:
    # -y works before or after the command; SUPPRESS keeps a subcommand from resetting it.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "-y",
        "--yolo",
        action=argparse.BooleanOptionalAction,
        default=argparse.SUPPRESS,
        help="start agents with permission checks off, or on (default: the yolo setting)",
    )
    parser = argparse.ArgumentParser(
        prog="pantheon",
        parents=[common],
        description="Run a small team of AI coding agents in one terminal.",
        epilog="With no command, pantheon opens the session switcher.",
    )
    sub = parser.add_subparsers(dest="command", metavar="COMMAND", title="commands")
    subs = {}
    subs["start"] = sub.add_parser(
        "start",
        parents=[common],
        help="start a session",
        description="Start a session in one of these modes.",
    )
    modes = subs["start"].add_subparsers(
        dest="mode", metavar="MODE", title="modes", required=True
    )
    for name, mode in MODES.items():
        p = modes.add_parser(
            name,
            parents=[common],
            help=mode.help,
            description=mode_description(mode),
            formatter_class=argparse.RawDescriptionHelpFormatter,
            allow_abbrev=False,  # so --agent never stands for --agents
        )
        p.add_argument(
            "-C", "--dir", default=".", metavar="DIR", help="start in DIR (default: .)"
        )
        p.add_argument(
            "-a",
            "--agents",
            default="",
            metavar="N|SPEC,...",
            help="how many agents, or which ones in order "
            f"(default: {count_help(mode)})",
        )
        singles = [s for s, st in mode.stages.items() if not st.team]
        p.add_argument(
            "--agent",
            action="append",
            default=[],
            metavar="STAGE=SPEC",
            help="the agent for one stage: "
            + (", ".join(singles) or "none in this mode"),
        )
        p.add_argument(
            "--effort",
            choices=[*EFFORTS, "default"],
            metavar="LEVEL",
            help=f"an effort level ({', '.join(EFFORTS)}), or default for the tools' own "
            f"config (this mode: {mode.effort or 'default'})",
        )
        p.add_argument(
            "task",
            nargs="+" if mode.needs_task else "*",
            metavar="TASK",
            help="free text, an issue number (123, #123), or an issue URL",
        )
        subs[name] = p
    modes.add_parser("help", help="show the modes, or one mode's options").add_argument(
        "topic", nargs="?", choices=list(MODES), metavar="MODE"
    )
    subs["session"] = sub.add_parser("session", help="open a session")
    subs["session"].add_argument(
        "slug", metavar="SLUG", help="the session (a unique part is enough)"
    )
    subs["sessions"] = sub.add_parser("sessions", help="list sessions")
    subs["sessions"].add_argument(
        "--prune",
        type=int,
        metavar="DAYS",
        help="delete sessions older than DAYS that are finished or from an older pantheon",
    )
    subs["show"] = sub.add_parser(
        "show", help="print a session's room, or one of its results"
    )
    subs["show"].add_argument(
        "slug", metavar="SLUG", help="the session (a unique part is enough)"
    )
    subs["show"].add_argument(
        "name", nargs="?", default="", metavar="NAME", help="a result, e.g. design"
    )
    subs["room"] = sub.add_parser(
        "room",
        help="print a session's room",
        description="Print a session's room, oldest first: its last entries, with a "
        "prompt by its step and a result by its file. It takes no lock, so it works "
        "while pantheon has the session open.",
    )
    subs["room"].add_argument(
        "session",
        metavar="SESSION",
        help="the session file, or its slug (a unique part is enough)",
    )
    subs["room"].add_argument(
        "--last", type=int, default=50, metavar="N", help="how many (default: 50)"
    )
    subs["say"] = sub.add_parser(
        "say",
        help="post to a session's room; agents use it",
        description="Post to a session's room. Pantheon gives the post to every agent "
        "but its author, and each decides whether it needs to act.",
    )
    subs["say"].add_argument(
        "session",
        metavar="SESSION",
        help="the session file, or its slug (a unique part is enough)",
    )
    subs["say"].add_argument(
        "--from",
        dest="sender",
        default="",
        metavar="NAME",
        help="who posts (default: $PANTHEON_AGENT, else you)",
    )
    subs["say"].add_argument(
        "message",
        nargs="+",
        metavar="MESSAGE",
        help="the post, or - to read it from stdin",
    )
    subs["config"] = sub.add_parser(
        "config",
        help="show or change the settings in config.toml",
        description="Show or change the settings in config.toml.",
        epilog="settings:\n"
        + "\n".join(f"  {k:<17} {v.help}" for k, v in SETTINGS.items()),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    actions = subs["config"].add_subparsers(
        dest="action", metavar="ACTION", required=True
    )
    actions.add_parser("show", help="list the settings, with yours marked")
    p = actions.add_parser(
        "set",
        help="change a setting; agents takes TOOL,TOOL,... and ollama_models "
        "LEVEL=MODEL,...",
    )
    p.add_argument("key", metavar="KEY")
    p.add_argument("value", metavar="VALUE")
    p = actions.add_parser("unset", help="put settings back to their defaults")
    p.add_argument("keys", nargs="+", metavar="KEY")
    subs["agents"] = sub.add_parser(
        "agents",
        help="show the agents and models a mode would get here",
        description="Show what pantheon start MODE would pick here, with no session: "
        "each stage's agents, track by track, the flags each agent gets, and what each "
        "tool's own config says about the rest. With no MODE: the tools, and the effort "
        "levels.",
    )
    p = subs["agents"]
    p.add_argument("mode", nargs="?", choices=list(MODES), metavar="MODE")
    p.add_argument("-C", "--dir", default=".", metavar="DIR", help="as for start")
    p.add_argument(
        "-a", "--agents", default="", metavar="N|SPEC,...", help="as for start"
    )
    p.add_argument(
        "--agent",
        action="append",
        default=[],
        metavar="STAGE=SPEC",
        help="as for start",
    )
    p.add_argument(
        "--effort",
        choices=[*EFFORTS, "default"],
        metavar="LEVEL",
        help="one effort level, or default (default: show each)",
    )
    subs["tools"] = sub.add_parser(
        "tools", help="show the claude, codex, gemini, and tmux found now"
    )
    subs["update"] = sub.add_parser(
        "update", help="replace this program with the newest one on GitHub"
    )
    subs["help"] = sub.add_parser("help", help="show help for a command")
    subs["help"].add_argument(
        "topic", nargs="?", metavar="COMMAND", help="a command or a mode"
    )
    return parser, subs


def main(argv: list[str] | None = None) -> int:
    parser, subs = build_parser()
    args = parser.parse_args(argv)
    command, yolo_flag = args.command, getattr(args, "yolo", None)
    if command == "help":
        (subs.get(args.topic) or parser).print_help()
        return 0
    if command == "start" and args.mode == "help":
        subs[args.topic or "start"].print_help()
        return 0
    # Agents run these in their tools' sandboxes: no dirs to make, no lock, and no
    # update prompt (codex runs commands on a terminal, where the prompt would wait).
    if command == "room":
        return cmd_room(args.session, args.last)
    if command == "say":
        return cmd_say(args.session, args.sender, args.message)
    problems = mode_problems()
    if problems:
        die("MODES has mistakes: " + "; ".join(problems))
    try:
        for path in (HOME, SESSIONS, RUN):
            private_dir(path)
    except ValueError as e:
        die(str(e))
    if command == "update":
        return cmd_update()
    try:
        offer_update(sys.argv[1:] if argv is None else argv)
    except KeyboardInterrupt:  # Ctrl-C while it checks or asks: you want out
        return 130
    if (
        command in (None, "start", "session")
        or getattr(args, "prune", None) is not None
    ):
        tmux_path()  # these run agents: fail now, before a session starts
    if command == "config":
        return cmd_config(args)
    if command == "show":
        cmd_show(resolve_slug(args.slug), args.name)
        return 0
    if command == "sessions":
        cmd_sessions(args.prune)
        return 0
    cfg = load_config()
    if command == "tools":
        cmd_tools(cfg)
        return 0
    if command == "agents":
        cmd_agents(cfg, args)
        return 0
    if command == "session":
        slug = resolve_slug(args.slug)
        holder = session_holder(db_path(slug))
        if holder:
            die(f"{slug} is open in another pantheon (pid {holder})")
        return run_ui(cfg, slug, yolo_flag)
    if command == "start":
        task = " ".join(args.task)
        yolo = setting(cfg, "yolo") if yolo_flag is None else yolo_flag
        req = NewSession(
            args.mode,
            task,
            args.dir,
            yolo,
            args.agents,
            args.agent,
            effort_arg(args.effort),
        )
        try:
            slug, notes = prepare(cfg, req, confirm_dirty)
        except PrepError as e:
            die(str(e))
        for note in notes:
            print(f"pantheon: {note}")
        return run_ui(cfg, slug, yolo_flag)
    return run_ui(cfg, None, yolo_flag)


# Installed copies look for these two lines before they update to a newer file.
if __name__ == "__main__":
    sys.exit(main())
