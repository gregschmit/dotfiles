# ---------------------------------------------------------------------- prompts and modes

# Every mode, and everything pantheon tells the agents, so you can change them here.


@dataclass(frozen=True)
class Agent:
    """One of a mode's agents."""

    role: str  # its job, which comes first in its first prompt
    # One instance for each tool from -a, each on a track of its own (or, in a stage
    # whose agents work together, all at once); else one instance, which works on
    # every track.
    multi: bool = False
    # Start it again, fresh, for each of its turns after the first, so no turn leans
    # on what it thought in the last one (a reviewer's own review, say). Each start
    # is a new generation, which its tab shows; it can still answer the room between
    # its turns.
    fresh: bool = False


@dataclass(frozen=True)
class Loop:
    """What makes a stage iterative: its agents take their turns again, round after
    round."""

    until: str  # the halting prompt: when the rounds stop, as a fact the agents judge
    max_rounds: int = 5


@dataclass(frozen=True)
class Stage:
    """A part of the plan. Its agents take turns in order: on each track when one of
    them is multi (unless together), and the next stage starts once this one is done
    on each track it runs on."""

    goal: str  # what the stage is for: its line in the plan that every agent reads
    agents: dict[str, str]  # the agents that take turns, in order: what each writes
    loop: Loop | None = None
    # For a stage with no loop: the plan goes on past it only if its agents find this
    # true. Each report then ends with go or stop, and one stop ends the plan.
    go_if: str = ""
    # For a stage with one single agent and no loop: the track it picks, as this says.
    # Its report then ends with track-N, and the later stages run on track N alone; or
    # with stop, which ends the plan.
    pick: str = ""
    # No tracks: the stage runs once, and a multi agent's instances take each of its
    # turns at once. Such a turn halts a loop only if all of them halt it.
    together: bool = False


@dataclass(frozen=True)
class Mode:
    help: str  # one line, for pantheon start help, and the start of the plan
    agents: dict[str, Agent]
    stages: dict[str, Stage]  # the plan, in order
    count: int = 0  # tools with no -a: up to this many that can run here; 0: all
    effort: str = ""  # an EFFORTS level, or "": each tool's own config
    needs_task: bool = True
    needs_git: bool = True


MODES: dict[str, Mode] = {
    "bakeoff": Mode(
        help=(
            "check the task, design the change several ways, build and review each, "
            "pick the best, and finish it with the best of the rest"
        ),
        agents={
            "architect": Agent(
                "You are a software architect: an engineer who designs changes to "
                "code. Study the task and the code, then design the change: what to "
                "change, where, why, and how to test it. Write it so a developer can "
                "build it without you. Do not change the code. You own your design: "
                "answer questions about it, and fix it when someone finds a problem.",
                multi=True,
            ),
            "developer": Agent(
                "You are a software developer: an engineer who writes and tests code. "
                "Build your track's design in a git worktree of your own, on a new "
                "branch from the session's start commit, and commit your work. If the "
                "design has a gap or a mistake, ask its architect in the room. When "
                "your reviewer asks for changes, make them, or refuse the ones you "
                "think are wrong, and say why.",
                multi=True,
            ),
            "reviewer": Agent(
                "You are a code reviewer: an engineer who checks code for bugs, gaps, "
                "and risks. Review your track's build against the task and the "
                "design: every change on its branch, uncommitted files too, and run "
                "the tests and checks you can. Approve it if it is good to keep; else "
                "ask for changes, and say exactly what and why. Do not change the "
                "code.",
                multi=True,
                fresh=True,
            ),
            "chief-architect": Agent(
                "You are the chief architect: the team's lead engineer, who owns the "
                "technical outcome. Judge the work by its code and its tests, not by "
                "its reports alone. First, check the task before the team starts on "
                "it: is it clear enough to design, and safe and sensible to do? Look "
                "for a task that is vague, contradicts itself or the code, could "
                "destroy data or work, is dangerous, or seems unwise. Ask the user in "
                "the room about each problem, and wait for the answers; stop the plan "
                "only if the problem stays. Once the builds are done, compare them, "
                "pick the one to keep, and decide what it should take from the other "
                "designs and builds. Do not change the code; ask the developers in the "
                "room.",
            ),
        },
        stages={
            "check": Stage(
                "The chief architect checks that the task is clear, safe, and sensible "
                "to do, and asks the user about anything that is not, before the team "
                "starts.",
                {
                    "chief-architect": (
                        "your check: the task as you understand it, the user's "
                        "answers to your questions, and any limits the team must "
                        "keep to; or, if you stop the plan, why"
                    ),
                },
                go_if=(
                    "the task is clear enough to design, and safe and sensible to do, "
                    "as written or with the user's answers in the room"
                ),
            ),
            "design": Stage(
                "Each architect designs the change on their own.",
                {"architect": "your design"},
            ),
            "build": Stage(
                "The developer builds the track's design, and the reviewer reviews the "
                "build.",
                {
                    "developer": (
                        "a summary of your work: its branch, its worktree, and what changed"
                    ),
                    "reviewer": "your review",
                },
                Loop(
                    "the reviewer approves the build, or the developer refuses the "
                    "changes the reviewer asks for",
                    max_rounds=5,
                ),
            ),
            "compare": Stage(
                "The chief architect compares the builds: their code, their tests, and "
                "how well each does the task.",
                {
                    "chief-architect": (
                        "your comparison for the user: how each build does, and the "
                        "one you pick and why (or why none)"
                    ),
                },
                pick="the track with the build to keep",
            ),
            "refine": Stage(
                "The chief architect decides what the picked build should take from "
                "the other designs and builds, and writes it up for its developer.",
                {
                    # The other tracks' work is still in use here, so the cleanup
                    # waits for the finish.
                    "chief-architect": (
                        "what the picked build should take from the others: what, "
                        "from which track, and why, so that its developer can build "
                        "it without you (or, if nothing, why); and which branches and "
                        "worktrees can go once it is finished"
                    ),
                },
            ),
            "finish": Stage(
                "The picked track's developer builds the chief architect's changes, "
                "and its reviewer reviews the build again.",
                {
                    "developer": (
                        "a summary of your work: its branch, its worktree, what you "
                        "took from the other tracks, what changed, how to check it, "
                        "and which branches and worktrees can go now"
                    ),
                    "reviewer": "your review",
                },
                # Not build's words: its reviewer approved the build there already.
                Loop(
                    "the reviewer approves the build with the chief architect's "
                    "changes, or the developer refuses the changes the reviewer asks "
                    "for",
                    max_rounds=5,
                ),
            ),
        },
    ),
    "develop": Mode(
        help=(
            "build the change, then review it with a reviewer for each tool, round "
