# pantheon test SCENARIO MODE: a session of the mode on the scenario's task (if the mode
# takes one), in a new, empty git repo (scenario_repo).
SCENARIOS = {
    "fizzbuzz": (
        "Write fizzbuzz.py, a Python program that prints the numbers from 1 to N, one "
        "per line, but Fizz for multiples of 3, Buzz for multiples of 5, and FizzBuzz "
        "for multiples of both. N is its only argument, and 100 if it is not given. "
        "Add tests that run with python3 -m unittest, and a README that says how to "
        "run the program and the tests."
    ),
    "odd_or_even": (
        "Write odd_or_even.py, a Python program that takes a whole number as its only "
        "argument and prints odd or even. For anything else, it prints an error and "
        "exits with status 1. Add tests that run with python3 -m unittest, and a "
        "README that says how to run the program and the tests."
    ),
}

# The texts pantheon types into agents or prints for them, and the lines about the plan
# it adds to the room: str.format templates. A typed text starts with a letter, since a
# "/" or "!" there is a command in the tools. It ends in a way no other text does
# (step_end, or a room id), since pantheon finds a short paste on the screen by its end.
# A prompt is header; then, in an agent's first prompt only, who, again (in a later
# generation), its role, task, team, plan, how, facts, room, and earlier (when the room
# has posts); then turn, came_in (or came_in_all, in a stage whose agents work
# together) and work (once there are reports); room_again (in later prompts, since the
# agent keeps its context); report or reports (with halt or halt_together in a loop,
# go, or pick); and step_end.
PROMPTS = {
    "header": "Pantheon step {step}, for {agent}.",
    "who": (
        "You are {agent}, one of a team of AI agents that work with the user on a "
        "task. Pantheon starts the agents, gives each its turns in the plan, and "
        "passes the room's posts to all of them. It makes no decisions: the team does, "
        "and the user has the last word."
    ),
    # Reports under its own name that it does not remember would puzzle it.
    "again": (
        "You are generation {n} of {agent}: you start fresh, and earlier generations "
        "took your earlier turns, with a context you do not have. Their reports and "
        "posts under your name are in the room and in the reports below; read what "
        "you need."
    ),
    "task": "The task:\n\n{task}",
    "team": "The team:\n\n{lines}",
    "team_line": "- {agent} ({role}{track}): {spec}{you}",
    "you": " (that is you)",
    "plan": (
        "The plan: {help}. Pantheon gives each agent its turns, one stage at a time: a "
        "stage starts once the stage before it is done, on each track it runs on."
        "\n\n{stages}"
    ),
    "plan_stage": "{n}. {stage}: {agents}{where}. {goal}{loop}{go}{pick}",
    "then": ", then ",
    "on_tracks": ", on each track",
    "on_pick": ", on the picked track",
    "at_once": "every {agent} at once",  # a multi agent in a stage that works together
    "plan_loop": (
        " They take turns in rounds until this is true: {until}; at most {max} "
        "round{s}."
    ),
    "plan_together": (
        " A turn that several agents take at once halts the loop only if all of them "
        "halt it."
    ),
    "plan_go": " The plan goes on only if this is true: {go_if}; else it ends here.",
    "plan_pick": (
        " Its agent picks {pick}: the stages after it run on that track alone, and a "
        "stop ends the plan here."
    ),
    "how": (
        "How to work: the plan is where the work starts, not a fence. If you see a "
        "reason to act outside your turns (a question about your work, a problem in "
        "it, a risk in someone else's), act, and say in the room what you did. Do your "
        "own role's work: ask the owner before you change another agent's work. If you "
        "change your work after others used it, say so. When you finish something "
        "someone asked for in the room, say so there. If you disagree, say why, once, "
        "with facts; then agree on a way forward, or ask the user. A request from the "
        "user comes first. After your turns, stay ready: the user or the team can ask "
        "you for more."
    ),
    "facts": "You start in {dir}.",
    "facts_git": (
        " It is in a git repo, and the session started at commit {base}. Put your name "
        "in the names of the branches and worktrees you make, so the team can tell "
        "them apart."
    ),
    "facts_dirty": (
        " These files had uncommitted changes then, so a branch from that commit does "
        "not have them: {files}."
    ),
    "room": (
        "The room is where the team talks: the user, pantheon, and every agent. It "
        "also lists each agent's report, as it comes in. Pantheon keeps its newest "
        "entries in this file, which you can read at any time:\n\n    {room}\n\nTo "
        "post to the room, end the last message of your turn with a line that starts "
        "with PANTHEON[say]:, like this:\n\nPANTHEON[say]: your message\n\nEverything "
        "after PANTHEON[say]: is the post, so it can have more than one line. Pantheon "
        "reads only the last message of a turn, and posts it when the turn ends. It "
        "gives each post to every other agent and to the user, and each agent takes a "
        "turn to read it. So post only what another agent must act on now: a "
        "question, a problem, or news that changes someone else's work. Do not post "
        "your progress, nor the report that ends a step: pantheon passes that on to "
        "the agents that need it. When a post is for one agent, start it with that "
        "agent's name. If you need an answer before you can finish a turn, post your "
        "question and end your turn: the answer wakes you."
    ),
    # Every later prompt repeats this, since compaction can drop the first.
    "room_again": (
        "The room, as before: read it in {room}, and post to it with a line that "
        "starts with PANTHEON[say]: at the end of the last message of your turn."
    ),
    # An agent gets only the posts made after it starts, so its first prompt lists the
    # newest of the earlier ones (EARLIER_POSTS), and says how many it left out.
    "earlier": "Posts in the room from before you joined, oldest first:\n\n{posts}",
    "earlier_line": "- {sender}: {text}",
    "earlier_cut": "({n} older post{s} left out; read the room to see every post)",
    "turn": "Your turn: {label}. {goal}",
    "round": " round {round}",  # in a turn's label, as in "build round 2, track 1"
    "track": ", track {track}",
    "came_in": "It is your turn since {agent}'s report came in: {path}",
    # In a stage whose agents work together, the turn before can be several reports.
    "came_in_all": "It is your turn since all of these came in:\n\n{lines}",
    "came_in_line": "- {agent}: {path} ({status})",
    "work": "Reports so far that you may need, track by track, oldest first:\n\n{lines}",
    "work_line": "- {label}, by {agent}: {path} ({status})",
    "work_note": "- {note}",  # how a loop ended: halted or out_of_rounds
    # Pantheon keeps each report in a file (report_path) for the next turns.
    "report": (
        "When you finish, write {write} as your report: the last message of your "
        "turn. Pantheon puts it in the room and passes it on to the agents that need "
        "it, so it needs no post and no file; if your work is a file or a branch, say "
        "where it is. End the report with this line:\n\n{lines}"
    ),
    "reports": (
        "When you finish, write {write} as your report: the last message of your "
        "turn. Pantheon puts it in the room and passes it on to the agents that need "
        "it, so it needs no post and no file; if your work is a file or a branch, say "
        "where it is. End the report with one of these lines:\n\n{lines}"
    ),
    "halt": (
        "Write halt if this is now true: {until}. Else write continue. This is round "
        "{round} of at most {max}."
    ),
    # For a multi agent whose instances take the turn at once: each one votes.
    "halt_together": (
        "Write halt if, for your part, this is now true: {until}. Else write "
        "continue. Every {agent} takes this turn at once, and the loop halts only if "
        "all of them write halt. This is round {round} of at most {max}."
    ),
    "go": (
        "Write go if this is true: {go_if}. Else write stop: the plan ends here, and "
        "the stages after this one do not start."
    ),
    "pick": (
        "Write track-N for {pick}, where N is the track's number: the stages after "
        "this one run on that track alone. Else write stop: the plan ends here, and "
        "the stages after this one do not start."
    ),
    "step_end": "(End of step {step}.)",
    "remind": (
        "You ended your turn before you finished step {step}.\n\n{room}\n\n"
        "{report}\n\n(End of reminder #{id}.)"
    ),
    "post": (
        "Room post #{id} from {sender}. Pantheon gives every post to every agent. "
        "Decide whether it needs something from you: a request, a question about your "
        "work, or a problem in it. If it does, act, and answer in the room. If not, "
        "end your turn without doing anything.\n\n{room}\n\nThe post:\n\n{text}"
        "\n\n(End of post #{id}.)"
    ),
    "user": "the user",  # you, as the agents read your posts
    # What the room file starts with when its newest entries fill it.
    "room_cut": "({n} older entr{y} left out, to keep this short)",
    # Pantheon's own lines in the room, which go to no agent; halted and out_of_rounds
    # go in the work list of a turn with no track too.
    "halted": "{label}: {agent} halted it in round {round}.",
    "out_of_rounds": "{label}: it ran out of rounds ({n}), and no one halted it.",
    "given_back": "{label} never reached it, so it gets that turn again, fresh.",
    "retried": "{label} did not finish, so it gets that turn again, fresh.",
    "done": "The plan is done. Read its last report{s}, by {agents}.",
    "stopped": "The plan stopped after {stage}. Read why in the report{s} by {agents}.",
    "still_running": (
        " The agents still run: post in the room (ctrl+s) to give them more work."
    ),
    "never_started": " No turn came for {names}, so they never started.",
}

# ---------------------------------------------------------------------- tools and efforts

# The tools pantheon runs, in the order it picks them: the agents setting's default.
# -a N takes the first N that can run here. Each multi agent has an instance for each,
# in that order, and each single agent takes the first, unless the scramble setting
# gives each agent its own order. An agent's model and effort come from the tool's own
# config, unless a SPEC or an effort level sets them.
TOOLS = ("claude", "codex", "agy", "ollama")  # SPEC: TOOL[:MODEL][@EFFORT]

# Effort levels, for a mode (Mode.effort) or a run (--effort): the (model, effort) each
# tool gets, where "" leaves that part to the tool. Aliases, not model IDs, so the table
# keeps up with new models; codex's model names change too often to name one.
EFFORTS = {
    "low": {
        "claude": ("haiku", "low"),
        "codex": ("", "low"),
        "agy": ("", "low"),  # agy's gemini models take low, medium, and high
        "ollama": ("", "low"),  # its think level, if the model has one
    },
    "medium": {
        "claude": ("sonnet", "medium"),
        "codex": ("", "medium"),
        "agy": ("", "medium"),
        "ollama": ("", ""),  # models read medium differently, so each keeps its own
    },
    "high": {
        "claude": ("", "high"),  # your model
        "codex": ("", "high"),  # every codex model takes high
        "agy": ("", "high"),
        "ollama": ("", "high"),  # a model without high gets its own default
    },
    "max": {
        "claude": ("", "max"),  # your model, at its top effort
        "codex": ("", "xhigh"),  # every codex model takes xhigh; older ones lack max
        "agy": ("", "high"),  # its top: its gemini models have no xhigh or max
        "ollama": ("", "max"),  # a model without max gets its default; gpt-oss: high
    },
}

# The effort words each tool takes. Pantheon checks them because the tools check late:
# claude only warns on stderr, and codex fails on the first turn. agy checks at its start, but
# then the agent never runs.
TOOL_EFFORTS = {
    "claude": ("low", "medium", "high", "xhigh", "max", "ultracode"),
    "codex": ("none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"),
    "agy": ("low", "medium", "high"),  # for its gemini models only (agy_effort)
    "ollama": ("low", "medium", "high", "xhigh", "max"),  # claude passes them on
}

# ------------------------------------------------------------------------------- settings


@dataclass(frozen=True)
class Setting:
    default: object  # its type is the setting's type
    help: str


# config.toml holds only the settings you change: pantheon config set KEY VALUE.
SETTINGS = {
    "agents": Setting(TOOLS, "the tools to pick agents from, in order"),
    "yolo": Setting(False, "start agents with permission checks off (-y, --no-yolo)"),
    "scramble": Setting(
        False, "give each agent the tools in a random order of its own"
    ),
    "disable_claude": Setting(False, "keep claude agents out of new sessions"),
    "disable_codex": Setting(False, "keep codex agents out of new sessions"),
    "disable_agy": Setting(False, "keep agy agents out of new sessions"),
    "disable_ollama": Setting(False, "keep ollama agents out of new sessions"),
    "ollama_url": Setting("", "the ollama server (empty: $OLLAMA_HOST, else local)"),
    "ollama_remote": Setting(
        False, "allow an ollama server on another machine, which gets your keys"
    ),
    "ollama_model": Setting("", "a plain ollama's model, unless ollama_models has one"),
    "ollama_models": Setting(
        {}, "a model per level, like low=qwen3.5:4b,max=qwen3.8:27b"
    ),
    "ollama_context": Setting(32768, "the context size the server gives ollama models"),
    "ollama_token_env": Setting("", "an env var with a bearer token for the server"),
}

# How each setting type reads in an error.
TYPE_WORDS = {bool: "true or false", int: "a whole number", str: "text in quotes"}

