    Path("/Library/Application Support/ClaudeCode")
    if sys.platform == "darwin"
    else Path("/etc/claude-code")
) / "managed-settings.json"

# ------------------------------------------------------------------------------- the room

# The room file that agents read, in run/<slug>/: the newest entries that fit in
# ROOM_CHARS, so an agent can read it whole.
ROOM_FILE = "room.txt"
