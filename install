#!/bin/sh

# Helper to install symlinks to `src` directory.

# Files with my git identity, and the origin (any URL form) that may install them as they are.
IDENTITY_FILES="src/.gitconfig src/.config/git/allowed_signers"
IDENTITY_NAME="schmitgreg"
OFFICIAL_REPO="github.com[:/]gregschmit/dotfiles"

# Stop before any change if a fork still has my git identity, so it doesn't commit as me.
check_identity() {
  case "`git remote get-url origin 2>/dev/null`" in
    *$OFFICIAL_REPO | *$OFFICIAL_REPO.git) return 0 ;;
  esac

  local f found=""
  for f in $IDENTITY_FILES; do
    if grep -qs "$IDENTITY_NAME" "$f"; then found="$found $f"; fi
  done
  if [ -z "$found" ]; then return 0; fi

  echo "ERROR: This is not a clone of gregschmit/dotfiles, but these files still have the git"
  echo "identity of its owner ($IDENTITY_NAME):"
  for f in $found; do echo "  $f"; done
  echo "Change them to match your setup (name, email, signing key), or delete them. Then run"
  echo "./install again. Nothing was installed."
  exit 1
}

# Remove any existing file/symlink at $2, then symlink $2 -> $1.
install_symlink() {
  echo "Symlinking:  $2 -> $1"
  rm -rf "$2"
  ln -s "$1" "$2"
}

# Directories (relative to src/) whose *contents* are symlinked individually into ~/<dir>/ rather
# than symlinking the directory itself. `.config` and `.local/bin` need this because AppArmor
# allows `~/.config` or `~/.local/bin` but doesn't follow symlinks to them. `.claude`, `.codex`,
# and `.gemini` (Antigravity) need it because those tools keep their state (sessions, history,
# caches) next to their config, and that state belongs in the home directory, not in this repo.
# Entries may be nested paths; ancestor directories are mkdir -p'd as needed.
EXPAND_DIRS=".config .local/bin .claude .codex .gemini/config"

# Check whether $1 exactly matches an entry in EXPAND_DIRS.
is_expand_dir() {
  for d in $EXPAND_DIRS; do
    if [ "$1" = "$d" ]; then return 0; fi
  done
  return 1
}

# Check whether $1 is a strict ancestor (path prefix) of some EXPAND_DIRS entry.
is_expand_ancestor() {
  for d in $EXPAND_DIRS; do
    case "$d" in
      "$1"/*) return 0 ;;
    esac
  done
  return 1
}

# Walk src/$1 and install entries into ~/$1. Pass "" to process the src root.
install_dir() {
  local rel="$1"
  local src_dir home_dir entry_path entry child_rel

  if [ -z "$rel" ]; then
    src_dir="`pwd`/src"
    home_dir="$HOME"
  else
    src_dir="`pwd`/src/$rel"
    home_dir="$HOME/$rel"

    # If a previous install symlinked this dir, remove the symlink and warn.
    if [ -L "$home_dir" ]; then
      echo "Found existing symlink!"
      echo "Removing:    $home_dir symlink"
      rm -rf "$home_dir"
      echo "WARNING: Move any untracked files out of the dotfiles tree and re-run this script."
      exit 1
    fi

    mkdir -p "$home_dir"
  fi

  for entry_path in "$src_dir"/.* "$src_dir"/*; do
    [ -e "$entry_path" ] || continue
    entry=$(basename "$entry_path")
    if [ "$entry" = "." ] || [ "$entry" = ".." ]; then continue; fi

    if [ -z "$rel" ]; then
      child_rel="$entry"
    else
      child_rel="$rel/$entry"
    fi

    if is_expand_dir "$child_rel" || is_expand_ancestor "$child_rel"; then
      install_dir "$child_rel"
    else
      install_symlink "$entry_path" "$home_dir/$entry"
    fi
  done
}

# Ensure current directory is the script location.
cd "`dirname "$0"`"

check_identity
install_dir ""
